---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);

// 第 1 頁的網址（/posts/ 或 /tags/<slug>/）。Astro 有給 page.url.first；沒有時從
// 目前網址把尾端的 /N 去掉。第 n 頁 = base + n/（postbuild 會再統一補尾斜線）。
const base = (
  page.url.first ??
  (page.currentPage === 1
    ? page.url.current
    : page.url.current.replace(/\/\d+\/?$/, ""))
).replace(/\/+$/, "");
const hrefOf = (n: number) => (n === 1 ? `${base}/` : `${base}/${n}/`);

// 頁碼視窗：1 … (當前−2 ～ 當前+2) … 末頁。45 頁的列表不再只能一頁一頁翻。
type Item = { kind: "page"; n: number } | { kind: "gap" };
const items: Item[] = [];
if (page.lastPage > 1) {
  const cur = page.currentPage;
  const last = page.lastPage;
  const wanted = new Set<number>([1, last]);
  for (let n = cur - 2; n <= cur + 2; n++) {
    if (n >= 1 && n <= last) wanted.add(n);
  }
  const sorted = [...wanted].sort((a, b) => a - b);
  let prev = 0;
  for (const n of sorted) {
    if (prev && n - prev > 1) items.push({ kind: "gap" });
    items.push({ kind: "page", n });
    prev = n;
  }
}
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex flex-wrap items-center justify-center gap-2 sm:gap-3"
      role="navigation"
      aria-label="分頁導覽"
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={["select-none", { "opacity-50": !page.url.prev }]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>

      <ol class="flex items-center gap-1 sm:gap-2">
        {items.map(item =>
          item.kind === "gap" ? (
            <li class="text-muted-foreground px-1 select-none" aria-hidden="true">
              …
            </li>
          ) : item.n === page.currentPage ? (
            <li>
              <span
                aria-current="page"
                class="bg-accent text-accent-foreground inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg px-3 font-bold"
              >
                {item.n}
              </span>
            </li>
          ) : (
            <li>
              <a
                href={hrefOf(item.n)}
                aria-label={`第 ${item.n} ${t.pagination.page}`}
                class="hover:bg-muted hover:text-accent inline-flex min-h-10 min-w-10 items-center justify-center rounded-lg px-3 no-underline transition-colors"
              >
                {item.n}
              </a>
            </li>
          )
        )}
      </ol>

      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={["select-none", { "opacity-50": !page.url.next }]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
