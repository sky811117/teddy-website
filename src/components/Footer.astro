---
/**
 * 內頁頁尾：2026-11 花店風改版起改渲染 flora/GlassFooter（淡米灰底、被白紙蓋住捲到底才露出）。
 * 文字（名稱、公司、證號、電話、版權）與連結跟舊版逐字相同；舊版深咖啡三欄在 git 歷史裡。
 * noMarginTop 保留介面相容（新版頁尾一律 margin-top:auto 貼底，不再需要這個開關）。
 */
import type { HTMLAttributes } from "astro/types";
import GlassFooter from "./flora/GlassFooter.astro";
type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;
const { noMarginTop: _noMarginTop = false, ...attrs } = Astro.props;
---

<GlassFooter {...attrs} />
