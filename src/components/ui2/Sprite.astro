<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <symbol id="u2-house" viewBox="0 0 48 48">
      <path d="M24 5.5 4.5 21.5V38a3.5 3.5 0 0 0 3.5 3.5h3.2l-2.7 5.2 8.7-5.2H40a3.5 3.5 0 0 0 3.5-3.5V21.5z" style="fill:var(--u2-vellum);stroke:var(--u2-ink);stroke-width:2.4;stroke-linejoin:round"></path>
