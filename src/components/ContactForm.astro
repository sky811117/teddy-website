---
/**
 * ContactForm — 客戶詢價 / 預約看屋表單
 *
 * 後端（2026-09-06 改）：
 *   主管道：Cloudflare Pages Functions `/api/contact-tg`（推 TG 到景泰手機）— 一律 POST
 *   副管道：Formspree（email）— 只有 build 時有 PUBLIC_FORMSPREE_FORM_ID 才並行送
 *   任一條回 ok → 導 /thank-you；兩條都收不到 → 表單原地顯示「備援面板」
 *   （LINE 鈕 + 複製訊息 + 撥電話），客戶永遠不會看到「後端沒設定好」這種字。
 *
 * Props 用來讓不同入口頁面預填欄位（詳情頁帶物件編號、服務頁帶意圖）。
 */
import { PUBLIC_FORMSPREE_FORM_ID } from "astro:env/client";
import IconMapPin from "@/assets/icons/IconMapPin.svg";
import IconPhone from "@/assets/icons/IconPhone.svg";
import LineIcon from "@/assets/icons/socials/line.svg";

type Props = {
  /** 預填物件編號（詳情頁帶入） */
  propertyId?: string;
  /** 預填物件標題（顯示用） */
  propertyTitle?: string;
  /** 預填「我想」（buy / sell / consult / upgrade / invest） */
  defaultIntent?: "buy" | "sell" | "consult" | "upgrade" | "invest";
  /** 表單標題 */
  title?: string;
  /** 副標 / 引導文 */
  subtitle?: string;
};

const {
  propertyId,
  propertyTitle,
  defaultIntent,
  title = "想聊聊？留你的聯絡方式",
  subtitle = "30 秒到 30 分鐘內回你，看你的需求複雜程度。",
} = Astro.props;

const formspreeId = PUBLIC_FORMSPREE_FORM_ID || "";

const TAICHUNG_AREAS = [
  "北屯區", "西屯區", "南屯區", "北區", "南區", "東區", "西區", "中區",
  "太平區", "大里區", "霧峰區", "烏日區", "大肚區", "沙鹿區", "梧棲區",
  "清水區", "潭子區", "大雅區", "神岡區", "豐原區", "后里區", "新社區", "石岡區",
];

// 預先運算的「物件提示文字」— 詳情頁帶 propertyId / propertyTitle 進來時顯示
const propertyHintText = propertyTitle
  ? `物件編號 ${propertyId}・${propertyTitle}`
  : propertyId
    ? `物件編號 ${propertyId}`
    : "";

// 給 textarea 預填的描述
const defaultDescription = propertyId
  ? `想了解物件 ${propertyId}${propertyTitle ? `（${propertyTitle}）` : ""}`
  : "";
---

<section
  class="border-border bg-card my-8 rounded-lg border p-6 sm:p-8"
  data-contact-form-section
>
  <header>
    <h2 class="text-foreground text-2xl font-bold sm:text-3xl">
      {title}
    </h2>
    <p class="text-muted-foreground mt-2 text-[17px] leading-relaxed">
      {subtitle}
    </p>
    {
      propertyHintText && (
        <p class="text-accent mt-2 text-[15px]"><IconMapPin class="size-4 inline-block" aria-hidden="true" /> {propertyHintText}</p>
      )
    }
  </header>

  <form
    data-contact-form
    action="/api/contact-tg"
    method="POST"
    novalidate
    class="mt-6 space-y-5"
    data-formspree-id={formspreeId}
  >
    {/* honeypot — bot 才會填，人類看不到 */}
    <input
      type="text"
      name="_gotcha"
      tabindex="-1"
      autocomplete="off"
      class="absolute -left-[9999px] h-0 w-0 opacity-0"
      aria-hidden="true"
    />

    {/* 載入時間戳 — 用來偵測 3 秒內 submit 的 bot */}
    <input type="hidden" name="_loaded_at" data-loaded-at />

    {/* 預填欄位（hidden） */}
    {
      propertyId && (
        <input type="hidden" name="物件編號" value={propertyId} />
      )
    }
    {
      propertyTitle && (
        <input type="hidden" name="物件標題" value={propertyTitle} />
      )
    }

    {/* 來源頁（讓景泰知道客戶從哪一頁送來） */}
    <input type="hidden" name="_subject" data-form-subject />
    <input type="hidden" name="來源頁" data-source-page />

    {/* === 第一排：姓名 === */}
    <div>
      <label
        for="cf-name"
        class="text-foreground block text-[17px] font-medium"
      >
        姓名 <span class="text-red-500">*</span>
      </label>
      <input
        id="cf-name"
        type="text"
        name="姓名"
        required
        maxlength="50"
        autocomplete="name"
        placeholder="陳先生 / 王小姐"
        class="border-border bg-background text-foreground focus:border-accent focus:ring-accent/30 mt-2 block w-full rounded-md border px-4 py-3 text-[17px] outline-none focus:ring-2"
      />
      <p
        data-error-for="姓名"
        class="mt-1 hidden text-[14px] text-red-500"
      ></p>
    </div>

    {/* === 第二排：手機 + Email === */}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label
          for="cf-phone"
          class="text-foreground block text-[17px] font-medium"
        >
          手機
          <span class="text-muted-foreground text-[13px] font-normal">
            （手機 / Email 至少填一個）
          </span>
        </label>
        <input
          id="cf-phone"
          type="tel"
          name="手機"
          maxlength="20"
          autocomplete="tel"
          inputmode="tel"
          placeholder="0912-345-678"
          pattern="[0-9 +-]{8,}"
          class="border-border bg-background text-foreground focus:border-accent focus:ring-accent/30 mt-2 block w-full rounded-md border px-4 py-3 text-[17px] outline-none focus:ring-2"
        />
        <p
          data-error-for="手機"
          class="mt-1 hidden text-[14px] text-red-500"
        ></p>
      </div>

      <div>
        <label
          for="cf-email"
          class="text-foreground block text-[17px] font-medium"
        >
          Email
        </label>
        <input
          id="cf-email"
          type="email"
          name="Email"
          maxlength="120"
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
          class="border-border bg-background text-foreground focus:border-accent focus:ring-accent/30 mt-2 block w-full rounded-md border px-4 py-3 text-[17px] outline-none focus:ring-2"
        />
        <p
          data-error-for="Email"
          class="mt-1 hidden text-[14px] text-red-500"
        ></p>
      </div>
    </div>

    {/* === 第三排：我想 + 預算 === */}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <div>
        <label
          for="cf-intent"
          class="text-foreground block text-[17px] font-medium"
        >
          我想 <span class="text-red-500">*</span>
        </label>
        <select
          id="cf-intent"
          name="我想"
          required
          class="border-border bg-background text-foreground focus:border-accent focus:ring-accent/30 mt-2 block w-full rounded-md border px-4 py-3 text-[17px] outline-none focus:ring-2"
        >
          <option value="" disabled selected={!defaultIntent}>
            -- 請選擇 --
          </option>
          <option value="找房" selected={defaultIntent === "buy"}>找房</option>
          <option value="賣房" selected={defaultIntent === "sell"}>賣房</option>
          <option value="換屋" selected={defaultIntent === "upgrade"}>換屋</option>
          <option value="投資諮詢" selected={defaultIntent === "invest"}>投資諮詢</option>
          <option value="一般諮詢" selected={defaultIntent === "consult"}>一般諮詢</option>
        </select>
        <p
          data-error-for="我想"
          class="mt-1 hidden text-[14px] text-red-500"
        ></p>
      </div>

      <div>
        <label
          for="cf-budget"
          class="text-foreground block text-[17px] font-medium"
        >
          預算
          <span class="text-muted-foreground text-[13px] font-normal">
            （選填）
          </span>
        </label>
        <select
          id="cf-budget"
          name="預算"
          class="border-border bg-background text-foreground focus:border-accent focus:ring-accent/30 mt-2 block w-full rounded-md border px-4 py-3 text-[17px] outline-none focus:ring-2"
        >
          <option value="">不限 / 未定</option>
          <option value="500萬以下">500 萬以下</option>
          <option value="500-1000萬">500 - 1,000 萬</option>
          <option value="1000-1500萬">1,000 - 1,500 萬</option>
          <option value="1500-2000萬">1,500 - 2,000 萬</option>
          <option value="2000-3000萬">2,000 - 3,000 萬</option>
          <option value="3000萬以上">3,000 萬以上</option>
        </select>
      </div>
    </div>

    {/* === 第四排：物件編號（手動輸入用，預填時隱藏） === */}
    {
      !propertyId && (
        <div>
          <label
            for="cf-listing-code"
            class="text-foreground block text-[17px] font-medium"
          >
            物件編號 / 案件描述
            <span class="text-muted-foreground text-[13px] font-normal">
              （選填）
            </span>
          </label>
          <input
            id="cf-listing-code"
            type="text"
            name="物件編號或描述"
            maxlength="200"
            placeholder="UG1234567 / 看到您 IG 的某一戶 / 北屯機捷 2 房"
            class="border-border bg-background text-foreground focus:border-accent focus:ring-accent/30 mt-2 block w-full rounded-md border px-4 py-3 text-[17px] outline-none focus:ring-2"
          />
        </div>
      )
    }

    {/* === 第五排：區域偏好（多選 checkbox） === */}
    <fieldset class="min-w-0 border-0 p-0">
      <legend class="text-foreground block text-[17px] font-medium">
        區域偏好
        <span class="text-muted-foreground text-[13px] font-normal">
          （多選、選填）
        </span>
      </legend>
      <details class="border-border bg-background mt-2 rounded-md border">
        <summary
          class="text-muted-foreground cursor-pointer list-none px-4 py-3 text-[16px] select-none [&::-webkit-details-marker]:hidden"
          data-area-summary
        >
          點開選擇區域 ▾
        </summary>
        <div
          class="grid max-h-60 grid-cols-2 gap-x-3 gap-y-2 overflow-y-auto p-4 sm:grid-cols-3"
        >
          {TAICHUNG_AREAS.map(area => (
            <label
              class="text-foreground hover:bg-card flex cursor-pointer items-center gap-2 rounded p-1 text-[15px]"
            >
              <input
                type="checkbox"
                name="區域偏好"
                value={area}
                class="accent-accent h-4 w-4"
                data-area-checkbox
              />
              {area}
            </label>
          ))}
        </div>
      </details>
    </fieldset>

    {/* === 第六排：訊息 === */}
    <div>
      <label
        for="cf-message"
        class="text-foreground block text-[17px] font-medium"
      >
        訊息
        <span class="text-muted-foreground text-[13px] font-normal">
          （選填、有什麼想先告訴我的、寫這）
        </span>
      </label>
      <textarea
        id="cf-message"
        name="訊息"
        rows="4"
        maxlength="1000"
        placeholder={
          defaultIntent === "sell"
            ? "目前住的地址 / 想賣的時程 / 心中目標價..."
            : "想看的物件條件 / 預計入住時間 / 自備款大概..."
        }
        class="border-border bg-background text-foreground focus:border-accent focus:ring-accent/30 mt-2 block w-full rounded-md border px-4 py-3 text-[17px] leading-relaxed outline-none focus:ring-2"
        >{defaultDescription}</textarea>
    </div>

    {/* === 提交按鈕 + 狀態訊息 === */}
    <div class="border-border border-t pt-5">
      <button
        type="submit"
        data-submit-btn
        class="bg-accent text-accent-foreground hover:bg-accent/90 disabled:cursor-not-allowed disabled:opacity-60 w-full rounded-md px-6 py-4 text-[18px] font-medium transition-all sm:w-auto sm:min-w-[200px]"
      >
        送出 → 等景泰回你
      </button>

      <p
        data-form-error
        class="mt-4 hidden text-[15px] text-red-500"
        role="alert"
      ></p>

      {/* 備援面板 — 後端暫時收不到件時原地出現，客戶照樣有三條路把需求交給景泰 */}
      <div
        data-form-fallback
        hidden
        class="border-accent/40 bg-background mt-5 rounded-lg border-2 border-dashed p-5"
        role="status"
        aria-live="polite"
      >
        <p class="text-foreground text-[18px] font-bold">
          已經把你的需求整理好了
        </p>
        <p class="text-muted-foreground mt-2 text-[15px] leading-relaxed">
          這邊剛好沒把訊息送出去。不用重填，按「複製訊息」再貼到 LINE
          給景泰，或直接撥電話，一樣 30 分鐘內回你。
        </p>
        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3">
          <button
            type="button"
            data-fallback-copy
            class="btn-outline w-full text-[16px]"
          >
            📋 複製訊息
          </button>
          <a
            href="/go/line?src=form-fallback"
            target="_blank"
            rel="noopener"
            class="btn-line w-full text-[16px]"
          >
            <LineIcon class="size-5" aria-hidden="true" />
            LINE 景泰
          </a>
          <a href="tel:+886920118756" class="btn-outline w-full text-[16px]">
            <IconPhone class="size-5" aria-hidden="true" />
            0920-118-756
          </a>
        </div>
        <textarea
          data-fallback-text
          readonly
          rows="5"
          aria-label="整理好的需求內容"
          class="border-border bg-card text-foreground mt-4 block w-full rounded-md border px-3 py-2 text-[15px] leading-relaxed"
        ></textarea>
      </div>

      <p class="text-muted-foreground mt-4 text-[14px] leading-relaxed">
        送出後直接推到景泰手機。
        如果你急 — LINE
        <a
          href="/go/line?src=contact-form"
          class="text-accent font-medium hover:underline"
          target="_blank"
          rel="noopener"
        >
          sky811117
        </a>
        或撥
        <a
          href="tel:+886920118756"
          class="text-accent font-medium hover:underline"
        >
          0920-118-756
        </a>
        最快。資料只用來回覆你，不轉賣、不做行銷名單。
      </p>
    </div>
  </form>
</section>

<script>
  function initContactForm() {
    const formRaw = document.querySelector<HTMLFormElement>(
      "[data-contact-form]"
    );
    if (!formRaw || formRaw.dataset.initialized === "true") return;
    formRaw.dataset.initialized = "true";
    const form: HTMLFormElement = formRaw;

    const formspreeId = form.dataset.formspreeId || "";
    const submitBtn = form.querySelector<HTMLButtonElement>(
      "[data-submit-btn]"
    );
    const submitLabel = submitBtn?.textContent?.trim() || "送出 → 等景泰回你";
    const formError = form.querySelector<HTMLElement>("[data-form-error]");
    const fallbackPanel = form.querySelector<HTMLElement>("[data-form-fallback]");
    const fallbackText = form.querySelector<HTMLTextAreaElement>(
      "[data-fallback-text]"
    );
    const fallbackCopyBtn = form.querySelector<HTMLButtonElement>(
      "[data-fallback-copy]"
    );
    const loadedAtInput = form.querySelector<HTMLInputElement>(
      "[data-loaded-at]"
    );
    const subjectInput = form.querySelector<HTMLInputElement>(
      "[data-form-subject]"
    );
    const sourceInput = form.querySelector<HTMLInputElement>(
      "[data-source-page]"
    );
    const areaSummary = form.querySelector<HTMLElement>("[data-area-summary]");
    const areaCheckboxes = form.querySelectorAll<HTMLInputElement>(
      "[data-area-checkbox]"
    );

    // 載入時間戳（給 bot 偵測用）
    const loadedAt = Date.now();
    if (loadedAtInput) loadedAtInput.value = String(loadedAt);

    // 來源頁
    if (sourceInput) sourceInput.value = window.location.pathname;

    // GA4 事件（Analytics.astro 有掛 gtag 才送；沒有就靜默）
    function track(name: string, params: Record<string, string>) {
      try {
        const w = window as unknown as {
          gtag?: (...args: unknown[]) => void;
        };
        if (typeof w.gtag === "function") {
          w.gtag("event", name, { ...params, page_path: location.pathname });
        }
      } catch {
        /* 量測失敗不影響表單 */
      }
    }

    // 預設 subject — 客戶送出後景泰 email 一眼看出意圖
    function updateSubject() {
      if (!subjectInput) return;
      const intent =
        (form.querySelector<HTMLSelectElement>("[name='我想']")?.value) ||
        "詢價";
      const name =
        (form.querySelector<HTMLInputElement>("[name='姓名']")?.value) ||
        "新訪客";
      subjectInput.value = `【網站詢價】${name} - ${intent}`;
    }
    form.addEventListener("input", updateSubject);
    updateSubject();

    // 區域選擇顯示計數
    function updateAreaSummary() {
      if (!areaSummary) return;
      const count = Array.from(areaCheckboxes).filter(c => c.checked).length;
      areaSummary.textContent =
        count > 0
          ? `已選 ${count} 個區域 ▾（點開修改）`
          : "點開選擇區域 ▾";
    }
    areaCheckboxes.forEach(c =>
      c.addEventListener("change", updateAreaSummary)
    );

    // 即時驗證 helpers
    function showError(field: string, msg: string) {
      const el = form.querySelector<HTMLElement>(
        `[data-error-for="${field}"]`
      );
      if (el) {
        el.textContent = msg;
        el.classList.remove("hidden");
      }
    }
    function clearError(field: string) {
      const el = form.querySelector<HTMLElement>(
        `[data-error-for="${field}"]`
      );
      if (el) {
        el.textContent = "";
        el.classList.add("hidden");
      }
    }
    function showFormError(msg: string) {
      if (!formError) return;
      formError.textContent = msg;
      formError.classList.remove("hidden");
    }
    function clearFormError() {
      if (!formError) return;
      formError.textContent = "";
      formError.classList.add("hidden");
    }
    function resetSubmitBtn() {
      if (!submitBtn) return;
      submitBtn.disabled = false;
      submitBtn.textContent = submitLabel;
    }

    // 把表單內容組成一段可以直接貼到 LINE 的文字（備援用）
    function composeMessage(payload: Record<string, string>): string {
      const lines: string[] = ["【網站詢價】"];
      const push = (label: string, key: string) => {
        const v = (payload[key] || "").trim();
        if (v) lines.push(`${label}：${v}`);
      };
      push("姓名", "姓名");
      push("手機", "手機");
      push("Email", "Email");
      push("我想", "我想");
      push("預算", "預算");
      push("物件編號", "物件編號");
      push("物件", "物件標題");
      push("物件 / 描述", "物件編號或描述");
      push("區域", "區域偏好");
      push("訊息", "訊息");
      const src = (payload["來源頁"] || "").trim();
      if (src) lines.push(`來源頁：${location.origin}${src}`);
      return lines.join("\n");
    }

    function showFallback(payload: Record<string, string>) {
      if (!fallbackPanel) return;
      const text = composeMessage(payload);
      if (fallbackText) fallbackText.value = text;
      fallbackPanel.hidden = false;
      fallbackPanel.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }

    fallbackCopyBtn?.addEventListener("click", async () => {
      const text = fallbackText?.value || "";
      if (!text) return;
      let copied = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          copied = true;
        }
      } catch {
        copied = false;
      }
      if (!copied && fallbackText) {
        // 舊瀏覽器 / 非 https：退回選取文字，讓客戶自己長按複製
        fallbackText.focus();
        fallbackText.select();
      }
      fallbackCopyBtn.textContent = copied ? "✅ 已複製，貼到 LINE 就好" : "已選取，長按複製";
      setTimeout(() => {
        fallbackCopyBtn.textContent = "📋 複製訊息";
      }, 2500);
    });

    // 個別欄位 blur 驗證
    form
      .querySelector<HTMLInputElement>("[name='姓名']")
      ?.addEventListener("blur", e => {
        const v = (e.target as HTMLInputElement).value.trim();
        if (!v) showError("姓名", "姓名是必填的");
        else clearError("姓名");
      });

    function validatePhoneEmail() {
      const phone =
        form.querySelector<HTMLInputElement>("[name='手機']")?.value.trim() ||
        "";
      const email =
        form.querySelector<HTMLInputElement>("[name='Email']")?.value.trim() ||
        "";
      if (!phone && !email) {
        showError("手機", "手機 / Email 至少要填一個");
        return false;
      }
      clearError("手機");
      clearError("Email");

      // 手機格式（台灣手機 09xx-xxx-xxx 或 09xxxxxxxx）
      if (phone) {
        const phoneClean = phone.replace(/[\s\-+]/g, "");
        if (!/^\d{8,12}$/.test(phoneClean)) {
          showError("手機", "手機號碼格式怪怪的，幫我看一下");
          return false;
        }
      }

      // Email 格式
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        showError("Email", "Email 格式怪怪的，幫我看一下");
        return false;
      }
      return true;
    }
    form
      .querySelector<HTMLInputElement>("[name='手機']")
      ?.addEventListener("blur", validatePhoneEmail);
    form
      .querySelector<HTMLInputElement>("[name='Email']")
      ?.addEventListener("blur", validatePhoneEmail);

    function validateAll() {
      let ok = true;
      const nameVal =
        form
          .querySelector<HTMLInputElement>("[name='姓名']")
          ?.value.trim() || "";
      if (!nameVal) {
        showError("姓名", "姓名是必填的");
        ok = false;
      }
      if (!validatePhoneEmail()) ok = false;
      const intentVal =
        form.querySelector<HTMLSelectElement>("[name='我想']")?.value || "";
      if (!intentVal) {
        showError("我想", "請選一個");
        ok = false;
      }
      return ok;
    }

    // submit handler
    form.addEventListener("submit", async e => {
      e.preventDefault();
      clearFormError();
      if (submitBtn?.disabled) return;

      // honeypot
      const honeypot =
        form.querySelector<HTMLInputElement>("[name='_gotcha']")?.value || "";
      if (honeypot) {
        // bot 中招、靜默 fail（直接導 thank-you 讓 bot 以為成功）
        window.location.href = "/thank-you/";
        return;
      }

      // 3 秒內 submit = bot
      if (Date.now() - loadedAt < 3000) {
        showFormError("送太快了、確認一下訊息再送");
        return;
      }

      if (!validateAll()) {
        showFormError("有幾個欄位需要補一下");
        return;
      }

      // 收集 FormData
      const fd = new FormData(form);

      // 區域偏好 — FormData 多值會自動合併、但要 join 起來給 email 好讀
      const areas = fd.getAll("區域偏好").map(a => String(a));
      if (areas.length > 0) {
        fd.delete("區域偏好");
        fd.append("區域偏好", areas.join("、"));
      }

      const payload: Record<string, string> = {};
      fd.forEach((v, k) => {
        payload[k] = String(v);
      });

      // disable 按鈕
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "送出中...";
      }

      // 1. 主管道：TG（一律送）
      const tgTask: Promise<boolean> = fetch("/api/contact-tg", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      })
        .then(async res => {
          if (!res.ok) return false;
          try {
            const data = (await res.json()) as { ok?: boolean };
            return data.ok === true;
          } catch {
            return false;
          }
        })
        .catch(() => false);

      // 2. 副管道：Formspree（有 ID 才送；Accept: application/json 才不會 redirect）
      const formspreeTask: Promise<boolean> = formspreeId
        ? fetch(`https://formspree.io/f/${formspreeId}`, {
            method: "POST",
            headers: {
              Accept: "application/json",
              "Content-Type": "application/json",
            },
            body: JSON.stringify(payload),
          })
            .then(res => res.ok)
            .catch(() => false)
        : Promise.resolve(false);

      const [tgOk, formspreeOk] = await Promise.all([tgTask, formspreeTask]);
      const intent = String(payload["我想"] || "");

      if (tgOk || formspreeOk) {
        track("lead_submit", { status: "ok", form: "contact", intent });
        const qs = new URLSearchParams({ form: "contact" });
        if (intent) qs.set("intent", intent);
        window.location.href = `/thank-you/?${qs.toString()}`;
        return;
      }

      // 兩條都沒收到 → 原地備援：不讓客戶看到「後端」這種字，需求照樣交得出去
      track("lead_submit", { status: "degraded", form: "contact", intent });
      showFallback(payload);
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "再送一次";
      }
    });

    // 讓 contact.astro 這類頁面能從外部重設按鈕文字（保留 hook、目前未用）
    form.addEventListener("reset", resetSubmitBtn);
  }

  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
  document.addEventListener("astro:page-load", initContactForm);
</script>
