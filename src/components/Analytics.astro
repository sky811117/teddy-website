---
import { PUBLIC_GA4_MEASUREMENT_ID } from "astro:env/client";
const gtagId = PUBLIC_GA4_MEASUREMENT_ID;
---

{gtagId && (
  <script is:inline define:vars={{ gtagId }}>
    // ── 1. GA4 boilerplate + Consent Mode v2 ──────────────────────────────
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }

    // Consent Mode v2。
    // ⚠️ 2026-08-27 修：原本 default 一律 denied + send_page_view:false，等於
    //   「沒按接受就什麼都不送」。實測後果是同期 GSC 有 151 次自然搜尋點擊、
    //   GA4 只認到 1 個 Organic Search 工作階段 —— 量測整個失真、無法歸因。
    // 現在的行為（也是 Consent Mode v2 原本的設計）：
    //   未同意 → analytics_storage denied：**不寫任何 cookie、不建立跨頁識別**，
    //            只送一筆不含識別碼的匿名瀏覽數（cookieless ping）。
    //   已同意 → granted：才啟用 cookie，能分辨新訪客 / 回訪。
    var _gaStored = null;
    try { _gaStored = localStorage.getItem('ga_consent'); } catch (e) {}
    gtag('consent', 'default', {
      analytics_storage: _gaStored === 'granted' ? 'granted' : 'denied',
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
    });

    // 動態載 gtag.js（帶 measurement ID）
    (function () {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gtagId;
      document.head.appendChild(s);
    })();

    gtag('js', new Date());
    // page_view 立刻送。denied 狀態下是 cookieless ping（無識別碼），
    // referrer 仍在 → 自然搜尋 / 社群 / 直接輸入才分得出來。
    gtag('config', gtagId);

    // 給其他 inline script 判斷「量測已就緒」用（不代表已取得 cookie 同意）。
    // 必須是全域旗標而不是事件 —— Analytics 排在 head slot 之前，
    // 事件會早於後面的 script 掛上 listener 而被錯過。
    window.__gaMeasure = true;

    // ── 2. Consent helper（供 PostLayout dwell script 訂閱）────────────────
    function _gaApplyGranted() {
      // 只是把 cookie 打開；page_view 一開始就送過了，不再補送以免重複計數。
      gtag('consent', 'update', { analytics_storage: 'granted' });
      window.dispatchEvent(new Event('ga:consented'));
    }

    // ── 3. Cookie consent banner ──────────────────────────────────────────
    // ⚠️ 2026-09-06 修：原本 z-index:9999 貼底全寬，手機上把右下角 LINE 浮動鈕
    //   與物件頁底部三鍵 CTA 整個蓋住（Playwright 390×844 實測 elementFromPoint
    //   全部落在橫幅上）。現在：
    //   - z-index 30（低於 CTA 的 40）
    //   - 出現時在 <html> 加 data-consent-open，並把橫幅高度寫進 CSS 變數
    //     --consent-h（px），貼底的固定元件用 bottom: calc(... + var(--consent-h, 0px))
    //     往上讓位；橫幅移除時歸 0。
    //   - 字 14px、按鈕高 44px（觸控目標）
    //   - 桌機（≥640px）改成右下角小卡片，不佔全寬
    document.addEventListener('DOMContentLoaded', function () {
      if (_gaStored === 'granted' || _gaStored === 'denied') return;

      var root = document.documentElement;
      var style = document.createElement('style');
      style.id = 'ga-consent-style';
      style.textContent =
        '#ga-consent{position:fixed;left:0;right:0;bottom:0;z-index:30;' +
          'display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:10px;' +
          'padding:10px 14px;background:var(--background,#fff);' +
          'border-top:1px solid var(--border,#e5e7eb);box-shadow:0 -2px 12px rgba(0,0,0,.08);' +
          'font-size:14px;line-height:1.5;color:var(--foreground,#111);}' +
        '#ga-consent p{margin:0;flex:1 1 240px;}' +
        '#ga-consent .ga-btns{display:flex;gap:8px;flex:0 0 auto;}' +
        '#ga-consent button{min-height:44px;padding:0 16px;font-size:14px;border-radius:8px;cursor:pointer;font-weight:500;}' +
        '#ga-accept{background:var(--accent);color:var(--accent-foreground,#fff);border:none;}' +
        '#ga-decline{background:transparent;color:var(--muted-foreground,#555);border:1px solid var(--border,#e5e7eb);}' +
        '@media (min-width:640px){#ga-consent{left:auto;right:16px;bottom:16px;max-width:380px;' +
          'border:1px solid var(--border,#e5e7eb);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.14);padding:14px 16px;}' +
          '#ga-consent p{flex-basis:100%;}}';
      document.head.appendChild(style);

      var banner = document.createElement('div');
      banner.id = 'ga-consent';
      banner.setAttribute('role', 'region');
      banner.setAttribute('aria-label', 'Cookie 使用說明');
      banner.innerHTML =
        '<p>本站會記錄不含 cookie、無法識別個人的匿名瀏覽數。按「接受」才會啟用 cookie（用來分辨回訪），協助改善內容品質。</p>' +
        '<div class="ga-btns">' +
          '<button type="button" id="ga-accept">接受</button>' +
          '<button type="button" id="ga-decline">拒絕</button>' +
        '</div>';

      // 物件頁：桌機小卡要避開底部 sticky 價格列，手機由 --consent-h 推上去
      var propertyBar = document.querySelector('[data-property-mobile-cta]');
      if (propertyBar && window.matchMedia('(min-width:640px)').matches) {
        banner.style.bottom = '96px';
      }
      document.body.appendChild(banner);
      root.setAttribute('data-consent-open', '1');

      // 橫幅高度 → --consent-h。手機全寬貼底才需要讓位；桌機小卡不佔底部整排、設 0。
      function syncHeight() {
        var full = !window.matchMedia('(min-width:640px)').matches;
        var h = full && document.body.contains(banner) ? banner.offsetHeight : 0;
        root.style.setProperty('--consent-h', h + 'px');
      }
      syncHeight();
      if ('ResizeObserver' in window) {
        try { new ResizeObserver(syncHeight).observe(banner); } catch (e) {}
      }
      window.addEventListener('resize', syncHeight);

      // 物件頁手機底部三鍵 CTA（properties/[...slug].astro）也貼底，直接讓它吃同一個變數，
      // 不必等那支檔案改 CSS；那邊若之後也寫了同樣的 bottom，值一致不衝突。
      if (propertyBar && !propertyBar.style.bottom) {
        propertyBar.style.bottom = 'var(--consent-h, 0px)';
      }

      function close() {
        banner.remove();
        root.removeAttribute('data-consent-open');
        root.style.setProperty('--consent-h', '0px');
        window.removeEventListener('resize', syncHeight);
      }
      document.getElementById('ga-accept').addEventListener('click', function () {
        try { localStorage.setItem('ga_consent', 'granted'); } catch (e) {}
        close();
        _gaApplyGranted();
      });
      document.getElementById('ga-decline').addEventListener('click', function () {
        try { localStorage.setItem('ga_consent', 'denied'); } catch (e) {}
        close();
      });
    });

    // ── 4. Event delegation ───────────────────────────────────────────────
    // 事件（點 LINE、點物件、Web Vitals）不含任何個人識別資料，
    // 跟 page_view 一樣在 cookieless 狀態下也送；cookie 與否由 consent 決定。
    function _gaOk() { return window.__gaMeasure === true; }

    // LINE 點擊：抓頁面所有 line.me 連結（FloatingCTA / Footer / 文章內 / 物件頁）
    document.addEventListener('click', function (e) {
      if (!_gaOk() || !window.gtag) return;
      // 站上的 LINE 按鈕 2026-08-27 起走 /go/line 中繼（為了追得出來源），
      // 但文章內文若有人直接寫 line.me 連結也要抓得到，兩種都比對。
      var a = e.target.closest('a[href*="/go/line"], a[href*="line.me"]');
      if (a) gtag('event', 'click_line', {
        link_url: a.href,
        link_text: (a.textContent || '').trim().slice(0, 80),
        page_path: location.pathname,
      });
    }, true);

    // Properties 卡片點擊：抓 data-track="property" 元素
    document.addEventListener('click', function (e) {
      if (!_gaOk() || !window.gtag) return;
      var a = e.target.closest('[data-track="property"]');
      if (a) gtag('event', 'click_property', {
        property_id: a.dataset.propertyId || '',
        property_title: a.dataset.propertyTitle || '',
        property_price: Number(a.dataset.propertyPrice) || 0,
        property_district: a.dataset.propertyDistrict || '',
      });
    }, true);

    // ── 5. Web Vitals → GA4 (Core Web Vitals 自動追蹤) ────────────────
    // 用 PerformanceObserver API、不需要額外 library
    function _trackWebVital(name, value, rating) {
      if (!_gaOk() || !window.gtag) return;
      gtag('event', name, {
        value: Math.round(name === 'CLS' ? value * 1000 : value),
        metric_value: value,
        metric_rating: rating,
        page_path: location.pathname,
      });
    }

    // LCP (Largest Contentful Paint) — 目標 < 2.5s
    if ('PerformanceObserver' in window) {
      try {
        new PerformanceObserver(function (list) {
          var entries = list.getEntries();
          var last = entries[entries.length - 1];
          if (last) {
            var lcp = last.renderTime || last.loadTime;
            var rating = lcp < 2500 ? 'good' : lcp < 4000 ? 'needs-improvement' : 'poor';
            _trackWebVital('LCP', lcp, rating);
          }
        }).observe({ type: 'largest-contentful-paint', buffered: true });
      } catch (e) {}

      // CLS (Cumulative Layout Shift) — 目標 < 0.1
      try {
        var clsValue = 0;
        new PerformanceObserver(function (list) {
          for (var entry of list.getEntries()) {
            if (!entry.hadRecentInput) clsValue += entry.value;
          }
        }).observe({ type: 'layout-shift', buffered: true });
        // 頁面離開時上報最終值
        window.addEventListener('pagehide', function () {
          var rating = clsValue < 0.1 ? 'good' : clsValue < 0.25 ? 'needs-improvement' : 'poor';
          _trackWebVital('CLS', clsValue, rating);
        }, { once: true });
      } catch (e) {}

      // FID / INP (First Input / Interaction to Next Paint) — 目標 < 100ms
      try {
        new PerformanceObserver(function (list) {
          for (var entry of list.getEntries()) {
            var inp = entry.processingStart - entry.startTime;
            var rating = inp < 100 ? 'good' : inp < 300 ? 'needs-improvement' : 'poor';
            _trackWebVital('FID', inp, rating);
          }
        }).observe({ type: 'first-input', buffered: true });
      } catch (e) {}
    }
  </script>
)}
