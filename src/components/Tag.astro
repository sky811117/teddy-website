---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** 掛了幾篇文章；有傳才顯示「(n)」（/tags/ 索引用，文章頁的 tag 列不傳） */
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

{/* 沒開 ClientRouter，transition:name 只會替每個 tag 灌一段 <style>（/tags/ 曾 857KB），不要加回來 */}
<li>
  {/* 2026-11 極簡改版：淺灰底膠囊（原本是字底下一條粗虛線），長相在 ax-pages.css 的 .axp-tag */}
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={["axp-tag", { "axp-tag--sm": size === "sm" }]}
  >
    <IconHash />
    {tagName}
    {
      typeof count === "number" && (
        <span class="axp-tag-n">({count})</span>
      )
    }
  </a>
</li>
