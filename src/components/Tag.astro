---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconHash from "@/assets/icons/IconHash.svg";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  /** 掛了幾篇文章；有傳才顯示「(n)」（/tags/ 索引用，文章頁的 tag 列不傳） */
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

{/* 沒開 ClientRouter，transition:name 只會替每個 tag 灌一段 <style>（/tags/ 曾 857KB），不要加回來 */}
<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    class:list={[
      "flex items-center gap-0.5",
      "border-foreground border-b-2 border-dashed",
      "hover:border-accent hover:text-accent hover:-mt-0.5",
      "focus-visible:text-accent focus-visible:border-none",
      { "text-sm": size === "sm" },
      { "text-lg": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-80",
        { "size-5": size === "lg" },
        { "size-4": size === "sm" },
      ]}
    />
    {tagName}
    {
      typeof count === "number" && (
        <span class="text-muted-foreground ms-1 text-sm">({count})</span>
      )
    }
  </a>
</li>
