---
/**
 * PageHero — 頁面頂部主視覺
 * eyebrow（小字標）+ 中文大標 + 副標 + 可選右側圖片
 * 2026-11 極簡改版：白底、不放漸層；小字標用灰字（藍色只留給連結）
 */
type Props = {
  eyebrow?: string;
  title: string;
  description?: string;
  image?: string;
};

const { eyebrow, title, description, image } = Astro.props;
---

<section>
  <div
    class:list={[
      "app-layout-wide flex flex-col items-center gap-8 pt-10 pb-4 sm:pt-14 sm:pb-6",
      image ? "sm:flex-row sm:justify-between sm:text-left" : "text-center",
    ]}
  >
    <div class:list={[image ? "" : "mx-auto max-w-2xl"]}>
      {
        eyebrow && (
          <p class="text-muted-foreground text-sm">
            {eyebrow}
          </p>
        )
      }
      <h1 class="mt-2 text-3xl font-extrabold sm:text-4xl">{title}</h1>
      {
        description && (
          <p class="text-muted-foreground mx-auto mt-4 max-w-2xl leading-relaxed">
            {description}
          </p>
        )
      }
    </div>
    {
      image && (
        <img
          src={image}
          alt=""
          class="rounded-card w-full max-w-xs object-cover"
          loading="eager"
          fetchpriority="high"
        />
      )
    }
  </div>
</section>
