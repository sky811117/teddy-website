---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import ContactForm from "@/components/ContactForm.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";

// 長尾 FAQ — 每題對應 1 個 Google 搜尋關鍵字
// 答案規則（2026-09-06 整理）：
//   - 含數字 / 政策的答案必須有「📌 資料來源」
//   - 不教議價折數、不預測漲跌、不寫「一定會更新」這種沒來源的預告
//   - post 欄位 = 站內對應深文 slug，有就渲染「完整說明 →」
type FaqItem = { q: string; a: string; post?: string };
type FaqCat = { cat: string; items: FaqItem[] };

const faqs: FaqCat[] = [
  {
    cat: "💰 費用 / 預算",
    items: [
      {
        q: "仲介費怎麼算？",
        a: "法規上限是向買賣雙方收取合計不超過成交價 6%，實務常見買方 2%、賣方 4%，實際以委託書約定為準。比起糾結費率，先看仲介幫你做什麼：看屋陪同、實價登錄分析、契約把關、貸款協助、過戶代辦、後續保固。簽委託前直接 LINE 我聊「服務包含什麼」，比上網查費率有用。📌 資料來源：內政部《不動產經紀業報酬計收標準規定》",
        post: "tool-agent-fee",
      },
      {
        q: "自備款要多少？青安 3.0 跟一般房貸差在哪？",
        a: "一般房貸多數自備 2-3 成。青安 3.0 最高貸 8 成（自備至少 2 成），差別在利率補貼：補貼後 1.775% 機動利率、前 3 年全額補貼、第 4 年起逐年退場；年限最長 40 年、寬限期最長 5 年、一生限用一次。額度一般 1,000 萬、新婚 2 年內 1,200 萬、有未成年子女 1,500 萬，超過額度的部分走承貸銀行一般房貸。📌 資料來源：財政部國庫署 青安 3.0 方案懶人包 / 2026-07-16",
        post: "faq-02-down-payment",
      },
      {
        q: "頭期款不夠怎麼辦？",
        a: "三條路：(1) 符合資格就走青安 3.0（最高 8 成、額度 1,000-1,500 萬，本人與配偶、未成年子女名下都沒有自有住宅）(2) 親友資金支援（要留意贈與稅申報）(3) 拉長存錢時間、把總價門檻降一級。不建議用信貸補頭期，利率會吃掉房貸優惠，銀行也會把信貸算進負債比。📌 資料來源：財政部國庫署 青安 3.0 方案懶人包 / 2026-07-16",
        post: "faq-02-down-payment",
      },
      {
        q: "簽約定金 / 斡旋金要付多少？",
        a: "斡旋金是出價時付給仲介、用來保留出價的錢，屋主書面同意前可以全額拿回；屋主一同意，斡旋金當下就轉成定金，反悔會被沒收。簽約定金常見是總價的一成左右，實際依契約約定。不想付錢的話可以用「要約書」，效力一樣、但對屋主來說誠意較弱。📌 資料來源：民法第 248 條、內政部要約書範本",
        post: "faq-25-earnest-vs-deposit",
      },
      {
        q: "過戶要準備什麼文件？",
        a: "買方：身分證、印鑑章、印鑑證明（3 個月內）、戶籍謄本、自備款證明。賣方：身分證、印鑑章、印鑑證明（3 個月內）、土地＋建物所有權狀正本、戶籍謄本、完稅證明（增值稅／房屋稅），有抵押權要先辦塗銷。地政士統一辦理，簽約到交屋通常 30-45 天。",
        post: "faq-16-transfer-documents",
      },
    ],
  },
  {
    cat: "🏠 看屋 / 出價",
    items: [
      {
        q: "凶宅怎麼查？",
        a: "免費 4 個管道：(1) Google 搜尋「路段 凶宅」(2) 凶宅網（unluckyhouse.com，民間整理僅供參考）(3) 不動產說明書「重大事項」欄位（法定必載）(4) 請仲介查公司內部紀錄。賣方刻意隱瞞凶宅，買方可以解約並求償。",
        post: "faq-03-haunted-house-check",
      },
      {
        q: "看屋順序怎麼安排？",
        a: "3 階段：(1) 廣度看：同預算區跑 5-8 間建立行情感 (2) 縮窄：鎖定 2-3 區深度比較 (3) 鎖定：鎖 1-2 間反覆看（白天／晚上／雨天／假日）。一天看太多會疲勞、決策變差。",
        post: "faq-04-viewing-order",
      },
      {
        q: "出價、斡旋、要約有什麼不同？",
        a: "出價 = 你第一次表達想買的價格。用「斡旋金」出價要先付一筆錢給仲介，用「要約書」出價不用付錢、簽書面就好。之後仲介把價格傳給屋主，屋主回覆、雙方再協調，最後談定的才是成交價。出價前先把同社區近 12 個月的實價登錄拉出來，價格才有依據。",
        post: "faq-24-offer-vs-negotiation",
      },
      {
        q: "出價前怎麼判斷合理價？",
        a: "三步驟：(1) 拉同社區／同路段近 12 個月實價登錄成交價（內政部實價登錄查得到）(2) 對照物件條件（屋齡、樓層、座向、裝潢、車位）(3) 看現在市場熱度（同社區待售幾戶、新成交多快）。開價貼近行情的物件，成交價通常也很接近開價。看屋前 LINE 我，我幫你抓這間的合理區間。📌 資料來源：內政部不動產交易實價查詢服務網",
        post: "week-03-negotiation-7",
      },
      {
        q: "簽約要看什麼？",
        a: "5 個重點：(1) 標的物地號／建號／持分對不對 (2) 總價、付款條件、過戶日期 (3) 違約條款 (4) 履約保證 (5) 屋況現況點交。仲介會帶地政士到場，有問題現場問清楚再簽。",
        post: "faq-26-contract-signing",
      },
    ],
  },
  {
    cat: "📐 屋況 / 屋齡",
    items: [
      {
        q: "屋齡 30 年還能買嗎？",
        a: "看 3 件事：(1) 結構（有沒有海砂、輻射、鋼筋鏽蝕）(2) 管線（自來水、排汙、電線要不要全換，這筆要先算進總成本）(3) 貸款（屋齡高的物件，銀行成數跟年限通常會保守）。蛋黃區老屋有重建價值、蛋白區老屋主要是自住功能，買前先想清楚你要哪一種。",
        post: "faq-07-30-year-old-house",
      },
      {
        q: "海砂屋 / 輻射屋怎麼測？",
        a: "海砂：取一小塊混凝土送檢驗氯離子含量，看天花板有沒有大面積爆筋鏽蝕。輻射：請輻射偵測單位檢測，1982-1984 年間完工的建物特別要查。檢測費用以檢測單位報價為準。",
        post: "faq-14-sea-sand-radiation",
      },
      {
        q: "漏水怎麼測？",
        a: "5 個免費招：(1) 看天花板／牆角有沒有水痕、油漆鼓起 (2) 聞潮濕黴味（雨天看最準）(3) 看廁所／廚房牆角矽利康有沒有發黑 (4) 看牆角防水漆有沒有重新漆過 (5) 雨後第 2 天再去看一次（地下室、頂樓）。",
        post: "faq-15-leak-warranty",
      },
      {
        q: "違章建築能買嗎？",
        a: "可以但要評估：(1) 拆除風險（屋頂加蓋、陽台外推、頂樓加蓋的風險等級不同）(2) 影響貸款（違建部分銀行不貸、坪數要扣）(3) 二手轉手難度高。建議把違建價值算 0 來評估這間房。",
        post: "faq-05-illegal-construction",
      },
      {
        q: "公設比多少合理？",
        a: "看屋齡：30 年以上公寓 0-15%、20-30 年華廈 15-25%、近年大樓 30-35%、超高樓豪宅 35-45%。公設比 35% 以上要算「實際得到坪數」：權狀 30 坪、公設 35%，室內加陽台大約只剩 19.5 坪。",
        post: "faq-06-common-area-ratio",
      },
    ],
  },
  {
    cat: "📊 政策 / 貸款 / 稅務",
    items: [
      {
        q: "青安 3.0 貸款條件是什麼？",
        a: "2026-08-01 起受理、到 2029-07-31。資格：本人、配偶、未成年子女名下都沒有自有住宅；借款人年所得 200 萬以下；申貸時未滿 50 歲，且年齡加貸款年限不超過 80；房屋總價台中不超過 2,000 萬（台北 3,500 萬、新北與新竹 2,500 萬）。額度一般 1,000 萬、新婚 2 年內 1,200 萬、有未成年子女 1,500 萬；最高 8 成、最長 40 年、寬限 5 年；利率補貼後 1.775% 機動，前 3 年全額補貼、第 4 年起逐年退場、第 7 年回牌告。細節以承貸銀行核定為準。📌 資料來源：財政部國庫署 青安 3.0 方案懶人包 / 2026-07-16",
        post: "2026-08-W02-news-qingan-3-launch-80-rule",
      },
      {
        q: "第二戶貸款成數多少？",
        a: "央行 2026-03-20 起把自然人第 2 戶房貸成數從 5 成放寬回最高 6 成，但仍然不能用寬限期；第 3 戶以上、高價住宅、公司法人維持最高 3 成。「第幾戶」是看全國名下的房屋持有狀況，配偶名下的也會被銀行一起看。提早整理還款紀錄、近 6 個月信用卡正常繳清會加分。📌 資料來源：中央銀行理監事會議決議 / 2026-03-19",
        post: "faq-10-second-home-loan",
      },
      {
        q: "房地合一 2.0 怎麼算？",
        a: "看持有期間：2 年內賣 45%、2-5 年 35%、5-10 年 20%、10 年以上 15%。自住優惠要 4 個條件同時符合：本人／配偶／未成年子女設籍、持有並實際居住連續滿 6 年、期間沒出租沒營業、交易前 6 年內沒用過這個優惠 → 課稅所得 400 萬以下免稅、超過部分課 10%。賣房前一定要先算稅。📌 資料來源：財政部 所得稅法第 4 條之 4、第 14 條之 4",
        post: "policy-02-house-land-tax-2",
      },
      {
        q: "房屋稅自住 vs 非自住差多少？",
        a: "自住（本人、配偶或直系親屬設籍、沒出租、全國最多 3 戶）1.2%；全國只有 1 戶且自住、房屋現值在門檻以下 → 1%。非自住依全國持有戶數採差別稅率，法定 2%-4.8%，級距由各縣市公告：台中市 2 戶以內 3.2%、3-4 戶 3.8%、5-6 戶 4.2%、7 戶以上 4.8%。要省稅就設籍加不出租，自住優惠每年 3 月底前申請。📌 資料來源：財政部 房屋稅差別稅率 2.0（2024-07-01 施行）、臺中市政府地方稅務局房屋稅稅率表",
        post: "faq-21-house-tax",
      },
      {
        q: "履約保證制度是什麼？",
        a: "買賣價金透過建經公司或銀行的專戶保管，等過戶完成、產權清楚才撥款給賣方。費用市場常見是成交價的萬分之 6（0.06%）、買賣雙方各半。沒有履約保證，錢跟房子的交付就沒有第三方把關，中古屋交易建議一定要做。",
        post: "faq-09-escrow-guarantee",
      },
    ],
  },
  {
    cat: "🏘️ 社區 / 預售屋",
    items: [
      {
        q: "預售屋怎麼挑建商？",
        a: "5 個指標：(1) 過往作品（去現場看、問住戶實際感受）(2) 財務體質（上市櫃看公開財報，一般建商查工商登記）(3) 履約保證機制（必須有）(4) 有沒有踩到紅單轉售禁令（2023 年平均地權條例修法）(5) 同社區換約頻率。",
        post: "faq-11-presale-developer",
      },
      {
        q: "中古屋翻新預算抓多少？",
        a: "以 30 坪老屋估算，市場常見三級：簡裝（油漆、地板、換衛浴）約 15-45 萬 ・ 標準（換水電管線、廚衛、系統櫃、油漆）約 50-100 萬 ・ 高規（全面拆改、進口建材、設計費）100-150 萬以上，另外留 10-15% 預備金。以上是估算區間，實際以裝修公司書面報價為準；先看屋況再決定做到哪一級。",
        post: "faq-12-renovation-budget",
      },
      {
        q: "老公寓加裝電梯可行嗎？",
        a: "可以但難，多半卡在鄰居同意。依都市更新條例走「整建維護」，法規門檻是土地及建物所有權人均過半同意，實務上簽到 8 成以上再動工比較穩。整棟費用估算約 300-800 萬、分攤到每戶約 30-80 萬，看樓層數跟電梯位置。台中市有都市更新整建維護補助可以申請，額度以當年公告為準。📌 資料來源：都市更新條例、臺中市政府都市發展局",
        post: "faq-13-old-apartment-elevator",
      },
      {
        q: "雨遮算坪數嗎？",
        a: "2018-01-01 以後申請建照的：雨遮不登記、不計價。之前的：權狀上會有「雨遮」欄位，那是不能住人但算進坪數的面積。買中古屋看權狀時把雨遮坪數拆出來，用主建物加陽台去算單價才準。📌 資料來源：內政部地籍測量實施規則 2018 年修正",
        post: "faq-08-eaves-area",
      },
      {
        q: "車位怎麼分？產權跟構造要分開看",
        a: "兩個軸各自看。產權：(1) 獨立產權（有自己的建號、權狀、車位坪數，可以單獨買賣、單獨貸款）(2) 共有持分（沒有獨立建號，只能綁著主屋一起賣）(3) 約定專用（沒有產權，由管委會或住戶大會分配使用）。構造：坡道平面、坡道機械、升降平面、升降機械，坡道平面最好用、價格也最高，機械車位維護費用高。台中市區坡道平面車位近一年中位數約 150-200 萬（外圍區約 100-120 萬），坡道機械大約是平面的一半，依區域不同。買房一定要先看權狀確認車位是哪一種。📌 資料來源：內政部實價登錄近一年中位數 / 2026-08",
        post: "term-10-independent-parking",
      },
    ],
  },
  {
    cat: "⚠️ 嫌惡設施 / 風水",
    items: [
      {
        q: "嫌惡設施有哪些？",
        a: "常見 10 類：殯儀館／墓地／焚化爐／垃圾場／變電所／加油站／高架橋／鐵路／高壓電塔／八大行業。站上有 Google Map 實測文跟台中嫌惡設施查詢地圖，看屋前先查。",
        post: "week-04-undesirable-facilities",
      },
      {
        q: "離捷運站幾分鐘合理？",
        a: "步行 5 分鐘內 = 捷運宅核心圈，價格通常最高 ／ 5-10 分鐘 = 價格與便利的平衡點 ／ 10-15 分鐘 = 看區位（七期這類本身機能強的區不靠捷運也行）／ 15 分鐘以上 = 捷運加分有限。看屋時自己走一趟量時間，比看建商型錄準。",
      },
      {
        q: "凶宅算嫌惡設施嗎？",
        a: "法律上凶宅是不動產說明書必載的「重大事項」，買到凶宅可以向賣方求償或解約。如果是隔壁戶或同棟其他戶才是凶宅，不算本戶的瑕疵，但會影響轉手價，出價時要把這點算進去。",
        post: "faq-03-haunted-house-check",
      },
    ],
  },
];

// 平攤所有 items 給 FAQPage schema
const allFAQs = faqs.flatMap(c => c.items);
const faqCount = allFAQs.length;
const pageTitle = `常見問題 ${faqCount} 題`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: allFAQs.map(item => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: pageTitle,
      item: new URL("/faq", Astro.site).href,
    },
  ],
};
---

<Layout
  title={`${pageTitle} | ${config.site.title}`}
  description={`台中買房 / 賣房 ${faqCount} 個最常問的問題 — 青安 3.0、第二戶成數、房屋稅、凶宅查詢、嫌惡設施、車位產權、翻新預算，每題附資料來源與完整說明。`}
  canonicalURL={new URL("/faq", Astro.site).href}
  ogImage="/og/page-faq.jpg"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(faqSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(breadcrumbSchema)}
    />
  </Fragment>

  <Header />

  <Main
    pageTitle={pageTitle}
    pageDesc={`台中買賣房最常被問的 ${faqCount} 個問題 — 短答先看，想深入每題都有完整說明。`}
  >
    {/* 快速跳轉導航 */}
    <nav class="border-border bg-card mt-6 rounded-lg border p-4">
      <p class="text-muted-foreground mb-2 text-sm tracking-wide">快速跳到</p>
      <ul class="flex flex-wrap gap-x-3 gap-y-1 text-sm">
        {
          faqs.map((cat, i) => (
            <li>
              <a
                href={`#cat-${i}`}
                class="text-accent hover:underline"
              >
                {cat.cat}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {/* FAQ 主體 */}
    <div class="mt-8 space-y-10">
      {
        faqs.map((cat, i) => (
          <section id={`cat-${i}`} class="scroll-mt-20">
            <h2 class="border-accent text-foreground border-b-2 pb-2 text-xl font-bold sm:text-2xl">
              {cat.cat}
            </h2>
            <div class="mt-4 space-y-4">
              {cat.items.map(item => (
                <details
                  class="border-border bg-card group rounded-lg border p-4 transition-colors"
                >
                  <summary class="text-foreground cursor-pointer text-base font-bold sm:text-lg">
                    {item.q}
                  </summary>
                  <p class="text-foreground mt-3 leading-relaxed">{item.a}</p>
                  {item.post && (
                    <p class="mt-3 text-sm">
                      <a
                        href={`/posts/${item.post}/`}
                        class="text-accent font-medium hover:underline"
                      >
                        延伸閱讀：完整說明 →
                      </a>
                    </p>
                  )}
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </div>

    {/* 底部 CTA — LINE 為主 */}
    <section
      class="border-border mt-12 rounded-lg border border-dashed p-6 text-center"
    >
      <p class="text-foreground font-medium">
        沒看到你要問的？直接 LINE 我
      </p>
      <p class="text-muted-foreground mt-3 leading-relaxed">
        台中買賣房任何問題都可以問 — 看屋、出價、貸款、稅務、過戶。<br />
        30 秒到 30 分鐘會回（除非在帶看或開會）。
      </p>
      <a
        href="/go/line?src=faq"
        class="bg-accent text-accent-foreground mt-6 inline-block rounded px-6 py-2 font-medium no-underline"
      >
        💬 LINE 私訊景泰 sky811117
      </a>
    </section>

    {/* 不愛即時通的表單入口（給長輩 / 企業戶 / 不想加 LINE 的人） */}
    <ContactForm
      title="不想加 LINE？用表單留聯絡方式"
      subtitle="Email 收件、30 分鐘內回。長輩、企業戶、習慣 email 的人 — 這條最舒服。"
    />
  </Main>

  <Footer />
</Layout>
