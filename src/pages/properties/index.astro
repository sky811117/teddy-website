---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";
import { isTaichung, getCounty, getDistrictSlug, COUNTY_ORDER } from "@/utils/isTaichung";
import PropertyCard from "./_components/PropertyCard.astro";
import PropertyCardIcons from "./_components/PropertyCardIcons.astro";
import {
  ROOM_ORDER,
  sortRecommended,
  buildCardMeta,
  shouldShowNewBadge,
} from "./_components/propertyMeta";
import IconChevronDown from "@/assets/icons/IconChevronDown.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconCheck from "@/assets/icons/IconCheck.svg";
import IconLine from "@/assets/icons/socials/line.svg";

// 只取 active 的，沒被屋主撤回 / 售出 / 暫停的不顯示
const allProperties = await getCollection(
  "properties",
  ({ data }) => data.status === "active"
);

// 類型／房型／推薦排序／badge 判定都在 _components/propertyMeta.ts（跟分區列表頁共用）
const sortedProperties = sortRecommended(allProperties);

// 統計 chip 選項 + 數量
const districtCount: Record<string, number> = {};
const typeCount: Record<string, number> = {};
const roomCount: Record<string, number> = {};
let newCount = 0;
let dropCount = 0;
let nonTaichungCount = 0;

const now = Date.now();
const propertyMeta = sortedProperties.map((p, idx) => {
  const m = buildCardMeta(p, idx, now);
  districtCount[m.district] = (districtCount[m.district] || 0) + 1;
  typeCount[m.type] = (typeCount[m.type] || 0) + 1;
  if (m.rooms) roomCount[m.rooms] = (roomCount[m.rooms] || 0) + 1;
  if (m.newListing) newCount++;
  if (m.dropPct) dropCount++;
  if (!isTaichung(p.data.district)) nonTaichungCount++;
  return m;
});

// 首屏只渲染前 FIRST_CHUNK 張卡；其餘每 CHUNK_SIZE 張包成一個 <template data-chunk>，
// 由「載入更多」或任何篩選／排序動作補進 DOM。這樣初始 DOM 從近萬節點降到約 1,500，
// 篩選邏輯不變（篩之前先把全部 template 補進來）。
// ⚠️ 不能改成 JSON 動態建卡：那會讓 345 個物件頁的內鏈從 HTML 消失。
const FIRST_CHUNK = 36;
const CHUNK_SIZE = 48;
const firstCards = propertyMeta.slice(0, FIRST_CHUNK);
const restChunks: (typeof propertyMeta)[] = [];
for (let i = FIRST_CHUNK; i < propertyMeta.length; i += CHUNK_SIZE) {
  restChunks.push(propertyMeta.slice(i, i + CHUNK_SIZE));
}
const cardGroups = [
  { deferred: false, items: firstCards },
  ...restChunks.map(items => ({ deferred: true, items })),
];
const deferredCount = propertyMeta.length - firstCards.length;

// badge 防通膨：pubDatetime 是批次同步日（properties-sync 整批重寫），
// 若全列表超過 30% 物件都判定為「新上架」，代表是同步日 artifact 不是真的新
// → 整批不顯示新上架 badge（含快選 chip）。
// 等 properties-sync 補 firstSeen 欄位後才能恢復精準判定。
const showNewBadge = shouldShowNewBadge(propertyMeta);

// district 按 county group（縣市對照在 src/utils/isTaichung.ts，與物件頁共用）
const districtsByCounty: Record<string, Array<[string, number]>> = {};
for (const [d, n] of Object.entries(districtCount)) {
  const c = getCounty(d);
  (districtsByCounty[c] ||= []).push([d, n]);
}
// 每縣市內按筆數排
for (const c of Object.keys(districtsByCounty)) {
  districtsByCounty[c].sort((a, b) => b[1] - a[1]);
}
// 縣市排序（依 COUNTY_ORDER + 筆數）
const counties = COUNTY_ORDER.filter(c => districtsByCounty[c]);

// 篩選收斂：預設只露台中市筆數前 8 行政區，長尾 + 其他縣市收進「更多區域」
const TOP_DISTRICTS = 8;
const taichungDistricts = districtsByCounty["台中市"] ?? [];
const taichungTop = taichungDistricts.slice(0, TOP_DISTRICTS);
const taichungRest = taichungDistricts.slice(TOP_DISTRICTS);
const otherCounties = counties.filter(c => c !== "台中市");

// 2026-09-06：台中各區 chip 改成連分區靜態頁 /properties/{slug}/（Google 才有一頁一區可收錄），
// 髒值（「台中北屯」）與外縣市沒有分區頁，維持 client-side 篩選 chip；?district= 深連結照舊可用。
const districtChipHref = (d: string): string | undefined => {
  const slug = getDistrictSlug(d);
  return slug ? `/properties/${slug}/` : undefined;
};

const types = Object.entries(typeCount).sort((a, b) => b[1] - a[1]);

const rooms = ROOM_ORDER.filter(r => roomCount[r]).map(
  r => [r, roomCount[r]] as [string, number]
);

// ============ SEO + JSON-LD ============
const canonicalURL = new URL("/properties/", Astro.site).href;
const taichungCount = sortedProperties.length - nonTaichungCount;
// 描述只講事實：不承諾「每筆都有實坪／屋齡／樓層／車位」（實際有缺），外縣市也講明
const seoDescription = `${sortedProperties.length} 筆在售物件，台中 ${taichungCount} 筆為主（北屯 / 西屯 / 南屯 / 北區 / 太平 / 大里…），另含本店同事聯賣的彰化、南投等外縣市案件。可依區域、總價、房型、屋齡篩選，每筆附總價、坪數、格局，多數有實照。`;
const pageTitle = `在售物件 ${sortedProperties.length} 筆（台中為主・含外縣市聯賣） | ${config.site.title}`;

// ItemList JSON-LD（給 Google 認識這是物件列表頁、可進 Google 物件搜尋）
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${canonicalURL}#listing`,
  name: "在售物件（台中為主）",
  description: seoDescription,
  numberOfItems: sortedProperties.length,
  itemListElement: propertyMeta.slice(0, 30).map((m, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/properties/${m.p.id}/`, Astro.site).href,
    name: m.title,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "在售物件",
      item: canonicalURL,
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={seoDescription}
  canonicalURL={canonicalURL}
  ogImage="/og/page-properties.jpg"
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(itemListSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(breadcrumbSchema)}
    />
  </Fragment>

  <Header />

  <Main
    pageTitle="在售物件"
    pageDesc={`${sortedProperties.length} 筆精選物件以台中為主，含本店跨縣市聯賣案件。`}
  >
    {/* 共用圖示：每張卡的 map-pin 以前各自 inline 一顆 svg（384 顆、150KB），改成只定義一次、卡片用 <use> */}
    <PropertyCardIcons />

    <!-- 篩選列 -->
    <div class="card-surface mb-6 space-y-3 p-4">
      <!-- 手機篩選收合開關（sm 以上恆展開） -->
      <button
        type="button"
        data-filter-toggle
        aria-expanded="false"
        class="text-foreground flex min-h-11 w-full cursor-pointer items-center justify-between text-sm font-medium sm:hidden"
      >
        篩選條件
        <IconChevronDown
          class="size-5 transition-transform"
          aria-hidden="true"
          data-filter-toggle-icon
        />
      </button>

      <div class="hidden space-y-4 sm:block" data-filter-body>
        <!-- 快選（降價；新上架 chip 受 showNewBadge 防通膨判定，目前不顯示） -->
        <div>
          <div class="text-muted-foreground mb-2 text-xs font-medium">快選</div>
          <div
            class="flex flex-wrap gap-2"
            data-filter-group="quick"
            role="group"
            aria-label="快選篩選"
          >
            <button
              type="button"
              data-filter-value=""
              class="filter-chip filter-chip-active"
            >
              全部
            </button>
            {
              showNewBadge && newCount > 0 && (
                <button
                  type="button"
                  data-filter-value="new"
                  class="filter-chip"
                >
                  新上架 ({newCount})
                </button>
              )
            }
            {
              dropCount > 0 && (
                <button
                  type="button"
                  data-filter-value="drop"
                  class="filter-chip"
                >
                  降價中 ({dropCount})
                </button>
              )
            }
          </div>
        </div>

        <!-- 區域：預設露台中前 8 區，其餘收進「更多區域」 -->
        <div>
          <div class="text-muted-foreground mb-2 text-xs font-medium">區域</div>
          <div
            class="space-y-2"
            data-filter-group="district"
            role="group"
            aria-label="區域篩選"
          >
            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                data-filter-value=""
                class="filter-chip filter-chip-active"
              >
                全部 ({sortedProperties.length})
              </button>
              {
                taichungTop.map(([d, n]) =>
                  districtChipHref(d) ? (
                    <a
                      href={districtChipHref(d)}
                      class="filter-chip district-link no-underline"
                      data-district-link={d}
                    >
                      {d} ({n})
                    </a>
                  ) : (
                    <button type="button" data-filter-value={d} class="filter-chip">
                      {d} ({n})
                    </button>
                  )
                )
              }
            </div>
            {
              (taichungRest.length > 0 || otherCounties.length > 0) && (
                <details class="group">
                  <summary class="text-muted-foreground hover:text-accent flex min-h-11 cursor-pointer items-center gap-1 text-sm select-none">
                    更多區域
                    <IconChevronDown
                      class="size-4 transition-transform group-open:rotate-180"
                      aria-hidden="true"
                    />
                  </summary>
                  <div class="mt-2 space-y-2">
                    {taichungRest.length > 0 && (
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-muted-foreground w-14 shrink-0 text-xs font-medium">
                          台中市
                        </span>
                        {taichungRest.map(([d, n]) =>
                          districtChipHref(d) ? (
                            <a
                              href={districtChipHref(d)}
                              class="filter-chip district-link no-underline"
                              data-district-link={d}
                            >
                              {d} ({n})
                            </a>
                          ) : (
                            <button
                              type="button"
                              data-filter-value={d}
                              class="filter-chip"
                            >
                              {d} ({n})
                            </button>
                          )
                        )}
                      </div>
                    )}
                    {otherCounties.map(c => (
                      <div class="flex flex-wrap items-center gap-2">
                        <span class="text-muted-foreground w-14 shrink-0 text-xs font-medium">
                          {c}
                        </span>
                        {districtsByCounty[c].map(([d, n]) => (
                          <button
                            type="button"
                            data-filter-value={d}
                            class="filter-chip"
                          >
                            {d} ({n})
                          </button>
                        ))}
                      </div>
                    ))}
                  </div>
                </details>
              )
            }
          </div>
        </div>

        <!-- 總價 range + 快選 -->
        <div>
          <div class="text-muted-foreground mb-2 text-xs font-medium">總價</div>
          <div class="flex flex-wrap items-center gap-2">
            <input
              type="number"
              inputmode="numeric"
              min="0"
              step="50"
              placeholder="不限"
              aria-label="總價下限（萬）"
              class="filter-range-input"
              data-filter-range="priceMin"
            />
            <span class="text-muted-foreground text-sm">~</span>
            <input
              type="number"
              inputmode="numeric"
              min="0"
              step="50"
              placeholder="不限"
              aria-label="總價上限（萬）"
              class="filter-range-input"
              data-filter-range="priceMax"
            />
            <span class="text-muted-foreground text-sm">萬</span>
          </div>
          <div class="mt-2 flex flex-wrap gap-2" data-filter-quick="price">
            <button
              type="button"
              data-quick-min=""
              data-quick-max="500"
              class="filter-chip"
            >
              500 萬以下
            </button>
            <button
              type="button"
              data-quick-min="500"
              data-quick-max="1000"
              class="filter-chip"
            >
              500–1000 萬
            </button>
            <button
              type="button"
              data-quick-min="1000"
              data-quick-max="2000"
              class="filter-chip"
            >
              1000–2000 萬
            </button>
            <button
              type="button"
              data-quick-min="2000"
              data-quick-max="3000"
              class="filter-chip"
            >
              2000–3000 萬
            </button>
            <button
              type="button"
              data-quick-min="3000"
              data-quick-max="5000"
              class="filter-chip"
            >
              3000–5000 萬
            </button>
            <button
              type="button"
              data-quick-min="5000"
              data-quick-max=""
              class="filter-chip"
            >
              5000 萬以上
            </button>
          </div>
        </div>

        <!-- 更多條件：類型 / 房型 / 屋齡 收斂進 details -->
        <details class="group">
          <summary
            class="text-muted-foreground hover:text-accent flex min-h-11 cursor-pointer items-center gap-1 text-sm select-none"
          >
            更多條件（類型・房型・屋齡）
            <IconChevronDown
              class="size-4 transition-transform group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <div class="mt-3 space-y-4">
            <!-- 類型 -->
            <div>
              <div class="text-muted-foreground mb-2 text-xs font-medium">
                類型
              </div>
              <div
                class="flex flex-wrap gap-2"
                data-filter-group="type"
                role="group"
                aria-label="物件類型篩選"
              >
                <button
                  type="button"
                  data-filter-value=""
                  class="filter-chip filter-chip-active"
                >
                  全部
                </button>
                {
                  types.map(([t, n]) => (
                    <button
                      type="button"
                      data-filter-value={t}
                      class="filter-chip"
                    >
                      {t} ({n})
                    </button>
                  ))
                }
              </div>
            </div>

            <!-- 房型（幾房） -->
            {
              rooms.length > 0 && (
                <div>
                  <div class="text-muted-foreground mb-2 text-xs font-medium">
                    房型
                  </div>
                  <div
                    class="flex flex-wrap gap-2"
                    data-filter-group="rooms"
                    role="group"
                    aria-label="房型篩選"
                  >
                    <button
                      type="button"
                      data-filter-value=""
                      class="filter-chip filter-chip-active"
                    >
                      全部
                    </button>
                    {rooms.map(([r, n]) => (
                      <button
                        type="button"
                        data-filter-value={r}
                        class="filter-chip"
                      >
                        {r} ({n})
                      </button>
                    ))}
                  </div>
                </div>
              )
            }

            <!-- 屋齡 range -->
            <div>
              <div class="text-muted-foreground mb-2 text-xs font-medium">
                屋齡
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <input
                  type="number"
                  inputmode="numeric"
                  min="0"
                  step="1"
                  placeholder="不限"
                  aria-label="屋齡下限（年）"
                  class="filter-range-input"
                  data-filter-range="ageMin"
                />
                <span class="text-muted-foreground text-sm">~</span>
                <input
                  type="number"
                  inputmode="numeric"
                  min="0"
                  step="1"
                  placeholder="不限"
                  aria-label="屋齡上限（年）"
                  class="filter-range-input"
                  data-filter-range="ageMax"
                />
                <span class="text-muted-foreground text-sm">年</span>
              </div>
              <div class="mt-2 flex flex-wrap gap-2" data-filter-quick="age">
                <button
                  type="button"
                  data-quick-min=""
                  data-quick-max="5"
                  class="filter-chip"
                >
                  新成屋（≤5 年）
                </button>
                <button
                  type="button"
                  data-quick-min=""
                  data-quick-max="15"
                  class="filter-chip"
                >
                  15 年內
                </button>
                <button
                  type="button"
                  data-quick-min="15"
                  data-quick-max="30"
                  class="filter-chip"
                >
                  15–30 年
                </button>
                <button
                  type="button"
                  data-quick-min="30"
                  data-quick-max=""
                  class="filter-chip"
                >
                  30 年以上
                </button>
              </div>
            </div>
          </div>
        </details>
      </div>

      <!-- 社區篩選（只從 URL ?community= 進來，例如物件頁的「看全部 XX 在售」）-->
      <div
        class="border-border flex flex-wrap items-center gap-2 border-t pt-3 text-sm"
        data-community-banner
        hidden
      >
        <span class="text-muted-foreground">社區：</span>
        <span class="text-foreground font-medium" data-community-name></span>
        <button type="button" class="filter-chip" data-community-clear>
          清除社區篩選 ✕
        </button>
      </div>

      <!-- 結果計數（醒目）+ 排序控制 — 不收進手機收合區，恆顯示 -->
      <div
        class="border-border flex flex-wrap items-center justify-between gap-3 border-t pt-3"
        data-filter-summary
      >
        <div class="text-foreground text-sm font-medium">
          顯示 <span
            class="text-accent text-lg font-extrabold"
            data-filter-count>{sortedProperties.length}</span
          > 筆
        </div>
        <label class="flex items-center gap-2">
          <span class="text-muted-foreground text-xs">排序</span>
          <select data-sort-select aria-label="排序方式" class="sort-select">
            <option value="recommended" selected>推薦排序</option>
            <option value="price-asc">總價低→高</option>
            <option value="price-desc">總價高→低</option>
            <option value="newest">最新上架</option>
          </select>
        </label>
      </div>
    </div>

    {
      sortedProperties.length === 0 ? (
        <p class="text-muted-foreground py-12 text-center">
          目前沒有開放公開的物件，
          <a href="/go/line?src=properties" class="text-accent underline">
            LINE 私訊
          </a>
          了解未公開物件。
        </p>
      ) : (
        <ul
          class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          data-property-list
          data-total={sortedProperties.length}
        >
          {cardGroups.map(group => {
            const cards = group.items.map(meta => (
              <PropertyCard meta={meta} showNewBadge={showNewBadge} />
            ));
            return group.deferred ? (
              <template data-chunk data-count={group.items.length}>
                {cards}
              </template>
            ) : (
              cards
            );
          })}
        </ul>
      )
    }

    {/* 載入更多：預設只掛前 36 張卡；篩選／排序時 script 會先把全部補進來 */}
    {
      deferredCount > 0 && (
        <div class="mt-8 text-center" data-load-more-wrap>
          <button type="button" class="btn-outline min-h-11 text-[15px]" data-load-more>
            載入更多物件（還有 <span data-load-more-count>{deferredCount}</span> 筆）
          </button>
        </div>
      )
    }

    <div
      class="card-surface hidden px-6 py-10 text-center sm:px-8 sm:py-12"
      data-filter-empty
    >
      <div class="bg-accent/10 mx-auto w-fit rounded-xl p-3">
        <IconSearch class="text-accent size-8" aria-hidden="true" />
      </div>
      <h3 class="text-foreground mt-4 text-xl font-bold sm:text-2xl">
        沒有完全符合條件的物件
      </h3>
      <p class="text-muted-foreground mt-3 text-[15px] leading-relaxed">
        試試放寬條件 — 未公開物件跟你的條件可能對得上，LINE 講一下需求就好。
      </p>

      <ul
        class="text-foreground mx-auto mt-5 max-w-md space-y-2 text-left text-[15px] leading-relaxed"
      >
        <li class="flex items-start gap-2">
          <IconCheck class="text-accent mt-1 size-4 shrink-0" aria-hidden="true" />
          <span>試試 <strong>清空所有條件</strong> 看完整 list</span>
        </li>
        <li class="flex items-start gap-2">
          <IconCheck class="text-accent mt-1 size-4 shrink-0" aria-hidden="true" />
          <span>把<strong>總價上限</strong>加 100-200 萬看更多選擇</span>
        </li>
        <li class="flex items-start gap-2">
          <IconCheck class="text-accent mt-1 size-4 shrink-0" aria-hidden="true" />
          <span>試試<strong>相鄰行政區</strong>（例 北屯 → 太平 / 西屯 → 北區）</span>
        </li>
      </ul>

      <div
        class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4"
      >
        <button type="button" data-filter-reset class="btn-outline text-[15px]">
          清空篩選
        </button>
        <a href="/go/line?src=properties" class="btn-line text-[15px]">
          <IconLine class="size-5" aria-hidden="true" />
          LINE 告訴我需求
        </a>
      </div>

      <p class="text-muted-foreground mt-5 text-[13px]">
        景泰會聯絡有相似物件的同事、24 小時內回覆。
      </p>
    </div>

    <div class="border-border mt-12 rounded-card border border-dashed p-6 text-center">
      <p class="text-muted-foreground mb-3 text-sm">
        看到喜歡的物件？或想看未公開物件？
      </p>
      <a href="/go/line?src=properties" class="btn-line">
        <IconLine class="size-5" aria-hidden="true" />
        LINE 私訊 sky811117
      </a>
      <p class="text-muted-foreground mt-4 text-xs">
        一品不動產 有巢氏房屋 台中世界之心加盟店<br />
        經紀人 黃永隆 113彰縣字324 ・ 營業員 陳景泰 114登字488296
      </p>
    </div>
  </Main>

  <Footer />
</Layout>

<style>
  .filter-chip {
    cursor: pointer;
    border-radius: 9999px;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    padding: 0.25rem 0.75rem;
    font-size: 0.875rem;
    transition:
      border-color 0.15s,
      background-color 0.15s,
      color 0.15s;
  }
  /* 手機：觸控目標 ≥44px（chip 是這頁主要互動，35px 太容易誤點相鄰行政區） */
  @media (max-width: 640px) {
    .filter-chip {
      min-height: 44px;
      padding: 0.5rem 0.875rem;
    }
  }
  .filter-chip:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .filter-chip-active,
  .filter-chip-active:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--background);
  }
  .filter-range-input {
    width: 5.5rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    padding: 0.25rem 0.5rem;
    font-size: 1rem;
    text-align: center;
    transition: border-color 0.15s;
  }
  .filter-range-input:focus {
    outline: none;
    border-color: var(--accent);
  }
  .filter-range-input::-webkit-outer-spin-button,
  .filter-range-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .filter-range-input[type="number"] {
    -moz-appearance: textfield;
  }
  .sort-select {
    cursor: pointer;
    border-radius: 0.375rem;
    border: 1px solid var(--border);
    background: var(--background);
    color: var(--foreground);
    padding: 0.375rem 0.5rem;
    font-size: 0.875rem;
    transition: border-color 0.15s;
  }
  .sort-select:focus {
    outline: none;
    border-color: var(--accent);
  }
</style>

<script is:inline>
  (function () {
    const groups = document.querySelectorAll("[data-filter-group]");
    const quickRanges = document.querySelectorAll("[data-filter-quick]");
    const rangeInputs = document.querySelectorAll("[data-filter-range]");
    const list = document.querySelector("[data-property-list]");
    if (!list) return;
    const countEl = document.querySelector("[data-filter-count]");
    const emptyEl = document.querySelector("[data-filter-empty]");
    const loadMoreWrap = document.querySelector("[data-load-more-wrap]");
    const loadMoreBtn = document.querySelector("[data-load-more]");
    const loadMoreCount = document.querySelector("[data-load-more-count]");
    const communityBanner = document.querySelector("[data-community-banner]");
    const communityNameEl = document.querySelector("[data-community-name]");
    const communityClear = document.querySelector("[data-community-clear]");

    // ── 分段載入：<ul> 內的 <template data-chunk> 各裝 48 張卡 ───────────
    function pendingTemplates() {
      return Array.from(list.querySelectorAll(":scope > template[data-chunk]"));
    }
    function pendingCount() {
      return pendingTemplates().reduce(
        (n, t) => n + (parseInt(t.dataset.count || "0", 10) || 0),
        0
      );
    }
    function hydrate(tpl) {
      // template 沒有渲染，卡片 append 在 template 之後也等於接在既有卡片後面
      list.appendChild(tpl.content);
      tpl.remove();
    }
    function hydrateNext() {
      const tpl = pendingTemplates()[0];
      if (tpl) hydrate(tpl);
    }
    function hydrateAll() {
      pendingTemplates().forEach(hydrate);
    }
    function getItems() {
      return Array.from(list.querySelectorAll(":scope > li"));
    }
    function syncLoadMore() {
      const left = pendingCount();
      if (loadMoreCount) loadMoreCount.textContent = String(left);
      if (loadMoreWrap) loadMoreWrap.hidden = left === 0;
    }

    const state = {
      district: "",
      type: "",
      rooms: "",
      quick: "",
      community: "",
      priceMin: "",
      priceMax: "",
      ageMin: "",
      ageMax: "",
    };
    const CHIP_KEYS = ["district", "type", "rooms", "quick"];
    const RANGE_KEYS = ["priceMin", "priceMax", "ageMin", "ageMax"];
    const ALL_KEYS = CHIP_KEYS.concat(RANGE_KEYS, ["community"]);

    function num(v) {
      if (v === "" || v === null || v === undefined) return null;
      const n = parseFloat(v);
      return isNaN(n) ? null : n;
    }

    function anyFilterActive() {
      return ALL_KEYS.some(k => !!state[k]);
    }

    function apply() {
      // 有任何條件就先把全部卡片補進 DOM，篩選才會對到全集合
      if (anyFilterActive()) hydrateAll();
      const pMin = num(state.priceMin);
      const pMax = num(state.priceMax);
      const aMin = num(state.ageMin);
      const aMax = num(state.ageMax);
      const ageActive = aMin !== null || aMax !== null;
      let visible = 0;
      for (const li of getItems()) {
        const okD = !state.district || li.dataset.district === state.district;
        const okC = !state.community || li.dataset.community === state.community;
        const okT = !state.type || li.dataset.type === state.type;
        const okR = !state.rooms || li.dataset.rooms === state.rooms;

        const priceNum = num(li.dataset.price);
        // 價格 filter 沒啟用時一律通過，避免缺價格的卡被無聲隱藏
        const priceActive = pMin !== null || pMax !== null;
        const okP =
          !priceActive ||
          (priceNum !== null &&
            (pMin === null || priceNum >= pMin) &&
            (pMax === null || priceNum <= pMax));

        let okA = true;
        if (ageActive) {
          const ageNum = num(li.dataset.age);
          if (ageNum === null) {
            okA = false; // 啟用屋齡 filter 但物件沒填 → 藏掉
          } else {
            okA =
              (aMin === null || ageNum >= aMin) &&
              (aMax === null || ageNum <= aMax);
          }
        }

        // quick 是空白分隔多值，contains check
        const quickTokens = (li.dataset.quick || "")
          .split(/\s+/)
          .filter(Boolean);
        const okQ = !state.quick || quickTokens.includes(state.quick);

        const show = okD && okC && okT && okR && okP && okA && okQ;
        li.style.display = show ? "" : "none";
        if (show) visible++;
      }
      // 沒條件時 template 裡還沒掛出來的卡也算「顯示中」
      const total = visible + (anyFilterActive() ? 0 : pendingCount());
      if (countEl) countEl.textContent = String(total);
      if (emptyEl) emptyEl.classList.toggle("hidden", total !== 0);
      list.classList.toggle("hidden", total === 0);
      if (communityBanner) {
        communityBanner.hidden = !state.community;
        if (communityNameEl) communityNameEl.textContent = state.community || "";
      }
      syncLoadMore();
      syncQuickRangeActive();
      syncUrl();
    }

    function syncUrl() {
      const url = new URL(location.href);
      ALL_KEYS.forEach(k => {
        if (state[k]) url.searchParams.set(k, state[k]);
        else url.searchParams.delete(k);
      });
      history.replaceState(null, "", url.toString());
    }

    function setChipActive(group, value) {
      group.querySelectorAll(".filter-chip").forEach(b => {
        // 連分區頁的 <a>（沒有 data-filter-value）不參與 active 切換，避免被當成「全部」
        if (b.dataset.filterValue === undefined) return;
        const match = (b.dataset.filterValue || "") === value;
        b.classList.toggle("filter-chip-active", match);
        b.setAttribute("aria-pressed", match ? "true" : "false");
      });
    }

    // quick-range chip 的 active 狀態：min/max 完全等於 state 才 active
    function syncQuickRangeActive() {
      quickRanges.forEach(group => {
        const prefix = group.dataset.filterQuick; // "price" or "age"
        const minKey = prefix + "Min";
        const maxKey = prefix + "Max";
        group.querySelectorAll(".filter-chip").forEach(b => {
          const match =
            (b.dataset.quickMin || "") === (state[minKey] || "") &&
            (b.dataset.quickMax || "") === (state[maxKey] || "");
          b.classList.toggle("filter-chip-active", match);
          b.setAttribute("aria-pressed", match ? "true" : "false");
        });
      });
    }

    function syncRangeInputs() {
      rangeInputs.forEach(inp => {
        const key = inp.dataset.filterRange;
        inp.value = state[key] || "";
      });
    }

    // 初始 URL state（深連結：首頁快速搜尋、區域頁「看完整 N 筆」、物件頁「看全部 XX 在售」）
    const params = new URLSearchParams(location.search);
    ALL_KEYS.forEach(k => {
      const v = params.get(k);
      if (v) state[k] = v.trim();
    });
    syncRangeInputs();

    // chip group：district / type / rooms / quick
    groups.forEach(g => {
      const key = g.dataset.filterGroup;
      setChipActive(g, state[key] || "");
      g.addEventListener("click", e => {
        const btn = e.target.closest(".filter-chip");
        // 連分區頁的 <a> 沒有 data-filter-value，交給瀏覽器導頁，不當篩選
        if (!btn || btn.dataset.filterValue === undefined) return;
        const v = btn.dataset.filterValue || "";
        state[key] = v;
        setChipActive(g, v);
        apply();
      });
    });

    // quick-range chip：price / age 快選
    quickRanges.forEach(g => {
      const prefix = g.dataset.filterQuick;
      const minKey = prefix + "Min";
      const maxKey = prefix + "Max";
      g.addEventListener("click", e => {
        const btn = e.target.closest(".filter-chip");
        if (!btn) return;
        const min = btn.dataset.quickMin || "";
        const max = btn.dataset.quickMax || "";
        // 點到已 active 的 chip → 清空（toggle off）
        const alreadyActive = btn.classList.contains("filter-chip-active");
        state[minKey] = alreadyActive ? "" : min;
        state[maxKey] = alreadyActive ? "" : max;
        syncRangeInputs();
        apply();
      });
    });

    // range input：min / max number 輸入
    rangeInputs.forEach(inp => {
      const key = inp.dataset.filterRange;
      inp.addEventListener("input", () => {
        state[key] = inp.value.trim();
        apply();
      });
    });

    // 社區篩選只能清除（沒有 chip 可選；入口是物件頁的連結）
    if (communityClear) {
      communityClear.addEventListener("click", () => {
        state.community = "";
        apply();
      });
    }

    // 載入更多：一次補一段；快捲到按鈕時也自動補（漸進載入）
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener("click", () => {
        hydrateNext();
        apply();
      });
      if ("IntersectionObserver" in window && loadMoreWrap) {
        const io = new IntersectionObserver(entries => {
          if (!entries.some(e => e.isIntersecting)) return;
          if (pendingCount() === 0) {
            io.disconnect();
            return;
          }
          hydrateNext();
          apply();
        }, { rootMargin: "600px 0px" });
        io.observe(loadMoreWrap);
      }
    }

    // 清空篩選按鈕（空狀態 UI 內）
    document.querySelectorAll("[data-filter-reset]").forEach(btn => {
      btn.addEventListener("click", () => {
        ALL_KEYS.forEach(k => {
          state[k] = "";
        });
        // 同步 UI：所有 chip group reset 到 "" (全部)
        groups.forEach(g => setChipActive(g, ""));
        syncQuickRangeActive();
        syncRangeInputs();
        apply();
        // scroll 回篩選列頂部讓用戶看到 reset 結果
        const filterBar = document.querySelector("[data-filter-group='district']");
        if (filterBar) filterBar.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    });

    apply();

    // 台中各區 chip 是連分區頁的 <a>（沒有 data-filter-value），?district= 深連結進來時也標 active
    document.querySelectorAll("[data-district-link]").forEach(a => {
      const match = !!state.district && a.dataset.districtLink === state.district;
      a.classList.toggle("filter-chip-active", match);
      if (match) a.setAttribute("aria-current", "page");
    });

    // 深連結進來時，active chip 若藏在 <details>（更多區域 / 更多條件）裡 → 自動展開
    // 注意：data-filter-value 為空字串 =「全部」chip（預設 active）→ 跳過，避免每次載入都展開
    document.querySelectorAll(".filter-chip-active").forEach(chip => {
      if (!chip.dataset.filterValue && !chip.dataset.districtLink) return;
      const det = chip.closest("details");
      if (det) det.open = true;
    });

    // 排序控制：client-side 重排卡片 DOM（不動 filter 顯示狀態）。排之前先把全部補進來
    const select = document.querySelector("[data-sort-select]");
    if (select) {
      const val = (li, key) => {
        const n = parseFloat(li.dataset[key]);
        return isNaN(n) ? 0 : n;
      };
      select.addEventListener("change", () => {
        hydrateAll();
        const v = select.value;
        const items = getItems();
        items.sort((a, b) => {
          if (v === "price-asc") return val(a, "price") - val(b, "price");
          if (v === "price-desc") return val(b, "price") - val(a, "price");
          if (v === "newest") return val(b, "pub") - val(a, "pub");
          // 推薦排序 = build-time 複合排序（data-order 還原）
          return val(a, "order") - val(b, "order");
        });
        items.forEach(li => list.appendChild(li));
        syncLoadMore();
      });
    }
  })();

  // 手機篩選收合：sm 以下預設收起，點「篩選條件」展開（sm 以上 CSS 恆顯示）
  (function () {
    const btn = document.querySelector("[data-filter-toggle]");
    const body = document.querySelector("[data-filter-body]");
    const icon = document.querySelector("[data-filter-toggle-icon]");
    if (!btn || !body) return;
    btn.addEventListener("click", () => {
      const opened = body.classList.toggle("hidden") === false;
      btn.setAttribute("aria-expanded", opened ? "true" : "false");
      if (icon) icon.classList.toggle("rotate-180", opened);
    });
  })();
</script>
