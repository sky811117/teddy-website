---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContactForm from "@/components/ContactForm.astro";
import config, { loan } from "@/config";
import { areas } from "@/data/areas";
import { safeJsonLd } from "@/utils/safeJsonLd";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { cleanStreetArea } from "@/utils/cleanStreetArea";
import { getCounty, OTHER_COUNTY } from "@/utils/isTaichung";
import { postFilter } from "@/utils/postFilter";
import {
  cleanPropertyTitle,
  sanitizeCopy,
  sanitizeHighlights,
} from "@/utils/cleanPropertyTitle";
import IconMapPin from "@/assets/icons/IconMapPin.svg";
import IconPhone from "@/assets/icons/IconPhone.svg";
import IconClipboardList from "@/assets/icons/IconClipboardList.svg";
import IconLine from "@/assets/icons/socials/line.svg";

export async function getStaticPaths() {
  const properties = await getCollection(
    "properties",
    ({ data }) => data.status === "active"
  );
  // 社區文（frontmatter community 跟物件的 community 一字不差才配對；
  // 用 postFilter 排掉草稿與未到發布時間的，避免連到沒 build 的 404）
  const posts = (await getCollection("posts")).filter(postFilter);
  const postsByCommunity = new Map<string, CollectionEntry<"posts">[]>();
  for (const post of posts) {
    const c = post.data.community?.trim();
    if (!c) continue;
    const bucket = postsByCommunity.get(c) ?? [];
    bucket.push(post);
    postsByCommunity.set(c, bucket);
  }
  return properties.map(property => {
    const comm = property.data.community?.trim();
    const communityPosts = (comm ? (postsByCommunity.get(comm) ?? []) : [])
      .slice()
      .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
    return {
      params: { slug: property.id },
      props: { property, properties, communityPosts },
    };
  });
}

type Props = {
  property: CollectionEntry<"properties">;
  properties: CollectionEntry<"properties">[];
  communityPosts: CollectionEntry<"posts">[];
};

const { property, properties, communityPosts } = Astro.props;
const { Content } = await render(property);

const formatPrice = (price: number) => {
  if (price >= 10000) return `${(price / 10000).toFixed(2)} 億`;
  return `${price.toLocaleString()} 萬`;
};

// 新上架 / 降價 判斷
const NEW_DAYS = 7;
const isNew =
  property.data.pubDatetime &&
  (Date.now() - property.data.pubDatetime.getTime()) / 86400000 <= NEW_DAYS;
const dropPct =
  property.data.lastPrice && property.data.lastPrice > property.data.totalPrice
    ? Math.round(((property.data.lastPrice - property.data.totalPrice) / property.data.lastPrice) * 100)
    : null;

// badge 防通膨（與列表頁同步）：pubDatetime 是批次同步日（properties-sync 整批重寫），
// 若全站超過 30% 物件都判定為「新上架」→ 整批不顯示新上架 badge。
// 等 properties-sync 補 firstSeen 欄位後才能恢復精準判定。
const NEW_BADGE_MAX_RATIO = 0.3;
const siteNewCount = properties.filter(
  p =>
    p.data.pubDatetime &&
    (Date.now() - p.data.pubDatetime.getTime()) / 86400000 <= NEW_DAYS
).length;
const showNewBadge =
  properties.length > 0 &&
  siteNewCount / properties.length <= NEW_BADGE_MAX_RATIO;

// 位置去重：streetArea 帶行政區前綴時去掉（標題下 / sticky bar 共用）
const streetAreaClean = cleanStreetArea(
  property.data.streetArea,
  property.data.district
);

// 委編 / 專任 badge：
// - 完整委編（含 UT/UG/HG 前綴）藏在 markdown body 的「> 委編：XXX」blockquote，
//   build-time 從 body 撈出來，fallback frontmatter listingCode
// - 「本店專任」依「原始」標題是否含「專任」判定（顯示用標題會把這個字清掉）
const bodyCodeMatch = property.body?.match(/委編：([A-Z0-9]+)/);
const fullListingCode = bodyCodeMatch?.[1] ?? property.data.listingCode;
const rawTitle = property.data.title || "";
const isExclusive = rawTitle.includes("專任");

// ── 對外顯示的標題／賣點／文案：渲染層防線（src/utils/cleanPropertyTitle.ts）──
// 委託書案名是寫給同事看的，帶「賠售」「稀有」「專任」與 emoji；H1、sticky bar、
// 麵包屑、JSON-LD、圖片 alt 一律用清過的版本。清到剩不到 4 字就退回「社區 格局」。
const titleFallback = [
  property.data.community?.trim() || property.data.district,
  property.data.layout,
]
  .filter(Boolean)
  .join(" ");
const displayTitle = cleanPropertyTitle(rawTitle, titleFallback);
const highlights = sanitizeHighlights(property.data.highlights);

// 類型（給規格卡用）：優先撈 markdown body 的「**類型**：XXX」，最準
const bodyTypeMatch = property.body?.match(/\*\*類型\*\*：\s*([^\n\r]+)/);
const propertyType = bodyTypeMatch?.[1]?.trim();

// 住宅型才顯示月付試算：土地／店面／廠房／商辦／農舍的貸款成數與年限依銀行鑑價而定，
// 用 8 成 30 年算出來的數字對買方是錯的（實例：69,990 萬農建地印出「月付約 215.6 萬」）
const RESIDENTIAL_RE = /大樓|華廈|公寓|透天|別墅|套房/;
const NON_RESIDENTIAL_RE = /土地|農地|建地|林地|店面|廠房|商辦|辦公|農舍|倉儲|商場/;
const isResidential = propertyType
  ? RESIDENTIAL_RE.test(propertyType)
  : !NON_RESIDENTIAL_RE.test(`${rawTitle} ${property.data.layout || ""}`) &&
    property.data.layout !== "—";

// 月付試算（build-time 靜態值；參數在 src/config.ts 的 loan，每月底更新）
const monthlyRate = loan.rate / 12;
const totalMonths = loan.years * 12;
const loanPrincipal = property.data.totalPrice * loan.ratio; // 單位：萬
const monthlyPayment =
  (loanPrincipal * monthlyRate * Math.pow(1 + monthlyRate, totalMonths)) /
  (Math.pow(1 + monthlyRate, totalMonths) - 1); // 單位：萬/月
const monthlyPaymentText = monthlyPayment.toFixed(1);
const loanRatePct = (loan.rate * 100).toFixed(3).replace(/0+$/, "").replace(/\.$/, "");
const loanRatioText = `${Math.round(loan.ratio * 10)} 成`;

// 照片 collage（桌面、照片 ≥3 張才啟用）：主圖 + 副圖最多 4 張
const photos = property.data.photos;
const useCollage = photos.length >= 3;
const collageSide = photos.slice(1, 5);
// 沒露出的張數（疊在最後一格的「+N 張」遮罩）
const collageHiddenCount = photos.length - 1 - collageSide.length;

// ── 內鏈：同社區 → 社區文 → 區域頁 → 同縣市 ────────────────────────────
// ⚠️ community 沒填的物件（約 45%）兩邊都是 undefined，直接 === 會把整站當同社區，先 guard
const communityName = property.data.community?.trim() || "";
const sameCommunity = communityName
  ? properties
      .filter(p => p.id !== property.id && p.data.community?.trim() === communityName)
      .sort((a, b) => {
        const coverDiff = (a.data.coverImage ? 0 : 1) - (b.data.coverImage ? 0 : 1);
        if (coverDiff !== 0) return coverDiff;
        return a.data.totalPrice - b.data.totalPrice;
      })
  : [];
const sameCommunityIds = new Set(sameCommunity.map(p => p.id));

// 區域頁（src/data/areas.ts 只有 7 區，對不到的 district 就不連，別硬連 /areas/undefined/）
const area = areas.find(a => a.districtMatch.includes(property.data.district));

// 社區名要連去哪：有社區文連社區文；沒有但同社區還有別戶 → 列表頁帶 community 篩選
const communityListUrl = communityName
  ? `/properties/?community=${encodeURIComponent(communityName)}`
  : null;
const communityHref = communityPosts[0]
  ? `/posts/${communityPosts[0].id}/`
  : sameCommunity.length > 0
    ? communityListUrl
    : null;

// 同縣市其他物件（最多 6 筆；同社區已另列，這裡去重）
const thisCounty = getCounty(property.data.district);
const sameCounty = properties
  .filter(
    p =>
      p.id !== property.id &&
      !sameCommunityIds.has(p.id) &&
      getCounty(p.data.district) === thisCounty
  )
  // 有照片優先 > 同區域 > 價格相近
  .sort((a, b) => {
    const coverDiff = (a.data.coverImage ? 0 : 1) - (b.data.coverImage ? 0 : 1);
    if (coverDiff !== 0) return coverDiff;
    const aSameDistrict = a.data.district === property.data.district ? 0 : 1;
    const bSameDistrict = b.data.district === property.data.district ? 0 : 1;
    if (aSameDistrict !== bSameDistrict) return aSameDistrict - bSameDistrict;
    return Math.abs(a.data.totalPrice - property.data.totalPrice) - Math.abs(b.data.totalPrice - property.data.totalPrice);
  })
  .slice(0, 6);

// 「其他物件」區塊：同社區先、同縣市後（一套卡片版型跑兩次）
const relatedSections = [
  {
    key: "community",
    heading: `${communityName}同社區其他在售`,
    count: sameCommunity.length,
    countLabel: "戶",
    list: sameCommunity,
    moreHref: communityListUrl,
    moreText: `看全部 ${communityName} 在售 →`,
  },
  {
    key: "county",
    heading: thisCounty === OTHER_COUNTY ? "更多在售物件" : `${thisCounty}其他物件`,
    count: sameCounty.length,
    countLabel: "筆精選",
    list: sameCounty,
    moreHref: "/properties/",
    moreText: "看全部在售物件 →",
  },
].filter(s => s.list.length > 0);

// ── 內文：body 的「## 物件介紹」段落 build-time 抽出來清洗後自己排版 ──────
// properties-sync 產的 body 固定是「## 物件介紹 → ## 物件規格 → --- → 委編 → 證號」，
// 規格與委編在頁面上方已有規格卡／badge，證號段落頁尾另有；這裡只要介紹段。
// 抽不到（格式跑掉）就退回 <Content />，下方 client script 會把重複段落拿掉。
const introMatch = property.body?.match(/## 物件介紹\s*\n([\s\S]*?)(?=\n## |\n---|$)/);
const introLines = introMatch
  ? sanitizeCopy(introMatch[1].replace(/\*\*/g, ""))
      .split("\n")
      .map(l => l.trim())
      .filter(Boolean)
  : null;

// ============ SEO + JSON-LD ============
// 尾斜線：Cloudflare Pages 會 308 到帶尾斜線的網址，canonical / Offer.url / breadcrumb 都要一致
const canonicalURL = new URL(`/properties/${property.id}/`, Astro.site).href;

// description: 優先 frontmatter description，沒有則組合基本資訊
// smartTruncate: 在 max chars 內找最後一個中文句末標點 (。！？) 切斷，避免斷句中間
function smartTruncate(s: string, max: number): string {
  if (s.length <= max) return s;
  const head = s.slice(0, max);
  // 嘗試在 max 範圍找最後一個句末標點
  const cutPoints = [...head.matchAll(/[。！？\?\!\.]/g)];
  if (cutPoints.length > 0) {
    const last = cutPoints[cutPoints.length - 1];
    // 句末標點位置 >= max*0.6 才採用，否則太短
    if (last.index !== undefined && last.index >= max * 0.6) {
      return head.slice(0, last.index + 1);
    }
  }
  // fallback: 找逗號 / 全形空白 / 換行
  const softCut = [...head.matchAll(/[，、,;\s]/g)];
  if (softCut.length > 0) {
    const last = softCut[softCut.length - 1];
    if (last.index !== undefined && last.index >= max * 0.7) {
      return head.slice(0, last.index) + "…";
    }
  }
  return head + "…";
}

// ── SEO 標題與描述（2026-08-28 重寫、2026-09-06 改用共用清洗）──────────
// 買方實際會搜的是「北屯 三房 1500萬」這種組合，所以把行政區、格局、坪數、
// 總價補進標題，並把誇大字眼濾掉（也避免踩不實廣告與 lint-seo 的誇大詞檢查）。
const areaNum = Number(property.data.area);
// 案名裡若已經有行政區（例如「北區｜麗園道｜…」）就不要再重複一次
const districtInTitle =
  !!property.data.district && displayTitle.includes(property.data.district);
const seoFacts = [
  districtInTitle ? "" : property.data.district,
  property.data.layout,
  Number.isFinite(areaNum) && areaNum > 0 ? `${Math.round(areaNum)}坪` : "",
  property.data.totalPrice ? `${property.data.totalPrice}萬` : "",
]
  .filter(Boolean)
  .join(" ");

// 物件頁不掛站名後綴 —— 後綴要 19 個字，等於把買方搜的詞擠出 SERP 可見範圍。
// 頁面本身與 JSON-LD 都有景泰的身分資訊，品牌訊號不靠標題後綴。
const seoTitle = [displayTitle, seoFacts].filter(Boolean).join("｜");

// 描述：先給事實，再接乾淨的賣點（去 emoji、去誇大句、去第三人聯絡、門牌砍到路段）
const cleanBlurb = sanitizeCopy(property.data.description || "")
  .replace(/\n+/g, " ")
  .replace(/\s{2,}/g, " ")
  .replace(/^[\s，、。!！?？]+/, "")
  .trim();

const factSentence = [
  // streetArea 本身通常已含行政區（「北屯區環中東路二段」），別再前綴一次
  property.data.streetArea
    ? (property.data.streetArea.startsWith(property.data.district)
        ? property.data.streetArea
        : `${property.data.district}・${property.data.streetArea}`)
    : property.data.district,
  property.data.layout,
  Number.isFinite(areaNum) && areaNum > 0 ? `${areaNum}坪` : "",
  property.data.totalPrice ? `總價 ${formatPrice(property.data.totalPrice)}` : "",
]
  .filter(Boolean)
  .join("，");

const seoDescription = smartTruncate(
  [factSentence, cleanBlurb].filter(Boolean).join("。").replace(/。。+/g, "。"),
  160
);

// ogImage: 用物件首圖（絕對路徑），fallback 到全站 default OG
const coverImageSrc = property.data.coverImage
  ? typeof property.data.coverImage === "string"
    ? property.data.coverImage
    : property.data.coverImage.src
  : property.data.photos[0] ?? null;
const ogImagePath = coverImageSrc
  ? new URL(coverImageSrc, Astro.site).href
  : new URL(resolveDefaultOgImagePath(config), Astro.site).href;

// 從 layout 抓房數（給 numberOfRooms）
const roomsMatch = property.data.layout?.match(/(\d+)\s*房/);
const numberOfRooms = roomsMatch ? parseInt(roomsMatch[1], 10) : undefined;

// 把「萬」轉成「元」(Google offers 用 TWD 標準幣別單位)
const priceInNTD = property.data.totalPrice * 10000;

// priceValidUntil: 預設廣告 90 天後 (跟物件刊登週期對齊)
const priceValidUntil = new Date(
  Date.now() + 90 * 24 * 60 * 60 * 1000
).toISOString().slice(0, 10);

// 物件類型 → schema.org 的「about」型別。
// 廠房／店面以前標 LocalBusiness，會被當成一家營業中的商家（可能餵進 Maps），改回 Place。
function getSchemaType(): string {
  const t = `${propertyType || ""} ${rawTitle} ${property.data.layout || ""}`;
  if (/透天|別墅/.test(t)) return "SingleFamilyResidence";
  if (/公寓|套房|大樓|華廈/.test(t)) return "Apartment";
  if (/店面|商辦|廠房|土地|農地|建地|林地|農舍|辦公/.test(t)) return "Place";
  // 預設大樓/華廈
  return "Apartment";
}
const schemaType = getSchemaType();

// 證號前綴防雙重 (frontmatter 若已含 "經紀人 X" / "營業員 X" 就不加)
function withPrefix(prefix: string, value: string): string {
  return value.startsWith(prefix) ? value : `${prefix}${value}`;
}

// 圖片 array: 至多 6 張避免 JSON-LD payload 過大
const MAX_SCHEMA_IMAGES = 6;
const schemaImages = property.data.photos.length > 0
  ? property.data.photos
      .slice(0, MAX_SCHEMA_IMAGES)
      .map(p => new URL(p, Astro.site).href)
  : [ogImagePath];

// 主 schema：RealEstateListing（schema.org 有這個型別；不動產不是 Product，
// 標 Product 拿不到 rich result 還可能被當實體商品）。住宅型別放在 about。
// addressRegion 只在 county 為已知縣市時輸出 (避免出現 "其他" 怪詞)
const aboutSchema = {
  "@type": schemaType,
  name: displayTitle,
  address: {
    "@type": "PostalAddress",
    addressLocality: property.data.district,
    ...(thisCounty !== OTHER_COUNTY ? { addressRegion: thisCounty } : {}),
    addressCountry: "TW",
    ...(property.data.streetArea ? { streetAddress: property.data.streetArea } : {}),
  },
  ...(property.data.area
    ? {
        floorSize: {
          "@type": "QuantitativeValue",
          value: property.data.area,
          unitText: "坪",
        },
      }
    : {}),
  ...(numberOfRooms ? { numberOfRooms } : {}),
  // yearBuilt 故意不輸出 — age 是 build-time 快照、跨年會 stale；schema 沒設 yearBuilt 比 stale 好
};

const listingSchema = {
  "@context": "https://schema.org",
  "@type": "RealEstateListing",
  "@id": `${canonicalURL}#listing`,
  url: canonicalURL,
  name: displayTitle,
  description: seoDescription,
  image: schemaImages,
  inLanguage: "zh-TW",
  datePosted: property.data.pubDatetime.toISOString().slice(0, 10),
  about: aboutSchema,
  offers: {
    "@type": "Offer",
    price: priceInNTD,
    priceCurrency: "TWD",
    availability:
      property.data.status === "active"
        ? "https://schema.org/InStock"
        : "https://schema.org/OutOfStock",
    url: canonicalURL,
    priceValidUntil,
    seller: {
      "@type": "RealEstateAgent",
      name: "陳景泰",
      telephone: "+886-920-118-756",
      email: "a0920118756@gmail.com",
      hasCredential: [
        withPrefix("經紀人 ", property.data.brokerLicense),
        withPrefix("營業員 ", property.data.agentLicense),
      ],
    },
  },
  // 額外屬性（Google 認 additionalProperty）
  additionalProperty: [
    {
      "@type": "PropertyValue",
      name: "格局",
      value: property.data.layout,
    },
    {
      "@type": "PropertyValue",
      name: "權狀坪數",
      value: `${property.data.area} 坪`,
    },
    ...(property.data.age !== undefined
      ? [{ "@type": "PropertyValue", name: "屋齡", value: `${property.data.age} 年` }]
      : []),
    ...(property.data.floor
      ? [{ "@type": "PropertyValue", name: "樓層", value: property.data.floor }]
      : []),
    ...(property.data.parking
      ? [{ "@type": "PropertyValue", name: "車位", value: property.data.parking }]
      : []),
    ...(numberOfRooms
      ? [{ "@type": "PropertyValue", name: "房數", value: numberOfRooms }]
      : []),
  ],
};

// Breadcrumb（item 一律帶尾斜線，跟 canonical 一致）
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "在售物件",
      item: new URL("/properties/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: displayTitle,
      item: canonicalURL,
    },
  ],
};

// 底部 CTA bar 的 bottom：cookie 同意橫幅出現時 Analytics.astro 會把橫幅高度寫進
// --consent-h，CTA 就往上讓開；沒橫幅時是 0px。
const ctaBottomStyle = "bottom: calc(0px + var(--consent-h, 0px))";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImagePath}
  canonicalURL={canonicalURL}
  showFloatingCTA={false}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(listingSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(breadcrumbSchema)}
    />
  </Fragment>

  <Header />

  {/* 桌面版 sticky CTA bar — 滾動超過 600px 才出現，常駐在視窗底部直到看完。
      隱藏時同時掛 inert，aria-hidden 內才不會有可聚焦的按鈕 */}
  <div
    data-property-sticky
    class="border-border bg-card/95 fixed inset-x-0 bottom-0 z-30 hidden translate-y-full border-t shadow-lg backdrop-blur transition-transform duration-300 sm:block"
    style={ctaBottomStyle}
    aria-hidden="true"
    inert
  >
    <div class="app-layout max-w-app flex flex-wrap items-center justify-between gap-4 py-3">
      <div class="min-w-0 flex-1">
        <p class="text-foreground line-clamp-1 text-sm font-semibold">
          {displayTitle}
        </p>
        <p class="text-muted-foreground flex items-center gap-1 text-xs">
          <IconMapPin class="size-3.5 shrink-0" aria-hidden="true" />
          <span class="line-clamp-1">
            {property.data.district}
            {streetAreaClean ? `・${streetAreaClean}` : ""}
            ・{property.data.layout} ・{property.data.area} 坪
          </span>
        </p>
      </div>
      <div class="text-accent shrink-0 text-xl font-bold sm:text-2xl">
        {formatPrice(property.data.totalPrice)}
      </div>
      <div class="flex shrink-0 items-center gap-2">
        <a href="#contact-form-section" class="btn-outline text-sm">
          <IconClipboardList class="size-4" aria-hidden="true" />
          詢問
        </a>
        <a href="tel:+886920118756" class="btn-outline text-sm">
          <IconPhone class="size-4" aria-hidden="true" />
          撥打
        </a>
        <a href="/go/line?src=property-sticky" class="btn-line text-sm">
          <IconLine class="size-4" aria-hidden="true" />
          LINE 景泰
        </a>
      </div>
    </div>
  </div>

  {/* 手機版常駐底部 CTA bar — 細價格列 + 三鍵、純 CSS、只在手機出現 */}
  <div
    class="border-border bg-card/95 fixed inset-x-0 bottom-0 z-40 border-t shadow-lg backdrop-blur sm:hidden"
    style={ctaBottomStyle}
    data-property-mobile-cta
  >
    <div class="border-border flex h-8 min-w-0 items-center justify-between gap-2 border-b px-3">
      <p class="text-foreground line-clamp-1 min-w-0 flex-1 text-xs">{displayTitle}</p>
      <span class="text-accent shrink-0 text-base font-bold">{formatPrice(property.data.totalPrice)}</span>
    </div>
    <div class="grid grid-cols-3">
      <a href="tel:+886920118756" class="text-accent flex min-h-11 flex-col items-center justify-center gap-0.5 py-2.5 text-xs font-medium no-underline"><IconPhone class="size-5" aria-hidden="true" />撥電話</a>
      <a href="/go/line?src=property-bar" class="bg-line flex min-h-11 flex-col items-center justify-center gap-0.5 py-2.5 text-xs font-medium text-white no-underline"><IconLine class="size-5" aria-hidden="true" />LINE 景泰</a>
      <a href="#contact-form-section" class="text-accent flex min-h-11 flex-col items-center justify-center gap-0.5 py-2.5 text-xs font-medium no-underline"><IconClipboardList class="size-5" aria-hidden="true" />詢問</a>
    </div>
  </div>

  <main id="main-content" class="app-layout max-w-app py-8 pb-24 sm:pb-24">
    <a
      href="/properties/"
      class="text-muted-foreground hover:text-accent mb-4 inline-block text-sm no-underline"
    >
      ← 返回在售物件列表
    </a>

    {/* Pagefind：只索引 article；站內搜尋才找得到物件（結果可用「物件」filter 分開） */}
    <article data-pagefind-body data-pagefind-filter="type:物件">
      <h1 class="text-accent text-2xl font-bold sm:text-3xl" data-pagefind-meta="title">
        {displayTitle}
      </h1>

      <p class="text-muted-foreground mt-2 flex items-center gap-1 text-sm">
        <IconMapPin class="size-4 shrink-0" aria-hidden="true" />
        <span>
          {property.data.district}
          {streetAreaClean ? `・${streetAreaClean}` : ""}
          {communityName && "・"}
          {
            communityName && communityHref ? (
              <a href={communityHref} class="text-accent underline decoration-dotted underline-offset-4">
                {communityName}
              </a>
            ) : (
              communityName
            )
          }
        </span>
      </p>

      {/* 委編 / 專任 / 新上架 / 降價 badge 列 */}
      <div class="mt-3 flex flex-wrap items-center gap-2">
        {fullListingCode && (
          <span class="bg-muted text-muted-foreground inline-block rounded px-2 py-0.5 text-xs">
            委編 {fullListingCode}
          </span>
        )}
        {isExclusive && (
          <span class="inline-block rounded border border-emerald-700 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:border-emerald-400 dark:text-emerald-400">
            本店專任
          </span>
        )}
        {showNewBadge && isNew && (
          <span class="inline-block rounded-full bg-emerald-700 px-2 py-0.5 text-xs font-medium text-white">
            新上架
          </span>
        )}
        {dropPct && (
          <span class="inline-block rounded-full bg-rose-700 px-2 py-0.5 text-xs font-medium text-white">
            降價 {dropPct}%
          </span>
        )}
      </div>

      <div class="text-accent mt-3 flex flex-wrap items-baseline gap-3 text-3xl font-bold sm:text-4xl">
        <span>{formatPrice(property.data.totalPrice)}</span>
        {
          dropPct && property.data.lastPrice && (
            <span class="text-muted-foreground text-lg font-normal line-through">
              {formatPrice(property.data.lastPrice)}
            </span>
          )
        }
        {
          property.data.pricePerPing && (
            <span class="text-muted-foreground text-base font-normal">
              單坪 {property.data.pricePerPing.toFixed(1)} 萬
            </span>
          )
        }
      </div>

      {/* 月付試算（住宅型才顯示；參數在 src/config.ts 的 loan）*/}
      {
        isResidential ? (
          <p class="text-muted-foreground mt-2 text-sm">
            {loanRatioText} {loan.years} 年・利率 {loanRatePct}% 試算 → 月付約 {monthlyPaymentText} 萬
            <span class="text-muted-foreground/80 ml-1 text-xs">
              （{loan.note}，{loan.asOf} 更新）
            </span>
            <a href="/tools/" class="text-accent ml-1 no-underline hover:underline">
              試算工具 →
            </a>
          </p>
        ) : (
          <p class="text-muted-foreground mt-2 text-sm">
            這類物件的貸款成數與年限依銀行鑑價而定，要試算月付
            <a href="/go/line?src=property" class="text-accent ml-1 no-underline hover:underline">
              LINE 問景泰 →
            </a>
          </p>
        )
      }

      {
        photos.length > 0 ? (
          <div class="my-6" data-gallery>
            {/* 桌面 collage（照片 ≥3 張、sm 以上）：主圖 2x2 + 副圖 2-4 張 */}
            {useCollage && (
              <div
                class="hidden gap-2 sm:grid sm:aspect-[2/1] sm:grid-cols-4 sm:grid-rows-2"
                data-gallery-collage
              >
                <button
                  type="button"
                  data-collage-index="0"
                  class="bg-muted group relative col-span-2 row-span-2 cursor-zoom-in overflow-hidden rounded-lg"
                  aria-label="查看第 1 張"
                >
                  <img
                    src={photos[0]}
                    alt={`${displayTitle}（第 1 張，共 ${photos.length} 張）`}
                    width="800"
                    height="600"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="eager"
                    fetchpriority="high"
                    decoding="sync"
                    data-pagefind-meta="image[src]"
                  />
                </button>
                {collageSide.map((p, i) => {
                  // 依副圖張數決定 span 避免破格：2 張各佔整排、3 張時最後一張補滿第二排
                  const spanClass =
                    collageSide.length === 2
                      ? "col-span-2"
                      : collageSide.length === 3 && i === 2
                        ? "col-span-2"
                        : "";
                  const isLastTile = i === collageSide.length - 1;
                  const showMore = isLastTile && collageHiddenCount > 0;
                  return (
                    <button
                      type="button"
                      data-collage-index={i + 1}
                      class={`bg-muted group relative cursor-zoom-in overflow-hidden rounded-lg ${spanClass}`}
                      aria-label={
                        showMore
                          ? `查看第 ${i + 2} 張，還有 +${collageHiddenCount} 張`
                          : `查看第 ${i + 2} 張`
                      }
                    >
                      <img
                        src={p}
                        alt={`${displayTitle}（第 ${i + 2} 張，共 ${photos.length} 張）`}
                        width="400"
                        height="300"
                        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                      />
                      {showMore && (
                        <span class="pointer-events-none absolute inset-0 flex items-center justify-center bg-black/55 text-xl font-bold text-white">
                          +{collageHiddenCount} 張
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>
            )}

            {/* 主圖 + 縮圖列（手機維持現狀；<3 張時桌面也用這套）。
                有可見文字（計數／點擊放大）就不另掛 aria-label，避免 label 與可見文字不一致 */}
            <div class={useCollage ? "sm:hidden" : ""}>
              {/* 主圖（點擊開 lightbox） */}
              <button
                type="button"
                data-gallery-main-btn
                class="bg-muted group relative block aspect-[4/3] w-full cursor-zoom-in overflow-hidden rounded-lg"
              >
                <img
                  src={photos[0]}
                  alt={`${displayTitle}（第 1 張，共 ${photos.length} 張）`}
                  width="800"
                  height="600"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="eager"
                  fetchpriority="high"
                  decoding="sync"
                  data-gallery-main
                  data-pagefind-meta={useCollage ? undefined : "image[src]"}
                />
                <span
                  class="pointer-events-none absolute right-3 bottom-3 rounded bg-black/60 px-2 py-1 font-mono text-xs text-white"
                  data-gallery-counter
                >
                  1 / {photos.length}
                </span>
                <span class="pointer-events-none absolute top-3 right-3 rounded bg-black/60 px-2 py-1 text-xs text-white opacity-0 transition-opacity group-hover:opacity-100">
                  點擊放大
                </span>
              </button>

              {/* 縮圖列（橫向 scroll） */}
              {photos.length > 1 && (
                <div
                  class="mt-3 flex gap-2 overflow-x-auto pb-2"
                  data-gallery-thumbs
                  style="scrollbar-width: thin;"
                >
                  {photos.map((p, i) => (
                    <button
                      type="button"
                      data-gallery-index={i}
                      aria-label={`查看第 ${i + 1} 張`}
                      class={`bg-muted aspect-[4/3] w-20 shrink-0 overflow-hidden rounded border-2 transition-all sm:w-24 ${
                        i === 0
                          ? "border-accent opacity-100"
                          : "border-transparent opacity-60 hover:opacity-100"
                      }`}
                    >
                      <img
                        src={p}
                        alt={`${displayTitle} 縮圖 ${i + 1}`}
                        width="120"
                        height="90"
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    </button>
                  ))}
                </div>
              )}
            </div>
          </div>
        ) : (
          <div class="bg-muted rounded-card my-6 flex h-48 w-full flex-col items-center justify-center gap-3 sm:h-56">
            <p class="text-foreground text-base font-medium">📷 照片整理中</p>
            <p class="text-muted-foreground text-sm">
              想先看實照／影片？
            </p>
            <a href="/go/line?src=property" class="btn-line text-sm">
              <IconLine class="size-4" aria-hidden="true" />
              LINE 索取實照
            </a>
          </div>
        )
      }

      {/* Lightbox 全螢幕瀏覽 */}
      {
        property.data.photos.length > 0 && (
          <dialog
            data-gallery-lightbox
            class="m-0 h-full max-h-none w-full max-w-none border-0 bg-black/95 p-0 backdrop:bg-black/80"
          >
            {/* 2026-08-26：原本硬寫 width=1600 height=1200。max-h/max-w 是上限
                不是固定值，1024px 的來源會被硬撐到 1600px 顯示（放大 1.56 倍→糊）。
                公司前台物件的圖源 CDN 只給 1024px，重抓也拿不到更大的，正解是不要撐。
                拿掉後依原生尺寸顯示；這是全螢幕 flex 置中的 lightbox，沒有 CLS 問題。 */}
            <div class="relative flex h-screen w-screen items-center justify-center">
              <img
                data-gallery-lightbox-img
                src={property.data.photos[0]}
                alt={displayTitle}
                loading="lazy"
                decoding="async"
                class="max-h-[92vh] max-w-[96vw] object-contain"
              />

              <button
                type="button"
                data-gallery-close
                aria-label="關閉"
                class="absolute top-3 right-3 flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-2xl text-white transition-colors hover:bg-white/30 sm:top-4 sm:right-4 sm:h-12 sm:w-12"
              >
                ✕
              </button>

              {property.data.photos.length > 1 && (
                <>
                  <button
                    type="button"
                    data-gallery-prev
                    aria-label="上一張"
                    class="absolute left-2 top-1/2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-3xl text-white transition-colors hover:bg-white/30 sm:left-6 sm:h-14 sm:w-14"
                  >
                    ‹
                  </button>
                  <button
                    type="button"
                    data-gallery-next
                    aria-label="下一張"
                    class="absolute right-2 top-1/2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-3xl text-white transition-colors hover:bg-white/30 sm:right-6 sm:h-14 sm:w-14"
                  >
                    ›
                  </button>
                  <span
                    data-gallery-lightbox-counter
                    class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-black/60 px-4 py-1.5 font-mono text-sm text-white"
                  >
                    1 / {property.data.photos.length}
                  </span>
                </>
              )}
            </div>
          </dialog>
        )
      }

      {/* 規格卡：格局 / 權狀 / 主建物 / 樓層 / 車位 / 屋齡 / 類型 / 單價 */}
      <div class="card-surface mt-6 grid grid-cols-2 gap-4 p-5 sm:grid-cols-4">
        <div>
          <div class="text-muted-foreground text-xs">格局</div>
          <div class="mt-1 text-lg font-bold">{property.data.layout}</div>
        </div>
        <div>
          <div class="text-muted-foreground text-xs">權狀</div>
          <div class="mt-1 text-lg font-bold">{property.data.area} 坪</div>
        </div>
        {
          property.data.indoorArea !== undefined && (
            <div>
              <div class="text-muted-foreground text-xs">主建物</div>
              <div class="mt-1 text-lg font-bold">
                {property.data.indoorArea} 坪
              </div>
            </div>
          )
        }
        {
          property.data.floor && (
            <div>
              <div class="text-muted-foreground text-xs">樓層</div>
              <div class="mt-1 text-lg font-bold">{property.data.floor}</div>
            </div>
          )
        }
        {
          property.data.parking && (
            <div>
              <div class="text-muted-foreground text-xs">車位</div>
              <div class="mt-1 text-lg font-bold">{property.data.parking}</div>
            </div>
          )
        }
        {
          property.data.age !== undefined && (
            <div>
              <div class="text-muted-foreground text-xs">屋齡</div>
              <div class="mt-1 text-lg font-bold">{property.data.age} 年</div>
            </div>
          )
        }
        {
          propertyType && (
            <div>
              <div class="text-muted-foreground text-xs">類型</div>
              <div class="mt-1 text-lg font-bold">{propertyType}</div>
            </div>
          )
        }
        {
          property.data.pricePerPing && (
            <div>
              <div class="text-muted-foreground text-xs">單價</div>
              <div class="mt-1 text-lg font-bold">
                {property.data.pricePerPing.toFixed(1)} 萬/坪
              </div>
            </div>
          )
        }
      </div>

      {/* 社區深度文 + 區域頁：物件頁的內容出口（沒有就整段不出現） */}
      {
        (communityPosts.length > 0 || area) && (
          <div class="mt-6 space-y-3" data-pagefind-ignore>
            {communityPosts.length > 0 && (
              <div class="card-surface p-5">
                <h2 class="text-lg font-bold">
                  {communityName} 評價／實價登錄整理
                </h2>
                <p class="text-muted-foreground mt-1 text-sm">
                  看這戶之前，先看這個社區的實價登錄、優缺點、適合誰。
                </p>
                <ul class="mt-3 space-y-3">
                  {communityPosts.slice(0, 3).map(post => (
                    <li>
                      <a
                        href={`/posts/${post.id}/`}
                        class="group block no-underline"
                        data-track="post"
                        data-post-id={post.id}
                      >
                        <span class="text-accent font-medium group-hover:underline">
                          {post.data.title} →
                        </span>
                        <span class="text-muted-foreground mt-0.5 line-clamp-2 block text-sm">
                          {post.data.description}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {area && (
              <p class="text-muted-foreground text-sm">
                想先看{area.shortName}整體行情、哪些人適合買？
                <a
                  href={`/areas/${area.slug}/`}
                  class="text-accent ml-1 no-underline hover:underline"
                >
                  {area.shortName}買房指南 →
                </a>
              </p>
            )}
          </div>
        )
      }

      {
        highlights.length > 0 && (
          <div class="mt-6">
            <h2 class="text-lg font-bold">物件亮點</h2>
            <ul class="mt-2 list-disc space-y-1 ps-6">
              {highlights.map(h => (
                <li>{h}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        introLines ? (
          introLines.length > 0 && (
            <div class="mt-8" data-property-intro>
              <h2 class="text-lg font-bold">物件介紹</h2>
              <div class="text-foreground mt-2 space-y-1.5 leading-relaxed">
                {introLines.map(line => (
                  <p>{line}</p>
                ))}
              </div>
            </div>
          )
        ) : (
          <div
            class="app-prose max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) mt-8"
            data-property-content
          >
            <Content />
          </div>
        )
      }

      {/* 同社區其他在售 → 同縣市其他物件（同一套卡片，先社區後縣市） */}
      {
        relatedSections.map(section => (
          <div class="mt-12" data-pagefind-ignore data-related={section.key}>
            <h2 class="text-lg font-bold">
              {section.heading}
              <span class="text-muted-foreground ml-2 text-sm font-normal">
                ({section.count} {section.countLabel})
              </span>
            </h2>
            <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {section.list.map(p => {
                const cardTitle = cleanPropertyTitle(
                  p.data.title,
                  [p.data.community?.trim() || p.data.district, p.data.layout]
                    .filter(Boolean)
                    .join(" ")
                );
                return (
                  <li class="card-interactive overflow-hidden">
                    <a
                      href={`/properties/${p.id}/`}
                      class="block no-underline"
                      data-track="property"
                      data-property-id={p.id}
                      data-property-title={cardTitle}
                      data-property-price={p.data.totalPrice}
                      data-property-district={p.data.district}
                    >
                      {p.data.coverImage ? (
                        <div class="bg-muted aspect-[4/3] w-full overflow-hidden">
                          <img
                            src={
                              typeof p.data.coverImage === "string"
                                ? p.data.coverImage
                                : p.data.coverImage.src
                            }
                            alt={cardTitle}
                            width="400"
                            height="300"
                            class="h-full w-full object-cover"
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      ) : (
                        <div class="bg-muted flex aspect-[4/3] w-full flex-col items-center justify-center gap-1 overflow-hidden">
                          <p class="text-muted-foreground text-sm">📷 照片整理中</p>
                        </div>
                      )}
                      {/* price-first：價格在上、標題在下 */}
                      <div class="p-3">
                        <div class="text-accent text-lg font-bold">
                          {formatPrice(p.data.totalPrice)}
                        </div>
                        <h3 class="text-foreground mt-1 line-clamp-1 text-xs font-medium">
                          {cardTitle}
                        </h3>
                        <p class="text-muted-foreground mt-1 flex items-center gap-1 text-xs">
                          <IconMapPin class="size-3.5 shrink-0" aria-hidden="true" />
                          {p.data.district}
                        </p>
                        <div class="text-muted-foreground mt-1 text-xs">
                          {p.data.layout} · {p.data.area} 坪
                        </div>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
            {section.moreHref && (
              <p class="mt-3 text-sm">
                <a href={section.moreHref} class="text-accent no-underline hover:underline">
                  {section.moreText}
                </a>
              </p>
            )}
          </div>
        ))
      }

      <hr class="my-8 border-dashed" />

      {/* 主表單 — 預填物件編號 + 標題（id 給 sticky CTA 錨點用）。
          表單把 23 個行政區、預算選項全印在頁上，不能進 Pagefind 索引 */}
      <div id="contact-form-section" class="scroll-mt-20" data-pagefind-ignore>
        <ContactForm
          propertyId={property.data.listingCode}
          propertyTitle={displayTitle}
          defaultIntent="buy"
          title="想看這戶？留你的聯絡方式"
          subtitle="物件編號已幫你預填、補完聯絡方式就送出。30 分鐘內回。"
        />
      </div>

      {/* 快速 LINE / 電話通道 — 給急的人 */}
      <div
        class="border-border rounded-lg border border-dashed p-6 text-center"
        data-pagefind-ignore
      >
        <p class="text-foreground text-[17px] font-medium">
          想直接聊、不想填表單？
        </p>
        <div
          class="mt-4 flex flex-col items-center justify-center gap-3 sm:flex-row"
        >
          <a href="/go/line?src=property-bottom" class="btn-line text-[17px]">
            <IconLine class="size-5" aria-hidden="true" />
            LINE sky811117
          </a>
          <a href="tel:+886920118756" class="btn-outline text-[17px]">
            <IconPhone class="size-5" aria-hidden="true" />
            0920-118-756
          </a>
        </div>
        <p class="text-muted-foreground mt-4 text-[13px]">
          一品不動產 有巢氏房屋 台中世界之心加盟店<br />
          經紀人 {property.data.brokerLicense}
          ・ 營業員 {property.data.agentLicense}
        </p>
      </div>
    </article>
  </main>

  <Footer />
</Layout>

<script
  is:inline
  define:vars={{
    photos: property.data.photos,
    title: displayTitle,
    total: property.data.photos.length,
  }}
>
  (function () {
    if (!photos || photos.length === 0) return;

    const gallery = document.querySelector("[data-gallery]");
    if (!gallery) return;

    const mainImg = gallery.querySelector("[data-gallery-main]");
    const mainBtn = gallery.querySelector("[data-gallery-main-btn]");
    const counter = gallery.querySelector("[data-gallery-counter]");
    const thumbBtns = gallery.querySelectorAll("[data-gallery-index]");

    const dialog = document.querySelector("[data-gallery-lightbox]");
    const lbImg = dialog && dialog.querySelector("[data-gallery-lightbox-img]");
    const lbCounter = dialog && dialog.querySelector("[data-gallery-lightbox-counter]");
    const closeBtn = dialog && dialog.querySelector("[data-gallery-close]");
    const prevBtn = dialog && dialog.querySelector("[data-gallery-prev]");
    const nextBtn = dialog && dialog.querySelector("[data-gallery-next]");

    let current = 0;

    function setIndex(i) {
      current = ((i % total) + total) % total;
      const src = photos[current];
      const label = `${title}（第 ${current + 1} 張，共 ${total} 張）`;
      if (mainImg) {
        mainImg.src = src;
        mainImg.alt = label;
      }
      if (counter) counter.textContent = `${current + 1} / ${total}`;
      if (lbImg) {
        lbImg.src = src;
        lbImg.alt = label;
      }
      if (lbCounter) lbCounter.textContent = `${current + 1} / ${total}`;
      thumbBtns.forEach((b, idx) => {
        const active = idx === current;
        b.classList.toggle("border-accent", active);
        b.classList.toggle("opacity-100", active);
        b.classList.toggle("border-transparent", !active);
        b.classList.toggle("opacity-60", !active);
      });
      // scroll thumb into view
      const activeThumb = thumbBtns[current];
      if (activeThumb && activeThumb.scrollIntoView) {
        activeThumb.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center",
        });
      }
    }

    function openLightbox() {
      if (!dialog) return;
      if (typeof dialog.showModal === "function") {
        dialog.showModal();
      } else {
        dialog.setAttribute("open", "");
      }
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!dialog) return;
      if (typeof dialog.close === "function") {
        dialog.close();
      } else {
        dialog.removeAttribute("open");
      }
      document.body.style.overflow = "";
    }

    if (mainBtn) mainBtn.addEventListener("click", openLightbox);
    thumbBtns.forEach(b => {
      b.addEventListener("click", () => {
        const i = parseInt(b.dataset.galleryIndex || "0", 10);
        setIndex(i);
      });
    });

    // 桌面 collage：點任一格 → 跳到該張並開 lightbox（沿用既有邏輯）
    gallery.querySelectorAll("[data-collage-index]").forEach(b => {
      b.addEventListener("click", () => {
        setIndex(parseInt(b.dataset.collageIndex || "0", 10));
        openLightbox();
      });
    });
    if (closeBtn) closeBtn.addEventListener("click", closeLightbox);
    if (prevBtn) prevBtn.addEventListener("click", () => setIndex(current - 1));
    if (nextBtn) nextBtn.addEventListener("click", () => setIndex(current + 1));

    // 點 backdrop 關閉
    if (dialog) {
      dialog.addEventListener("click", e => {
        if (e.target === dialog) closeLightbox();
      });
      dialog.addEventListener("close", () => {
        document.body.style.overflow = "";
      });
    }

    // 鍵盤導覽（lightbox 開啟時）
    document.addEventListener("keydown", e => {
      if (!dialog || !dialog.open) return;
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        setIndex(current - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        setIndex(current + 1);
      }
    });
  })();
</script>

<script is:inline>
  // 桌面版 sticky CTA bar 滑入/滑出：滾過 600px 出現、靠近 ContactForm 時收回。
  // 收起時 aria-hidden + inert 一起掛，鍵盤不會 tab 進看不見的按鈕。
  (function () {
    const sticky = document.querySelector("[data-property-sticky]");
    if (!sticky) return;
    const form = document.getElementById("contact-form-section");

    let raf = null;
    function update() {
      raf = null;
      const scrolled = window.scrollY > 600;
      let nearForm = false;
      if (form) {
        const rect = form.getBoundingClientRect();
        // ContactForm 進到視窗 60% 以上 → 隱藏 sticky（已經看到表單就不用 CTA bar）
        nearForm = rect.top < window.innerHeight * 0.6;
      }
      const show = scrolled && !nearForm;
      sticky.classList.toggle("translate-y-full", !show);
      sticky.setAttribute("aria-hidden", show ? "false" : "true");
      sticky.inert = !show;
    }
    function onScroll() {
      if (raf === null) raf = requestAnimationFrame(update);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    update();
  })();
</script>

<script is:inline>
  // 內文去重（只在 <Content /> fallback 路徑會有東西可刪）：markdown body 由
  // properties-sync 批次產出，固定帶「## 物件規格」bullet 段落（與上方規格卡重複）
  // +「> 委編：…」blockquote（已改成標題下 badge）。
  // .md 內容不能動（sync 會整批覆寫），改在 client 端把這兩段從渲染移除；
  // 無 JS 時 fallback 維持完整內文，資訊不會缺。
  (function () {
    const prose = document.querySelector("[data-property-content]");
    if (!prose) return;
    prose.querySelectorAll("h2").forEach(h => {
      if ((h.textContent || "").trim() !== "物件規格") return;
      let node = h.nextElementSibling;
      h.remove();
      // 連同其後內容（到下一個標題 / hr 為止）一起移除，證號段落在 hr 後不受影響
      while (node && !/^(H[1-6]|HR)$/.test(node.tagName)) {
        const next = node.nextElementSibling;
        node.remove();
        node = next;
      }
    });
    prose.querySelectorAll("blockquote").forEach(bq => {
      if ((bq.textContent || "").includes("委編：")) bq.remove();
    });
  })();
</script>

<script
  is:inline
  define:vars={{
    quickCode: property.data.listingCode ?? "",
    quickTitle: displayTitle,
  }}
>
  // 表單瘦身（漸進增強）：ContactForm 是全站共用元件不能動，改在本頁把
  // Email / 我想 / 預算 / 區域偏好 收進「進階需求（選填）」<details>，
  // 預設只露 姓名 / 手機 / 訊息；並在表單頂部加 3 顆 quick chips 一鍵覆寫訊息。
  // 無 JS 時 fallback 維持完整表單，功能不會缺。
  (function () {
    const form = document.querySelector("[data-contact-form]");
    if (!form) return;
    const msgInput = form.querySelector("[name='訊息']");
    const msgWrap = msgInput ? msgInput.closest("div") : null;

    // --- 進階需求 <details>：搬 Email / 我想+預算 grid / 區域偏好 ---
    const emailEl = document.getElementById("cf-email");
    const emailWrap = emailEl ? emailEl.closest("div") : null;
    const intentEl = document.getElementById("cf-intent");
    const intentGrid = intentEl ? intentEl.closest(".grid") : null;
    const areaSummary = form.querySelector("[data-area-summary]");
    const areaDetails = areaSummary ? areaSummary.closest("details") : null;
    const areaBlock = areaDetails ? areaDetails.parentElement : null;

    if (msgWrap && (emailWrap || intentGrid || areaBlock)) {
      const adv = document.createElement("details");
      adv.className = "border-border bg-background rounded-md border";
      const summary = document.createElement("summary");
      summary.className =
        "text-muted-foreground cursor-pointer px-4 py-3 text-[15px] select-none";
      summary.textContent = "進階需求（選填）▾";
      const body = document.createElement("div");
      body.className = "space-y-5 p-4 pt-2";
      adv.append(summary, body);
      msgWrap.after(adv);
      [emailWrap, intentGrid, areaBlock].forEach(el => {
        if (el) body.appendChild(el);
      });
    }

    // --- quick chips：點了覆寫訊息（物件編號 hidden 欄位另有預填、不受影響） ---
    if (msgInput) {
      const chips = document.createElement("div");
      chips.className = "flex flex-wrap gap-2";
      ["想約看屋", "想問貸款", "想要實照"].forEach(text => {
        const b = document.createElement("button");
        b.type = "button";
        b.className =
          "border-border bg-background text-foreground hover:border-accent hover:text-accent cursor-pointer rounded-full border px-3 py-1.5 text-sm transition-colors";
        b.textContent = text;
        b.addEventListener("click", () => {
          const ref = quickCode
            ? "物件 " + quickCode + (quickTitle ? "（" + quickTitle + "）" : "")
            : "這個物件";
          msgInput.value = text + "：" + ref;
          msgInput.dispatchEvent(new Event("input", { bubbles: true }));
          msgInput.focus();
        });
        chips.appendChild(b);
      });
      form.insertBefore(chips, form.firstElementChild);
    }
  })();
</script>
