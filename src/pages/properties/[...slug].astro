---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContactForm from "@/components/ContactForm.astro";
import config, { loan } from "@/config";
import { areas } from "@/data/areas";
import { safeJsonLd } from "@/utils/safeJsonLd";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { cleanStreetArea } from "@/utils/cleanStreetArea";
import { getCounty, getDistrictListUrl, OTHER_COUNTY } from "@/utils/isTaichung";
import { postFilter } from "@/utils/postFilter";
import {
  cleanPropertyTitle,
  sanitizeCopy,
  sanitizeHighlights,
} from "@/utils/cleanPropertyTitle";
import { areaIncludesParking, bodyPropertyType } from "@/utils/parkingCaliber";
import { listedAt, priceCheckedDate } from "@/utils/propertySiteData";
import { coverSrcOf, coverSrcset, coverThumb } from "@/utils/coverThumb";
import {
  photoAlt,
  publicCommunityName,
  stripAddressDetail,
} from "@/utils/propertyPhotoAlt";
import AskBar from "@/components/flora/AskBar.astro";
import { coverSmall, homeShortByCode, playerUrl } from "@/data/shorts";
import { wbrSegments } from "@/utils/wbr";
// 2026-11 極簡改版（樣稿 v3）：共用元件在 ax.css，物件頁要補的在 flora-property.css（檔名沿用，順序不能反）
import "@/styles/ax.css";
import "@/styles/flora-property.css";
import "@/styles/shorts-embed.css";

export async function getStaticPaths() {
  const properties = await getCollection(
    "properties",
    ({ data }) => data.status === "active"
  );
  // 社區文（frontmatter community 跟物件的 community 一字不差才配對；
  // 用 postFilter 排掉草稿與未到發布時間的，避免連到沒 build 的 404）
  const posts = (await getCollection("posts")).filter(postFilter);
  const postsByCommunity = new Map<string, CollectionEntry<"posts">[]>();
  for (const post of posts) {
    const c = post.data.community?.trim();
    if (!c) continue;
    const bucket = postsByCommunity.get(c) ?? [];
    bucket.push(post);
    postsByCommunity.set(c, bucket);
  }
  return properties.map(property => {
    const comm = property.data.community?.trim();
    const communityPosts = (comm ? (postsByCommunity.get(comm) ?? []) : [])
      .slice()
      .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime());
    return {
      params: { slug: property.id },
      props: { property, properties, communityPosts },
    };
  });
}

type Props = {
  property: CollectionEntry<"properties">;
  properties: CollectionEntry<"properties">[];
  communityPosts: CollectionEntry<"posts">[];
};

const { property, properties, communityPosts } = Astro.props;
// 這間有短影音：照片上放入口，沒照片時影片直接當第一眼（點了才載入播放器，物件頁速度不受影響）
const short = homeShortByCode(property.id);
const shortHref = `/shorts/homes/${property.id}/`;
const { Content } = await render(property);

const formatPrice = (price: number) => {
  if (price >= 10000) return `${(price / 10000).toFixed(2)} 億`;
  return `${price.toLocaleString()} 萬`;
};

// 新上架 / 降價 判斷
const NEW_DAYS = 7;
const isNew = (Date.now() - listedAt(property).getTime()) / 86400000 <= NEW_DAYS;
const dropPct =
  property.data.lastPrice && property.data.lastPrice > property.data.totalPrice
    ? Math.round(((property.data.lastPrice - property.data.totalPrice) / property.data.lastPrice) * 100)
    : null;

// badge 防通膨（與列表頁同步）：pubDatetime 是批次同步日（properties-sync 整批重寫），
// 若全站超過 30% 物件都判定為「新上架」→ 整批不顯示新上架 badge。
// 等 properties-sync 補 firstSeen 欄位後才能恢復精準判定。
const NEW_BADGE_MAX_RATIO = 0.3;
const siteNewCount = properties.filter(
  p => (Date.now() - listedAt(p).getTime()) / 86400000 <= NEW_DAYS
).length;
const showNewBadge =
  properties.length > 0 &&
  siteNewCount / properties.length <= NEW_BADGE_MAX_RATIO;

// 位置去重：streetArea 帶行政區前綴時去掉（標題下 / sticky bar 共用）
// stripAddressDetail：地號／巷弄號碼保險切（HG0238992 的 streetArea 是「南興段717、718地號」）
const streetAreaClean = stripAddressDetail(
  cleanStreetArea(property.data.streetArea, property.data.district)
);

// 委編 / 專任 badge：
// - 完整委編（含 UT/UG/HG 前綴）藏在 markdown body 的「> 委編：XXX」blockquote，
//   build-time 從 body 撈出來，fallback frontmatter listingCode
// - 「本店專任」依「原始」標題是否含「專任」判定（顯示用標題會把這個字清掉）
const bodyCodeMatch = property.body?.match(/委編：([A-Z0-9]+)/);
const fullListingCode = bodyCodeMatch?.[1] ?? property.data.listingCode;
const rawTitle = property.data.title || "";
const isExclusive = rawTitle.includes("專任");

// ── 對外顯示的標題／賣點／文案：渲染層防線（src/utils/cleanPropertyTitle.ts）──
// 委託書案名是寫給同事看的，帶「賠售」「稀有」「專任」與 emoji；H1、sticky bar、
// 麵包屑、JSON-LD、圖片 alt 一律用清過的版本。清到剩不到 4 字就退回「社區 格局」。
const titleFallback = [
  property.data.community?.trim() || property.data.district,
  property.data.layout,
]
  .filter(Boolean)
  .join(" ");
const displayTitle = cleanPropertyTitle(rawTitle, titleFallback, property.data.district);
const highlights = sanitizeHighlights(property.data.highlights, property.data.district);

// 類型（規格卡、月付、schema 型別都看它）：
// 1. src/data/property-types.json（properties-sync 每晚從公司完整快照的 caseTypeName 輸出，
//    格式 {"<物件id>": "<caseTypeName>"}，稽核 F130）—— 含 type_overrides.json 的人工修正
//    （例 1211236 前台標電梯大樓、實際是商場），所以排第一
// 2. markdown body 的「**類型**：XXX」行
// 檔案不存在 → glob 回空物件 → 等於原本只看 body；兩邊都沒有的物件維持原狀，不用樓層數去猜類型。
const propertyTypeFiles = import.meta.glob<Record<string, unknown>>("/src/data/property-types.json", {
  eager: true,
  import: "default",
});
const propertyTypeMap = Object.values(propertyTypeFiles)[0] ?? {};
const jsonPropertyType = (() => {
  const v = propertyTypeMap[property.id];
  return typeof v === "string" && v.trim() ? v.trim() : undefined;
})();
const propertyType = jsonPropertyType ?? bodyPropertyType(property.body);

// 權狀／單價是否含車位（大樓／華廈的產權固定車位；判斷規則見 src/utils/parkingCaliber.ts）
// 沒有「類型」行的 HG/UA 物件拿原始案名代替做排除比對（只會更嚴，不會多標）
const includesParking = areaIncludesParking(
  property.data.parking,
  propertyType ?? rawTitle
);
const parkingSuffix = includesParking ? "（含車位）" : "";

// 對外可用的社區名（≤12 字、不含誇大字；SEO 標題、描述、事實句、照片 alt 共用）
const publicCommunity = publicCommunityName(property.data);

// 資料日期：Asia/Taipei 的 YYYY-MM-DD。toISOString() 是 UTC，台灣 08:00 前的時間戳
// 會少一天（8/23 06:36 被印成 8/22）
const twDate = (d: Date) =>
  new Intl.DateTimeFormat("sv-SE", { timeZone: "Asia/Taipei" }).format(d);
const dataDate = property.data.lastSeen ?? property.data.pubDatetime;
// 2026-10-04 台帳 X006 第二階段：當晚店頭價格核對過的委編，頁面改標「價格核對日」
const priceChecked = priceCheckedDate(property.id);

// 月付試算（build-time 靜態值；參數在 src/config.ts 的 loan，每月底更新）
const monthlyRate = loan.rate / 12;
const totalMonths = loan.years * 12;
const loanPrincipal = property.data.totalPrice * loan.ratio; // 單位：萬
const monthlyPayment =
  (loanPrincipal * monthlyRate * Math.pow(1 + monthlyRate, totalMonths)) /
  (Math.pow(1 + monthlyRate, totalMonths) - 1); // 單位：萬/月
const monthlyPaymentText = monthlyPayment.toFixed(1);
const loanRatePct = (loan.rate * 100).toFixed(3).replace(/0+$/, "").replace(/\.$/, "");
const loanRatioText = `${Math.round(loan.ratio * 10)} 成`;

// 照片 collage（桌面、照片 ≥3 張才啟用）：主圖 + 副圖最多 4 張
const photos = property.data.photos;
const useCollage = photos.length >= 3;
const collageSide = photos.slice(1, 5);
// 沒露出的張數（疊在最後一格的「+N 張」遮罩）
const collageHiddenCount = photos.length - 1 - collageSide.length;
// 照片 alt：「社區名・格局 照片 第 N 張」（只用事實欄位，不帶行銷標題與路段；見 propertyPhotoAlt.ts）
const photoAlts = photos.map((_, i) => photoAlt(property.data, i));

// ── 內鏈：同社區 → 社區文 → 區域頁 → 同縣市 ────────────────────────────
// ⚠️ community 沒填的物件（約 45%）兩邊都是 undefined，直接 === 會把整站當同社區，先 guard
const communityName = property.data.community?.trim() || "";
const sameCommunity = communityName
  ? properties
      .filter(p => p.id !== property.id && p.data.community?.trim() === communityName)
      .sort((a, b) => {
        const coverDiff = (a.data.coverImage ? 0 : 1) - (b.data.coverImage ? 0 : 1);
        if (coverDiff !== 0) return coverDiff;
        return a.data.totalPrice - b.data.totalPrice;
      })
  : [];
const sameCommunityIds = new Set(sameCommunity.map(p => p.id));

// 區域頁（src/data/areas.ts 目前 11 區，對不到的 district 就不連，別硬連 /areas/undefined/）
const area = areas.find(a => a.districtMatch.includes(property.data.district));
// 分區靜態列表頁 /properties/{slug}/：台中 29 區都有；外縣市退回 ?district= 篩選
const districtListUrl = getDistrictListUrl(property.data.district);
const districtActiveCount = properties.filter(
  p => p.id !== property.id && p.data.district === property.data.district
).length;

// 社區名要連去哪：有社區文連社區文；沒有但同社區還有別戶 → 列表頁帶 community 篩選
const communityListUrl = communityName
  ? `/properties/?community=${encodeURIComponent(communityName)}`
  : null;
const communityHref = communityPosts[0]
  ? `/posts/${communityPosts[0].id}/`
  : sameCommunity.length > 0
    ? communityListUrl
    : null;

// 同縣市其他物件（最多 6 筆；同社區已另列，這裡去重）
const thisCounty = getCounty(property.data.district);
const sameCounty = properties
  .filter(
    p =>
      p.id !== property.id &&
      !sameCommunityIds.has(p.id) &&
      getCounty(p.data.district) === thisCounty
  )
  // 有照片優先 > 同區域 > 價格相近
  .sort((a, b) => {
    const coverDiff = (a.data.coverImage ? 0 : 1) - (b.data.coverImage ? 0 : 1);
    if (coverDiff !== 0) return coverDiff;
    const aSameDistrict = a.data.district === property.data.district ? 0 : 1;
    const bSameDistrict = b.data.district === property.data.district ? 0 : 1;
    if (aSameDistrict !== bSameDistrict) return aSameDistrict - bSameDistrict;
    return Math.abs(a.data.totalPrice - property.data.totalPrice) - Math.abs(b.data.totalPrice - property.data.totalPrice);
  })
  .slice(0, 6);

// 「其他物件」區塊：同社區先、同縣市後（一套卡片版型跑兩次）
const relatedSections = [
  {
    key: "community",
    heading: `${communityName}同社區其他在售`,
    count: sameCommunity.length,
    countLabel: "戶",
    list: sameCommunity,
    moreHref: communityListUrl,
    moreText: `看全部 ${communityName} 在售 →`,
  },
  {
    key: "county",
    heading: thisCounty === OTHER_COUNTY ? "更多在售物件" : `${thisCounty}其他物件`,
    count: sameCounty.length,
    countLabel: "筆精選",
    list: sameCounty,
    moreHref: "/properties/",
    moreText: "看全部在售物件 →",
  },
].filter(s => s.list.length > 0);

// ── 內文：body 的「## 物件介紹」段落 build-time 抽出來清洗後自己排版 ──────
// properties-sync 產的 body 固定是「## 物件介紹 → ## 物件規格 → --- → 委編 → 證號」，
// 規格與委編在頁面上方已有規格卡／badge，證號段落頁尾另有；這裡只要介紹段。
// 抽不到（格式跑掉）就退回 <Content />，下方 client script 會把重複段落拿掉。
const introMatch = property.body?.match(/## 物件介紹\s*\n([\s\S]*?)(?=\n## |\n---|$)/);
const introLines = introMatch
  ? sanitizeCopy(introMatch[1].replace(/\*\*/g, ""), property.data.district)
      .split("\n")
      .map(l => l.trim())
      .filter(Boolean)
  : null;

// 亮點去重（稽核 F037）：properties-sync 的 highlights 是從物件介紹逐行抽的，九成頁面
// 「物件亮點」跟「物件介紹」逐句相同。比對前去掉開頭的 ・·• 項目符號與多餘空白
// （EMOJI_RE 不含這三個字元，0397192 就是卡在前綴差異）。全部重複時亮點整塊不渲染。
const normLine = (s: string) =>
  s.replace(/^[・·•\s]+/, "").replace(/\s{2,}/g, " ").trim();
const introSet = new Set((introLines ?? []).map(normLine));
const uniqueHighlights = highlights.filter(h => !introSet.has(normLine(h)));

// ============ SEO + JSON-LD ============
// 尾斜線：Cloudflare Pages 會 308 到帶尾斜線的網址，canonical / Offer.url / breadcrumb 都要一致
const canonicalURL = new URL(`/properties/${property.id}/`, Astro.site).href;

// description: 優先 frontmatter description，沒有則組合基本資訊
// smartTruncate: 在 max chars 內找最後一個中文句末標點 (。！？) 切斷，避免斷句中間
function smartTruncate(s: string, max: number): string {
  if (s.length <= max) return s;
  const head = s.slice(0, max);
  // 嘗試在 max 範圍找最後一個句末標點
  const cutPoints = [...head.matchAll(/[。！？\?\!\.]/g)];
  if (cutPoints.length > 0) {
    const last = cutPoints[cutPoints.length - 1];
    // 句末標點位置 >= max*0.6 才採用，否則太短
    if (last.index !== undefined && last.index >= max * 0.6) {
      return head.slice(0, last.index + 1);
    }
  }
  // fallback: 找逗號 / 全形空白 / 換行
  const softCut = [...head.matchAll(/[，、,;\s]/g)];
  if (softCut.length > 0) {
    const last = softCut[softCut.length - 1];
    if (last.index !== undefined && last.index >= max * 0.7) {
      return head.slice(0, last.index) + "…";
    }
  }
  return head + "…";
}

// ── SEO 標題與描述（2026-08-28 重寫、2026-09-06 改用共用清洗、2026-10-03 改公式）──
// 2026-10-03（稽核 F040）：買方搜的「區＋社區＋格局＋總價」以前放在最後，常超過 30 字被 SERP
// 截掉；非住宅印「—」、億級印成「45000萬」。改成事實段（lead）放前面、案名段（tail）放後面：
//   lead ＝ 行政區 社區名（不能用就路段） N房（抓不到就坪數） 總價（億級寫 X.X億）
//   tail ＝ 清過的案名以「｜」切段，丟掉跟 lead 重複的整段
// 總長超過 32 字從 tail 尾端整段丟（只在「｜」「，」邊界切），lead 永遠不截。
// H1 不動；物件頁不掛站名後綴 —— 後綴要 19 個字，會把買方搜的詞擠出 SERP 可見範圍。
const SEO_TITLE_MAX = 32;
const charLen = (s: string) => [...s].length;
const areaNum = Number(property.data.area);
const hasArea = Number.isFinite(areaNum) && areaNum > 0;
const layoutText = (property.data.layout ?? "").trim();
const layoutKnown = layoutText !== "" && layoutText !== "—";
const roomMatch = layoutText.match(/(\d+)\s*房/);
const roomText = roomMatch ? `${roomMatch[1]}房` : "";
// 格局抓不到「N房」（「—」、空白、土地）時改放坪數；不用 propertyType（1211236 類型是電梯大樓、實際是商場）
const roomSlot = roomText || (hasArea ? `${Math.round(areaNum)}坪` : "");
const totalPrice = property.data.totalPrice;
// ⚠️ 不要在模板字串的 ${} 裡寫除號（例 `${(totalPrice / 10000)…}`）：Astro 編譯器會把 / 當成正規式開頭，
//    前置區塊判讀錯亂、getStaticPaths 被留在元件內，build 直接失敗（2026-10-03 踩過）。
const priceYi = Number((totalPrice * 0.0001).toFixed(2));
const priceShort = !totalPrice
  ? ""
  : totalPrice >= 10000
    ? String(priceYi) + "億"
    : String(totalPrice) + "萬";
const seoLead = [
  property.data.district,
  publicCommunity || streetAreaClean,
  roomSlot,
  priceShort,
]
  .filter(Boolean)
  .join(" ");

// tail：案名段落裡「整段都是 lead 已經講過的字」（行政區／社區名／格局／N房）就丟掉，
// 修掉 HG0212841 那種「南投中寮區3房2廳3衛」整段跟事實段重複
const leadFacts = [
  property.data.district,
  property.data.community?.trim() ?? "",
  publicCommunity,
  layoutText,
  roomText,
].filter(s => s && s !== "—");
const isCoveredByLead = (seg: string) => {
  let rest = seg;
  for (const f of [...leadFacts].sort((a, b) => b.length - a.length)) {
    rest = rest.split(f).join("");
  }
  return rest.replace(/[\s、，,・·\-—–]/g, "") === "";
};
let tailSegs = displayTitle
  .split("｜")
  .map(seg => seg.trim())
  .filter(seg => seg && !isCoveredByLead(seg));
const joinTitle = (segs: string[]) => [seoLead, ...segs].join("｜");
while (charLen(joinTitle(tailSegs)) > SEO_TITLE_MAX && tailSegs.length > 1) {
  tailSegs = tailSegs.slice(0, -1);
}
if (charLen(joinTitle(tailSegs)) > SEO_TITLE_MAX && tailSegs.length === 1) {
  // 只剩一段還太長：在「，」邊界往前收；收不進來就留 lead＋第一段，讓 Google 自己加「…」
  let seg = tailSegs[0];
  while (charLen(joinTitle([seg])) > SEO_TITLE_MAX && /[，,]/.test(seg)) {
    seg = seg.replace(/[，,][^，,]*$/, "").trim();
  }
  tailSegs = seg ? [seg] : tailSegs;
}
const seoTitle = joinTitle(tailSegs);

// 描述：先給事實，再接乾淨的賣點（去 emoji、去誇大句、去第三人聯絡、門牌砍到路段）
// 2026-10-03（稽核 F101）：只剩小標題（「物件亮點 :」）、只剩數字（「1」）、不到 8 字的殘段一律丟掉
const isJunkBlurb = (s: string) =>
  /^[^。！？]{0,20}[:：]\s*$/.test(s) || /^\d{1,3}\.?$/.test(s) || charLen(s) < 8;
let cleanBlurb = sanitizeCopy(property.data.description || "", property.data.district)
  .replace(/\n+/g, " ")
  .replace(/\s{2,}/g, " ")
  .replace(/^[\s，、。!！?？]+/, "")
  .trim();
if (isJunkBlurb(cleanBlurb)) cleanBlurb = "";
// 太短（< 40 字，例 1195641 線上只有 42 字的描述）改用物件介紹前幾行接到約 120 字
if (charLen(cleanBlurb) < 40 && introLines && introLines.length > 0) {
  let acc = "";
  for (const raw of introLines) {
    const line = normLine(raw.replace(/^#+\s*/, "").replace(/^[-*]\s+/, ""));
    if (!line || isJunkBlurb(line)) continue;
    acc = acc ? (/[。！？!?]$/.test(acc) ? acc + line : `${acc}。${line}`) : line;
    if (charLen(acc) >= 120) break;
  }
  if (charLen(acc) > charLen(cleanBlurb)) cleanBlurb = acc;
}

// 事實句（稽核 F101／F128）：補樓層、屋齡、社區名，同建案多戶的描述才不會逐字相同
const factSentence = [
  // 位置用去掉行政區前綴、砍過地號／巷弄的路段
  streetAreaClean
    ? `${property.data.district}・${streetAreaClean}`
    : property.data.district,
  publicCommunity && publicCommunity !== displayTitle ? publicCommunity : "",
  layoutKnown ? layoutText : "",
  property.data.floor ?? "",
  hasArea ? `${areaNum}坪` : "",
  property.data.age !== undefined ? `屋齡${property.data.age}年` : "",
  totalPrice ? `總價 ${formatPrice(totalPrice)}` : "",
]
  .filter(Boolean)
  .join("，");

const seoDescription = smartTruncate(
  [factSentence, cleanBlurb].filter(Boolean).join("。").replace(/。。+/g, "。"),
  160
);

// ogImage: 用物件首圖（絕對路徑），fallback 到全站 default OG
const coverImageSrc = property.data.coverImage
  ? typeof property.data.coverImage === "string"
    ? property.data.coverImage
    : property.data.coverImage.src
  : property.data.photos[0] ?? null;
const ogImagePath = coverImageSrc
  ? new URL(coverImageSrc, Astro.site).href
  : new URL(resolveDefaultOgImagePath(config), Astro.site).href;

// 從 layout 抓房數（給 numberOfRooms）
const roomsMatch = property.data.layout?.match(/(\d+)\s*房/);
const numberOfRooms = roomsMatch ? parseInt(roomsMatch[1], 10) : undefined;

// 把「萬」轉成「元」(Google offers 用 TWD 標準幣別單位)
const priceInNTD = property.data.totalPrice * 10000;

// priceValidUntil 已拿掉（2026-10-03，稽核 X006）：以前是 build 當天＋90 天，網站拿不出
// 可信的價格有效期限，與其每次 build 都假裝「再 90 天有效」不如不輸出（非必填）。
// 改在頁面價格下方印「資料更新日」，JSON-LD 輸出 dateModified。

// 物件類型 → schema.org 的「about」型別（2026-10-03，稽核 F080／X007 改成依優先序判斷）。
// 以前把類型、案名、格局串在一起比對，「台中清水農地套房價…」這種案名的「套房」會把
// 土地判成 Apartment；33 筆沒有「類型」行的 HG/UA 物件（含 1500 坪農地）全部預設 Apartment。
// 廠房／店面以前標 LocalBusiness，會被當成一家營業中的商家（可能餵進 Maps），維持 Place。
const NON_RESIDENTIAL_TITLE_RE = /農地|建地|土地|林地|農舍|車位|停車|店面|廠房|商辦/;
// 路段欄位是地段名（「先驅段」，不是「XX路二段」）＝用地段定位的農地／農舍（只在沒有類型時採用）
const streetIsLandSection = (() => {
  const street = streetAreaClean || "";
  return Boolean(street) && !/[路街道巷]/.test(street) && /[^一二三四五六七八九十]段$/.test(street);
})();
function getSchemaType(): string {
  // 1. 有「類型」行就只看它
  if (propertyType) {
    if (/透天|別墅/.test(propertyType)) return "SingleFamilyResidence";
    if (/電梯大樓|大樓|華廈|公寓|套房/.test(propertyType)) return "Apartment";
    return "Place"; // 土地、店面、廠房、農舍…
  }
  // 2. 沒有類型：格局寫「土地」或「—」（非住宅）
  if (layoutText === "土地" || layoutText === "—") return "Place";
  // 3. 只看原始案名的非住宅字（不看描述、不用面積門檻）。
  //    格局有「N房」時不看「車位／停車」：「北屯三房柱邊車位」「兩房有車位」是附車位的住宅，
  //    不是車位物件（2026-10-04 修，UG1139951／UG1172042 以前被判成 Place）
  const titleForNonRes = roomMatch ? rawTitle.replace(/車位|停車/g, "") : rawTitle;
  if (NON_RESIDENTIAL_TITLE_RE.test(titleForNonRes)) return "Place";
  // 4. 路段欄位是地段名（「先驅段」「高西段」，不是「XX路二段」）：用地段定位的是農地／農舍，
  //    不是公寓大樓（HG0212841 先驅段 1500 坪農地＋農舍就是這種）
  if (streetIsLandSection) return "Place";
  if (/透天|別墅/.test(rawTitle)) return "SingleFamilyResidence";
  // 5. 最後才預設大樓／華廈
  return "Apartment";
}
const schemaType = getSchemaType();
// 土地物件：「權狀坪數」其實是土地坪數（JSON-LD 與事實句改名）
const isLand =
  schemaType === "Place" &&
  (propertyType
    ? /土地|農地|建地|林地/.test(propertyType)
    : layoutText === "土地" || /農地|建地|土地|林地/.test(rawTitle));

// 住宅型才顯示月付試算：土地／店面／廠房／商辦／農舍的貸款成數與年限依銀行鑑價而定，
// 用 8 成 30 年算出來的數字對買方是錯的（實例：69,990 萬農建地印出「月付約 215.6 萬」）
// 2026-10-04（F130）：沒有類型的土地（例 HG0212841 先驅段農地＋農舍，格局寫「3房2廳3衛」、
// 案名也沒有土地字樣）以前會漏網印出月付 → 再排除 isLand 與「路段是地段名」。
// ⛔ 不要改成直接看 schemaType：附車位住宅、店面以外的判斷各有例外，月付只排除「確定是土地」的。
const RESIDENTIAL_RE = /大樓|華廈|公寓|透天|別墅|套房/;
const NON_RESIDENTIAL_RE = /土地|農地|建地|林地|店面|廠房|商辦|辦公|農舍|倉儲|商場/;
const isResidential =
  !isLand &&
  !(!propertyType && streetIsLandSection) &&
  (propertyType
    ? RESIDENTIAL_RE.test(propertyType)
    : !NON_RESIDENTIAL_RE.test(`${rawTitle} ${property.data.layout || ""}`) &&
      property.data.layout !== "—");

// 圖片 array: 至多 6 張避免 JSON-LD payload 過大
const MAX_SCHEMA_IMAGES = 6;
const schemaImages = property.data.photos.length > 0
  ? property.data.photos
      .slice(0, MAX_SCHEMA_IMAGES)
      .map(p => new URL(p, Astro.site).href)
  : [ogImagePath];

// floorSize 用的坪數：住宅型別才有；主建物優先，沒有就用權狀
const floorPing =
  schemaType !== "Place"
    ? (property.data.indoorArea ?? property.data.area)
    : undefined;

// 主 schema：RealEstateListing（schema.org 有這個型別；不動產不是 Product，
// 標 Product 拿不到 rich result 還可能被當實體商品）。住宅型別放在 about。
// addressRegion 只在 county 為已知縣市時輸出 (避免出現 "其他" 怪詞)
const aboutSchema = {
  "@type": schemaType,
  name: displayTitle,
  address: {
    "@type": "PostalAddress",
    addressLocality: property.data.district,
    ...(thisCounty !== OTHER_COUNTY ? { addressRegion: thisCounty } : {}),
    addressCountry: "TW",
    // 地號／巷弄號碼保險切（本戶只寫到路名）
    ...(stripAddressDetail(property.data.streetArea)
      ? { streetAddress: stripAddressDetail(property.data.streetArea) }
      : {}),
  },
  // floorSize：只有住宅型別輸出（schema.org 的 Place 沒有這個屬性）。用主建物坪數，
  // 沒有 indoorArea 代表主建物＝權狀（apply_utrust.py 只在兩者不同時才寫 indoorArea）。
  // 以前用含公設、含車位的權狀坪數（稽核 X007）。
  ...(floorPing
    ? {
        floorSize: {
          "@type": "QuantitativeValue",
          value: floorPing,
          unitText: "坪",
        },
      }
    : {}),
  ...(numberOfRooms ? { numberOfRooms } : {}),
  // yearBuilt 故意不輸出 — age 是 build-time 快照、跨年會 stale；schema 沒設 yearBuilt 比 stale 好
};

const listingSchema = {
  "@context": "https://schema.org",
  "@type": "RealEstateListing",
  "@id": `${canonicalURL}#listing`,
  url: canonicalURL,
  name: displayTitle,
  description: seoDescription,
  image: schemaImages,
  inLanguage: "zh-TW",
  // 台灣日期（toISOString 是 UTC，8/23 06:36 會被印成 8/22）
  datePosted: twDate(listedAt(property)),
  dateModified: twDate(dataDate),
  about: aboutSchema,
  offers: {
    "@type": "Offer",
    price: priceInNTD,
    priceCurrency: "TWD",
    availability:
      property.data.status === "active"
        ? "https://schema.org/InStock"
        : "https://schema.org/OutOfStock",
    url: canonicalURL,
    // 2026-10-03（稽核 X003／F009）：以前 seller 內嵌「陳景泰 RealEstateAgent」＋ hasCredential
    // ［經紀人 黃永隆…, 營業員 陳景泰…］，等於把經紀人證號掛在景泰名下。改成只用 @id 指回
    // Layout.astro @graph 的 Person（#realestateagent）與公司（#organization）節點，
    // 證照由那兩個節點各自表達。⛔ 不要加 broker（Offer 上不合法）。
    // 頁尾看得到的「經紀人 {brokerLicense}・營業員 {agentLicense}」是法規揭露，照舊保留。
    seller: {
      "@type": "Person",
      "@id": `${config.site.url}#realestateagent`,
      name: "陳景泰",
    },
    offeredBy: { "@id": `${config.site.url}#organization` },
  },
  // 額外屬性（Google 認 additionalProperty）
  additionalProperty: [
    {
      "@type": "PropertyValue",
      name: "格局",
      value: property.data.layout,
    },
    {
      "@type": "PropertyValue",
      name: isLand ? "土地坪數" : `權狀坪數${parkingSuffix}`,
      value: `${property.data.area} 坪`,
    },
    ...(property.data.indoorArea !== undefined
      ? [{ "@type": "PropertyValue", name: "主建物坪數", value: `${property.data.indoorArea} 坪` }]
      : []),
    ...(property.data.age !== undefined
      ? [{ "@type": "PropertyValue", name: "屋齡", value: `${property.data.age} 年` }]
      : []),
    ...(property.data.floor
      ? [{ "@type": "PropertyValue", name: "樓層", value: property.data.floor }]
      : []),
    ...(property.data.parking
      ? [{ "@type": "PropertyValue", name: "車位", value: property.data.parking }]
      : []),
    ...(numberOfRooms
      ? [{ "@type": "PropertyValue", name: "房數", value: numberOfRooms }]
      : []),
  ],
};

// Breadcrumb（item 一律帶尾斜線，跟 canonical 一致）
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "在售物件",
      item: new URL("/properties/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: displayTitle,
      item: canonicalURL,
    },
  ],
};

// 規格卡下方的事實句（稽核 F037）：規格卡的散文版，給 snippet 與 AI 擷取用。
// 只用既有欄位、沒值就省略；不接 areas.ts 的區域文字（帶資料期、貼進同區幾十頁會變樣板又會過期）。
const specAreaNotes = [
  includesParking ? "含車位" : "",
  property.data.indoorArea !== undefined ? `主建物 ${property.data.indoorArea} 坪` : "",
].filter(Boolean);
const specFactText =
  [
    `${property.data.district}${streetAreaClean ? `・${streetAreaClean}` : ""}${
      publicCommunity && publicCommunity !== displayTitle ? `「${publicCommunity}」` : ""
    }`,
    layoutKnown ? layoutText : "",
    hasArea
      ? `${isLand ? "土地" : "權狀"} ${property.data.area} 坪${
          specAreaNotes.length > 0 ? `（${specAreaNotes.join("，")}）` : ""
        }`
      : "",
    property.data.floor ? `樓層 ${property.data.floor}` : "",
    property.data.age !== undefined ? `屋齡 ${property.data.age} 年` : "",
    property.data.parking ? `車位 ${property.data.parking}` : "",
    property.data.pricePerPing
      ? `單價 ${property.data.pricePerPing.toFixed(1)} 萬/坪${parkingSuffix}`
      : "",
    totalPrice ? `總價 ${formatPrice(totalPrice)}` : "",
  ]
    .filter(Boolean)
    .join("，") + "。";
// 月付句只給住宅型（沿用 isResidential）：土地／廠房／店面的成數年限依銀行鑑價，不能套 8 成 30 年
const specLoanText = isResidential
  ? `以貸款 ${loanRatioText}、${loan.years} 年、利率 ${loanRatePct}% 試算，月付約 ${monthlyPaymentText} 萬（參考利率，以銀行核定為準，${loan.asOf} 更新）。`
  : "";

// 底部 CTA bar 的 bottom：cookie 同意橫幅出現時 Analytics.astro 會把橫幅高度寫進
// --consent-h，CTA 就往上讓開；沒橫幅時是 0px。
const ctaBottomStyle = "bottom: calc(0px + var(--consent-h, 0px))";

// 2026-11 改版：標題按詞換行、底部詢問列寫「問這間」、物件介紹先露 6 行（字都還在，按「看完整介紹」展開）
const titleParts = wbrSegments(displayTitle);
const priceText = formatPrice(property.data.totalPrice);
const askSub = `${property.data.district}・${priceText}`;
const askMsg = `你好，我在官網看到「${displayTitle}」（委編 ${fullListingCode}，${priceText}），想約看屋`;
const INTRO_SHOW = introLines && introLines.length > 9 ? 6 : (introLines?.length ?? 0);

// ── 2026-11 極簡改版（樣稿 v3）：以下只給畫面排版用，上面的資料邏輯與 SEO 欄位都沒動 ──
// 大數字價格：把「數字」和「萬／億」分開（單位用小一號的字）；兩段接回去跟 formatPrice 的字一樣
const splitPrice = (price: number): [string, string] => {
  const text = formatPrice(price);
  const unit = text.slice(-1);
  return unit === "萬" || unit === "億" ? [text.slice(0, -1).trim(), unit] : [text, ""];
};
const [priceNum, priceUnit] = splitPrice(property.data.totalPrice);
// 規格（大字數值＋小字標籤）：項目、順序、有沒有值的判斷都跟原本的規格卡一樣
type SpecItem = { k: string; v: string; u: string };
const specItems: SpecItem[] = [
  { k: "格局", v: property.data.layout, u: "" },
  { k: `權狀${parkingSuffix}`, v: String(property.data.area), u: "坪" },
  ...(property.data.indoorArea !== undefined
    ? [{ k: "主建物", v: String(property.data.indoorArea), u: "坪" }]
    : []),
  ...(property.data.floor ? [{ k: "樓層", v: property.data.floor, u: "" }] : []),
  ...(property.data.parking ? [{ k: "車位", v: property.data.parking, u: "" }] : []),
  ...(property.data.age !== undefined ? [{ k: "屋齡", v: String(property.data.age), u: "年" }] : []),
  ...(propertyType ? [{ k: "類型", v: propertyType, u: "" }] : []),
  ...(property.data.pricePerPing
    ? [{ k: `單價${parkingSuffix}`, v: property.data.pricePerPing.toFixed(1), u: "萬/坪" }]
    : []),
];
// 規格的值太長（例「3房2廳2衛2陽台」「坡道平面固定車位」）手機一欄放不下大字，最後一個字會自己掉到下一行：
// 粗估寬度（中文字算 1、英數算 0.56），超過就標 long，CSS 在手機上收小一級
const specIsLong = (v: string) =>
  [...v].reduce((n, ch) => n + (ch.charCodeAt(0) < 0x2e80 ? 0.56 : 1), 0) > 6.4;
// 月付試算可以切的成數、年限：樣稿的選項＋設定檔 loan 的預設值（預設值一定在選項裡）
const payRatios = [...new Set<number>([0.7, 0.8, loan.ratio])].sort((a, b) => a - b);
const payYears = [...new Set<number>([20, 30, 40, loan.years])].sort((a, b) => a - b);
// 「區域指南＋分區列表」那一格的標題（裡面有什麼就寫什麼）
const areaAccTitle =
  area && districtActiveCount > 0
    ? `${property.data.district}行情與其他在售`
    : area
      ? `${property.data.district}行情`
      : `${property.data.district}其他在售`;
// 物件介紹的行如果是「小標｜說明」，把小標另外包一層（深色粗字）；字與順序不變，兩段接回去就是原本那一行
const introSplit = (line: string): [string, string] => {
  const m = line.match(/^([^｜，。：；！？\s]{2,14})(｜.+)$/);
  return m ? [m[1], m[2]] : ["", line];
};
---

<Layout
  title={seoTitle}
  description={seoDescription}
  ogImage={ogImagePath}
  canonicalURL={canonicalURL}
  showFloatingCTA={false}
  lcpImage={photos[0]}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(listingSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(breadcrumbSchema)}
    />
  </Fragment>

  <Header />

  {/* 上方小列（原本電腦版貼在視窗底部的價格列，改到頁首下面）：捲過價格與按鈕才滑出來，
      ax.ts 會加 .on 並切換 inert（收起來時鍵盤 tab 不進去）。標題、位置、價格、三個連結都跟原本一樣；
      手機只顯示名稱與價格（位置與按鈕收起來，底部詢問列已經有 LINE、電話、詢問）。
      外面那層 .ax 只是讓 ax.css／ax.ts 認得它（它在 <main> 外面）。 */}
  <div class="ax pd-top">
    <div class="ln" data-property-sticky inert>
      <b>{displayTitle}</b>
      <span class="loc d-only">
        {property.data.district}
        {streetAreaClean ? `・${streetAreaClean}` : ""}
        ・{property.data.layout} ・{property.data.area} 坪
      </span>
      <span class="tnum">{formatPrice(property.data.totalPrice)}</span>
      <a href="#contact-form-section" class="pill o">詢問</a>
      <a href="tel:+886920118756" class="pill o">撥打</a>
      <a href="/go/line?src=property-sticky" class="pill f">LINE 景泰</a>
    </div>
  </div>

  {/* 底部詢問列（取代原本手機底部三鍵）：LINE 照用 property-bar 代碼、電話、表單錨點；data-property-mobile-cta 給 GA4 */}
  <AskBar
    main="用 LINE 問這間"
    sub={askSub}
    href="/go/line?src=property-bar"
    msg={askMsg}
    formHref="#contact-form-section"
    formLabel="詢問"
    propertyCta
  />

  {
    short && (
      <dialog class="sv-dlg" data-short-dlg aria-label="這間的短影音">
        <div class="sv-dlg-frame" data-short-frame></div>
        <div class="sv-dlg-bar">
          <a href={shortHref}>到影片頁看</a>
          <button type="button" data-short-close>關閉</button>
        </div>
      </dialog>
    )
  }

  <main id="main-content" class="ax pd-main">
    {/* Pagefind：只索引 article；站內搜尋才找得到物件（結果可用「物件」filter 分開） */}
    <article class="pd-wrap" data-gallery data-pagefind-body data-pagefind-filter="type:物件">
      {/* 照片：全部做成左右滑（手機用手指滑；電腦滑鼠滑不動，另外有上一張／下一張圓鈕）。
          每一張都是按鈕，點了開原本的燈箱。第一張是首屏最大圖（eager＋fetchpriority=high，
          Layout 的 lcpImage 預先載入同一張），其餘 lazy；從物件卡點進來時照片會接到第一張（data-house-target）。 */}
      {
        photos.length > 0 ? (
          <section class="gal">
            <div class="car" data-car="gal">
              {photos.map((ph, i) => (
                <figure class="ph" data-house-target={i === 0 ? "" : undefined}>
                  <button type="button" data-collage-index={i}>
                    <img
                      src={ph}
                      alt={photoAlts[i]}
                      width="800"
                      height="600"
                      loading={i === 0 ? "eager" : "lazy"}
                      fetchpriority={i === 0 ? "high" : undefined}
                      decoding={i === 0 ? "sync" : "async"}
                      data-pagefind-meta={i === 0 ? "image[src]" : undefined}
                    />
                    <span class="sr-only" data-pagefind-ignore>點擊放大</span>
                  </button>
                </figure>
              ))}
            </div>
            {short && <a class="sv-pill" href={shortHref} data-short-play={playerUrl(short.videoId, true)}>看影片</a>}
            {/* 上一張／下一張（只有電腦、滑鼠裝置才畫出來；ax-property.ts 有跑起來才打開） */}
            {photos.length > 1 && (
              <div class="pads" data-pagefind-ignore>
                <button type="button" class="pad" data-gal-prev disabled>
                  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
                  <span class="sr-only">上一張</span>
                </button>
                <button type="button" class="pad" data-gal-next>
                  <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                  <span class="sr-only">下一張</span>
                </button>
              </div>
            )}
            {/* 圓點＋第幾張（ax.ts 會跟著滑動更新）。只有一張照片時沒有圓點，只留「1 / 1」（改版前照片角落就有這個數字） */}
            {photos.length > 1 ? (
              <>
                <div class="dots" data-dots="gal" aria-hidden="true"></div>
                <p class="foot">
                  {/* 張數只講一次：前面只報「第幾張」（data-fmt 給 ax.ts 用），總數在後面那句 */}
                  <span data-pagefind-ignore><span class="tnum" data-count="gal" data-fmt="第 {i} 張">第 1 張</span>・</span>共 {photos.length} 張照片，點任一張可以放大
                </p>
              </>
            ) : (
              <p class="foot" data-pagefind-ignore>
                <span class="tnum" data-count="gal">1 / 1</span>
              </p>
            )}
          </section>
        ) : short ? (
          <section class="gal">
            <a class="sv-poster" href={shortHref} data-short-play={playerUrl(short.videoId, true)}>
              <img src={coverSmall(short.videoId, short.cover)} alt={`${displayTitle} 短影音封面`} width="540" height="960" loading="eager" fetchpriority="high" decoding="async" />
              <span class="sv-big" aria-hidden="true"></span>
              <span class="sr-only">播放這間的短影音</span>
            </a>
          </section>
        ) : (
          <section class="gal">
            <div class="ph none">
              <p>📷 照片整理中</p>
              <p>想先看實照／影片？</p>
              <a href="/go/line?src=property" class="pill f">LINE 索取實照</a>
            </div>
          </section>
        )
      }

      <section class="pd">
        {/* 第一眼這一塊捲出畫面後，上方小列才滑出來（ax.ts 看 data-ln-after） */}
        <div class="top" data-ln-after>
          <a href="/properties/" class="crumb" data-pagefind-ignore>
            ← 返回在售物件列表
          </a>

          {/* 委編 / 專任 / 新上架 / 降價：原始碼順序跟改版前同一段（委編 → 專任 → 新上架 → 降價），
              畫面上新上架、降價排前面（CSS order）。寫法照舊，不改判斷 */}
          <p class="lab">
            {fullListingCode && <span class="code">委編 {fullListingCode}</span>}
            {isExclusive && <span class="ex">本店專任</span>}
            {showNewBadge && isNew && <span class="new">新上架</span>}
            {dropPct && <span class="drop">降價 {dropPct}%</span>}
          </p>

          {/* 標題：字與 <wbr> 斷詞照舊，只多包一層 .tseg（每一段到標點為止是一塊；不能叫 .seg，那是 ax.css 的分段切換）——
              放得下就整段不拆、標點不會跑到行首；一段比一行還長時只在那一段裡平均換行，不會剩一兩個字自己一行 */}
          <h1 class="kw" data-pagefind-meta="title">
            {titleParts.map((part, i) => (i < titleParts.length - 1 ? <><span class="tseg">{part}</span><wbr /></> : <span class="tseg">{part}</span>))}
          </h1>

          <p class="where">
            {property.data.district}
            {streetAreaClean ? `・${streetAreaClean}` : ""}
            {communityName && "・"}
            {
              communityName && communityHref ? (
                <a href={communityHref}>{communityName}</a>
              ) : (
                communityName
              )
            }
          </p>

          {/* 大數字價格；舊價（刪除線）與單價那句緊接在後面，跟改版前是同一段字 */}
          <p class="pr">
            <b class="tnum">{priceNum}<small>{priceUnit}</small></b>
            {
              dropPct && property.data.lastPrice && (
                <s class="tnum">{formatPrice(property.data.lastPrice)}</s>
              )
            }
          </p>
          {
            property.data.pricePerPing && (
              <p class="per">
                單價{parkingSuffix} {property.data.pricePerPing.toFixed(1)} 萬/坪
              </p>
            )
          }

          <div class="cta" data-pagefind-ignore>
            <a href="/go/line?src=property" class="pill f">用 LINE 問這間</a>
            <a href="#contact-form-section" class="pill o">詢問</a>
          </div>

          {/* 資料日期（稽核 X006）：用「資料更新日」不寫「核對日」——目前沒有每晚比價 */}
          <p class="foot">{priceChecked ? `價格核對日 ${priceChecked}` : `資料更新日 ${twDate(dataDate)}`}・價格、格局與屋況以委託契約及現場說明為準</p>

          {/* 月付那一句（住宅型才有試算；參數在 src/config.ts 的 loan）。成數、年限、利率都寫在同一句，數字不單獨露出 */}
          {
            isResidential ? (
              <p class="foot">
                {loanRatioText} {loan.years} 年・利率 {loanRatePct}% 試算 → 月付約 {monthlyPaymentText} 萬
                <span>（{loan.note}，{loan.asOf} 更新）</span>
                <a href="/tools/">試算工具 →</a>
              </p>
            ) : (
              <p class="foot">
                這類物件的貸款成數與年限依銀行鑑價而定，要試算月付
                <a href="/go/line?src=property">LINE 問景泰 →</a>
              </p>
            )
          }
        </div>

        {/* 規格：格局 / 權狀 / 主建物 / 樓層 / 車位 / 屋齡 / 類型 / 單價（大字數值＋小字標籤）。
            原始碼裡標籤在前、數值在後（跟改版前一樣），畫面上標籤排在數值下面（ax.css 的 order） */}
        <dl class="spec">
          {specItems.map((s, i) => (
            <div data-r="rise" style={`--i:${i % 2}`}>
              <dt>{s.k}</dt>
              <dd class:list={["tnum", { long: specIsLong(s.v) }]}>{s.v}{s.u && <small>{s.u}</small>}</dd>
            </div>
          ))}
        </dl>
        {
          includesParking && (
            <p class="foot">
              單價＝總價÷權狀坪數（含車位），車位坪數與價格未拆分，以不動產說明書為準。
            </p>
          )
        }

        {/* 物件介紹抽不到（內文格式跑掉）才會走這裡：整段內文照放，下方行內程式會把跟規格重複的段落拿掉 */}
        {
          !introLines && (
            <div
              class="app-prose max-w-app prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg) mt-8"
              data-property-content
            >
              <Content />
            </div>
          )
        }

        {/* 其餘的字收進「＋」，點了才展開（字都在原始碼裡）。ax.ts 負責順順展開；沒有 JavaScript 就是瀏覽器原生的開合。
            原本是 H2 的標題（物件介紹、物件亮點、社區文）照樣是 H2，放在 summary 裡 */}
        <div class="acc">
          {
            introLines && introLines.length > 0 && (
              <details open data-property-intro>
                <summary>
                  <h2>物件介紹</h2>
                  <span class="plus"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                </summary>
                <div class="in">
                  <div>
                    <div class="intro">
                      {introLines.slice(0, INTRO_SHOW).map(line => {
                        const [lead, rest] = introSplit(line);
                        return <p>{lead && <b>{lead}</b>}{rest}</p>;
                      })}
                    </div>
                    {introLines.length > INTRO_SHOW && (
                      <details class="fold">
                        <summary>
                          看完整介紹
                          <span class="plus"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                        </summary>
                        <div class="in">
                          <div class="intro rest">
                            {introLines.slice(INTRO_SHOW).map(line => {
                              const [lead, rest] = introSplit(line);
                              return <p>{lead && <b>{lead}</b>}{rest}</p>;
                            })}
                          </div>
                        </div>
                      </details>
                    )}
                  </div>
                </div>
              </details>
            )
          }

          {
            uniqueHighlights.length > 0 && (
              <details>
                <summary>
                  <h2>物件亮點</h2>
                  <span class="plus"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                </summary>
                <div class="in">
                  <div>
                    <ul class="hl">
                      {uniqueHighlights.map(h => (
                        <li>{h}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </details>
            )
          }

          {/* 月付試算（住宅型才有）：可以切成數、年限，ax.ts 用同一條本息平均攤還公式重算 data-pay-out 的數字 */}
          {
            isResidential && (
              <details
                data-pay
                data-price={property.data.totalPrice}
                data-rate={loanRatePct}
                data-ratio={loan.ratio}
                data-years={loan.years}
                data-pagefind-ignore
              >
                <summary>
                  月付試算
                  <em>約 <span class="tnum" data-pay-out>{monthlyPaymentText}</span> 萬</em>
                  <span class="plus"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                </summary>
                <div class="in">
                  <div>
                    <p class="pay-big">月付約 <b class="tnum" data-pay-out>{monthlyPaymentText}</b> 萬</p>
                    <p class="seg-l">貸款成數</p>
                    <div class="seg" data-k="ratio" style={`--n:${payRatios.length};--i:${payRatios.indexOf(loan.ratio)}`}>
                      <i></i>
                      {payRatios.map(v => (
                        <button type="button" data-v={v} aria-pressed={v === loan.ratio ? "true" : "false"}>{Math.round(v * 10)} 成</button>
                      ))}
                    </div>
                    <p class="seg-l">年限</p>
                    <div class="seg" data-k="years" style={`--n:${payYears.length};--i:${payYears.indexOf(loan.years)}`}>
                      <i></i>
                      {payYears.map(v => (
                        <button type="button" data-v={v} aria-pressed={v === loan.years ? "true" : "false"}>{v} 年</button>
                      ))}
                    </div>
                    <p class="foot">利率 {loanRatePct}% 試算（{loan.note}，{loan.asOf} 更新）</p>
                  </div>
                </div>
              </details>
            )
          }

          {/* 規格的散文版（稽核 F037）：只用既有欄位，給 snippet 與 AI 擷取 */}
          <details>
            <summary data-pagefind-ignore>
              詳細資料
              <span class="plus"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
            </summary>
            <div class="in">
              <p data-property-facts>
                {specFactText}
                {specLoanText && <span> {specLoanText}</span>}
              </p>
            </div>
          </details>

          {/* 社區深度文 + 區域頁 + 分區列表：物件頁的內容出口（沒有的那一格就不出現） */}
          {
            communityPosts.length > 0 && (
              <details data-pagefind-ignore>
                <summary>
                  <h2>
                    {communityName} 評價／實價登錄整理
                  </h2>
                  <span class="plus"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                </summary>
                <div class="in">
                  <div>
                    <p>
                      看這戶之前，先看這個社區的實價登錄、優缺點、適合誰。
                      {includesParking && "社區中位數為扣車位口徑，與本戶含車位單價計算方式不同。"}
                    </p>
                    <ul class="posts">
                      {communityPosts.slice(0, 3).map(post => (
                        <li>
                          <a
                            href={`/posts/${post.id}/`}
                            data-track="post"
                            data-post-id={post.id}
                          >
                            <span>
                              {post.data.title} →
                            </span>
                            <span class="d">
                              {post.data.description}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </details>
            )
          }
          {
            (area || districtActiveCount > 0) && (
              <details data-pagefind-ignore>
                <summary>
                  {areaAccTitle}
                  <span class="plus"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
                </summary>
                <div class="in">
                  <div class="go">
                    {area && (
                      <p>
                        想先看{area.shortName}整體行情、哪些人適合買？
                        <a href={`/areas/${area.slug}/`} class="more">
                          {area.shortName}買房指南 →
                        </a>
                      </p>
                    )}
                    {districtActiveCount > 0 && (
                      <p>
                        <a href={districtListUrl} class="more">
                          看{property.data.district}全部 {districtActiveCount + 1} 筆在售 →
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              </details>
            )
          }

          {/* 主表單 — 預填物件編號 + 標題。id 給「詢問」的錨點用：底部詢問列、上方小列、標題下的按鈕點了，
              ax.ts 會先把這一格打開再捲過來。表單把 23 個行政區、預算選項全印在頁上，不能進 Pagefind 索引 */}
          <details id="contact-form-section" data-pagefind-ignore>
            <summary>
              詢問
              <span class="plus"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></span>
            </summary>
            <div class="in">
              <div class="form">
                <ContactForm
                  propertyId={property.data.listingCode}
                  propertyTitle={displayTitle}
                  defaultIntent="buy"
                  title="想看這戶？留你的聯絡方式"
                  subtitle="物件編號已幫你預填、補完聯絡方式就送出。30 分鐘內回。"
                />
              </div>
            </div>
          </details>
        </div>

        {/* 快速 LINE / 電話通道 — 給急的人。公司與證號是法規揭露，不收合。
            data-hide-ask：這顆實心 LINE 鈕在畫面上時，底部詢問列先讓位（跟改版前一樣，flora.ts），證號那一行不會被蓋住 */}
        <div class="quick" data-pagefind-ignore>
          <p>
            想直接聊、不想填表單？
          </p>
          <div class="cta">
            <a href="/go/line?src=property-bottom" class="pill f" data-hide-ask>
              LINE sky811117
            </a>
            <a href="tel:+886920118756" class="pill o">
              0920-118-756
            </a>
          </div>
          <p class="foot">
            一品不動產 有巢氏房屋 台中世界之心加盟店<br />
            經紀人 {property.data.brokerLicense}
            ・ 營業員 {property.data.agentLicense}
          </p>
        </div>
      </section>

      {/* Lightbox 全螢幕瀏覽 */}
      {
        property.data.photos.length > 0 && (
          <dialog
            data-gallery-lightbox
            class="m-0 h-full max-h-none w-full max-w-none border-0 bg-black/95 p-0 backdrop:bg-black/80"
          >
            {/* 2026-08-26：原本硬寫 width=1600 height=1200。max-h/max-w 是上限
                不是固定值，1024px 的來源會被硬撐到 1600px 顯示（放大 1.56 倍→糊）。
                公司前台物件的圖源 CDN 只給 1024px，重抓也拿不到更大的，正解是不要撐。
                拿掉後依原生尺寸顯示；這是全螢幕 flex 置中的 lightbox，沒有 CLS 問題。 */}
            <div class="relative flex h-screen w-screen items-center justify-center">
              <img
                data-gallery-lightbox-img
                src={property.data.photos[0]}
                alt={photoAlts[0]}
                loading="lazy"
                decoding="async"
                class="max-h-[92vh] max-w-[96vw] object-contain"
              />

              <button
                type="button"
                data-gallery-close
                aria-label="關閉"
                class="absolute top-3 right-3 flex h-10 w-10 items-center justify-center rounded-full bg-white/15 text-2xl text-white transition-colors hover:bg-white/30 sm:top-4 sm:right-4 sm:h-12 sm:w-12"
              >
                ✕
              </button>

              {property.data.photos.length > 1 && (
                <>
                  <button
                    type="button"
                    data-gallery-prev
                    aria-label="上一張"
                    class="absolute left-2 top-1/2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-3xl text-white transition-colors hover:bg-white/30 sm:left-6 sm:h-14 sm:w-14"
                  >
                    ‹
                  </button>
                  <button
                    type="button"
                    data-gallery-next
                    aria-label="下一張"
                    class="absolute right-2 top-1/2 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-white/15 text-3xl text-white transition-colors hover:bg-white/30 sm:right-6 sm:h-14 sm:w-14"
                  >
                    ›
                  </button>
                  <span
                    data-gallery-lightbox-counter
                    class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-black/60 px-4 py-1.5 font-mono text-sm text-white"
                  >
                    1 / {property.data.photos.length}
                  </span>
                </>
              )}
            </div>
          </dialog>
        )
      }
    </article>

    {/* 同社區其他在售 → 同縣市其他物件（同一套卡片，先社區後縣市）：灰底區塊＋橫向卡片（手機左右滑、電腦一排三張）。
        卡片留著 data-house-link：點了照片會接到下一頁的第一張；底部詢問列不跟這些卡 */}
    {
      relatedSections.length > 0 && (
        <div class="tiles">
          {relatedSections.map(section => (
            <section class="tile pb" data-pagefind-ignore data-related={section.key}>
              <h2 class="h2" data-r="rise">
                {section.heading}
                <span class="cnt">
                  ({section.count} {section.countLabel})
                </span>
              </h2>
              {section.moreHref && (
                <p class="cta" data-r="rise">
                  <a href={section.moreHref} class="pill f">
                    {section.moreText}
                  </a>
                </p>
              )}
              <ul class="car" data-car={`rel-${section.key}`} data-r="rise">
                {section.list.map(p => {
                  const cardTitle = cleanPropertyTitle(
                    p.data.title,
                    [p.data.community?.trim() || p.data.district, p.data.layout]
                      .filter(Boolean)
                      .join(" "),
                    p.data.district
                  );
                  const [cardNum, cardUnit] = splitPrice(p.data.totalPrice);
                  return (
                    <li class="card" data-house-link>
                      <a
                        href={`/properties/${p.id}/`}
                        data-track="property"
                        data-property-id={p.id}
                        data-property-title={cardTitle}
                        data-property-price={p.data.totalPrice}
                        data-property-district={p.data.district}
                      >
                        {p.data.coverImage ? (
                          <figure>
                            {/* 相關卡用 400×300 縮圖（F027）；縮圖不在就退回原圖（coverThumb 保底） */}
                            <img
                              src={coverThumb(coverSrcOf(p.data.coverImage) ?? "", 400)}
                              srcset={coverSrcset(coverSrcOf(p.data.coverImage) ?? "")}
                              sizes={
                                coverSrcset(coverSrcOf(p.data.coverImage) ?? "")
                                  ? "(min-width: 735px) 330px, 70vw"
                                  : undefined
                              }
                              alt=""
                              width="400"
                              height="300"
                              loading="lazy"
                              decoding="async"
                            />
                          </figure>
                        ) : (
                          <figure class="none">
                            <p>📷 照片整理中</p>
                          </figure>
                        )}
                        {/* price-first：價格在上、標題在下 */}
                        <div class="b">
                          <p class="p tnum">{cardNum}<small>{cardUnit}</small><em>{p.data.district}</em></p>
                          <h3 class="t">{cardTitle}</h3>
                          <p class="d">{p.data.layout} · {p.data.area} 坪</p>
                        </div>
                      </a>
                    </li>
                  );
                })}
              </ul>
              <div class="dots" data-dots={`rel-${section.key}`} aria-hidden="true"></div>
            </section>
          ))}
        </div>
      )
    }
  </main>

  <Footer />
</Layout>

<script is:inline>
  // 短影音入口：點了才放播放器；沒有 JavaScript 時就是連到單支影片頁的一般連結
  (function () {
    var dlg = document.querySelector("[data-short-dlg]");
    if (!dlg || !dlg.showModal) return;
    var frame = dlg.querySelector("[data-short-frame]");
    document.querySelectorAll("[data-short-play]").forEach(function (a) {
      a.addEventListener("click", function (e) {
        e.preventDefault();
        var f = document.createElement("iframe");
        f.src = a.getAttribute("data-short-play");
        f.title = "這間的短影音";
        f.allow = "autoplay; encrypted-media; picture-in-picture; web-share";
        f.referrerPolicy = "strict-origin-when-cross-origin";
        f.allowFullscreen = true;
        frame.replaceChildren(f);
        dlg.showModal();
      });
    });
    dlg.addEventListener("close", function () { frame.replaceChildren(); });
    dlg.querySelector("[data-short-close]").addEventListener("click", function () { dlg.close(); });
    dlg.addEventListener("click", function (e) { if (e.target === dlg) dlg.close(); });
  })();
</script>

<script
  is:inline
  define:vars={{
    photos: property.data.photos,
    alts: photoAlts,
    total: property.data.photos.length,
  }}
>
  (function () {
    if (!photos || photos.length === 0) return;

    const gallery = document.querySelector("[data-gallery]");
    if (!gallery) return;

    const mainImg = gallery.querySelector("[data-gallery-main]");
    const mainBtn = gallery.querySelector("[data-gallery-main-btn]");
    const counter = gallery.querySelector("[data-gallery-counter]");
    const thumbBtns = gallery.querySelectorAll("[data-gallery-index]");

    const dialog = document.querySelector("[data-gallery-lightbox]");
    const lbImg = dialog && dialog.querySelector("[data-gallery-lightbox-img]");
    const lbCounter = dialog && dialog.querySelector("[data-gallery-lightbox-counter]");
    const closeBtn = dialog && dialog.querySelector("[data-gallery-close]");
    const prevBtn = dialog && dialog.querySelector("[data-gallery-prev]");
    const nextBtn = dialog && dialog.querySelector("[data-gallery-next]");

    let current = 0;

    function setIndex(i) {
      current = ((i % total) + total) % total;
      const src = photos[current];
      // alt 由 build-time 的 photoAlts 傳進來，切圖時才不會把舊的「標題（第 N 張）」寫回去
      const label = alts[current] || "";
      if (mainImg) {
        mainImg.src = src;
        mainImg.alt = label;
      }
      if (counter) counter.textContent = `${current + 1} / ${total}`;
      if (lbImg) {
        lbImg.src = src;
        lbImg.alt = label;
      }
      if (lbCounter) lbCounter.textContent = `${current + 1} / ${total}`;
      thumbBtns.forEach((b, idx) => {
        const active = idx === current;
        b.classList.toggle("border-accent", active);
        b.classList.toggle("opacity-100", active);
        b.classList.toggle("border-transparent", !active);
        b.classList.toggle("opacity-60", !active);
      });
      // scroll thumb into view
      const activeThumb = thumbBtns[current];
      if (activeThumb && activeThumb.scrollIntoView) {
        activeThumb.scrollIntoView({
          behavior: "smooth",
          block: "nearest",
          inline: "center",
        });
      }
    }

    function openLightbox() {
      if (!dialog) return;
      if (typeof dialog.showModal === "function") {
        dialog.showModal();
      } else {
        dialog.setAttribute("open", "");
      }
      document.body.style.overflow = "hidden";
    }

    function closeLightbox() {
      if (!dialog) return;
      if (typeof dialog.close === "function") {
        dialog.close();
      } else {
        dialog.removeAttribute("open");
      }
      document.body.style.overflow = "";
    }

    if (mainBtn) mainBtn.addEventListener("click", openLightbox);
    thumbBtns.forEach(b => {
      b.addEventListener("click", () => {
        const i = parseInt(b.dataset.galleryIndex || "0", 10);
        setIndex(i);
      });
    });

    // 桌面 collage：點任一格 → 跳到該張並開 lightbox（沿用既有邏輯）
    gallery.querySelectorAll("[data-collage-index]").forEach(b => {
      b.addEventListener("click", () => {
        setIndex(parseInt(b.dataset.collageIndex || "0", 10));
        openLightbox();
      });
    });
    if (closeBtn) closeBtn.addEventListener("click", closeLightbox);
    if (prevBtn) prevBtn.addEventListener("click", () => setIndex(current - 1));
    if (nextBtn) nextBtn.addEventListener("click", () => setIndex(current + 1));

    // 點 backdrop 關閉
    if (dialog) {
      dialog.addEventListener("click", e => {
        if (e.target === dialog) closeLightbox();
      });
      dialog.addEventListener("close", () => {
        document.body.style.overflow = "";
      });
    }

    // 鍵盤導覽（lightbox 開啟時）
    document.addEventListener("keydown", e => {
      if (!dialog || !dialog.open) return;
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        setIndex(current - 1);
      } else if (e.key === "ArrowRight") {
        e.preventDefault();
        setIndex(current + 1);
      }
    });
  })();
</script>

{/* 2026-11 極簡改版：原本這裡控制電腦版貼底價格列（data-property-sticky）的行內程式拿掉了——
    那一列改成頁首下面的小列（.ln），什麼時候滑出來由 ax.ts 的觀察器負責（看 data-ln-after），不要兩套同時跑。 */}
<script>
  // 共用互動（收合區順順展開、點錨點先打開收合區、橫向卡片圓點與第幾張、上方小列、月付試算）＋物件頁專用（照片的上一張／下一張）
  import "@/scripts/ax";
  import "@/scripts/ax-property";
</script>

<script is:inline>
  // 內文去重（只在 <Content /> fallback 路徑會有東西可刪）：markdown body 由
  // properties-sync 批次產出，固定帶「## 物件規格」bullet 段落（與上方規格卡重複）
  // +「> 委編：…」blockquote（已改成標題下 badge）。
  // .md 內容不能動（sync 會整批覆寫），改在 client 端把這兩段從渲染移除；
  // 無 JS 時 fallback 維持完整內文，資訊不會缺。
  (function () {
    const prose = document.querySelector("[data-property-content]");
    if (!prose) return;
    prose.querySelectorAll("h2").forEach(h => {
      if ((h.textContent || "").trim() !== "物件規格") return;
      let node = h.nextElementSibling;
      h.remove();
      // 連同其後內容（到下一個標題 / hr 為止）一起移除，證號段落在 hr 後不受影響
      while (node && !/^(H[1-6]|HR)$/.test(node.tagName)) {
        const next = node.nextElementSibling;
        node.remove();
        node = next;
      }
    });
    prose.querySelectorAll("blockquote").forEach(bq => {
      if ((bq.textContent || "").includes("委編：")) bq.remove();
    });
  })();
</script>

<script
  is:inline
  define:vars={{
    quickCode: property.data.listingCode ?? "",
    quickTitle: displayTitle,
  }}
>
  // 表單瘦身（漸進增強）：ContactForm 是全站共用元件不能動，改在本頁把
  // Email / 我想 / 預算 / 區域偏好 收進「進階需求（選填）」<details>，
  // 預設只露 姓名 / 手機 / 訊息；並在表單頂部加 3 顆 quick chips 一鍵覆寫訊息。
  // 無 JS 時 fallback 維持完整表單，功能不會缺。
  (function () {
    const form = document.querySelector("[data-contact-form]");
    if (!form) return;
    const msgInput = form.querySelector("[name='訊息']");
    const msgWrap = msgInput ? msgInput.closest("div") : null;

    // --- 進階需求 <details>：搬 Email / 我想+預算 grid / 區域偏好 ---
    const emailEl = document.getElementById("cf-email");
    const emailWrap = emailEl ? emailEl.closest("div") : null;
    const intentEl = document.getElementById("cf-intent");
    const intentGrid = intentEl ? intentEl.closest(".grid") : null;
    const areaSummary = form.querySelector("[data-area-summary]");
    const areaDetails = areaSummary ? areaSummary.closest("details") : null;
    const areaBlock = areaDetails ? areaDetails.parentElement : null;

    if (msgWrap && (emailWrap || intentGrid || areaBlock)) {
      const adv = document.createElement("details");
      adv.className = "border-border bg-background rounded-md border";
      const summary = document.createElement("summary");
      summary.className =
        "text-muted-foreground cursor-pointer px-4 py-3 text-[15px] select-none";
      summary.textContent = "進階需求（選填）▾";
      const body = document.createElement("div");
      body.className = "space-y-5 p-4 pt-2";
      adv.append(summary, body);
      msgWrap.after(adv);
      [emailWrap, intentGrid, areaBlock].forEach(el => {
        if (el) body.appendChild(el);
      });
    }

    // --- quick chips：點了覆寫訊息（物件編號 hidden 欄位另有預填、不受影響） ---
    if (msgInput) {
      const chips = document.createElement("div");
      chips.className = "flex flex-wrap gap-2";
      ["想約看屋", "想問貸款", "想要實照"].forEach(text => {
        const b = document.createElement("button");
        b.type = "button";
        b.className =
          "border-border bg-background text-foreground hover:border-accent hover:text-accent cursor-pointer rounded-full border px-3 py-1.5 text-sm transition-colors";
        b.textContent = text;
        b.addEventListener("click", () => {
          const ref = quickCode
            ? "物件 " + quickCode + (quickTitle ? "（" + quickTitle + "）" : "")
            : "這個物件";
          msgInput.value = text + "：" + ref;
          msgInput.dispatchEvent(new Event("input", { bubbles: true }));
          msgInput.focus();
        });
        chips.appendChild(b);
      });
      form.insertBefore(chips, form.firstElementChild);
    }
  })();
</script>
