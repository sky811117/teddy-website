---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import IconClock from "@/assets/icons/IconClock.svg";
import IconLine from "@/assets/icons/socials/line.svg";
import { getPostSlug, getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import EditPost from "./_components/EditPost.astro";
import ShareLinks from "./_components/ShareLinks.astro";
import BackButton from "./_components/BackButton.astro";
import BackToTopButton from "./_components/BackToTopButton.astro";
import AdjacentPostNav from "./_components/AdjacentPostNav.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import CommunityListings from "@/components/CommunityListings.astro";
import AuthorBox from "@/components/AuthorBox.astro";
import { normalizeFaqSchema } from "@/utils/faqSchema";
import { ogThumb } from "@/utils/ogThumb";
import Cusdis from "@/components/Cusdis.astro";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map((post, index) => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: {
      post,
      prevPost:
        index > 0
          ? {
              id: sortedPosts[index - 1].id,
              title: sortedPosts[index - 1].data.title,
              filePath: sortedPosts[index - 1].filePath,
            }
          : null,
      nextPost:
        index < sortedPosts.length - 1
          ? {
              id: sortedPosts[index + 1].id,
              title: sortedPosts[index + 1].data.title,
              filePath: sortedPosts[index + 1].filePath,
            }
          : null,
    },
  }));
}

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  post: CollectionEntry<"posts">;
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { post, prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const {
  title,
  description,
  ogImage: initOgImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  tags,
  hideEditPost,
  faqSchema,
} = post.data;

const { Content, headings } = await render(post);

// 文末 CTA 用：文章 slug（給 /go/line?p= 帶進 TG 通知，不再只靠 Referer）
const postSlug = getPostSlug(post.id, post.filePath).replace(/^\/+/, "");
const community = post.data.community?.trim() || "";
// 賣方相關文章（稅務 / 過戶 / 政策 / 賣房）加第二顆「行情評估」鈕
const SELLER_TAG = /賣方|稅務|policy|過戶|賣房/i;
const isSellerTopic = tags.some(tag => SELLER_TAG.test(tag));
const lineHref = `/go/line?src=post-end&p=${encodeURIComponent(postSlug)}`;

// 結構化 FAQ 也要在頁面上看得到（Google 規範：schema 內容必須是使用者可見的內容）。
// 跟 PostLayout 的 FAQPage JSON-LD 同一份 frontmatter、同一個 normalize，可見文字與 schema 自動一致。
const faqs = normalizeFaqSchema(faqSchema)?.mainEntity ?? [];

// 文內目錄 — 只取 h2，數量 ≥ 4 才顯示摺疊 TOC
const tocHeadings = headings.filter(({ depth }) => depth === 2);

let ogImageUrl: string | undefined;

if (typeof initOgImage === "string") {
  ogImageUrl = initOgImage;
} else if (initOgImage?.src) {
  ogImageUrl = initOgImage.src;
}

// 封面圖只用 frontmatter 明確提供的 ogImage（dynamicOgImage 自動生成的不當封面）
const coverImage = ogImageUrl;
// /og/ 底下的封面都是 AI 生成圖（generate_og_local_flux.py），頁面上要標示成示意圖，
// alt 也不能寫社區名（Google 圖片會把 AI 擬真建築當成社區實景秀出去）。
// /og/ 開頭的封面另有 640w／960w webp 縮圖（scripts/generate-og-thumbs.mjs），用 <picture> 給。
const coverIsAi = !!coverImage?.startsWith("/og/");
const coverAlt = coverIsAi ? "台中住宅示意圖（AI 生成，非實景）" : title;

if (!ogImageUrl && config.features.dynamicOgImage) {
  const postUrl = getPostUrl(post.id, post.filePath, locale).replace(
    /\/+$/,
    ""
  );
  ogImageUrl = `${postUrl}/index.png`;
}

const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;

// 計算文章字數 + 預估閱讀時間
// 中文：每字 1 char，1 分鐘 ~ 350 字 (一般中文閱讀速度)
// markdown 語法略去（粗略，純估算）
const rawBody = (post.body ?? "")
  .replace(/```[\s\S]*?```/g, "")        // code block
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")  // image
  .replace(/\[[^\]]*\]\([^)]*\)/g, "")   // link
  .replace(/[#>*_`~|-]/g, "")            // markdown 符號
  .replace(/\s+/g, "");                  // 空白
const wordCount = rawBody.length;
const timeRequiredMin = Math.max(1, Math.round(wordCount / 350));
// ISO 8601 duration: PT5M
const timeRequired = `PT${timeRequiredMin}M`;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  tags={tags}
  wordCount={wordCount}
  timeRequired={timeRequired}
  faqSchema={faqSchema}
>
  <Header />

  <BackButton />

  <main
    id="main-content"
    class:list={["app-layout", { "mt-8": !config.features.showBackButton }]}
    data-pagefind-body
    data-pagefind-filter="type:文章"
  >
    <header>
      {
        tags.length > 0 && (
          <div class="mb-3 flex flex-wrap gap-2">
            {tags.map(tag => (
              <a
                href={getRelativeLocaleUrl(locale, `tags/${slugifyStr(tag)}/`)}
                class="bg-muted text-muted-foreground hover:text-accent rounded-full px-2.5 py-1 text-xs no-underline transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )
      }

      <h1 class="text-accent inline-block text-2xl font-bold sm:text-3xl">
        {title}
      </h1>

      <div class="my-2 flex flex-wrap items-center gap-x-2 gap-y-1">
        <span class="text-muted-foreground text-[14px] sm:text-[15px]">
          作者：<a href="/about/" rel="author" class="hover:text-accent">{post.data.author}</a>（一品不動產 有巢氏房屋 台中世界之心加盟店・營業員）
        </span>
        <span
          aria-hidden="true"
          class="text-muted-foreground hidden sm:inline"
        >
          ·
        </span>
        <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" showPub={true} />
        <span
          aria-hidden="true"
          class="text-muted-foreground hidden sm:inline"
        >
          ·
        </span>
        <span class="text-muted-foreground flex items-center gap-x-1 text-[14px] sm:text-[15px]">
          <IconClock class="inline-block size-4" aria-hidden="true" />
          閱讀時間 {timeRequiredMin} 分鐘
        </span>
        <span class="text-muted-foreground text-[14px] sm:text-[15px]">
          · {wordCount.toLocaleString()} 字
        </span>
        <span
          aria-hidden="true"
          class:list={[
            "text-muted-foreground max-sm:hidden",
            { hidden: !config.features.editPost?.enabled || hideEditPost },
          ]}
        >
          |
        </span>
        <EditPost {hideEditPost} {post} class="max-sm:hidden" />
      </div>

      {
        coverImage && (
          <figure class="mt-4">
            {coverIsAi ? (
              <picture>
                <source
                  type="image/webp"
                  srcset={`${ogThumb(coverImage, 640)} 640w, ${ogThumb(coverImage, 960)} 960w`}
                  sizes="(min-width: 768px) 736px, calc(100vw - 32px)"
                />
                <img
                  src={coverImage}
                  alt={coverAlt}
                  width="800"
                  height="450"
                  class="rounded-card aspect-[16/9] w-full object-cover"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </picture>
            ) : (
              <img
                src={coverImage}
                alt={coverAlt}
                width="800"
                height="450"
                class="rounded-card aspect-[16/9] w-full object-cover"
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            )}
            {coverIsAi && (
              <figcaption class="text-muted-foreground mt-1 text-xs">
                示意圖（AI 生成，非本文社區實景）
              </figcaption>
            )}
          </figure>
        )
      }
    </header>

    {
      tocHeadings.length >= 4 && (
        <details class="card-surface mt-8 px-4 py-3" data-toc>
          <summary class="cursor-pointer font-bold select-none">目錄</summary>
          <ul class="mt-2 flex flex-col gap-1.5 text-sm">
            {tocHeadings.map(({ slug, text }) => (
              <li>
                <a
                  href={`#${slug}`}
                  class="text-muted-foreground hover:text-accent no-underline"
                >
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    }

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    {/* 本文作者卡（可見署名，給讀者與 AI 摘要認得出整理者） */}
    <AuthorBox slug={postSlug} />

    {/* 常見問題：frontmatter faqSchema 的可見版（純文字插值，不用 set:html） */}
    {
      faqs.length > 0 && (
        <section id="faq" class="mt-10" data-pagefind-ignore>
          <h2 class="text-xl font-bold sm:text-2xl">常見問題</h2>
          <div class="mt-4 space-y-3">
            {faqs.map(item => (
              <details class="card-surface p-4">
                <summary class="cursor-pointer font-bold">
                  {item.name.replace(/\?\s*/g, "？").trim()}
                </summary>
                <p class="mt-3 leading-relaxed">{item.acceptedAnswer.text}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {/* 社區文章 → 該社區目前的在售物件，放在 CTA 之前：讀者看到「真的有一戶在賣」時旁邊就有動作鈕。
        該社區沒在售 → 同區 3 戶；連區都推不出來或沒在售 → 改放各區買房指南導覽 */}
    <CommunityListings community={post.data.community} tags={post.data.tags} />

    <!-- 文末 LINE CTA — 內文結束、分享列之前。href 帶 p={slug}，/go/line 記得住是哪篇文章 -->
    <div
      class="card-surface mt-10 flex flex-col items-center gap-4 p-6 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <div>
        {
          community ? (
            <>
              <p class="text-lg font-bold">想看 {community} 的實際樓層、行情？</p>
              <p class="text-muted-foreground mt-1">
                LINE 我「{community}」，我把手上的成交、在售資料整理給你
              </p>
            </>
          ) : (
            <>
              <p class="text-lg font-bold">這篇有幫到你？</p>
              <p class="text-muted-foreground mt-1">
                台中買房賣房問題直接 LINE 泰迪
              </p>
            </>
          )
        }
      </div>
      <div class="flex shrink-0 flex-col items-stretch gap-3 sm:items-end">
        <a href={lineHref} target="_blank" rel="noopener" class="btn-line">
          <IconLine class="size-5" aria-hidden="true" />
          {community ? `LINE 我「${community}」` : "LINE 泰迪"}
        </a>
        {
          isSellerTopic && (
            <a
              href="/sell/?src=post-end-sell#sell-form-section"
              class="btn-outline text-center text-[15px] whitespace-normal"
            >
              想知道你的房子現在值多少？留屋況、24 小時內回行情評估區間
            </a>
          )
        }
      </div>
    </div>

    <hr class="my-8 border-dashed" />

    <EditPost class="sm:hidden" {hideEditPost} {post} />

    <BackToTopButton />

    <ShareLinks />

    <hr class="my-8 border-dashed" />

    <RelatedPosts {post} />

    <AdjacentPostNav {prevPost} {nextPost} />

    <Cusdis title={title} pageId={post.id} pageUrl={Astro.url.href} />
  </main>
  <Footer />
</PostLayout>

<script is:inline data-astro-rerun>
  function createProgressBar() {
    const progressContainer = document.createElement("div");
    progressContainer.className =
      "progress-container fixed top-0 z-10 h-1 w-full bg-background";

    const progressBar = document.createElement("div");
    progressBar.className = "progress-bar h-1 w-0 bg-accent";
    progressBar.id = "myBar";

    progressContainer.appendChild(progressBar);
    document.body.appendChild(progressContainer);
  }
  createProgressBar();

  function updateScrollProgress() {
    document.addEventListener("scroll", () => {
      const winScroll =
        document.body.scrollTop || document.documentElement.scrollTop;
      const height =
        document.documentElement.scrollHeight -
        document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      if (document) {
        const myBar = document.getElementById("myBar");
        if (myBar) {
          myBar.style.width = scrolled + "%";
        }
      }
    });
  }
  updateScrollProgress();

  function addHeadingLinks() {
    // 只掛在文章正文內、而且真的有 id 的標題上。原本全頁掃描會把「相關文章」卡片、
    // 在售物件區的 h3 也塞一顆 href="#" 的假錨點，手機上肉眼可見、點了還跳回頁首。
    const headings = Array.from(
      document.querySelectorAll("#article h2[id], #article h3[id], #article h4[id]")
    );
    for (const heading of headings) {
      if (heading.querySelector(".heading-link")) continue;
      heading.classList.add("group");
      const link = document.createElement("a");
      link.className =
        "heading-link ms-2 no-underline opacity-75 md:opacity-0 md:group-hover:opacity-100 md:focus:opacity-100";
      link.href = "#" + heading.id;
      link.setAttribute(
        "aria-label",
        "「" + (heading.textContent || "").trim() + "」段落連結"
      );

      const span = document.createElement("span");
      span.ariaHidden = "true";
      span.innerText = "#";
      link.appendChild(span);
      heading.appendChild(link);
    }
  }
  addHeadingLinks();

  // 目錄：桌機預設展開（手機保留摺疊，避免把首屏推太下面）
  (function openTocOnDesktop() {
    const toc = document.querySelector("[data-toc]");
    if (toc && window.matchMedia("(min-width: 768px)").matches) {
      toc.setAttribute("open", "");
    }
  })();

  function attachCopyButtons() {
    const copyButtonLabel = "複製";
    const codeBlocks = Array.from(document.querySelectorAll("pre"));

    for (const codeBlock of codeBlocks) {
      const wrapper = document.createElement("div");
      wrapper.style.position = "relative";

      const computedStyle = getComputedStyle(codeBlock);
      const hasFileNameOffset =
        computedStyle.getPropertyValue("--file-name-offset").trim() !== "";

      const topClass = hasFileNameOffset
        ? "top-(--file-name-offset)"
        : "-top-3";

      const copyButton = document.createElement("button");
      copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
      copyButton.innerHTML = copyButtonLabel;
      codeBlock.setAttribute("tabindex", "0");
      codeBlock.appendChild(copyButton);

      codeBlock?.parentNode?.insertBefore(wrapper, codeBlock);
      wrapper.appendChild(codeBlock);

      copyButton.addEventListener("click", async () => {
        await copyCode(codeBlock, copyButton);
      });
    }

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText;

      await navigator.clipboard.writeText(text ?? "");

      button.innerText = "已複製";

      setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }
  }
  attachCopyButtons();

  document.addEventListener("astro:after-swap", () =>
    window.scrollTo({ left: 0, top: 0, behavior: "instant" })
  );
</script>
