---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

{/* 2026-11 極簡改版：細線分隔的文字連結（小灰字「上一篇／下一篇」＋黑字標題），長相在 flora-post.css 的 .post-adj */}
<div data-pagefind-ignore class="post-adj">
  {
    prevPost && (
      <a href={getPostUrl(prevPost.id, prevPost.filePath, locale)}>
        <IconArrowLeft class="rtl:rotate-180" />
        <div>
          <span class="post-adj-k">{t.post.previousPost}</span>
          <div class="post-adj-t">{prevPost.title}</div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="post-adj-next"
      >
        <div>
          <span class="post-adj-k">{t.post.nextPost}</span>
          <div class="post-adj-t">{nextPost.title}</div>
        </div>
        <IconArrowRight class="rtl:rotate-180" />
      </a>
    )
  }
</div>
