---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

// 內部估價工具（密碼保護、景泰自用）。
// ⚠ 密碼不在本檔任何地方 —— 使用者「輸入」密碼，由 functions/api/estimate.ts
//   在 server 端比對 CF 環境變數 ESTIMATE_GATE_PASSWORD。本頁 source 永遠乾淨。
// noindex + 不加進導覽/sitemap：這頁不對外公開。
---

<Layout
  title={`估價工具 | ${config.site.title}`}
  description="內部估價工具"
  noindex={true}
>
  <Header />

  <main id="main-content" class="app-layout max-w-app py-10">
    {/* 內部工具標示 — 跟對客戶的頁面明顯區隔，避免手滑當公開頁分享 */}
    <div
      class="bg-muted text-muted-foreground mb-8 rounded-md px-4 py-2 text-center text-[14px]"
    >
      🔒 內部估價工具 · 僅供景泰個人使用（請勿公開分享此頁連結）
    </div>

    {/* ── 第一步：密碼解鎖 ── */}
    <section id="gate" class="mx-auto max-w-md">
      <h1 class="text-foreground text-center text-2xl font-bold">估價工具</h1>
      <p class="text-muted-foreground mt-2 text-center text-[15px]">
        輸入密碼解鎖
      </p>
      <div class="border-border bg-card mt-6 rounded-lg border p-6">
        <input
          id="pw"
          type="password"
          autocomplete="off"
          placeholder="密碼"
          class="border-border bg-background text-foreground focus:border-accent w-full rounded-md border px-4 py-3 text-[16px] outline-none"
        />
        <button
          id="unlock"
          class="bg-accent text-accent-foreground hover:bg-accent/90 mt-3 w-full rounded-md px-4 py-3 text-[16px] font-medium"
        >
          解鎖
        </button>
        <p
          id="gate-err"
          class="mt-3 hidden text-center text-[14px] text-red-500"
        >
          密碼錯誤
        </p>
      </div>
    </section>

    {/* ── 第二步：地址查詢（解鎖後 JS 顯示）── */}
    <section id="tool" class="mx-auto hidden max-w-2xl">
      <h1 class="text-foreground text-2xl font-bold">估價工具</h1>
      <p class="text-muted-foreground mt-1 text-[15px]">
        輸入地址 → 出景泰格式估價（含樓層之 N 最準）
      </p>

      <div class="border-border bg-card mt-6 rounded-lg border p-5 sm:p-6">
        <label for="addr" class="text-foreground text-[15px] font-medium"
          >物件地址</label
        >
        <input
          id="addr"
          type="text"
          maxlength="120"
          placeholder="例：西屯區台灣大道三段 818 號 13 樓之 7"
          class="border-border bg-background text-foreground focus:border-accent mt-2 w-full rounded-md border px-4 py-3 text-[16px] outline-none"
        />
        <button
          id="run"
          class="bg-accent text-accent-foreground hover:bg-accent/90 mt-4 w-full rounded-md px-4 py-3 text-[17px] font-semibold disabled:opacity-50"
        >
          開始估價
        </button>
        <p class="text-muted-foreground mt-3 text-[13px]">
          首次抓樂居約 30–60 秒，之後同址秒回。估不出社區行情多為透天／店面。
        </p>
      </div>

      {/* loading */}
      <div id="loading" class="mt-6 hidden text-center">
        <div
          class="border-accent inline-block h-8 w-8 animate-spin rounded-full border-4 border-t-transparent"
        >
        </div>
        <p class="text-muted-foreground mt-3 text-[15px]">
          估價中…（首次較久）
        </p>
      </div>

      {/* 訊息（離線 / 估不了 / 錯誤） */}
      <div
        id="msg"
        class="border-border bg-card mt-6 hidden rounded-lg border border-dashed p-6 text-center text-[16px]"
      >
      </div>

      {/* 結果 */}
      <div id="result" class="mt-6 hidden">
        <div class="border-border bg-card rounded-lg border p-5 sm:p-6">
          <div class="flex items-center justify-between gap-3">
            <div>
              <span id="r-community" class="text-foreground text-xl font-bold"
              ></span>
              <span
                id="r-verified"
                class="bg-accent/15 text-accent ml-2 hidden rounded px-2 py-0.5 align-middle text-[12px]"
                >門牌已驗證</span
              >
            </div>
            <a
              id="r-leju"
              href="#"
              target="_blank"
              rel="noopener"
              class="text-accent hidden text-[13px] no-underline hover:underline"
              >樂居頁 ↗</a
            >
          </div>
          <pre
            id="r-text"
            class="text-foreground mt-4 overflow-x-auto text-[15px] leading-relaxed"
            style="white-space:pre-wrap;font-family:inherit;">
          </pre>
          <button
            id="copy"
            class="border-accent text-accent hover:bg-accent/10 mt-4 rounded-md border px-4 py-2 text-[14px]"
          >
            複製估價文字
          </button>
        </div>
      </div>

      <button
        id="lock"
        class="text-muted-foreground mt-8 text-[13px] underline"
      >
        鎖定
      </button>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  (function () {
    const KEY = "est_pw";
    const $ = id => document.getElementById(id);
    const gate = $("gate"),
      tool = $("tool");

    function showTool() {
      gate.classList.add("hidden");
      tool.classList.remove("hidden");
    }
    function showGate() {
      tool.classList.add("hidden");
      gate.classList.remove("hidden");
    }

    // 已解鎖過（本次分頁）→ 直接進工具；密碼若失效，估價時 401 會退回
    if (sessionStorage.getItem(KEY)) showTool();

    async function post(payload) {
      const ctrl = new AbortController();
      const t = setTimeout(() => ctrl.abort(), 70000);
      try {
        const res = await fetch("/api/estimate", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(payload),
          signal: ctrl.signal,
        });
        return { status: res.status, data: await res.json() };
      } finally {
        clearTimeout(t);
      }
    }

    // 解鎖
    async function unlock() {
      const pw = $("pw").value.trim();
      if (!pw) return;
      $("gate-err").classList.add("hidden");
      try {
        const { status, data } = await post({ password: pw, verify: true });
        if (status === 200 && data.ok) {
          sessionStorage.setItem(KEY, pw);
          $("pw").value = "";
          showTool();
        } else if (status === 503) {
          $("gate-err").textContent = "後台尚未設定密碼（請先設 CF 環境變數）";
          $("gate-err").classList.remove("hidden");
        } else {
          $("gate-err").textContent = "密碼錯誤";
          $("gate-err").classList.remove("hidden");
        }
      } catch {
        $("gate-err").textContent = "連線失敗，請重試";
        $("gate-err").classList.remove("hidden");
      }
    }
    $("unlock").addEventListener("click", unlock);
    $("pw").addEventListener("keydown", e => {
      if (e.key === "Enter") unlock();
    });

    // 估價
    // reason 可能夾帶使用者輸入的地址（estimator2 回顯）→ 一律 escape 再進 innerHTML，擋反射式 XSS
    function esc(s) {
      return String(s).replace(
        /[&<>"']/g,
        c =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c]
      );
    }
    function setMsg(html) {
      const m = $("msg");
      m.innerHTML = html;
      m.classList.remove("hidden");
    }
    function hide(...ids) {
      ids.forEach(id => $(id).classList.add("hidden"));
    }

    async function runEstimate() {
      const addr = $("addr").value.trim();
      if (!addr) return;
      const pw = sessionStorage.getItem(KEY);
      if (!pw) {
        showGate();
        return;
      }
      hide("result", "msg");
      $("loading").classList.remove("hidden");
      $("run").disabled = true;
      try {
        const { status, data } = await post({ password: pw, addr });
        if (status === 401) {
          sessionStorage.removeItem(KEY);
          showGate();
          return;
        }
        if (data.offline) {
          setMsg("估價主機目前離線，晚點再試 🌙");
          return;
        }
        if (!data.busy && !data.ok) {
          const r = data.reason || "估不出來";
          setMsg(
            "這個地址估不出社區行情 🤔<br><span class='text-muted-foreground text-[14px]'>" +
              "多為透天／店面／無社區公寓（原因：" +
              esc(r) +
              "）</span>"
          );
          return;
        }
        if (data.busy) {
          setMsg("系統正在估另一筆，請稍候幾秒再試 ⏳");
          return;
        }
        // 成功
        $("r-community").textContent = data.community || "（未辨認）";
        const vb = $("r-verified");
        data.verified
          ? vb.classList.remove("hidden")
          : vb.classList.add("hidden");
        const leju = $("r-leju");
        if (data.oid) {
          leju.href = "https://www.leju.com.tw/community/" + data.oid;
          leju.classList.remove("hidden");
        } else {
          leju.classList.add("hidden");
        }
        $("r-text").textContent = data.text || "";
        $("result").classList.remove("hidden");
      } catch {
        setMsg("估價主機沒有回應（可能離線或首次太久），請再試一次 🌙");
      } finally {
        $("loading").classList.add("hidden");
        $("run").disabled = false;
      }
    }
    $("run").addEventListener("click", runEstimate);
    $("addr").addEventListener("keydown", e => {
      if (e.key === "Enter") runEstimate();
    });

    // 複製
    $("copy").addEventListener("click", () => {
      const t = $("r-text").textContent || "";
      navigator.clipboard.writeText(t).then(() => {
        $("copy").textContent = "已複製 ✓";
        setTimeout(() => ($("copy").textContent = "複製估價文字"), 1500);
      });
    });

    // 鎖定
    $("lock").addEventListener("click", () => {
      sessionStorage.removeItem(KEY);
      showGate();
    });
  })();
</script>
