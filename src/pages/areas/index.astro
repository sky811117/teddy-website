---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import config from "@/config";
import { areas, AREA_DATA_PERIOD, getAreaStats } from "@/data/areas";
import { safeJsonLd } from "@/utils/safeJsonLd";

// 區數跟 areas.ts 走（2026-09-06 從 7 區補到 11 區：西區／梧棲區／烏日區／南區；2026-10-04 補豐原區／潭子區／沙鹿區到 14 區）
const areaCount = areas.length;
// 區名清單（description／頁首說明用，跟 areas.ts 自動同步，不手寫）
const areaNames = areas.map(a => a.shortName).join("、");
// 卡片上的單價：每區最多 3 個分群，樣本少的排後面（資料來自 area-stats.json）
const cardStats = (area: (typeof areas)[number]) =>
  [...getAreaStats(area)]
    .sort((a, b) => Number(a.smallSample) - Number(b.smallSample) || b.n - a.n)
    .slice(0, 3);

// JSON-LD: 各區總覽頁的 ItemList
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: `台中 ${areaCount} 區買房指南`,
  itemListElement: areas.map((a, idx) => ({
    "@type": "ListItem",
    position: idx + 1,
    name: `${a.name}買房指南`,
    url: new URL(`/areas/${a.slug}/`, Astro.site).href,
  })),
};

// BreadcrumbList — 給 Google 標明站內位置
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: new URL("/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "台中各區",
      item: new URL("/areas/", Astro.site).href,
    },
  ],
};
---

<Layout
  title={`台中 ${areaCount} 區買房指南 | ${config.site.title}`}
  description={`台中 ${areaCount} 區買房指南：${areaNames}。每區一頁，整理實價登錄成交單價（${AREA_DATA_PERIOD}）、生活圈、熱門社區、適合誰買、要避開什麼，附站上在售物件。`}
  canonicalURL={new URL("/areas/", Astro.site).href}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(itemListSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(breadcrumbSchema)}
    />
  </Fragment>

  <Header />

  <Main
    pageTitle={`台中 ${areaCount} 區買房指南`}
    pageDesc={`不同區的生活圈與產品型態差很多。各區實價登錄成交單價（${AREA_DATA_PERIOD}）、熱門社區、適合誰買都整理在各自的深度頁，你看哪區順手點哪區。`}
  >
    {/* 各區卡片網格 */}
    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        areas.map(area => (
          <a
            href={`/areas/${area.slug}/`}
            class="border-border bg-card hover:border-accent group flex flex-col overflow-hidden rounded-lg border no-underline transition-colors"
          >
            {/* 2026-08-26 補：原本 7 張卡片零縮圖，整頁只有 emoji 撐版面
                2026-10-03 F025：改 astro:assets 產 webp 400/800 兩種寬（AI 意象圖的說明放在格線下方一行） */}
            {area.heroImage && (
              <Picture
                src={area.heroImage}
                formats={["webp"]}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, calc(100vw - 32px)"
                alt={`${area.shortName}城市景觀 AI 意象圖`}
                loading="lazy"
                decoding="async"
                class="aspect-[16/9] w-full object-cover transition-opacity group-hover:opacity-90"
              />
            )}
            <div class="flex flex-col p-6">
            <div class="flex items-center gap-3">
              <span class="text-4xl">{area.emoji}</span>
              <h2 class="text-foreground text-xl font-bold">
                {area.name}
              </h2>
            </div>

            <p class="text-accent mt-2 font-medium">{area.headline}</p>

            <p class="text-muted-foreground mt-3 line-clamp-3 leading-relaxed">
              {area.summary}
            </p>

            <ul class="text-muted-foreground mt-4 space-y-1 text-sm">
              {cardStats(area).map(s => (
                <li class="flex flex-wrap items-baseline gap-x-2">
                  <span class="text-foreground/70">・{s.label}</span>
                  <span class="text-foreground font-medium">{s.median.toFixed(1)} 萬/坪</span>
                  {s.smallSample && <span class="text-xs">樣本少</span>}
                </li>
              ))}
            </ul>

            <div class="text-accent mt-auto pt-4 text-sm font-medium group-hover:underline">
              看 {area.shortName}深度頁 →
            </div>
            </div>
          </a>
        ))
      }
    </div>
    <p class="text-muted-foreground mt-4 text-xs leading-relaxed">
      卡片單價：內政部實價登錄（{AREA_DATA_PERIOD}）扣車位成交單價中位數，站方逐筆統計，口徑見各區頁。
      各區卡片圖片為 AI 生成的意象圖，非實景照片（豐原、潭子、沙鹿暫無圖片）。
    </p>

    {/* 底部 CTA */}
    <section
      class="border-border mt-12 rounded-lg border border-dashed p-6 text-center"
    >
      <p class="text-foreground font-medium">想看其他區？</p>
      <p class="text-muted-foreground mt-3 leading-relaxed">
        東區 / 大雅 / 霧峰 / 海線（龍井 / 清水）
        — 台中全區都有在跑。LINE 說你想看哪一區，回你最近 3 個月當區實價整理 + 站上在售物件。
      </p>
      <a
        href="/go/line?src=areas"
        class="bg-accent text-accent-foreground mt-6 inline-block rounded px-6 py-2 font-medium no-underline"
      >
        LINE sky811117 問景泰
      </a>
      <p class="text-muted-foreground mt-4 text-xs">
        一品不動產 有巢氏房屋 台中世界之心加盟店<br />
        經紀人 黃永隆 113彰縣字324 ・ 營業員 陳景泰 114登字488296
      </p>
    </section>
  </Main>

  <Footer />
</Layout>
