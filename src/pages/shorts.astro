---
/**
 * 短影音專區首頁（2026-11-18 改版）：物件片和房市新聞片分開排，每支有自己的單支頁。
 * ⛔ 這頁有物件，算廣告頁：提到未完工建設的新聞片不放這裡（hubNewsShorts 已濾掉）。
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import AskBar from "@/components/flora/AskBar.astro";
import ShortCard from "@/components/shorts/ShortCard.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";
import { platformInfo } from "@/data/videos";
import { coverSmall, formatDay, getHomeShorts, hubNewsShorts } from "@/data/shorts";
import "@/styles/shorts.css";

const homes = await getHomeShorts();
const latestHomes = homes.slice(0, 8);
const latestNews = hubNewsShorts.slice(0, 8);

const districtCount = new Map<string, number>();
for (const h of homes) districtCount.set(h.district, (districtCount.get(h.district) ?? 0) + 1);
const districts = [...districtCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8);

const siteOrigin = new URL("/", Astro.site).href;
const canonicalURL = new URL("/shorts/", Astro.site).href;
const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonicalURL}#collectionpage`,
  url: canonicalURL,
  name: "景泰的房仲短影音",
  description: "台中物件看屋短影音與房市新聞短影音。",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: [
      ...latestHomes.map(h => ({ url: new URL(`/shorts/homes/${h.code}/`, Astro.site).href, name: h.label })),
      ...latestNews.map(n => ({ url: new URL(`/shorts/news/${n.slug}/`, Astro.site).href, name: n.title })),
    ].map((item, i) => ({ "@type": "ListItem", position: i + 1, ...item })),
  },
  about: { "@id": `${siteOrigin}#realestateagent` },
  inLanguage: "zh-TW",
};
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首頁", item: siteOrigin },
    { "@type": "ListItem", position: 2, name: "短影音", item: canonicalURL },
  ],
};
---

<Layout
  title={`短影音作品集 | ${config.site.title}`}
  description="台中物件看屋短影音與房市新聞短影音。先看影片，再決定要不要約看；政策、貸款、行情，一分鐘講白話。"
  canonicalURL={canonicalURL}
  showFloatingCTA={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={safeJsonLd(collectionSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(breadcrumbSchema)} />
  </Fragment>
  <Header />
  <AskBar href="/go/line?src=shorts" />
  <main id="main-content" class="sv">
    <header class="sv-head">
      <h1>景泰的房仲短影音</h1>
      <p>看房子，也看懂房市新聞。</p>
    </header>
    <nav class="sv-seg" aria-label="短影音分類">
      <a href="/shorts/" aria-current="page">全部</a>
      <a href="/shorts/homes/">物件</a>
      <a href="/shorts/news/">房市新聞</a>
    </nav>

    {
      latestHomes.length > 0 && (
        <section class="sv-sec">
          <div class="sv-sec-h">
            <h2>最新物件</h2>
            <a class="sv-more" href="/shorts/homes/">全部 {homes.length} 支</a>
          </div>
          <div class="sv-row">
            {latestHomes.map(h => (
              <ShortCard
                href={`/shorts/homes/${h.code}/`}
                cover={coverSmall(h.videoId, h.cover)}
                alt={`${h.place} 看屋短影音封面`}
                title={h.place}
                sub={h.sub}
                price={h.priceText}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      latestNews.length > 0 && (
        <section class="sv-sec">
          <div class="sv-sec-h">
            <h2>房市新聞</h2>
            <a class="sv-more" href="/shorts/news/">看全部</a>
          </div>
          <div class="sv-row">
            {latestNews.map(n => (
              <ShortCard
                href={`/shorts/news/${n.slug}/`}
                cover={coverSmall(n.videoId, n.cover)}
                alt={`${n.title} 短影音封面`}
                title={n.title}
                sub={`${formatDay(n.date)}・${n.category}`}
              />
            ))}
          </div>
        </section>
      )
    }

    {
      districts.length > 0 && (
        <section class="sv-sec">
          <div class="sv-sec-h"><h2>依行政區看</h2></div>
          <div class="sv-chips">
            {districts.map(([d, n]) => (
              <a href={`/shorts/homes/?d=${encodeURIComponent(d)}`}>{d} <small>{n}</small></a>
            ))}
          </div>
        </section>
      )
    }

    <aside class="sv-follow">
      <h2>新片不漏接</h2>
      <p>挑你常用的平台追蹤。</p>
      <div>
        <a href={platformInfo.youtube.url} target="_blank" rel="noopener">YouTube</a>
        <a href={platformInfo.instagram.url} target="_blank" rel="noopener">Instagram</a>
        <a href={platformInfo.tiktok.url} target="_blank" rel="noopener">TikTok</a>
      </div>
    </aside>

    <p class="sv-legal">
      一品不動產經紀股份有限公司 有巢氏房屋台中世界之心加盟店<br />
      不動產經紀人 黃永隆 113彰縣字第324號<br />
      不動產營業員 陳景泰 114年登字第488296號
    </p>
  </main>
  <Footer />
</Layout>
