        M.setPaintProperty("gt-near-beam", "fill-extrusion-height", beamH(sc, "h"));
        M.setPaintProperty("gt-near-sleeve", "fill-extrusion-height", beamH(sc, "h"));
      }

      // 彈窗：同一張地圖同時只開一個（跟原本 Leaflet 一樣）。tr＝那張地圖的紀錄 { cur, closedAt }
      var popMain = { cur: null, closedAt: 0 }, popHol = { cur: null, closedAt: 0 };
      // 彈窗寬度：地圖寬 − 左右留白，手機 320 寬也不會被地圖邊切掉
      function popW(el) { return Math.max(150, Math.min(300, (el ? el.clientWidth : 320) - 130)); }
      function mkPop(tr, el, o) {
        var p = new ML.Popup(Object.assign({ maxWidth: popW(el) + "px", className: "gt-mlpop", focusAfterOpen: false }, o || {}));
        p.on("open", function () { if (tr.cur && tr.cur !== p) tr.cur.remove(); tr.cur = p; });
