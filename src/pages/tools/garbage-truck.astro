      function dlabel(ymd) { var p = ymd.split("-"); return +p[1] + "/" + +p[2] + "（" + WD[slotOf(ymd)] + "）"; }
      function holOn(ymd) {
        var ds = (BOOT && BOOT.hol && BOOT.hol.dates) || [];
