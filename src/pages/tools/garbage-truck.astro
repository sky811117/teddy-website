          var s = it.s;
          var st = stateOf(s, day);
          var mk = L.circleMarker([s.lat, s.lng], {
            radius: 7, weight: 2, color: "#ffffff", fillColor: COL[st], fillOpacity: 0.95,
            dashArray: isApprox(s) ? "3 3" : null,
          });
          mk.bindPopup(function () { return popupHtml(it, dayInfo(S.dayOff)); }, popOpts(E.map));
          if (!isTouch) {
            var g = segs(s.g[day.slot]);
            mk.bindTooltip(esc(s.place) + "<br>" + (g.length ? "垃圾 " + segsTxt(g) : "這天沒有垃圾車") + (isDrift(s) ? "（時間可能已改）" : ""), { direction: "top", offset: [0, -6] });
          }
          mk.addTo(sLayer);
          markers[s.id] = mk;
        });
      }
      // 每分鐘更新「約 N 分鐘後／已過」
      function tickStates() {
        if (S.dayOff !== 0) return;
        var now = twNow();
        Array.prototype.forEach.call(document.querySelectorAll(".gt-st[data-a]"), function (el) {
          var st = segState({ a: +el.getAttribute("data-a"), b: +el.getAttribute("data-b") }, now.min);
          el.textContent = st.t;
          el.className = "gt-st gt-st-" + st.k;
        });
      }

      function indexIn(list, id) {
        for (var i = 0; i < list.length; i++) if (list[i].s.id === id) return i;
        return -1;
      }
      function goCard(id) {
        var el = $("gt-s-" + id);
