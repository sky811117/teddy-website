      function driftWhy(s) {
        var dd = driftDate();
        if (s.od === 1) return "官方 " + dd + " 抽查，這一點的時間跟開放資料不同";
        if (s.od === 2) return "官方 " + dd + " 抽查，同一台車（" + s.route + "）有別的點時間已改，這一點可能也改了";
        var st = BOOT.drift.dists && BOOT.drift.dists[s.dist];
        return s.dist + "班表可能已改（官方 " + dd + " 抽查" + (st ? " " + st.n + " 點有 " + st.diff + " 點不同" : "") + "）";
