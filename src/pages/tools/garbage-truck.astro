      }
      // 某點從某天起的下一次收運（跳過國定假日，因為那天沿街收運暫停）
      function nextService(s, kind, now) {
        for (var k = 0; k < 14; k++) {
          var ymd = addDays(now.ymd, k);
          if (holOn(ymd)) continue;
