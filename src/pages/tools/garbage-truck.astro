    text-align: left;
  }
  .gt-chip:hover { border-color: var(--accent); color: var(--accent); }
  .gt-small { font-size: 0.875rem; color: var(--muted-foreground); line-height: 1.6; }
  .gt-mt { margin-top: 0.75rem; }
  .gt-a { color: var(--accent); text-decoration: underline; }
  .gt-today-date { font-weight: 700; }
  .gt-facts { margin-top: 0.4rem; padding-left: 1.1rem; list-style: disc; font-size: 0.95rem; line-height: 1.65; }
  .gt-facts li + li { margin-top: 0.3rem; }
  @media (max-width: 399px) {
    .gt-facts { font-size: 0.9rem; line-height: 1.55; }
