  }
  .gt-kicker { font-size: 0.8rem; color: var(--muted-foreground); }
  .gt-sum-title { font-weight: 700; font-size: 1.05rem; overflow-wrap: anywhere; }
  .gt-note { margin-top: 0.35rem; font-size: 0.875rem; color: #9a3412; }
  [data-theme="dark"] .gt-note { color: #fdba74; }
  .gt-sum-count { margin-top: 0.5rem; font-size: 1.05rem; }
  /* 官方抽查：班表可能已改 */
  .gt-drift {
    margin: 0.4rem 0;
    padding: 0.45rem 0.7rem;
    border-left: 4px solid #b3261e;
    background: rgb(179 38 30 / 0.07);
    border-radius: 0.375rem;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .gt-drift-big { font-size: 0.95rem; margin-top: 0.6rem; }
  .gt-drift-big p + p { margin-top: 0.3rem; }
  /* 摘要最上面的抽查警示：手機只顯示一句＋「展開說明」，電腦版整段攤開 */
  .gt-drift-desk { display: none; }
  @media (min-width: 1024px) {
    .gt-drift-desk { display: block; }
    .gt-drift-mob { display: none; }
  }
  .gt-drift-more > summary { cursor: pointer; color: var(--accent); min-height: 44px; display: flex; align-items: center; font-size: 0.9rem; font-weight: 600; list-style: none; }
  .gt-drift-more > summary::-webkit-details-marker { display: none; }
  .gt-drift-more > summary::before { content: "▸"; margin-right: 0.4rem; flex: 0 0 auto; }
  .gt-drift-more[open] > summary::before { content: "▾"; }
  .gt-drift-more > p { font-size: 0.9rem; }
  .gt-drift-more > p + p { margin-top: 0.3rem; }
  [data-theme="dark"] .gt-drift { border-left-color: #ffb4ab; background: rgb(255 180 171 / 0.1); }
  .gt-old { opacity: 0.6; }
