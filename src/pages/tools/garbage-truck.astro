        var dim = Math.max(180, Math.min(w, h * 1.3)) - 40;
        var lat = S.pt ? S.pt.lat : 24.15;
        var z = Math.log(40075016.686 * Math.cos(lat * Math.PI / 180) * dim / (512 * 2.3 * R)) / Math.LN2;
        return Math.max(12, Math.min(17.2, z));
      }
      function qLabel() { return S.via === "geo" ? "你的位置" : S.via === "address" ? "你查的地址" : "你在地圖上點的位置"; }

      // 動態效果（只在地圖看得到、分頁在前景、沒有「減少動態」時跑）：查詢範圍的擴散光環、路線流動虛線、光柱升起
      // 都有結束點：光環擴散 3 圈、虛線流 6 秒、光柱升到頂就停，之後地圖不再逐格重畫（省電、不發燙）。
      // 新查詢、換 300／500 公尺、開新路線、地圖重新捲進畫面時再播一輪。
      var DASH = [[0, 4, 3], [0.5, 4, 2.5], [1, 4, 2], [1.5, 4, 1.5], [2, 4, 1], [2.5, 4, 0.5], [3, 4, 0],
        [0, 0.5, 3, 3.5], [0, 1, 3, 3], [0, 1.5, 3, 2.5], [0, 2, 3, 2], [0, 2.5, 3, 1.5], [0, 3, 3, 1], [0, 3.5, 3, 0.5]];
      var PULSE_MS = 2800, PULSE_N = 3, DASH_MS = 6000;
