            // 下一行的說明寫「查無 123 號，改用最接近的 111 號定位」，不要讓人以為系統把地址認錯
            runQuery(r.lat, r.lng, "address", { label: r.precision === "near-number" ? String(q).trim() : r.label, note: r.note || "", dist: r.dist, precision: r.precision });
