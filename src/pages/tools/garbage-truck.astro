      function nextTxt(n) {
        if (!n) return "兩週內查不到排班";
        var today = twNow().ymd;
        return (n.ymd === today ? "今天" : n.ymd === addDays(today, 1) ? "明天 " + dlabel(n.ymd) : dlabel(n.ymd)) + " " + hm(n.seg.a);
      }
      function segState(seg, nowMin) {
        if (nowMin < seg.a) {
