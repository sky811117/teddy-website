      function fxArmPulse() { if (!RM) fx.pq = -1; fxKick(); }
      function fxArmDash() { if (!RM) fx.pr = -1; fxKick(); }
      function fxTick(t) {
        fx.raf = 0;
        if (!fxNeed()) return;
        if (t - fx.last >= 40) {
          fx.last = t;
          try {
            if (fx.pq && MS.q.features.length) {
