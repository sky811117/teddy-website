        el.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      function showOnMap(id) {
        if (!map || !markers[id]) return;
        var mk = markers[id];
        var r = E.map.getBoundingClientRect();
        var visible = r.top >= -40 && r.bottom <= window.innerHeight + 40;
        if (!visible) E.mapcol.scrollIntoView({ behavior: "smooth", block: "start" });
        map.setView(mk.getLatLng(), Math.max(map.getZoom(), 17));
        setTimeout(function () { mk.openPopup(); }, visible ? 0 : 350);
      }

      /* ---------- 這台車的路線 ---------- */
      var routeState = null;
      function closeRoute(silent) {
        routeState = null;
        if (rLayer) rLayer.clearLayers();
        E.route.hidden = true;
        E.route.innerHTML = "";
        if (!silent && map && qCircle) map.fitBounds(qCircle.getBounds(), { padding: [16, 16] });
      }
      function showRoute(plate, fromId) {
        if (!plate) return;
        var day = dayInfo(S.dayOff);
        routeState = { plate: plate, fromId: fromId || "" };
        E.route.hidden = false;
        E.route.innerHTML = '<div class="gt-card"><p class="gt-small">載入車號 ' + esc(plate) + " 的路線中……</p></div>";
        var mySeq = S.seq;
        loadRoutes().then(function (rj) {
          var info = rj.routes && rj.routes[plate];
          if (!info) throw new Error("noroute");
          var keys = info.tiles.filter(function (k) { return BOOT.tiles[k]; });
          return Promise.all(keys.map(loadTile)).then(function (arrs) {
            var seen = {}, stops = [];
            arrs.forEach(function (a) { a.forEach(function (s) { if (s.route === plate && !seen[s.id] && s.lat != null) { seen[s.id] = 1; stops.push(s); } }); });
            return { info: info, stops: stops };
          });
        }).then(function (res) {
          if (!routeState || routeState.plate !== plate || mySeq !== S.seq) return;
          var rows = [];
          res.stops.forEach(function (s) {
            var g = segs(s.g[day.slot]), r = segs(s.r[day.slot]);
            (g.length ? g : r).forEach(function (sg) {
              rows.push({ s: s, seg: sg, d: S.pt ? haversine(S.pt.lat, S.pt.lng, s.lat, s.lng) : null });
            });
          });
          rows.sort(function (a, b) { return a.seg.a - b.seg.a; });
          var dayTxt = day.isToday ? "今天" : dlabel(day.ymd);
          var h = ['<div class="gt-card"><div class="gt-route-head"><h2 class="gt-h3">這條清運路線・' + dayTxt + "的停靠順序</h2>" +
            '<button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-act="route-close">關閉路線</button></div>'];
          var dd = driftDate();
          // routes.json 的 ok 只代表「官方抽查時車牌還是這台」，不代表時間一致；時間有沒有改看 od
          h.push('<p class="gt-small">依開放資料（' + esc(BOOT.modified || "") + " 版），這條路線登記的車號是 " + esc(plate) +
            (res.info.moved ? "；官方 " + dd + " 抽查時，這條路線已經換成別台車" :
              res.info.ok ? "；官方 " + dd + " 抽查時車號還是這台，但時間不一定跟開放資料一樣" : "；環保局可能已經換車或調整路線") + "。</p>");
          if (res.info.od) h.push('<p class="gt-drift">' + esc(res.info.od.msg) + "下面的時間只能參考，請以" + officialA("官方查詢") + "為準。</p>");
          if (!rows.length) {
            h.push('<p class="gt-small">這條路線' + dayTxt + "沒有排班。</p></div>");
            E.route.innerHTML = h.join("");
            if (rLayer) rLayer.clearLayers();
            return;
          }
          // 「粗體」那句只在真的有粗體時才講（還沒查地址、或整條路線都在 1 公里外時，畫面上沒有粗體）
          var anyNear = rows.some(function (x) { return x.d != null && x.d <= 1000; });
          h.push('<p class="gt-small">' + esc(res.info.dists.join("、")) + "・共 " + rows.length + " 站・" + hm(rows[0].seg.a) + "～" + hm(rows[rows.length - 1].seg.a) +
            "。" + (anyNear ? "粗體是離你 1 公里內的點。" : "") + "</p>");
          if (!res.info.od && res.info.dists.some(driftFlag)) h.push('<p class="gt-drift">官方 ' + dd + " 抽查，" + esc(res.info.dists.filter(driftFlag).join("、")) + "的班表可能已經跟開放資料不一樣，下面的時間只能參考。</p>");
          if (day.hol) h.push('<p class="gt-warn-box">' + esc(day.hol.name) + "：沿街收運暫停，改定時定點。</p>");
          h.push('<ol class="gt-route-list" tabindex="0" aria-label="這條路線的停靠順序">');
          rows.forEach(function (x) {
            var near = x.d != null && x.d <= 1000;
            var cur = x.s.id === routeState.fromId;
            h.push('<li class="' + (cur ? "gt-cur " : "") + (near ? "gt-near" : "") + '"><span class="gt-rt">' + segTxt(x.seg) + '</span><span class="gt-rp">' + esc(x.s.place) +
              (x.d != null ? '<small>' + mtxt(x.d) + "</small>" : "") + "</span></li>");
          });
          h.push("</ol></div>");
          E.route.innerHTML = h.join("");
          var curEl = E.route.querySelector("li.gt-cur");
          if (curEl) { var ol = curEl.parentNode; ol.scrollTop = Math.max(0, curEl.offsetTop - ol.offsetTop - 60); }
          if (map) {
            rLayer.clearLayers();
            var pts = rows.map(function (x) { return [x.s.lat, x.s.lng]; });
            L.polyline(pts, { color: "#8a6539", weight: 3, opacity: 0.7, interactive: false }).addTo(rLayer);
            rows.forEach(function (x) {
              L.circleMarker([x.s.lat, x.s.lng], { radius: 3, weight: 1, color: "#8a6539", fillColor: "#fff", fillOpacity: 1, bubblingMouseEvents: false })
                .bindTooltip(segTxt(x.seg) + " " + esc(x.s.place), { direction: "top" }).addTo(rLayer);
            });
