          E.route.innerHTML = '<div class="gt-card"><p class="gt-small">' + msg + '</p><button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-act="route-close">關閉</button></div>';
        });
      }

      /* ---------- 附近垃圾車大約位置（/api/garbage-live，只在頁面看得到時每 60 秒更新） ---------- */
      // markers：車牌 → 地圖標記（重畫時只移動位置、不整層清掉，開著的彈窗才不會被關掉）；openPlate：目前開著彈窗的車
      var live = { on: false, timer: null, last: 0, data: null, busy: false, markers: {}, openPlate: "" };
      function liveMsg(msg) { E.liveSt.textContent = msg; E.liveSt.hidden = !msg; }
      function liveStop() { clearInterval(live.timer); live.timer = null; }
      function liveStart() {
        liveStop();
        live.timer = setInterval(function () { if (document.visibilityState === "visible") liveFetch(); }, 60000);
      }
      function liveClear() {
        if (lLayer) lLayer.clearLayers();
        live.markers = {};
        live.openPlate = "";
      }
      function liveFail() {
        live.data = null;
        liveClear();
        liveStop();
        live.on = false;
        E.live.checked = false;
        updateLegend();
        liveMsg("目前拿不到垃圾車位置，班表查詢不受影響。可以稍後再開一次，或看官方 APP。");
        track("gt_live", { state: "error" });
      }
      function liveFetch() {
        if (live.busy) return;
        live.busy = true;
        live.last = Date.now();
        fetch("/api/garbage-live", { headers: { accept: "application/json" } })
          .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
          .then(function (j) {
            live.busy = false;
            if (!live.on) return;
            if (!j || j.ok !== true || !j.cars) throw new Error("bad");
            live.data = j;
            drawLive(j);
          })
          .catch(function () { live.busy = false; if (live.on) liveFail(); });
      }
      function drawLive(j) {
        if (!j) return;
        if (!map) { liveMsg("地圖沒有載入，看不到垃圾車位置。班表查詢不受影響。"); return; }
        var snapMs = Date.parse(j.snapshot || "");
        var age = isNaN(snapMs) ? null : Math.max(0, Math.round((Date.now() - snapMs) / 60000));
        var snapHM = j.snapshot ? String(j.snapshot).slice(11, 16) : "";
        if (age != null && age > 40) {
          liveClear();
          // 可能已經收班，也可能是官方資料暫停更新（白天也遇過車子停在 1 小時前的位置）→ 不斷言「沒有車」
          liveMsg("最近 40 分鐘沒有新的車輛位置（官方最後回報 " + snapHM + "），可能已經收班，也可能是資料暫停更新。");
          return;
        }
        var c = S.pt ? L.latLng(S.pt.lat, S.pt.lng) : null;
        var bounds = map.getBounds();
        var routes = live.routes || null;
        var n = 0, inView = 0, near = [], keep = {};
        j.cars.forEach(function (car) {
          var plate = String(car[0] || "");
          var lat = car[2], lng = car[1];
          if (!plate || typeof lat !== "number" || typeof lng !== "number") return;
          var dd = c ? haversine(c.lat, c.lng, lat, lng) : 0;
          var isOpen = plate === live.openPlate;
          if (c) { if (dd > LIVE_RADIUS && !isOpen) return; }
          else if (!bounds.contains([lat, lng]) && !isOpen) return;
          n++;
          if (bounds.contains([lat, lng])) inView++;
          near.push({ d: dd, ll: [lat, lng] });
          var mins = (age != null ? age : 0) + (Number(car[6]) || 0);
          // 開放資料沒有車種欄位；車牌對得上清運路線、而且官方抽查時還是這台車，才給「看路線」
          var info = routes && routes[plate];
          var okRoute = !!(info && info.ok);
          var html = '<div class="gt-pop"><strong>垃圾車或資源回收車・' + esc(plate) + "</strong>" +
            '<div class="gt-pop-sub">約 ' + mins + " 分鐘前的位置" + (car[4] ? "・時速約 " + esc(car[4]) + " 公里" : "") + "</div>" +
            (okRoute ? '<button type="button" class="gt-linkbtn" data-act="route" data-route="' + esc(plate) + '">看這台車登記的清運路線</button>' : "") +
            "</div>";
          keep[plate] = 1;
          var mk = live.markers[plate];
          if (mk) {
            var ll = mk.getLatLng();
            if (ll.lat !== lat || ll.lng !== lng) mk.setLatLng([lat, lng]); // 彈窗會跟著車移動，不會關掉
            if (mk._gtHtml !== html) { mk._gtHtml = html; mk.setPopupContent(html); }
            return;
          }
          mk = L.marker([lat, lng], { icon: truckIcon, keyboard: false, zIndexOffset: 500 }).bindPopup(html, popOpts(E.map));
          mk._gtHtml = html;
          mk.on("popupopen", function () { live.openPlate = plate; });
          mk.on("popupclose", function () { if (live.openPlate === plate) live.openPlate = ""; });
          mk.addTo(lLayer);
          live.markers[plate] = mk;
        });
        Object.keys(live.markers).forEach(function (plate) {
          if (keep[plate]) return;
          lLayer.removeLayer(live.markers[plate]);
          delete live.markers[plate];
          if (live.openPlate === plate) live.openPlate = "";
        });
        // 剛打開時，如果查詢範圍裡看不到車，把地圖拉遠到看得到最近的幾台
        if (live.fitOnce && c && n && !inView) {
          near.sort(function (a, b) { return a.d - b.d; });
          var fb = L.latLngBounds([[c.lat, c.lng]]);
          near.slice(0, 3).forEach(function (x) { fb.extend(x.ll); });
          map.fitBounds(fb, { padding: [30, 30], maxZoom: 17 });
        }
        live.fitOnce = false;
        var where = c ? "附近 3 公里內" : "地圖範圍內";
        liveMsg(where + " " + n + " 台・資料時間 " + snapHM + (age != null ? "（約 " + age + " 分鐘前）" : "") +
          (j.stale ? "・暫時抓不到新資料，顯示的是較舊的位置" : "") + "・官方快照約 10 分鐘更新一次，位置會落後 10～20 分鐘。");
      }
      function liveOn() {
        live.on = true;
        live.fitOnce = true;
        updateLegend();
        liveMsg("讀取垃圾車位置中……");
        track("gt_live", { state: "on" });
        loadRoutes().then(function (rj) { live.routes = rj.routes || {}; if (live.data) drawLive(live.data); }).catch(function () { live.routes = {}; });
        liveFetch();
        liveStart();
      }
      function liveOff() {
        live.on = false;
        updateLegend();
        liveStop();
        live.data = null;
        liveClear();
        liveMsg("");
      }
      document.addEventListener("visibilitychange", function () {
        if (!live.on) return;
        if (document.visibilityState === "visible") {
          if (Date.now() - live.last > 60000) liveFetch();
          liveStart();
        } else {
          liveStop();
        }
      });

      /* ---------- 國定假日定點班表 ---------- */
      var holMap = null, holLayer = null;
      function initHolidaySection() {
        if (!BOOT) return;
        var now = twNow();
        var left = BOOT.hol.dates.filter(function (d) { return d.date >= now.ymd; });
        if (!left.length) {
          E.holLeft.innerHTML = BOOT.hol.yearRoc + " 年的國定假日都已經過了。新年度的定點表，看" +
            '<a class="gt-a" href="https://cleaner.epb.taichung.gov.tw/schedule.aspx" rel="noopener" target="_blank">臺中垃圾清運大車隊國定假日定點班表</a>。';
          E.holSel.disabled = true;
          return;
        }
        E.holLeft.innerHTML = "今年還剩：" + left.map(function (d) { return "<b>" + dlabel(d.date) + esc(d.name) + "</b>"; }).join("、");
      }
      function renderHol(dist) {
        if (!dist) { E.holOut.innerHTML = ""; E.holMapcol.hidden = true; return; }
        var t = teamOf(dist);
        if (BOOT.hol.noData.indexOf(dist) !== -1) {
          E.holOut.innerHTML = '<p class="gt-warn-box">' + esc(BOOT.hol.noDataNote) + "</p>" +
            (t ? '<p class="gt-small">' + esc(teamName(dist, t)) + '：<a class="gt-a" href="tel:' + esc(t.tel) + '">' + esc(t.tel) + "</a></p>" : "");
          E.holMapcol.hidden = true;
          return;
        }
        E.holOut.innerHTML = '<p class="gt-small">載入中……</p>';
        loadHoliday().then(function (hd) {
          if (E.holSel.value !== dist) return;
          var list = hd.stops.filter(function (s) { return s.dist === dist; })
            .sort(function (a, b) { return a.start < b.start ? -1 : a.start > b.start ? 1 : 0; });
          var h = ['<p class="gt-small">' + esc(dist) + " 共 " + list.length + " 個假日定點，依時間排序。" +
            (BOOT.hol.pdf[dist] ? ' <a class="gt-a" href="' + esc(BOOT.hol.pdf[dist]) + '" rel="noopener" target="_blank">官方 PDF</a>' : "") + "</p>"];
          h.push('<ol class="gt-hol-list" tabindex="0" aria-label="' + esc(dist) + '國定假日定點清單">');
          list.forEach(function (s, i) {
            var d = S.pt ? haversine(S.pt.lat, S.pt.lng, s.lat, s.lng) : null;
            h.push('<li><span class="gt-hn">' + (i + 1) + '</span><span class="gt-rt">' + esc(s.start) + "–" + esc(s.end) + '</span><span class="gt-rp">' + esc(s.place) +
              "<small>" + esc(s.li) + (d != null ? "・離你查的位置" + mtxt(d) : "") + "</small></span></li>");
          });
          h.push("</ol>");
          E.holOut.innerHTML = h.join("");
          E.holMapcol.hidden = false;
          if (hasL) {
            if (!holMap) {
              holMap = makeMap(E.holMap, E.holHint);
              holLayer = L.layerGroup().addTo(holMap);
            }
            holMap.invalidateSize();
            holLayer.clearLayers();
            var pts = [];
            list.forEach(function (s, i) {
              pts.push([s.lat, s.lng]);
              L.marker([s.lat, s.lng], { icon: L.divIcon({ className: "gt-hmk", html: "<span>" + (i + 1) + "</span>", iconSize: [22, 22], iconAnchor: [11, 11] }) })
                .bindPopup('<div class="gt-pop"><strong>' + (i + 1) + ". " + esc(s.place) + "</strong><br>" + esc(s.start) + "–" + esc(s.end) + "・" + esc(s.li) + "</div>", popOpts(E.holMap))
                .addTo(holLayer);
            });
            if (S.pt && pinIcon) L.marker([S.pt.lat, S.pt.lng], { icon: pinIcon, interactive: false, keyboard: false }).addTo(holLayer);
            if (pts.length) holMap.fitBounds(L.latLngBounds(pts), { padding: [20, 20], maxZoom: 16 });
          }
          track("gt_holiday", { district: dist });
        }).catch(function () {
          E.holOut.innerHTML = '<p class="gt-small gt-err">假日定點資料載入失敗，請重新整理，或看<a class="gt-a" href="' + esc(BOOT.hol.announcement) + '" rel="noopener" target="_blank">環保局公告</a>。</p>';
        });
      }
      function openHol(dist) {
        if (dist && !E.holSel.disabled) { E.holSel.value = dist; renderHol(dist); }
        $("gt-hol").scrollIntoView({ behavior: "smooth", block: "start" });
      }

      /* ---------- 事件 ---------- */
      function boot() {
        if (!BOOT) {
          setStatus("清運點資料沒有載入，請重新整理再試；也可以用環保局官方查詢。", true);
          return;
        }
        // 門牌索引帶版本字樣（跟 tc-addr.js 同一份建置），/data/* 有 1 天快取也不會拿到舊索引
        if (window.TcAddr && window.TcAddr.config && BOOT.vIdx) {
          try { window.TcAddr.config({ v: BOOT.vIdx }); } catch (e) { /* 舊版 tc-addr.js 沒有 v 參數也能用 */ }
        }
        renderToday();
        buildDaySelect();
        initHolidaySection();
        if (hasL && E.map) {
          try { initMap(); } catch (e) { map = null; }
        }
        if (!map) {
          E.map.innerHTML = '<p class="gt-mapfail">地圖載入失敗（可能是網路擋住了地圖服務）。清單查詢還是可以用。</p>';
          if (E.empty) E.empty.hidden = true;
          if (E.liveRow) E.liveRow.hidden = true;
          if (E.legend) E.legend.hidden = true;
        }

        var skip = $("gt-skip");
        if (skip) skip.addEventListener("click", function (e) {
          e.preventDefault();
          var tgt = !E.listwrap.hidden ? $("gt-list-h") : $("gt-hol-h");
          if (tgt) { if (!tgt.hasAttribute("tabindex")) tgt.setAttribute("tabindex", "-1"); tgt.focus(); tgt.scrollIntoView({ block: "start" }); }
        });
        E.form.addEventListener("submit", function (e) {
          e.preventDefault();
          E.addr.blur();
          lookupAddr((E.addr.value || "").trim());
        });
        // 第一次點輸入框就先載門牌索引（~21KB gzip），按查詢時比較快
        E.addr.addEventListener("focus", function () { if (window.TcAddr) window.TcAddr.ready().catch(function () {}); }, { once: true });
        E.cands.addEventListener("click", function (e) {
          var b = e.target.closest("[data-cand]");
          if (!b || !E.cands._list) return;
          var c = E.cands._list[+b.getAttribute("data-cand")];
          if (!c) return;
          E.addr.value = c.query || c.label;
          lookupAddr(c.query || c.label);
        });
        E.here.addEventListener("click", function () {
          if (!navigator.geolocation) { setStatus("這個瀏覽器不支援定位，請輸入地址或點地圖。", true); return; }
          setStatus("定位中……（需要你允許使用位置）");
          navigator.geolocation.getCurrentPosition(function (pos) {
            var acc = pos.coords.accuracy;
            runQuery(pos.coords.latitude, pos.coords.longitude, "geo", {
              label: "", dist: "",
              note: acc && acc > 200 ? "定位誤差約 " + Math.round(acc) + " 公尺，結果可能有偏差；可以改輸入地址。" : "",
            });
          }, function () {
            setStatus("拿不到位置（可能沒給權限）。請輸入地址，或直接點地圖。", true);
            track("gt_query", { result: "fail", reason: "geo", via: "geo" });
          }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
        });
        Array.prototype.forEach.call(document.querySelectorAll('input[name="gt-r"]'), function (el) {
          el.addEventListener("change", function () {
            S.radius = Number(el.value) || 300;
            S.limit = PAGE;
            if (S.pt) renderAll(true);
          });
        });
        Array.prototype.forEach.call(document.querySelectorAll('input[name="gt-sort"]'), function (el) {
          el.addEventListener("change", function () { S.sort = el.value; S.limit = PAGE; renderList(); });
        });
        E.day.addEventListener("change", function () {
          S.dayOff = Number(E.day.value) || 0;
          S.limit = PAGE;
          renderList();
          if (routeState) showRoute(routeState.plate, routeState.fromId);
        });
        E.only.addEventListener("change", function () { S.only = E.only.checked; S.limit = PAGE; renderList(); });
        E.more.addEventListener("click", function () { S.limit += PAGE; renderList(); });
        E.live.addEventListener("change", function () { if (E.live.checked) liveOn(); else liveOff(); });
        E.holSel.addEventListener("change", function () { renderHol(E.holSel.value); });

        // 清單、摘要、地圖彈窗裡的按鈕（capture：Leaflet 彈窗會擋冒泡）
        document.addEventListener("click", function (e) {
          var t = e.target;
          if (!t || !t.closest) return;
          var go = t.closest("[data-gt-go]");
          if (go) { e.preventDefault(); if (map) map.closePopup(); goCard(go.getAttribute("data-gt-go")); return; }
          var here = t.closest("[data-gt-here]");
          if (here) {
            e.preventDefault();
            var ll = here.getAttribute("data-gt-here").split(",");
            if (map) map.closePopup();
            runQuery(+ll[0], +ll[1], "map", { label: "", note: "", dist: "" });
            return;
          }
          var hb = t.closest("[data-gt-hol]");
          if (hb) { e.preventDefault(); openHol(hb.getAttribute("data-gt-hol")); return; }
          var a = t.closest("[data-act]");
          if (!a) return;
          var act = a.getAttribute("data-act");
          if (act === "map") { e.preventDefault(); showOnMap(a.getAttribute("data-id")); }
          else if (act === "route") {
            e.preventDefault();
            if (map) map.closePopup();
            showRoute(a.getAttribute("data-route"), a.getAttribute("data-id"));
            if (window.innerWidth < 1024) setTimeout(function () { E.route.scrollIntoView({ behavior: "smooth", block: "start" }); }, 50);
          } else if (act === "route-close") { e.preventDefault(); closeRoute(false); }
        }, true);
        // 常見問題的站內連結：打開對應的那一題
        function openFaq(id) {
          var d = document.getElementById(id);
          if (!d || d.tagName !== "DETAILS") return false;
          d.open = true;
          d.scrollIntoView({ behavior: "smooth", block: "start" });
          return true;
        }
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest('a[href^="#gt-faq-"]');
          if (a && openFaq(a.getAttribute("href").slice(1))) e.preventDefault();
        });
        if (/^#gt-faq-/.test(location.hash)) openFaq(location.hash.slice(1));
        // 「看假日定點」連結：已經查過地址時，直接帶入那一區
        E.today.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest('a[href="#gt-hol"]');
          if (a && S.dist) { e.preventDefault(); openHol(S.dist); }
        });

        setInterval(function () {
          if (document.visibilityState !== "visible") return;
          tickStates();
        }, 60000);
      }

      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
      else boot();
    })();
  </script>
</Layout>

<style is:global>
  @media (min-width: 1024px) {
    #main-content.gt-main {
      max-width: 80rem;
    }
  }
  .gt-app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "search" "today" "summary" "map" "route" "list";
    column-gap: 1.5rem;
    row-gap: 0;
  }
  .gt-app > * {
    min-width: 0;
    margin-bottom: 1rem;
  }
  .gt-app [hidden],
  .gt-hol [hidden] {
    display: none !important;
  }
  .gt-a-search { grid-area: search; }
  .gt-a-today { grid-area: today; }
  .gt-a-summary { grid-area: summary; }
  .gt-a-map { grid-area: map; }
  .gt-a-route { grid-area: route; }
  .gt-a-list { grid-area: list; }
  @media (min-width: 1024px) {
    .gt-app {
      grid-template-columns: minmax(340px, 410px) minmax(0, 1fr);
      grid-template-rows: auto auto auto auto 1fr;
      grid-template-areas: "search map" "today map" "summary map" "route map" "list map";
