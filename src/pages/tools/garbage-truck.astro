          var day = dayInfo(S.dayOff);
          var idx = indexIn(sortedItems(day), id);
          if (idx < 0 && S.only) {
            S.only = false;
            E.only.checked = false;
            idx = indexIn(sortedItems(day), id);
          }
          if (idx >= 0) S.limit = Math.max(S.limit, idx + 1);
          renderList();
          el = $("gt-s-" + id);
        }
        if (!el) return;
        var d = el.querySelector("details");
        if (d) d.open = true;
        el.classList.add("gt-flash");
