        showCands(null);
        if (!q) { setStatus("請先輸入地址，例如「北屯區崇德路二段46號」。", true); return; }
        if (!window.TcAddr) { setStatus("地址比對元件沒有載入，請重新整理；也可以用「用我的位置」或直接點地圖。", true); return; }
        var city = outOfCity(q, null);
        if (city) { lookupFail("這個工具只查臺中市的地址（你輸入的是" + city + "）。其他縣市的垃圾車時間，請看當地環保局。", "out-of-city"); return; }
        setStatus("比對地址中……");
        window.TcAddr.lookup(q).then(function (r) {
          var oc = (r.ok || r.reason === "ambiguous") ? outOfCity(q, r) : "";
          if (oc) { lookupFail("這個工具只查臺中市的地址，「" + oc + "」不在臺中市。其他縣市的垃圾車時間，請看當地環保局。", "out-of-city"); return; }
          if (r.ok) {
            // 查無此號（near-number）：標題放使用者輸入的地址（只在本機顯示，跟學區頁一樣），
            // 下一行的說明寫「查無 123 號，改用最接近的 111 號定位」，不要讓人以為系統把地址認錯
            runQuery(r.lat, r.lng, "address", { label: r.precision === "near-number" ? String(q).trim() : r.label, note: r.note || "", dist: r.dist, precision: r.precision });
            return;
          }
          if (r.reason === "ambiguous") {
            lookupFail(r.message || "這條路在好幾個地方都有，請選一個。", r.reason);
            showCands(r.candidates, "請選行政區：");
          } else if (r.reason === "road-not-found" && r.renamed) {
            // 舊路名（中港路、中區／西區的中正路 → 臺灣大道）：tc-addr 刻意不給建議（中港路 ≠ 中清路），這裡也不叫 typoCands
            lookupFail(r.message || "這條路已經改名，請改用新地址再查一次。", "renamed");
            if (r.renamed.src && r.renamed.src.url) {
              var rs = r.renamed.src;
              E.cands.innerHTML = '<p class="gt-small">📌 資料來源：<a class="gt-a" href="' + esc(rs.url) + '" target="_blank" rel="noopener">' +
                esc(rs.org + "〈" + rs.name + "〉") + "</a>（" + esc(rs.date) + "；新舊門牌對照表在這一頁下載）</p>";
              E.cands._list = [];
              E.cands.hidden = false;
            }
          } else if (r.reason === "road-not-found") {
            lookupFail((r.message || "找不到這條路。") + " 請檢查路名，或直接點地圖。", r.reason);
            if (r.candidates && r.candidates.length) showCands(r.candidates, "你要找的是不是：");
            else typoCands(q).then(function (c) { if (c.length) showCands(c, "你要找的是不是："); });
          } else if (r.reason === "not-taichung") { // tc-addr.js 新版自己會判斷外縣市
            lookupFail((r.message || "這個工具只查臺中市的地址。") + "其他縣市的垃圾車時間，請看當地環保局。", "out-of-city");
          } else if (r.reason === "empty") {
            setStatus("請先輸入地址。", true);
          } else {
            lookupFail("看不出路名。請輸入像「北屯區崇德路二段46號」這樣的地址，或直接點地圖。", r.reason);
          }
        }).catch(function () {
          lookupFail("地址資料載入失敗，請檢查網路後再試；也可以用「用我的位置」或直接點地圖。", "load");
        });
      }

      function runQuery(lat, lng, via, info) {
        var seq = ++S.seq;
        S.pt = { lat: lat, lng: lng };
        S.via = via;
        S.label = info.label || "";
        S.note = info.note || "";
        S.dist = info.dist || "";
        S.limit = PAGE;
        markStale(false);
        closeRoute(true);
        if (E.empty) E.empty.hidden = true;
        setStatus("查詢附近清運點中……");
        drawQuery(true);
        if (!BOOT) { setStatus("清運點資料沒有載入，請重新整理再試。", true); return; }
        stopsNear(lat, lng, 500).then(function (list) {
          if (seq !== S.seq) return;
          S.all = list;
          if (!S.dist && list.length) S.dist = list[0].s.dist;
          renderAll(true);
          var n = inR().length;
          setStatus(n ? (map ? "想改查別的位置：點地圖，再按「改查這個位置」。" : "查好了，結果在下面。") : "這個位置附近沒有清運點資料，可以換個位置或放大範圍。");
          track("gt_query", { result: n ? "ok" : "empty", via: via, district: S.dist || "", radius: S.radius });
          maybeScroll();
        }).catch(function () {
          if (seq !== S.seq) return;
          setStatus("清運點資料載入失敗，請檢查網路後再試一次。", true);
          track("gt_query", { result: "fail", reason: "load", via: via });
        });
      }

      function maybeScroll() {
        if (window.innerWidth >= 1024) return;
        var r = E.summary.getBoundingClientRect();
        if (r.top > window.innerHeight * 0.55 || r.top < 0) {
          E.summary.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }

      function drawQuery(fit) {
        if (!map || !S.pt) return;
        qLayer.clearLayers();
        L.marker([S.pt.lat, S.pt.lng], { icon: pinIcon, interactive: false, keyboard: false }).addTo(qLayer);
        qCircle = L.circle([S.pt.lat, S.pt.lng], { radius: S.radius, color: "#8a6539", weight: 2, fillOpacity: 0.05, interactive: false }).addTo(qLayer);
        if (fit) map.fitBounds(qCircle.getBounds(), { padding: [16, 16] });
      }

      function renderAll(fit) {
        drawQuery(fit);
        renderSummary();
        renderList();
        if (live.on && live.data) drawLive(live.data);
      }

      /* ---------- 查詢結果摘要（最重要的答案放最上面） ---------- */
      function renderSummary() {
        var now = twNow();
        var items = inR();
        var R = S.radius;
        var th = holOn(now.ymd);
        var h = ['<div class="gt-card">'];
        var kicker = S.via === "address" ? "你查的地址" : S.via === "geo" ? "你目前的位置" : "你在地圖上點的位置";
        h.push('<p class="gt-kicker">' + kicker + "</p>");
        if (S.label) h.push('<p class="gt-sum-title">' + esc(S.label) + "</p>");
        if (S.note) h.push('<p class="gt-note">' + esc(S.note) + "</p>");

        // 建置時抽查官方查詢系統，發現整區班表已經改了 → 最上面先講清楚
        var fl = [];
        if (S.dist && driftFlag(S.dist)) fl.push(S.dist);
        items.forEach(function (it) { if (driftFlag(it.s.dist) && fl.indexOf(it.s.dist) === -1) fl.push(it.s.dist); });
        // 整區沒被標、但路線抽查到不同（同一台車的點一起標）→ 每條路線講一次就好；卡片上只放徽章，說明集中在這一格
        var rl = [];
        items.forEach(function (it) {
          var s = it.s;
          if ((s.od === 1 || s.od === 2) && !driftFlag(s.dist) && driftRoute(s.route) && rl.indexOf(s.route) === -1) rl.push(s.route);
        });
        var dl = fl.map(function (d) { return esc((BOOT.drift.msg && BOOT.drift.msg[d]) || ""); })
          .concat(rl.map(function (plate) { return esc(driftRoute(plate).msg); }));
        if (dl.length) {
          var who = fl.map(function (d) { return esc(d) + "的點"; }).concat(rl.map(function (plate) { return "車號 " + esc(plate) + " 經過的點"; })).join("、");
          var dlP = dl.map(function (x) { return "<p>" + x + "</p>"; }).join("");
          var ddTxt = driftDate() ? "（官方 " + driftDate() + " 抽查）" : "";
          // 電腦版（≥1024px）整段攤開，跟以前一樣
          h.push('<div class="gt-drift gt-drift-big gt-drift-desk">' + dlP +
            "<p>" + who + "都標了「時間可能已改」，請以" + officialA("官方查詢") + "或官方 APP 為準。</p></div>");
          // 手機版：中區這種整區＋路線雙重警示攤開要 360～440px，會把地圖推到快兩個螢幕以下 →
          // 只留一句摘要＋官方查詢連結，抽查細節收進「展開說明」
          h.push('<div class="gt-drift gt-drift-big gt-drift-mob"><p><b>' + who + "，時間可能已改</b>" + ddTxt +
            "，請以" + officialA("官方查詢") + "為準。</p>" +
            '<details class="gt-drift-more"><summary>展開說明</summary>' + dlP +
            "<p>下面清單裡這些點都標了「時間可能已改」，也可以用官方 APP 查。</p></details></div>");
        }

        var t = teamOf(S.dist);
        if (!items.length) {
          var more = S.all.length && R < 500 ? "改成 500 公尺，還有 " + S.all.length + " 個點。" :
            "山區、工業區、新開的路，或台中市以外的地方，開放資料可能沒有清運點；可以直接問當地清潔隊" +
            (t ? "（電話在下面）。" : "（" + '<a class="gt-a" href="' + esc(BOOT.teamPage) + '" rel="noopener" target="_blank">各區清潔隊電話</a>）。');
          h.push('<p class="gt-sum-count">' + (S.all.length ? R : 500) + " 公尺內沒有清運點。" + more + "</p>");
        } else {
          // 時間可能已改的點（整區已改、或這點抽查不同）不拿來算「今天幾點」
          var good = items.filter(function (it) { return !isDrift(it.s); });
          var nDrift = items.length - good.length;
          h.push('<p class="gt-sum-count">' + R + " 公尺內有 <b>" + items.length + "</b> 個清運點</p>");
          h.push('<ul class="gt-facts">');
          if (th) {
            h.push('<li class="gt-warn">今天 ' + dlabel(now.ymd) + "是<b>" + esc(th.name) + "</b>，沿街收運暫停，改看下面的國定假日定點。</li>");
          } else if (!good.length) {
            h.push("<li>這附近的點，開放資料的時間可能已經過時；今天幾點收，請直接看" + officialA("官方查詢") + "。</li>");
          } else {
            var todays = [];
            good.forEach(function (it) { var g = segs(it.s.g[now.slot]); if (g.length) todays.push({ it: it, g: g }); });
            if (!todays.length) {
              h.push("<li>今天 " + dlabel(now.ymd) + "：這附近的點今天都<b>沒有排垃圾車</b>。</li>");
            } else {
              var first = 1e9, last = -1, lastIt = null, nx = null, nxIt = null;
              todays.forEach(function (x) {
                x.g.forEach(function (sg) {
                  if (sg.a < first) first = sg.a;
                  if (sg.a > last || (sg.a === last && x.it.d < lastIt.d)) { last = sg.a; lastIt = x.it; }
                  if (sg.b + 5 >= now.min && (!nx || sg.a < nx.a || (sg.a === nx.a && x.it.d < nxIt.d))) { nx = sg; nxIt = x.it; }
                });
              });
              var rc = 0;
              good.forEach(function (it) { if (segs(it.s.r[now.slot]).length) rc++; });
              h.push("<li>今天 " + dlabel(now.ymd) + "：<b>" + todays.length + "</b> 個點有垃圾車（" + hm(first) + "～" + hm(last) + "）" +
                (rc ? "，" + rc + " 個點有資源回收" : "") + "。</li>");
              if (nx) {
                h.push("<li>接下來最早的一班：<b>" + segTxt(nx) + "</b>・" + dtxt(nxIt) + "・" + esc(nxIt.s.place) + "</li>");
              } else {
                h.push("<li>照班表，今天這附近的垃圾車<b>都已經過了</b>。</li>");
              }
              h.push("<li>今天最晚一班：<b>" + hm(last) + "</b>・" + dtxt(lastIt) + "・" + esc(lastIt.s.place) + "</li>");
            }
            if (nDrift) h.push("<li>另有 " + nDrift + " 個點的時間可能已經改了，沒有算進上面。</li>");
          }
          // 最近的清運點：照實寫真正最近的那一點；它的時間被標「可能已改」時，再補一行時間沒被標的最近點
          var nearTxt = function (it) {
            var k = it.s.kind === "回收" ? "r" : "g";
            var g0 = segs(it.s[k][now.slot]);
            var w = k === "r" ? "資源回收" : "垃圾";
            return th ? "今天是國定假日，改看假日定點" :
              isDrift(it.s) ? "時間可能已改，請看" + officialA("官方查詢") :
              g0.length ? "今天" + w + " " + segsTxt(g0) :
              "今天沒有" + (k === "r" ? "資源回收車" : "垃圾車") + "，下一次 " + nextTxt(nextService(it.s, k, now));
          };
          var n0 = items[0];
          h.push("<li>最近的清運點：" + dtxt(n0) + "・" + esc(n0.s.place) + "（" + esc(n0.s.method) + "）・" + nearTxt(n0) + "</li>");
          if (isDrift(n0.s) && good.length && !th) {
            h.push("<li>時間沒被標記的最近清運點：" + dtxt(good[0]) + "・" + esc(good[0].s.place) + "（" + esc(good[0].s.method) + "）・" + nearTxt(good[0]) + "</li>");
          }
          // 明天
          var tmr = addDays(now.ymd, 1), ts = slotOf(tmr), tHol = holOn(tmr);
          if (tHol) {
            h.push('<li class="gt-warn">明天 ' + dlabel(tmr) + "是<b>" + esc(tHol.name) + "</b>，沿街收運暫停，改定時定點。</li>");
          } else if (good.length) {
            var tc = 0, tf = 1e9, tl = -1;
            good.forEach(function (it) {
              var g = segs(it.s.g[ts]);
              if (g.length) { tc++; if (g[0].a < tf) tf = g[0].a; if (g[g.length - 1].a > tl) tl = g[g.length - 1].a; }
            });
            if (tc) {
              h.push("<li>明天 " + dlabel(tmr) + "：<b>" + tc + "</b> 個點有垃圾車，" + hm(tf) + "～" + hm(tl) + "。</li>");
            } else {
              var nd = null;
              for (var k = 2; k <= 8 && !nd; k++) {
                var y = addDays(now.ymd, k);
                if (holOn(y)) continue;
                var sl = slotOf(y);
                for (var i = 0; i < good.length; i++) if (segs(good[i].s.g[sl]).length) { nd = y; break; }
              }
              h.push("<li>明天 " + dlabel(tmr) + "：這附近<b>沒有點排垃圾車</b>" + (nd ? "，下一次是 " + dlabel(nd) : "") + "。</li>");
            }
          }
          h.push("</ul>");
        }
        // 次要資訊收進「更多」：手機預設收起來，地圖才不會被擠到第二個螢幕以下；電腦版、國定假日當天預設打開
        var hs = holsBetween(now.ymd, addDays(now.ymd, 14));
        var sumLab = hs.map(function (d) { return dlabel(d.date).replace(/（.）/, "") + " " + esc(d.name) + "改定點"; })
          .concat(t ? ["清潔隊電話", "官方查詢"] : ["官方查詢"]).join("・");
        var open = window.innerWidth >= 1024 || !!th;
        h.push('<details class="gt-sum-more"' + (open ? " open" : "") + "><summary>" + sumLab + "</summary>");
        h.push('<div id="gt-holnear"></div>');
        if (t) {
          h.push('<p class="gt-small gt-mt">要丟大型家電、堪用家具：先打給' + esc(teamName(S.dist, t)) + ' <a class="gt-a" href="tel:' + esc(t.tel) + '">' + esc(t.tel) +
            "</a> 約時間（" + '<a class="gt-a" href="https://recycle.epb.taichung.gov.tw/other/other10.asp" rel="noopener" target="_blank">資源回收網說明</a>）。</p>');
        }
        h.push('<p class="gt-small gt-mt">實際到點：' + officialA("臺中垃圾清運大車隊查詢") + '或<a class="gt-a" href="#gt-official">官方 APP</a>。</p>');
        h.push("</details>");
        h.push("</div>");
        E.summary.innerHTML = h.join("");
        E.summary.hidden = false;
        // 摘要已經講了今天、明天、國定假日，上面的「今天」卡收起來，避免同一件事講兩遍
        E.today.hidden = true;
        if (S.stale) markStale(true); // 換範圍重畫時，「這是上一次的結果」提示要留著
        renderHolNear();
      }

      // 今天或 14 天內有國定假日 → 列最近的 3 個假日定點
      function renderHolNear() {
        var box = $("gt-holnear");
        if (!box || !S.pt) return;
        var now = twNow();
        var hs = holsBetween(now.ymd, addDays(now.ymd, 14));
        if (hLayer) hLayer.clearLayers();
        if (!hs.length) { box.innerHTML = ""; return; }
        var todayHol = !!holOn(now.ymd);
        var head = '<div class="gt-holnear"><p><b>' + hs.map(function (d) { return (d.date === now.ymd ? "今天 " : "") + dlabel(d.date) + esc(d.name); }).join("、") +
          "</b>：停止沿街垃圾收運，改為定時定點（<a class=\"gt-a\" href=\"" + esc(BOOT.hol.announcement) + "\" rel=\"noopener\" target=\"_blank\">環保局公告</a>）。</p>";
        if (S.dist && BOOT.hol.noData.indexOf(S.dist) !== -1) {
          box.innerHTML = head + "<p>" + esc(BOOT.hol.noDataNote) + "</p></div>";
          return;
        }
        box.innerHTML = head + '<p class="gt-small">正在找附近的假日定點……</p></div>';
        var seq = S.seq;
        loadHoliday().then(function (hd) {
          if (seq !== S.seq) return;
          // 只列 3 公里內的；更遠的不說「離你最近」（山區、市界附近常會對到別區很遠的定點）
          var arr = hd.stops.map(function (s) { return { s: s, d: haversine(S.pt.lat, S.pt.lng, s.lat, s.lng) }; })
            .filter(function (x) { return x.d <= 3000; })
            .sort(function (a, b) { return a.d - b.d; }).slice(0, 3);
          var line = function (x) {
            return mtxt(x.d) + "・<b>" + esc(x.s.start) + "–" + esc(x.s.end) + "</b>・" + esc(x.s.place) + "（" + esc(x.s.dist) + esc(x.s.li) + "）";
          };
          var h = [head];
          if (!arr.length) {
            h.push("<p>3 公里內沒有國定假日定點" + (S.dist && BOOT.hol.pdf[S.dist] ? "，下面可以看" + esc(S.dist) + "完整的定點班表，或問清潔隊" : "，請看環保局公告附的各區定點表，或問當地清潔隊") + "。</p>");
          } else if (todayHol) {
            // 今天就是國定假日：三個都攤開
            h.push("<p>離你最近的假日定點" + (map ? "（地圖上紫色 1～3）" : "") + "：</p><ol class=\"gt-ol\">");
            arr.forEach(function (x) { h.push("<li>" + line(x) + "</li>"); });
            h.push("</ol>");
          } else if (arr.length) {
            h.push("<p>當天離你最近的假日定點" + (map ? "（地圖上紫色 1）" : "") + "：" + line(arr[0]) + "</p>");
            if (arr.length > 1) {
              h.push('<details class="gt-more-d"><summary>再看 ' + (arr.length - 1) + ' 個</summary><ol class="gt-ol" start="2">');
              arr.slice(1).forEach(function (x) { h.push("<li>" + line(x) + "</li>"); });
              h.push("</ol></details>");
            }
          }
          var dd = S.dist && BOOT.hol.pdf[S.dist] ? S.dist : (arr[0] ? arr[0].s.dist : "");
          if (dd) h.push('<button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-gt-hol="' + esc(dd) + '">看' + esc(dd) + "完整的假日定點班表</button>");
          h.push("</div>");
          box.innerHTML = h.join("");
          if (map) {
            hLayer.clearLayers();
            arr.forEach(function (x, i) {
              L.marker([x.s.lat, x.s.lng], { icon: L.divIcon({ className: "gt-hmk", html: "<span>" + (i + 1) + "</span>", iconSize: [22, 22], iconAnchor: [11, 11] }) })
                .bindPopup('<div class="gt-pop"><strong>國定假日定點 ' + (i + 1) + "</strong><br>" + esc(x.s.place) + "<br>" + esc(x.s.start) + "–" + esc(x.s.end) + "・" + mtxt(x.d) + "</div>", popOpts(E.map))
                .addTo(hLayer);
            });
          }
        }).catch(function () {
          if (seq !== S.seq) return;
          box.innerHTML = head + '<p class="gt-small">假日定點資料載入失敗，請看下方「國定假日定點班表」或環保局公告。</p></div>';
        });
      }

      /* ---------- 清單 ---------- */
      function buildDaySelect() {
        var cur = S.dayOff;
        var h = [];
        for (var k = 0; k < 7; k++) {
          var di = dayInfo(k);
          var lab = (k === 0 ? "今天 " : k === 1 ? "明天 " : "") + dlabel(di.ymd) + (di.hol ? "・" + di.hol.name : "");
          h.push('<option value="' + k + '"' + (k === cur ? " selected" : "") + ">" + esc(lab) + "</option>");
        }
        E.day.innerHTML = h.join("");
      }
      function stateOf(s, day) {
        if (day.hol) return "n";
        if (segs(s.g[day.slot]).length) return "g";
        if (segs(s.r[day.slot]).length) return "r";
        return "n";
      }
      function stHtml(seg, day, s) {
        if (!day.isToday || day.hol || (s && isDrift(s))) return "";
        var st = segState(seg, day.now.min);
        return ' <em class="gt-st gt-st-' + st.k + '" data-a="' + seg.a + '" data-b="' + seg.b + '">' + st.t + "</em>";
      }
      function kindLine(label, cls, arr, day, s) {
        if (!arr.length) return "";
        var first = arr.filter(function (x) { return !day.isToday || x.b + 5 >= day.now.min; })[0] || arr[arr.length - 1];
        return '<div class="gt-kline"><span class="gt-tag ' + cls + '">' + label + "</span> <b>" + segsTxt(arr) + "</b>" + stHtml(first, day, s) + "</div>";
      }
      function weekTable(s, day) {
        var h = ['<table class="gt-week"><thead><tr><th scope="col">星期</th><th scope="col">垃圾・廚餘</th><th scope="col">資源回收</th></tr></thead><tbody>'];
        for (var i = 0; i < 7; i++) {
          var g = segs(s.g[i]), r = segs(s.r[i]);
          h.push("<tr" + (i === day.slot ? ' class="gt-cur"' : "") + "><th scope=\"row\">週" + WD[i] + "</th><td>" + (g.length ? segsTxt(g) : "—") + "</td><td>" + (r.length ? segsTxt(r) : "—") + "</td></tr>");
        }
        h.push("</tbody></table>");
        return h.join("");
      }
      function stopCard(it, day, now) {
        var s = it.s;
        var g = segs(s.g[day.slot]), r = segs(s.r[day.slot]);
        var h = ['<li class="gt-stop" id="gt-s-' + esc(s.id) + '">'];
        var dr = isDrift(s);
        h.push('<div class="gt-stop-top"><span class="gt-dist">' + (isApprox(s) ? dtxt(it).replace("（位置約略）", "") : mtxt(it.d)) + '</span><span class="gt-badge">' + esc(s.method) + "</span>" +
          (s.kind === "回收" ? '<span class="gt-badge">只有資源回收</span>' : "") +
          (isApprox(s) ? '<span class="gt-badge gt-badge-warn" title="這個點只能定位到巷口、路段或村里中心，實際位置請看地點文字">位置約略</span>' : "") +
          (dr ? driftBadge(s) : "") + "</div>");
        h.push('<p class="gt-place">' + esc(s.place) + "</p>");
        h.push('<p class="gt-meta">' + esc(s.dist) + esc(s.li) + "</p>");
        h.push('<div class="gt-dayline' + (dr ? " gt-old" : "") + '">');
        if (day.hol) {
          h.push('<p class="gt-holtag">' + day.full + "是" + esc(day.hol.name) + "：沿街收運暫停，改定時定點。</p>");
        }
        if (g.length || r.length) {
          h.push(kindLine("垃圾・廚餘", "gt-tag-g", g, day, s));
          h.push(kindLine("資源回收", "gt-tag-r", r, day, s));
        } else {
          var base = { ymd: day.ymd, slot: day.slot, min: day.isToday ? now.min : -1 };
          var nx = s.kind === "回收" ? nextService(s, "r", base) : nextService(s, "g", base);
          h.push('<p class="gt-none">' + day.name + "沒有排班・下一次 " + nextTxt(nx) + "</p>");
        }
        h.push("</div>");
        h.push("<details class=\"gt-weekd\"><summary>一週班表</summary>" + weekTable(s, day) +
          (s.route ? '<p class="gt-small">開放資料登記的車號：' + esc(s.route) + "（環保局可能已經換車）</p>" : "") + "</details>");
        h.push('<div class="gt-actions">' + (map ? '<button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-act="map" data-id="' + esc(s.id) + '">在地圖上看</button>' : ""));
        if (s.route) h.push('<button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-act="route" data-route="' + esc(s.route) + '" data-id="' + esc(s.id) + '">看這條路線</button>');
        h.push("</div></li>");
        return h.join("");
      }
      function sortedItems(day) {
        var list = inR().map(function (it) {
          var g = segs(it.s.g[day.slot]), r = segs(it.s.r[day.slot]);
          var first = g[0] || r[0];
          return { s: it.s, d: it.d, key: first ? first.a : 1e9, any: !!(g.length || r.length) };
        });
        if (S.only) list = list.filter(function (x) { return x.any; });
        if (S.sort === "time") list.sort(function (a, b) { return a.key - b.key || a.d - b.d; });
        else list.sort(function (a, b) { return a.d - b.d; });
        return list;
      }
      function renderList() {
        var day = dayInfo(S.dayOff);
        var now = twNow();
        var all = inR();
        if (!all.length) { E.listwrap.hidden = true; E.list.innerHTML = ""; E.dayinfo.innerHTML = ""; drawStops([], day); return; }
        E.listwrap.hidden = false;
        var list = sortedItems(day);
        var info = [];
        if (day.hol) {
          info.push('<p class="gt-warn-box">' + day.full + "是<b>" + esc(day.hol.name) + "</b>：環保局公告停止沿街垃圾收運，改為定時定點。下面是平常的班表，當天請改用國定假日定點（" +
            '<a class="gt-a" href="#gt-hol">看假日定點班表</a>）。</p>');
        }
        if (BOOT.hol.year && Number(day.ymd.slice(0, 4)) > BOOT.hol.year) {
          info.push('<p class="gt-warn-box">本站只有 ' + BOOT.hol.yearRoc + " 年的國定假日資料。" + day.full + "如果是國定假日，請看" +
            '<a class="gt-a" href="https://cleaner.epb.taichung.gov.tw/schedule.aspx" rel="noopener" target="_blank">臺中垃圾清運大車隊國定假日定點班表</a>。</p>');
        }
        if (day.hol) {
          info.push('<p class="gt-small">' + day.full + "：" + S.radius + " 公尺內 " + all.length + " 個點。這天是國定假日，下面平常的班表只供對照。</p>");
        } else {
          var active = 0, drn = 0;
          all.forEach(function (it) {
            if (segs(it.s.g[day.slot]).length || segs(it.s.r[day.slot]).length) active++;
            if (isDrift(it.s)) drn++;
          });
          info.push('<p class="gt-small">' + day.full + "：" + S.radius + " 公尺內 " + all.length + " 個點，其中 " + active + " 個這天有車" +
            (drn ? "（" + drn + " 個點的時間可能已經改了）" : "") + "。時間是環保局預定班表，僅供參考，以官方公告為準。</p>");
        }
        E.dayinfo.innerHTML = info.join("");
        var shown = list.slice(0, S.limit);
        E.list.innerHTML = shown.length ? shown.map(function (it) { return stopCard(it, day, now); }).join("") :
          '<li class="gt-none">這天附近沒有排班的點。</li>';
        E.more.hidden = list.length <= S.limit;
        E.more.textContent = "再顯示 " + Math.min(PAGE, list.length - S.limit) + " 個（共 " + list.length + " 個）";
        drawStops(all, day);
        updateLegend(day);
      }
      function updateLegend(day) {
        day = day || dayInfo(S.dayOff);
        var lab = day.isToday ? "今天" : dlabel(day.ymd);
        E.legend.innerHTML =
          '<span><i class="gt-dot gt-dot-g"></i>' + lab + "有垃圾車</span>" +
          '<span><i class="gt-dot gt-dot-r"></i>只有資源回收</span>' +
          '<span><i class="gt-dot gt-dot-n"></i>' + (day.hol ? "國定假日（沿街暫停）" : "沒排班") + "</span>" +
          '<span><i class="gt-sq"></i>國定假日定點</span>' +
          (live.on ? '<span><i class="gt-tk"></i>垃圾車大約位置</span>' : "");
      }
      function popupHtml(it, day) {
        var s = it.s;
        var g = segs(s.g[day.slot]), r = segs(s.r[day.slot]);
        var lab = day.isToday ? "今天" : dlabel(day.ymd);
        return '<div class="gt-pop"><strong>' + esc(s.place) + "</strong>" +
          '<div class="gt-pop-sub">' + dtxt(it) + "・" + esc(s.method) + "</div>" +
          (isDrift(s) ? '<div class="gt-pop-warn">' + esc(driftWhy(s)) + "；下面是開放資料的時間，請以" + officialA("官方查詢") + "為準</div>" : "") +
          (day.hol ? '<div class="gt-pop-warn">' + esc(day.hol.name) + "：沿街收運暫停，改定時定點</div>" : "") +
          "<div>" + lab + " 垃圾・廚餘：" + (g.length ? "<b>" + segsTxt(g) + "</b>" : "沒排班") + "</div>" +
          "<div>" + lab + " 資源回收：" + (r.length ? "<b>" + segsTxt(r) + "</b>" : "沒排班") + "</div>" +
          '<button type="button" class="gt-linkbtn" data-gt-go="' + esc(s.id) + '">看一週班表</button></div>';
