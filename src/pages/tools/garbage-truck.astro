      }
      function isApprox(s) { return BOOT && BOOT.geoApprox && BOOT.geoApprox.indexOf(s.geo) !== -1; }
      // 位置約略的點（巷口、路段、村里中心）不給精確公尺數，只給到百公尺
      function dtxt(it) {
