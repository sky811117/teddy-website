      }

      function addLayers() {
        ["q", "route", "routePts", "stops", "near", "nearPt"].forEach(function (k) { M.addSource("gt-" + k, { type: "geojson", data: MS[k] }); });
        var col = stCol();
        var a = accent(), dk = isDark();
        var L = function (o) { M.addLayer(o); };
        L({ id: "gt-q-fill", type: "fill", source: "gt-q", paint: { "fill-color": "#e0a95a", "fill-opacity": 0.09 } });
        L({ id: "gt-q-glow", type: "line", source: "gt-q", paint: { "line-color": "#f2c27c", "line-width": 10, "line-blur": 9, "line-opacity": 0.45 } });
        L({ id: "gt-q-pulse", type: "line", source: "gt-q", paint: { "line-color": "#f5c983", "line-width": 3, "line-blur": 2.5, "line-opacity": 0 } });
