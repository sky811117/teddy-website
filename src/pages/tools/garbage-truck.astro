      }
      function closePop() { if (popMain.cur) popMain.cur.remove(); }

      // cine-map 的 flyTo／fitBounds 會自己取消開場飛行：地圖還沒捲進畫面時先查詢，之後捲到地圖也不會飛回台中全景
      function camTo(ll, z) { if (!mapOK()) return Promise.resolve(); return cm.flyTo(ll, z); }
      function camFit(b, o) { if (!mapOK()) return Promise.resolve(); return cm.fitBounds(b, o); }
      // 查詢範圍圈塞得進地圖的縮放（MapLibre 512 圖磚：每像素公尺 = 40075016.686·cos(緯度) / (512·2^z)）
      function zoomFor(R) {
