        L({ id: "gt-route-line", type: "line", source: "gt-route", layout: { "line-join": "round" },
          paint: { "line-color": a, "line-width": 3.2, "line-dasharray": DASH[0] } });
        L({ id: "gt-route-pts", type: "circle", source: "gt-routePts",
