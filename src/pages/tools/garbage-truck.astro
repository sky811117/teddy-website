      var TC_TOWNS = ["豐原", "大里", "太平", "東勢", "大甲", "清水", "沙鹿", "梧棲", "后里", "神岡", "潭子", "大雅", "新社", "石岡",
        "外埔", "大安", "烏日", "大肚", "龍井", "霧峰", "和平"];
      var SEC_CN = ["", "一段", "二段", "三段", "四段", "五段", "六段", "七段", "八段", "九段"];
      function normAddr(q) { return String(q || "").replace(/[\s　]/g, "").replace(/台/g, "臺").replace(/^\d{3,6}/, ""); }
      function stripSec(r) { return String(r || "").replace(/[一二三四五六七八九十]+段$/, ""); }
      // 使用者寫了別的縣市，或寫了臺中沒有的「X區」（例：信義區市府路1號）→ 不要硬比成臺中的同名路
      function outOfCity(q, r) {
        var n = normAddr(q);
        for (var i = 0; i < OTHER_CITY.length; i++) if (n.indexOf(OTHER_CITY[i]) === 0) return OTHER_CITY[i];
        if (n.indexOf("臺中") === 0 || !r || !window.TcAddr.parse) return "";
        var p = window.TcAddr.parse(q);
        if (!p || p.dist) return "";
        var road = r.ok ? stripSec(r.road) : (r.candidates && r.candidates[0] ? stripSec(r.candidates[0].road) : "");
        var pr = String(p.road || "");
        if (!road || pr.length <= road.length || pr.slice(pr.length - road.length) !== road) return "";
        var m = pr.slice(0, pr.length - road.length).match(/([\u4e00-\u9fff]{1,3})([區鄉鎮市縣])$/);
        if (!m) return "";
        if (TC_TOWNS.indexOf(m[1]) !== -1 || (BOOT.distTeam && BOOT.distTeam[m[1] + "區"])) return "";
        return m[0];
      }
      var roadIdxP = null;
      function typoCands(q) {
        var p = window.TcAddr.parse ? window.TcAddr.parse(q) : null;
        if (!p || !p.road || !p.no) return Promise.resolve([]);
        if (!roadIdxP) roadIdxP = getJSON("/data/tc-addr/index.json" + (BOOT.vIdx ? "?v=" + encodeURIComponent(BOOT.vIdx) : "")).catch(function (e) { roadIdxP = null; throw e; });
        return roadIdxP.then(function (ix) {
          var di = -1;
          if (p.dist) for (var i = 0; i < ix.d.length; i++) if (ix.d[i][1] === p.dist) di = i;
          var want = String(p.road), out = [];
          Object.keys(ix.r).forEach(function (k) {
            if (out.length >= 6) return;
            var base = stripSec(k);
            if (base.length !== want.length || base === want) return;
            var diff = 0;
            for (var j = 0; j < base.length && diff < 2; j++) if (base[j] !== want[j]) diff++;
            if (diff !== 1) return;
