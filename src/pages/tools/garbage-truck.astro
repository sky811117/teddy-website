      function runQuery(lat, lng, via, info) {
        var seq = ++S.seq;
        S.pt = { lat: lat, lng: lng };
        S.via = via;
        S.label = info.label || "";
        S.note = info.note || "";
        S.dist = info.dist || "";
        S.limit = PAGE;
        markStale(false);
        closeRoute(true);
        if (E.empty) E.empty.hidden = true;
        setStatus("查詢附近清運點中……");
        // 第一次查詢還沒有結果可看 → 骨架閃光（之後重查時保留上一次的結果，換好再依序滑入）
        if (E.skel) E.skel.hidden = !E.summary.hidden;
        drawQuery(true);
        if (!BOOT) { if (E.skel) E.skel.hidden = true; setStatus("清運點資料沒有載入，請重新整理再試。", true); return; }
        stopsNear(lat, lng, 500).then(function (list) {
          if (seq !== S.seq) return;
          if (E.skel) E.skel.hidden = true;
          S.all = list;
          if (!S.dist && list.length) S.dist = list[0].s.dist;
          renderAll(true);
          var n = inR().length;
          setStatus(n ? (mapOK() ? "想改查別的位置：點地圖，再按「改查這個位置」。" : "查好了，結果在下面。") : "這個位置附近沒有清運點資料，可以換個位置或放大範圍。");
          track("gt_query", { result: n ? "ok" : "empty", via: via, district: S.dist || "", radius: S.radius });
          maybeScroll();
        }).catch(function () {
          if (seq !== S.seq) return;
          if (E.skel) E.skel.hidden = true;
          setStatus("清運點資料載入失敗，請檢查網路後再試一次。", true);
          track("gt_query", { result: "fail", reason: "load", via: via });
        });
      }

      function maybeScroll() {
        if (window.innerWidth >= 1024) return;
        var tgt = E.next && !E.next.hidden ? E.next : E.summary; // 下一班倒數在摘要正上方，一起帶進畫面
        var r = tgt.getBoundingClientRect();
        if (r.top > window.innerHeight * 0.55 || r.top < 0) {
          tgt.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      }

      // 查詢點：圖釘（落下＋地面光環）＋範圍圈（填色＋描邊＋擴散光環）；鏡頭帶轉場飛過去
      // 同一次查詢重畫（資料載好、換範圍）不重丟圖釘、不重飛，只調範圍
      var qKey = "", qR = 0;
      function drawQuery(fit) {
        if (!mapOK() || !S.pt) return;
        var ll = [S.pt.lng, S.pt.lat];
        setSrc("q", fcol([CM.circle(ll, S.radius, 96)]));
        var k = S.seq + ":" + ll.join(",");
        if (k !== qKey) {
          qKey = k;
          qR = S.radius;
          cm.clearPins();
          cm.addPulsePin(ll, { variant: S.via === "geo" ? "dot" : "pin", label: qLabel() });
          if (fit) camTo(ll, zoomFor(S.radius));
          fxArmPulse();
        } else if (fit && qR !== S.radius) {
          qR = S.radius;
          if (M && !RM) { cm.cancelIntro(); M.easeTo({ center: ll, zoom: zoomFor(S.radius), duration: 1100, essential: true }); }
          else camTo(ll, zoomFor(S.radius));
          fxArmPulse();
        }
        fxKick();
      }

      function renderAll(fit) {
        drawQuery(fit);
        renderSummary();
        renderList();
        if (live.on && live.data) drawLive(live.data);
      }

      /* ---------- 下一班倒數（摘要上方的光圈） ----------
       * 跟摘要「接下來最早的一班」同一套判斷：只看時間沒被標「可能已改」的點、國定假日當天沿街暫停、
       * 班次結束 5 分鐘內還算「這時候會到」。今天沒有（或都過了）→ 只寫下一次的日期時間，不倒數。 */
      var RING_MIN = 60; // 圓環代表 60 分鐘：一小時內才開始往下走
      function nextPickup() {
        var now = twNow();
        var good = inR().filter(function (it) { return !isDrift(it.s); });
        if (!good.length) return null;
        var th = holOn(now.ymd), any = false, nx = null, nxIt = null;
        if (!th) {
          good.forEach(function (it) {
            segs(it.s.g[now.slot]).forEach(function (sg) {
              any = true;
              if (sg.b + 5 >= now.min && (!nx || sg.a < nx.a || (sg.a === nx.a && it.d < nxIt.d))) { nx = sg; nxIt = it; }
            });
          });
          if (nx) return { now: now, today: true, seg: nx, it: nxIt };
        }
        var why = th ? "hol" : any ? "past" : "none";
        for (var k = 1; k <= 14; k++) {
          var y = addDays(now.ymd, k);
          if (holOn(y)) continue;
          var sl = slotOf(y), b = null, bIt = null;
          for (var i = 0; i < good.length; i++) {
            var g = segs(good[i].s.g[sl]);
            if (g.length && (!b || g[0].a < b.a || (g[0].a === b.a && good[i].d < bIt.d))) { b = g[0]; bIt = good[i]; }
          }
          if (b) return { now: now, today: false, ymd: y, seg: b, it: bIt, why: why, hol: th };
        }
        return { now: now, today: false, why: why, hol: th };
      }
      function nw(t) { return '<span class="gt-nw">' + esc(t) + "</span>"; } // 時間區段不要從中間斷行
      function renderNext(replay) {
        var el = E.next;
        if (!el) return;
        var n = S.pt && !E.summary.hidden ? nextPickup() : null;
        if (!n) { el.hidden = true; return; }
        var R = el._r;
        if (!R) {
          R = el._r = { arc: el.querySelector(".gt-ring-arc"), tip: el.querySelector(".gt-ring-tipr") };
          Array.prototype.forEach.call(el.querySelectorAll("[data-n]"), function (x) { R[x.getAttribute("data-n")] = x; });
        }
        var st, frac = 0, big = "—", small = "", main, sub = "", where = n.it ? dtxt(n.it) + "・" + n.it.s.place : "";
        if (n.today) {
          var m = n.seg.a - n.now.min;
          st = m <= 0 ? "now" : "soon";
          frac = m <= 0 ? 1 : Math.min(1, m / RING_MIN);
          main = m <= 0 ? "照班表，車子這時候會到" :
            "還有約 " + (m < 60 ? m + " 分鐘" : Math.floor(m / 60) + " 小時" + (m % 60 ? " " + (m % 60) + " 分" : ""));
          big = hm(n.seg.a);
          small = "今天";
          sub = "垃圾・廚餘 " + nw(segTxt(n.seg));
        } else {
          st = "later";
          main = n.why === "hol" ? "今天" + n.hol.name + "，沿街收運暫停" :
            n.why === "past" ? "今天這附近的班次，照班表都已經過了" : "今天這附近沒有排垃圾車";
          if (n.seg) {
            var tmr = n.ymd === addDays(n.now.ymd, 1);
            big = +n.ymd.slice(5, 7) + "/" + +n.ymd.slice(8, 10);
            small = tmr ? "明天" : "週" + WD[slotOf(n.ymd)];
            sub = "下一班：" + nw((tmr ? "明天 " : "") + dlabel(n.ymd)) + " " + nw(segTxt(n.seg));
          } else {
            sub = esc("兩週內查不到排班");
          }
        }
        R.big.textContent = big;
        R.small.textContent = small;
        R.main.textContent = main;
        R.sub.innerHTML = sub; // 只有 esc 過的日期時間（nw），沒有外來字串
        R.where.textContent = where;
        R.where.hidden = !where;
        R.orb.className = "cine-orb cine-orb--sm " + (st === "soon" ? "cine-orb--green" : st === "now" ? "cine-orb--yellow" : "cine-orb--grey");
        ["soon", "now", "later"].forEach(function (x) { el.classList.toggle("is-" + x, x === st); });
        R.arc.style.strokeDashoffset = String(100 - frac * 100);
        R.tip.style.transform = "rotate(" + (frac * 360).toFixed(1) + "deg)";
        var wasHidden = el.hidden;
        el.hidden = false;
        if (replay && !wasHidden && !RM) { // 新結果：光圈重掃一次
          el.classList.remove("is-in");
          void el.offsetWidth;
        }
        el.classList.add("is-in");
      }

      /* ---------- 查詢結果摘要（最重要的答案放最上面） ---------- */
      function renderSummary() {
        var now = twNow();
        var items = inR();
        var R = S.radius;
        var th = holOn(now.ymd);
        var h = ['<div class="gt-card">'];
        var kicker = S.via === "address" ? "你查的地址" : S.via === "geo" ? "你目前的位置" : "你在地圖上點的位置";
        h.push('<p class="gt-kicker">' + kicker + "</p>");
        if (S.label) h.push('<p class="gt-sum-title">' + esc(S.label) + "</p>");
        if (S.note) h.push('<p class="gt-note">' + esc(S.note) + "</p>");

        // 建置時抽查官方查詢系統，發現整區班表已經改了 → 最上面先講清楚
        var fl = [];
        if (S.dist && driftFlag(S.dist)) fl.push(S.dist);
        items.forEach(function (it) { if (driftFlag(it.s.dist) && fl.indexOf(it.s.dist) === -1) fl.push(it.s.dist); });
        // 整區沒被標、但路線抽查到不同（同一台車的點一起標）→ 每條路線講一次就好；卡片上只放徽章，說明集中在這一格
        var rl = [];
        items.forEach(function (it) {
          var s = it.s;
          if ((s.od === 1 || s.od === 2) && !driftFlag(s.dist) && driftRoute(s.route) && rl.indexOf(s.route) === -1) rl.push(s.route);
        });
        var dl = fl.map(function (d) { return esc((BOOT.drift.msg && BOOT.drift.msg[d]) || ""); })
          .concat(rl.map(function (plate) { return esc(driftRoute(plate).msg); }));
        if (dl.length) {
          var who = fl.map(function (d) { return esc(d) + "的點"; }).concat(rl.map(function (plate) { return "車號 " + esc(plate) + " 經過的點"; })).join("、");
          var dlP = dl.map(function (x) { return "<p>" + x + "</p>"; }).join("");
          var ddTxt = driftDate() ? "（官方 " + driftDate() + " 抽查）" : "";
          // 電腦版（≥1024px）整段攤開，跟以前一樣
          h.push('<div class="gt-drift gt-drift-big gt-drift-desk">' + dlP +
            "<p>" + who + "都標了「時間可能已改」，請以" + officialA("官方查詢") + "或官方 APP 為準。</p></div>");
          // 手機版：中區這種整區＋路線雙重警示攤開要 360～440px，會把地圖推到快兩個螢幕以下 →
          // 只留一句摘要＋官方查詢連結，抽查細節收進「展開說明」
          h.push('<div class="gt-drift gt-drift-big gt-drift-mob"><p><b>' + who + "，時間可能已改</b>" + ddTxt +
            "，請以" + officialA("官方查詢") + "為準。</p>" +
            '<details class="gt-drift-more"><summary>展開說明</summary>' + dlP +
            "<p>下面清單裡這些點都標了「時間可能已改」，也可以用官方 APP 查。</p></details></div>");
        }

        var t = teamOf(S.dist);
        if (!items.length) {
          var more = S.all.length && R < 500 ? "改成 500 公尺，還有 " + S.all.length + " 個點。" :
            "山區、工業區、新開的路，或台中市以外的地方，開放資料可能沒有清運點；可以直接問當地清潔隊" +
            (t ? "（電話在下面）。" : "（" + '<a class="gt-a" href="' + esc(BOOT.teamPage) + '" rel="noopener" target="_blank">各區清潔隊電話</a>）。');
          h.push('<p class="gt-sum-count">' + (S.all.length ? R : 500) + " 公尺內沒有清運點。" + more + "</p>");
        } else {
          // 時間可能已改的點（整區已改、或這點抽查不同）不拿來算「今天幾點」
          var good = items.filter(function (it) { return !isDrift(it.s); });
          var nDrift = items.length - good.length;
          h.push('<p class="gt-sum-count">' + R + " 公尺內有 <b>" + items.length + "</b> 個清運點</p>");
          h.push('<ul class="gt-facts">');
          if (th) {
            h.push('<li class="gt-warn">今天 ' + dlabel(now.ymd) + "是<b>" + esc(th.name) + "</b>，沿街收運暫停，改看下面的國定假日定點。</li>");
          } else if (!good.length) {
            h.push("<li>這附近的點，開放資料的時間可能已經過時；今天幾點收，請直接看" + officialA("官方查詢") + "。</li>");
          } else {
            var todays = [];
            good.forEach(function (it) { var g = segs(it.s.g[now.slot]); if (g.length) todays.push({ it: it, g: g }); });
            if (!todays.length) {
              h.push("<li>今天 " + dlabel(now.ymd) + "：這附近的點今天都<b>沒有排垃圾車</b>。</li>");
            } else {
              var first = 1e9, last = -1, lastIt = null, nx = null, nxIt = null;
              todays.forEach(function (x) {
                x.g.forEach(function (sg) {
                  if (sg.a < first) first = sg.a;
                  if (sg.a > last || (sg.a === last && x.it.d < lastIt.d)) { last = sg.a; lastIt = x.it; }
                  if (sg.b + 5 >= now.min && (!nx || sg.a < nx.a || (sg.a === nx.a && x.it.d < nxIt.d))) { nx = sg; nxIt = x.it; }
                });
              });
              var rc = 0;
              good.forEach(function (it) { if (segs(it.s.r[now.slot]).length) rc++; });
              h.push("<li>今天 " + dlabel(now.ymd) + "：<b>" + todays.length + "</b> 個點有垃圾車（" + hm(first) + "～" + hm(last) + "）" +
                (rc ? "，" + rc + " 個點有資源回收" : "") + "。</li>");
              if (nx) {
                h.push("<li>接下來最早的一班：<b>" + segTxt(nx) + "</b>・" + dtxt(nxIt) + "・" + esc(nxIt.s.place) + "</li>");
              } else {
                h.push("<li>照班表，今天這附近的垃圾車<b>都已經過了</b>。</li>");
              }
              h.push("<li>今天最晚一班：<b>" + hm(last) + "</b>・" + dtxt(lastIt) + "・" + esc(lastIt.s.place) + "</li>");
            }
            if (nDrift) h.push("<li>另有 " + nDrift + " 個點的時間可能已經改了，沒有算進上面。</li>");
          }
          // 最近的清運點：照實寫真正最近的那一點；它的時間被標「可能已改」時，再補一行時間沒被標的最近點
          var nearTxt = function (it) {
            var k = it.s.kind === "回收" ? "r" : "g";
            var g0 = segs(it.s[k][now.slot]);
            var w = k === "r" ? "資源回收" : "垃圾";
            return th ? "今天是國定假日，改看假日定點" :
              isDrift(it.s) ? "時間可能已改，請看" + officialA("官方查詢") :
              g0.length ? "今天" + w + " " + segsTxt(g0) :
              "今天沒有" + (k === "r" ? "資源回收車" : "垃圾車") + "，下一次 " + nextTxt(nextService(it.s, k, now));
          };
          var n0 = items[0];
          h.push("<li>最近的清運點：" + dtxt(n0) + "・" + esc(n0.s.place) + "（" + esc(n0.s.method) + "）・" + nearTxt(n0) + "</li>");
          if (isDrift(n0.s) && good.length && !th) {
            h.push("<li>時間沒被標記的最近清運點：" + dtxt(good[0]) + "・" + esc(good[0].s.place) + "（" + esc(good[0].s.method) + "）・" + nearTxt(good[0]) + "</li>");
          }
          // 明天
          var tmr = addDays(now.ymd, 1), ts = slotOf(tmr), tHol = holOn(tmr);
          if (tHol) {
            h.push('<li class="gt-warn">明天 ' + dlabel(tmr) + "是<b>" + esc(tHol.name) + "</b>，沿街收運暫停，改定時定點。</li>");
          } else if (good.length) {
            var tc = 0, tf = 1e9, tl = -1;
            good.forEach(function (it) {
              var g = segs(it.s.g[ts]);
              if (g.length) { tc++; if (g[0].a < tf) tf = g[0].a; if (g[g.length - 1].a > tl) tl = g[g.length - 1].a; }
            });
            if (tc) {
              h.push("<li>明天 " + dlabel(tmr) + "：<b>" + tc + "</b> 個點有垃圾車，" + hm(tf) + "～" + hm(tl) + "。</li>");
            } else {
              var nd = null;
              for (var k = 2; k <= 8 && !nd; k++) {
                var y = addDays(now.ymd, k);
                if (holOn(y)) continue;
                var sl = slotOf(y);
                for (var i = 0; i < good.length; i++) if (segs(good[i].s.g[sl]).length) { nd = y; break; }
              }
              h.push("<li>明天 " + dlabel(tmr) + "：這附近<b>沒有點排垃圾車</b>" + (nd ? "，下一次是 " + dlabel(nd) : "") + "。</li>");
            }
          }
          h.push("</ul>");
        }
        // 次要資訊收進「更多」：手機預設收起來，地圖才不會被擠到第二個螢幕以下；電腦版、國定假日當天預設打開
        var hs = holsBetween(now.ymd, addDays(now.ymd, 14));
        var sumLab = hs.map(function (d) { return dlabel(d.date).replace(/（.）/, "") + " " + esc(d.name) + "改定點"; })
          .concat(t ? ["清潔隊電話", "官方查詢"] : ["官方查詢"]).join("・");
        var open = window.innerWidth >= 1024 || !!th;
        h.push('<details class="gt-sum-more"' + (open ? " open" : "") + "><summary>" + sumLab + "</summary>");
        h.push('<div id="gt-holnear"></div>');
        if (t) {
          h.push('<p class="gt-small gt-mt">要丟大型家電、堪用家具：先打給' + esc(teamName(S.dist, t)) + ' <a class="gt-a" href="tel:' + esc(t.tel) + '">' + esc(t.tel) +
            "</a> 約時間（" + '<a class="gt-a" href="https://recycle.epb.taichung.gov.tw/other/other10.asp" rel="noopener" target="_blank">資源回收網說明</a>）。</p>');
        }
        h.push('<p class="gt-small gt-mt">實際到點：' + officialA("臺中垃圾清運大車隊查詢") + '或<a class="gt-a" href="#gt-official">官方 APP</a>。</p>');
        h.push("</details>");
        h.push("</div>");
        E.summary.innerHTML = h.join("");
        E.summary.hidden = false;
        // 摘要已經講了今天、明天、國定假日，上面的「今天」卡收起來，避免同一件事講兩遍
        E.today.hidden = true;
        if (S.stale) markStale(true); // 換範圍重畫時，「這是上一次的結果」提示要留著
        renderNext(true);
        renderHolNear();
      }

      // 今天或 14 天內有國定假日 → 列最近的 3 個假日定點
      function renderHolNear() {
        var box = $("gt-holnear");
        if (!box || !S.pt) return;
        var now = twNow();
        var hs = holsBetween(now.ymd, addDays(now.ymd, 14));
        drawHolNear([]);
        if (!hs.length) { box.innerHTML = ""; return; }
        var todayHol = !!holOn(now.ymd);
        var head = '<div class="gt-holnear"><p><b>' + hs.map(function (d) { return (d.date === now.ymd ? "今天 " : "") + dlabel(d.date) + esc(d.name); }).join("、") +
          "</b>：停止沿街垃圾收運，改為定時定點（<a class=\"gt-a\" href=\"" + esc(BOOT.hol.announcement) + "\" rel=\"noopener\" target=\"_blank\">環保局公告</a>）。</p>";
        if (S.dist && BOOT.hol.noData.indexOf(S.dist) !== -1) {
          box.innerHTML = head + "<p>" + esc(BOOT.hol.noDataNote) + "</p></div>";
          return;
        }
        box.innerHTML = head + '<p class="gt-small">正在找附近的假日定點……</p></div>';
        var seq = S.seq;
        loadHoliday().then(function (hd) {
          if (seq !== S.seq) return;
          // 只列 3 公里內的；更遠的不說「離你最近」（山區、市界附近常會對到別區很遠的定點）
          var arr = hd.stops.map(function (s) { return { s: s, d: haversine(S.pt.lat, S.pt.lng, s.lat, s.lng) }; })
            .filter(function (x) { return x.d <= 3000; })
            .sort(function (a, b) { return a.d - b.d; }).slice(0, 3);
          var line = function (x) {
            return mtxt(x.d) + "・<b>" + esc(x.s.start) + "–" + esc(x.s.end) + "</b>・" + esc(x.s.place) + "（" + esc(x.s.dist) + esc(x.s.li) + "）";
          };
          var h = [head];
          if (!arr.length) {
            h.push("<p>3 公里內沒有國定假日定點" + (S.dist && BOOT.hol.pdf[S.dist] ? "，下面可以看" + esc(S.dist) + "完整的定點班表，或問清潔隊" : "，請看環保局公告附的各區定點表，或問當地清潔隊") + "。</p>");
          } else if (todayHol) {
            // 今天就是國定假日：三個都攤開
            h.push("<p>離你最近的假日定點" + (mapOK() ? "（地圖上紫色 1～3）" : "") + "：</p><ol class=\"gt-ol\">");
            arr.forEach(function (x) { h.push("<li>" + line(x) + "</li>"); });
            h.push("</ol>");
          } else if (arr.length) {
            h.push("<p>當天離你最近的假日定點" + (mapOK() ? "（地圖上紫色 1）" : "") + "：" + line(arr[0]) + "</p>");
            if (arr.length > 1) {
              h.push('<details class="gt-more-d"><summary>再看 ' + (arr.length - 1) + ' 個</summary><ol class="gt-ol" start="2">');
              arr.slice(1).forEach(function (x) { h.push("<li>" + line(x) + "</li>"); });
              h.push("</ol></details>");
            }
          }
          var dd = S.dist && BOOT.hol.pdf[S.dist] ? S.dist : (arr[0] ? arr[0].s.dist : "");
          if (dd) h.push('<button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-gt-hol="' + esc(dd) + '">看' + esc(dd) + "完整的假日定點班表</button>");
          h.push("</div>");
          box.innerHTML = h.join("");
          drawHolNear(arr);
        }).catch(function () {
          if (seq !== S.seq) return;
          box.innerHTML = head + '<p class="gt-small">假日定點資料載入失敗，請看下方「國定假日定點班表」或環保局公告。</p></div>';
        });
      }
      // 主地圖上「離你最近的假日定點」紫色 1～3（地圖還沒載好就先記著，載好時補畫）
      var hMk = [];
      function drawHolNear(arr) {
        hMk.forEach(function (m) { m.remove(); });
        hMk = [];
        MS.holNear = arr || [];
        if (!M) return;
        MS.holNear.forEach(function (x, i) {
          var p = mkPop(popMain, E.map, { offset: 14 }).setHTML('<div class="gt-pop"><strong>國定假日定點 ' + (i + 1) + "</strong><br>" + esc(x.s.place) + "<br>" + esc(x.s.start) + "–" + esc(x.s.end) + "・" + mtxt(x.d) + "</div>");
          hMk.push(new ML.Marker({ element: holEl(i + 1, i) }).setLngLat([x.s.lng, x.s.lat]).setPopup(p).addTo(M));
        });
      }

      /* ---------- 清單 ---------- */
      function buildDaySelect() {
        var cur = S.dayOff;
        var h = [];
        for (var k = 0; k < 7; k++) {
          var di = dayInfo(k);
          var lab = (k === 0 ? "今天 " : k === 1 ? "明天 " : "") + dlabel(di.ymd) + (di.hol ? "・" + di.hol.name : "");
          h.push('<option value="' + k + '"' + (k === cur ? " selected" : "") + ">" + esc(lab) + "</option>");
        }
        E.day.innerHTML = h.join("");
      }
      function stateOf(s, day) {
        if (day.hol) return "n";
        if (segs(s.g[day.slot]).length) return "g";
        if (segs(s.r[day.slot]).length) return "r";
        return "n";
      }
      function stHtml(seg, day, s) {
        if (!day.isToday || day.hol || (s && isDrift(s))) return "";
        var st = segState(seg, day.now.min);
        return ' <em class="gt-st gt-st-' + st.k + '" data-a="' + seg.a + '" data-b="' + seg.b + '">' + st.t + "</em>";
      }
      function kindLine(label, cls, arr, day, s) {
        if (!arr.length) return "";
        var first = arr.filter(function (x) { return !day.isToday || x.b + 5 >= day.now.min; })[0] || arr[arr.length - 1];
        return '<div class="gt-kline"><span class="gt-tag ' + cls + '">' + label + "</span> <b>" + segsTxt(arr) + "</b>" + stHtml(first, day, s) + "</div>";
      }
      function weekTable(s, day) {
        var h = ['<table class="gt-week"><thead><tr><th scope="col">星期</th><th scope="col">垃圾・廚餘</th><th scope="col">資源回收</th></tr></thead><tbody>'];
        for (var i = 0; i < 7; i++) {
          var g = segs(s.g[i]), r = segs(s.r[i]);
          h.push("<tr" + (i === day.slot ? ' class="gt-cur"' : "") + "><th scope=\"row\">週" + WD[i] + "</th><td>" + (g.length ? segsTxt(g) : "—") + "</td><td>" + (r.length ? segsTxt(r) : "—") + "</td></tr>");
        }
        h.push("</tbody></table>");
        return h.join("");
      }
      function stopCard(it, day, now, still) {
        var s = it.s;
        var g = segs(s.g[day.slot]), r = segs(s.r[day.slot]);
        var h = ['<li class="gt-stop' + (still ? " gt-noanim" : "") + '" id="gt-s-' + esc(s.id) + '">'];
        var dr = isDrift(s);
        // 燈號光球：跟地圖上的點同一個顏色（這天有垃圾車／只有資源回收／沒排班）
        h.push('<div class="gt-stop-top"><i class="cine-orb cine-orb--sm gt-orb-still ' + ORB[stateOf(s, day)] + '" aria-hidden="true"></i><span class="gt-dist">' + (isApprox(s) ? dtxt(it).replace("（位置約略）", "") : mtxt(it.d)) + '</span><span class="gt-badge">' + esc(s.method) + "</span>" +
          (s.kind === "回收" ? '<span class="gt-badge">只有資源回收</span>' : "") +
          (isApprox(s) ? '<span class="gt-badge gt-badge-warn" title="這個點只能定位到巷口、路段或村里中心，實際位置請看地點文字">位置約略</span>' : "") +
          (dr ? driftBadge(s) : "") + "</div>");
        h.push('<p class="gt-place">' + esc(s.place) + "</p>");
        h.push('<p class="gt-meta">' + esc(s.dist) + esc(s.li) + "</p>");
        h.push('<div class="gt-dayline' + (dr ? " gt-old" : "") + '">');
        if (day.hol) {
          h.push('<p class="gt-holtag">' + day.full + "是" + esc(day.hol.name) + "：沿街收運暫停，改定時定點。</p>");
        }
        if (g.length || r.length) {
          h.push(kindLine("垃圾・廚餘", "gt-tag-g", g, day, s));
          h.push(kindLine("資源回收", "gt-tag-r", r, day, s));
        } else {
          var base = { ymd: day.ymd, slot: day.slot, min: day.isToday ? now.min : -1 };
          var nx = s.kind === "回收" ? nextService(s, "r", base) : nextService(s, "g", base);
          h.push('<p class="gt-none">' + day.name + "沒有排班・下一次 " + nextTxt(nx) + "</p>");
        }
        h.push("</div>");
        h.push("<details class=\"gt-weekd\"><summary>一週班表</summary>" + weekTable(s, day) +
          (s.route ? '<p class="gt-small">開放資料登記的車號：' + esc(s.route) + "（環保局可能已經換車）</p>" : "") + "</details>");
        h.push('<div class="gt-actions">' + (mapOK() ? '<button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-act="map" data-id="' + esc(s.id) + '">在地圖上看</button>' : ""));
        if (s.route) h.push('<button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-act="route" data-route="' + esc(s.route) + '" data-id="' + esc(s.id) + '">看這條路線</button>');
        h.push("</div></li>");
        return h.join("");
      }
      function sortedItems(day) {
        var list = inR().map(function (it) {
          var g = segs(it.s.g[day.slot]), r = segs(it.s.r[day.slot]);
          var first = g[0] || r[0];
          return { s: it.s, d: it.d, key: first ? first.a : 1e9, any: !!(g.length || r.length) };
        });
        if (S.only) list = list.filter(function (x) { return x.any; });
        if (S.sort === "time") list.sort(function (a, b) { return a.key - b.key || a.d - b.d; });
        else list.sort(function (a, b) { return a.d - b.d; });
        return list;
      }
      var listAnim = { key: "", n: 0 };
      function renderList() {
        var day = dayInfo(S.dayOff);
        var now = twNow();
        var all = inR();
        if (!all.length) { E.listwrap.hidden = true; E.list.innerHTML = ""; E.dayinfo.innerHTML = ""; drawStops([], day); return; }
        E.listwrap.hidden = false;
        var list = sortedItems(day);
        var info = [];
        if (day.hol) {
          info.push('<p class="gt-warn-box">' + day.full + "是<b>" + esc(day.hol.name) + "</b>：環保局公告停止沿街垃圾收運，改為定時定點。下面是平常的班表，當天請改用國定假日定點（" +
            '<a class="gt-a" href="#gt-hol">看假日定點班表</a>）。</p>');
        }
        if (BOOT.hol.year && Number(day.ymd.slice(0, 4)) > BOOT.hol.year) {
          info.push('<p class="gt-warn-box">本站只有 ' + BOOT.hol.yearRoc + " 年的國定假日資料。" + day.full + "如果是國定假日，請看" +
            '<a class="gt-a" href="https://cleaner.epb.taichung.gov.tw/schedule.aspx" rel="noopener" target="_blank">臺中垃圾清運大車隊國定假日定點班表</a>。</p>');
        }
        if (day.hol) {
          info.push('<p class="gt-small">' + day.full + "：" + S.radius + " 公尺內 " + all.length + " 個點。這天是國定假日，下面平常的班表只供對照。</p>");
        } else {
          var active = 0, drn = 0;
          all.forEach(function (it) {
            if (segs(it.s.g[day.slot]).length || segs(it.s.r[day.slot]).length) active++;
            if (isDrift(it.s)) drn++;
          });
          info.push('<p class="gt-small">' + day.full + "：" + S.radius + " 公尺內 " + all.length + " 個點，其中 " + active + " 個這天有車" +
            (drn ? "（" + drn + " 個點的時間可能已經改了）" : "") + "。時間是環保局預定班表，僅供參考，以官方公告為準。</p>");
        }
        E.dayinfo.innerHTML = info.join("");
        var shown = list.slice(0, S.limit);
        // 依序滑入：按「顯示更多」時，原本就在畫面上的卡片不要再滑一次
        var aKey = S.seq + "|" + S.dayOff + "|" + S.sort + "|" + S.only + "|" + S.radius;
        var still = aKey === listAnim.key ? listAnim.n : 0;
        listAnim = { key: aKey, n: shown.length };
        E.list.innerHTML = shown.length ? shown.map(function (it, i) { return stopCard(it, day, now, i < still); }).join("") :
          '<li class="gt-none">這天附近沒有排班的點。</li>';
        E.more.hidden = list.length <= S.limit;
        E.more.textContent = "再顯示 " + Math.min(PAGE, list.length - S.limit) + " 個（共 " + list.length + " 個）";
        drawStops(all, day);
        updateLegend(day);
      }
      function updateLegend(day) {
        day = day || dayInfo(S.dayOff);
        var lab = day.isToday ? "今天" : dlabel(day.ymd);
        E.legend.innerHTML =
          '<span><i class="cine-orb cine-orb--sm cine-orb--green gt-orb-still"></i>' + lab + "有垃圾車</span>" +
          '<span><i class="cine-orb cine-orb--sm gt-orb--blue gt-orb-still"></i>只有資源回收</span>' +
          '<span><i class="cine-orb cine-orb--sm cine-orb--grey gt-orb-still"></i>' + (day.hol ? "國定假日（沿街暫停）" : "沒排班") + "</span>" +
          '<span><i class="gt-sq"></i>國定假日定點</span>' +
          (S.pt ? '<span><i class="gt-beam-ic"></i>光柱：最近的清運點</span>' : "") +
          (live.on ? '<span><i class="gt-tk"></i>垃圾車大約位置</span>' : "");
      }
      function popupHtml(it, day) {
        var s = it.s;
        var g = segs(s.g[day.slot]), r = segs(s.r[day.slot]);
        var lab = day.isToday ? "今天" : dlabel(day.ymd);
        return '<div class="gt-pop"><strong>' + esc(s.place) + "</strong>" +
          '<div class="gt-pop-sub">' + dtxt(it) + "・" + esc(s.method) + "</div>" +
          (isDrift(s) ? '<div class="gt-pop-warn">' + esc(driftWhy(s)) + "；下面是開放資料的時間，請以" + officialA("官方查詢") + "為準</div>" : "") +
          (day.hol ? '<div class="gt-pop-warn">' + esc(day.hol.name) + "：沿街收運暫停，改定時定點</div>" : "") +
          "<div>" + lab + " 垃圾・廚餘：" + (g.length ? "<b>" + segsTxt(g) + "</b>" : "沒排班") + "</div>" +
          "<div>" + lab + " 資源回收：" + (r.length ? "<b>" + segsTxt(r) + "</b>" : "沒排班") + "</div>" +
          '<button type="button" class="gt-linkbtn" data-gt-go="' + esc(s.id) + '">看一週班表</button></div>';
      }
      // 清運點：circle 圖層（下面疊一層柔光），點了開彈窗（內容跟原本一樣，開的當下依「看哪一天」算）
      var stopIdx = {};
      function drawStops(items, day) {
        stopIdx = {};
        if (!mapOK()) return;
        setSrc("stops", fcol(items.map(function (it) {
          stopIdx[it.s.id] = it;
          return ptF(it.s.lng, it.s.lat, { id: it.s.id, st: stateOf(it.s, day), ap: isApprox(it.s) ? 1 : 0 });
        })));
        drawNear();
      }
      function openStop(id) {
        var it = stopIdx[id];
        if (!M || !it) return;
        if (tip) { tip.remove(); tipKey = ""; }
        mkPop(popMain, E.map, { offset: 10 }).setLngLat([it.s.lng, it.s.lat]).setHTML(popupHtml(it, dayInfo(S.dayOff))).addTo(M);
      }
      // 最近的清運點：3D 光柱（fill-extrusion 小圓柱）＋地面光暈；換了最近的點才重新升起
      var nearId = "";
      function drawNear() {
        var it = S.pt ? inR()[0] : null;
        if (!it) { nearId = ""; setSrc("near", fcol()); setSrc("nearPt", fcol()); return; }
        if (nearId === it.s.id + "@" + S.seq) return;
        nearId = it.s.id + "@" + S.seq;
        var ll = [it.s.lng, it.s.lat];
        fx.beam = RM ? 1 : 0;
        fx.t0 = 0;
        try { if (M) beamScale(RM ? 1 : 0); } catch (e) { /* 還沒建好 */ }
        var core = CM.circle(ll, 5.5, 24).geometry;
        setSrc("near", fcol(BEAM_Z.map(function (z, i) {
          return { type: "Feature", properties: { part: "c", k: i, b: z[0], h: z[1] }, geometry: core };
        }).concat([{ type: "Feature", properties: { part: "s", k: 0, b: 0, h: 44 }, geometry: CM.circle(ll, 13, 28).geometry }])));
        setSrc("nearPt", fcol([ptF(ll[0], ll[1])]));
        fxKick();
      }
      // 每分鐘更新「約 N 分鐘後／已過」
      function tickStates() {
        if (S.dayOff !== 0) return;
        var now = twNow();
        Array.prototype.forEach.call(document.querySelectorAll(".gt-st[data-a]"), function (el) {
          var st = segState({ a: +el.getAttribute("data-a"), b: +el.getAttribute("data-b") }, now.min);
          el.textContent = st.t;
          el.className = "gt-st gt-st-" + st.k;
        });
      }

      function indexIn(list, id) {
        for (var i = 0; i < list.length; i++) if (list[i].s.id === id) return i;
        return -1;
      }
      function goCard(id) {
        var el = $("gt-s-" + id);
        if (!el) {
          var day = dayInfo(S.dayOff);
          var idx = indexIn(sortedItems(day), id);
          if (idx < 0 && S.only) {
            S.only = false;
            E.only.checked = false;
            idx = indexIn(sortedItems(day), id);
          }
          if (idx >= 0) S.limit = Math.max(S.limit, idx + 1);
          renderList();
          el = $("gt-s-" + id);
        }
        if (!el) return;
        var d = el.querySelector("details");
        if (d) d.open = true;
        el.classList.add("gt-flash");
        setTimeout(function () { el.classList.remove("gt-flash"); }, 1600);
        el.scrollIntoView({ behavior: "smooth", block: "center" });
      }
      function showOnMap(id) {
        var it = stopIdx[id];
        if (!mapOK() || !it) return;
        var r = E.map.getBoundingClientRect();
        var visible = r.top >= -40 && r.bottom <= window.innerHeight + 40;
        if (!visible) E.mapcol.scrollIntoView({ behavior: "smooth", block: "start" });
        closePop();
        camTo([it.s.lng, it.s.lat], Math.max(M ? M.getZoom() : 17, 17)).then(function () { openStop(id); });
      }

      /* ---------- 這台車的路線 ---------- */
      var routeState = null;
      function closeRoute(silent) {
        routeState = null;
        setSrc("route", fcol());
        setSrc("routePts", fcol());
        E.route.hidden = true;
        E.route.innerHTML = "";
        if (!silent && S.pt) camTo([S.pt.lng, S.pt.lat], zoomFor(S.radius));
      }
      function showRoute(plate, fromId) {
        if (!plate) return;
        var day = dayInfo(S.dayOff);
        routeState = { plate: plate, fromId: fromId || "" };
        E.route.hidden = false;
        E.route.innerHTML = '<div class="gt-card"><p class="gt-small">載入車號 ' + esc(plate) + " 的路線中……</p>" +
          '<span class="cine-skeleton cine-skeleton--line" aria-hidden="true"></span><span class="cine-skeleton cine-skeleton--line" style="width:72%" aria-hidden="true"></span></div>';
        var mySeq = S.seq;
        loadRoutes().then(function (rj) {
          var info = rj.routes && rj.routes[plate];
          if (!info) throw new Error("noroute");
          var keys = info.tiles.filter(function (k) { return BOOT.tiles[k]; });
          return Promise.all(keys.map(loadTile)).then(function (arrs) {
            var seen = {}, stops = [];
            arrs.forEach(function (a) { a.forEach(function (s) { if (s.route === plate && !seen[s.id] && s.lat != null) { seen[s.id] = 1; stops.push(s); } }); });
            return { info: info, stops: stops };
          });
        }).then(function (res) {
          if (!routeState || routeState.plate !== plate || mySeq !== S.seq) return;
          var rows = [];
          res.stops.forEach(function (s) {
            var g = segs(s.g[day.slot]), r = segs(s.r[day.slot]);
            (g.length ? g : r).forEach(function (sg) {
              rows.push({ s: s, seg: sg, d: S.pt ? haversine(S.pt.lat, S.pt.lng, s.lat, s.lng) : null });
            });
          });
          rows.sort(function (a, b) { return a.seg.a - b.seg.a; });
          var dayTxt = day.isToday ? "今天" : dlabel(day.ymd);
          var h = ['<div class="gt-card"><div class="gt-route-head"><h2 class="gt-h3">這條清運路線・' + dayTxt + "的停靠順序</h2>" +
            '<button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-act="route-close">關閉路線</button></div>'];
          var dd = driftDate();
          // routes.json 的 ok 只代表「官方抽查時車牌還是這台」，不代表時間一致；時間有沒有改看 od
          h.push('<p class="gt-small">依開放資料（' + esc(BOOT.modified || "") + " 版），這條路線登記的車號是 " + esc(plate) +
            (res.info.moved ? "；官方 " + dd + " 抽查時，這條路線已經換成別台車" :
              res.info.ok ? "；官方 " + dd + " 抽查時車號還是這台，但時間不一定跟開放資料一樣" : "；環保局可能已經換車或調整路線") + "。</p>");
          if (res.info.od) h.push('<p class="gt-drift">' + esc(res.info.od.msg) + "下面的時間只能參考，請以" + officialA("官方查詢") + "為準。</p>");
          if (!rows.length) {
            h.push('<p class="gt-small">這條路線' + dayTxt + "沒有排班。</p></div>");
            E.route.innerHTML = h.join("");
            setSrc("route", fcol());
            setSrc("routePts", fcol());
            return;
          }
          // 「粗體」那句只在真的有粗體時才講（還沒查地址、或整條路線都在 1 公里外時，畫面上沒有粗體）
          var anyNear = rows.some(function (x) { return x.d != null && x.d <= 1000; });
          h.push('<p class="gt-small">' + esc(res.info.dists.join("、")) + "・共 " + rows.length + " 站・" + hm(rows[0].seg.a) + "～" + hm(rows[rows.length - 1].seg.a) +
            "。" + (anyNear ? "粗體是離你 1 公里內的點。" : "") + "</p>");
          if (!res.info.od && res.info.dists.some(driftFlag)) h.push('<p class="gt-drift">官方 ' + dd + " 抽查，" + esc(res.info.dists.filter(driftFlag).join("、")) + "的班表可能已經跟開放資料不一樣，下面的時間只能參考。</p>");
          if (day.hol) h.push('<p class="gt-warn-box">' + esc(day.hol.name) + "：沿街收運暫停，改定時定點。</p>");
          h.push('<ol class="gt-route-list gt-stag" tabindex="0" aria-label="這條路線的停靠順序">');
          rows.forEach(function (x) {
            var near = x.d != null && x.d <= 1000;
            var cur = x.s.id === routeState.fromId;
            h.push('<li class="' + (cur ? "gt-cur " : "") + (near ? "gt-near" : "") + '"><span class="gt-rt">' + segTxt(x.seg) + '</span><span class="gt-rp">' + esc(x.s.place) +
              (x.d != null ? '<small>' + mtxt(x.d) + "</small>" : "") + "</span></li>");
          });
          h.push("</ol></div>");
          E.route.innerHTML = h.join("");
          var curEl = E.route.querySelector("li.gt-cur");
          if (curEl) { var ol = curEl.parentNode; ol.scrollTop = Math.max(0, curEl.offsetTop - ol.offsetTop - 60); }
          if (mapOK()) {
            // 路線：流動虛線（依停靠時間連線）＋各站小白點（電腦滑過、手機點一下看時間）
            var pts = rows.map(function (x) { return [x.s.lng, x.s.lat]; });
            setSrc("route", fcol([{ type: "Feature", properties: {}, geometry: { type: "LineString", coordinates: pts } }]));
            setSrc("routePts", fcol(rows.map(function (x) { return ptF(x.s.lng, x.s.lat, { tip: segTxt(x.seg) + " " + esc(x.s.place) }); })));
            camFit(bbox(pts), { padding: 36, maxZoom: 17 });
            fxArmDash();
          }
          track("gt_route", { district: (res.info.dists || [])[0] || "" });
        }).catch(function (err) {
          if (!routeState || routeState.plate !== plate) return;
          var msg = err && err.message === "noroute" ? "開放資料裡沒有車號 " + esc(plate) + " 的路線。" : "路線資料載入失敗，請檢查網路後再試。";
          E.route.innerHTML = '<div class="gt-card"><p class="gt-small">' + msg + '</p><button type="button" class="gt-btn gt-btn-outline gt-btn-sm" data-act="route-close">關閉</button></div>';
        });
      }

      /* ---------- 附近垃圾車大約位置（/api/garbage-live，只在頁面看得到時每 60 秒更新） ---------- */
      // markers：車牌 → 地圖標記（重畫時只移動位置、不整層清掉，開著的彈窗才不會被關掉）；openPlate：目前開著彈窗的車
      var live = { on: false, timer: null, last: 0, data: null, busy: false, markers: {}, openPlate: "" };
      function liveMsg(msg) { E.liveSt.textContent = msg; E.liveSt.hidden = !msg; }
      function liveStop() { clearInterval(live.timer); live.timer = null; }
      function liveStart() {
        liveStop();
        live.timer = setInterval(function () { if (document.visibilityState === "visible") liveFetch(); }, 60000);
      }
      function liveClear() {
        Object.keys(live.markers).forEach(function (k) { live.markers[k].mk.remove(); });
        live.markers = {};
        live.openPlate = "";
      }
      function liveFail() {
        live.data = null;
        liveClear();
        liveStop();
        live.on = false;
        E.live.checked = false;
        updateLegend();
        liveMsg("目前拿不到垃圾車位置，班表查詢不受影響。可以稍後再開一次，或看官方 APP。");
        track("gt_live", { state: "error" });
      }
      function liveFetch() {
        if (live.busy) return;
        live.busy = true;
        live.last = Date.now();
        fetch("/api/garbage-live", { headers: { accept: "application/json" } })
          .then(function (r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
          .then(function (j) {
            live.busy = false;
            if (!live.on) return;
            if (!j || j.ok !== true || !j.cars) throw new Error("bad");
            live.data = j;
            drawLive(j);
          })
          .catch(function () { live.busy = false; if (live.on) liveFail(); });
      }
      function drawLive(j) {
        if (!j) return;
        if (!mapOK()) { liveMsg("地圖沒有載入，看不到垃圾車位置。班表查詢不受影響。"); return; }
        if (!M) return; // 地圖還在載入：載好時（onMapReady）會再畫一次
        var snapMs = Date.parse(j.snapshot || "");
        var age = isNaN(snapMs) ? null : Math.max(0, Math.round((Date.now() - snapMs) / 60000));
        var snapHM = j.snapshot ? String(j.snapshot).slice(11, 16) : "";
        if (age != null && age > 40) {
          liveClear();
          // 可能已經收班，也可能是官方資料暫停更新（白天也遇過車子停在 1 小時前的位置）→ 不斷言「沒有車」
          liveMsg("最近 40 分鐘沒有新的車輛位置（官方最後回報 " + snapHM + "），可能已經收班，也可能是資料暫停更新。");
          return;
        }
        var c = S.pt ? { lat: S.pt.lat, lng: S.pt.lng } : null;
        // 斜視地圖的 getBounds() 是梯形畫面的外接長方形（比看得到的大很多）→ 改用投影到畫面上的座標判斷
        var cv = M.getCanvas(), vw = cv.clientWidth, vh = cv.clientHeight;
        var onScreen = function (lng, lat) { var q = M.project([lng, lat]); return q.x >= 0 && q.y >= 0 && q.x <= vw && q.y <= vh; };
        var routes = live.routes || null;
        var n = 0, inView = 0, near = [], keep = {};
        j.cars.forEach(function (car) {
          var plate = String(car[0] || "");
          var lat = car[2], lng = car[1];
          if (!plate || typeof lat !== "number" || typeof lng !== "number") return;
          var dd = c ? haversine(c.lat, c.lng, lat, lng) : 0;
          var isOpen = plate === live.openPlate;
          var inB = onScreen(lng, lat);
          if (c) { if (dd > LIVE_RADIUS && !isOpen) return; }
          else if (!inB && !isOpen) return;
          n++;
          if (inB) inView++;
          near.push({ d: dd, ll: [lng, lat] });
          var mins = (age != null ? age : 0) + (Number(car[6]) || 0);
          // 開放資料沒有車種欄位；車牌對得上清運路線、而且官方抽查時還是這台車，才給「看路線」
          var info = routes && routes[plate];
          var okRoute = !!(info && info.ok);
          var html = '<div class="gt-pop"><strong>垃圾車或資源回收車・' + esc(plate) + "</strong>" +
            '<div class="gt-pop-sub">約 ' + mins + " 分鐘前的位置" + (car[4] ? "・時速約 " + esc(car[4]) + " 公里" : "") + "</div>" +
            (okRoute ? '<button type="button" class="gt-linkbtn" data-act="route" data-route="' + esc(plate) + '">看這台車登記的清運路線</button>' : "") +
            "</div>";
          keep[plate] = 1;
          var lm = live.markers[plate];
          if (lm) {
            var ll = lm.mk.getLngLat();
            if (ll.lat !== lat || ll.lng !== lng) lm.mk.setLngLat([lng, lat]); // 彈窗會跟著車移動，不會關掉
            if (lm.html !== html) { lm.html = html; lm.pop.setHTML(html); }
            return;
          }
          // 呼吸光點（HTML 標記，動畫只動 transform／opacity）
          var pop = mkPop(popMain, E.map, { offset: 18 }).setHTML(html);
          pop.on("open", function () { live.openPlate = plate; });
          pop.on("close", function () { if (live.openPlate === plate) live.openPlate = ""; });
          live.markers[plate] = { mk: new ML.Marker({ element: truckEl() }).setLngLat([lng, lat]).setPopup(pop).addTo(M), pop: pop, html: html };
        });
        Object.keys(live.markers).forEach(function (plate) {
          if (keep[plate]) return;
          live.markers[plate].mk.remove();
          delete live.markers[plate];
          if (live.openPlate === plate) live.openPlate = "";
        });
        // 剛打開時，如果查詢範圍裡看不到車，把地圖拉遠到看得到最近的幾台
        if (live.fitOnce && c && n && !inView) {
          near.sort(function (a, b) { return a.d - b.d; });
          camFit(bbox([[c.lng, c.lat]].concat(near.slice(0, 3).map(function (x) { return x.ll; }))), { padding: 40, maxZoom: 17 });
        }
        live.fitOnce = false;
        var where = c ? "附近 3 公里內" : "地圖範圍內";
        liveMsg(where + " " + n + " 台・資料時間 " + snapHM + (age != null ? "（約 " + age + " 分鐘前）" : "") +
          (j.stale ? "・暫時抓不到新資料，顯示的是較舊的位置" : "") + "・官方快照約 10 分鐘更新一次，位置會落後 10～20 分鐘。");
      }
      function liveOn() {
        live.on = true;
        live.fitOnce = true;
        updateLegend();
        liveMsg("讀取垃圾車位置中……");
        track("gt_live", { state: "on" });
        loadRoutes().then(function (rj) { live.routes = rj.routes || {}; if (live.data) drawLive(live.data); }).catch(function () { live.routes = {}; });
        liveFetch();
        liveStart();
      }
      function liveOff() {
        live.on = false;
        updateLegend();
        liveStop();
        live.data = null;
        liveClear();
        liveMsg("");
      }
      document.addEventListener("visibilitychange", function () {
        if (!live.on) return;
        if (document.visibilityState === "visible") {
          if (Date.now() - live.last > 60000) liveFetch();
          liveStart();
        } else {
          liveStop();
        }
      });

      /* ---------- 國定假日定點班表 ---------- */
      var holCm = null, holMk = [];
      function initHolidaySection() {
        if (!BOOT) return;
        var now = twNow();
        var left = BOOT.hol.dates.filter(function (d) { return d.date >= now.ymd; });
        if (!left.length) {
          E.holLeft.innerHTML = BOOT.hol.yearRoc + " 年的國定假日都已經過了。新年度的定點表，看" +
            '<a class="gt-a" href="https://cleaner.epb.taichung.gov.tw/schedule.aspx" rel="noopener" target="_blank">臺中垃圾清運大車隊國定假日定點班表</a>。';
          E.holSel.disabled = true;
          return;
        }
        E.holLeft.innerHTML = "今年還剩：" + left.map(function (d) { return "<b>" + dlabel(d.date) + esc(d.name) + "</b>"; }).join("、");
      }
      function renderHol(dist) {
        if (!dist) { E.holOut.innerHTML = ""; E.holMapcol.hidden = true; return; }
        var t = teamOf(dist);
        if (BOOT.hol.noData.indexOf(dist) !== -1) {
          E.holOut.innerHTML = '<p class="gt-warn-box">' + esc(BOOT.hol.noDataNote) + "</p>" +
            (t ? '<p class="gt-small">' + esc(teamName(dist, t)) + '：<a class="gt-a" href="tel:' + esc(t.tel) + '">' + esc(t.tel) + "</a></p>" : "");
          E.holMapcol.hidden = true;
          return;
        }
        E.holOut.innerHTML = '<p class="gt-small">載入中……</p>' +
          '<span class="cine-skeleton cine-skeleton--line" aria-hidden="true"></span><span class="cine-skeleton cine-skeleton--line" style="width:78%" aria-hidden="true"></span><span class="cine-skeleton cine-skeleton--line" style="width:64%" aria-hidden="true"></span>';
        loadHoliday().then(function (hd) {
          if (E.holSel.value !== dist) return;
          var list = hd.stops.filter(function (s) { return s.dist === dist; })
            .sort(function (a, b) { return a.start < b.start ? -1 : a.start > b.start ? 1 : 0; });
          var h = ['<p class="gt-small">' + esc(dist) + " 共 " + list.length + " 個假日定點，依時間排序。" +
            (BOOT.hol.pdf[dist] ? ' <a class="gt-a" href="' + esc(BOOT.hol.pdf[dist]) + '" rel="noopener" target="_blank">官方 PDF</a>' : "") + "</p>"];
          h.push('<ol class="gt-hol-list gt-stag" tabindex="0" aria-label="' + esc(dist) + '國定假日定點清單">');
          list.forEach(function (s, i) {
            var d = S.pt ? haversine(S.pt.lat, S.pt.lng, s.lat, s.lng) : null;
            h.push('<li><span class="gt-hn">' + (i + 1) + '</span><span class="gt-rt">' + esc(s.start) + "–" + esc(s.end) + '</span><span class="gt-rp">' + esc(s.place) +
              "<small>" + esc(s.li) + (d != null ? "・離你查的位置" + mtxt(d) : "") + "</small></span></li>");
          });
          h.push("</ol>");
          E.holOut.innerHTML = h.join("");
          drawHolMap(list, dist);
          track("gt_holiday", { district: dist });
        }).catch(function () {
          E.holOut.innerHTML = '<p class="gt-small gt-err">假日定點資料載入失敗，請重新整理，或看<a class="gt-a" href="' + esc(BOOT.hol.announcement) + '" rel="noopener" target="_blank">環保局公告</a>。</p>';
        });
      }
      // 假日定點地圖（第二張 MapLibre；選了行政區才建）：紫色編號標記、你查的位置、鏡頭飛到那一區
      function drawHolMap(list, dist) {
        if (!CM || !CM.supported()) { E.holMapcol.hidden = true; return; }
        E.holMapcol.hidden = false;
        if (!holCm) {
          try {
            holCm = CM.create(E.holMap, {
              intro: false,
              cooperativeGestures: true,
              onUnavailable: function (kind) { if (kind !== "lost") E.holMapcol.hidden = true; },
            });
          } catch (e) { holCm = null; E.holMapcol.hidden = true; return; }
        }
        holCm.ready.then(function (m) {
          if (!m || E.holSel.value !== dist) return;
          ML = window.maplibregl;
          m.resize();
          holMk.forEach(function (x) { x.remove(); });
          holMk = [];
          if (popHol.cur) popHol.cur.remove();
          holCm.clearPins();
          var pts = [];
          list.forEach(function (s, i) {
            pts.push([s.lng, s.lat]);
            var p = mkPop(popHol, E.holMap, { offset: 14 }).setHTML('<div class="gt-pop"><strong>' + (i + 1) + ". " + esc(s.place) + "</strong><br>" + esc(s.start) + "–" + esc(s.end) + "・" + esc(s.li) + "</div>");
            holMk.push(new ML.Marker({ element: holEl(i + 1, i) }).setLngLat([s.lng, s.lat]).setPopup(p).addTo(m));
          });
          if (S.pt) holCm.addPulsePin([S.pt.lng, S.pt.lat], { variant: S.via === "geo" ? "dot" : "pin", label: qLabel() });
          if (pts.length) holCm.fitBounds(bbox(pts), { padding: 28, maxZoom: 16 });
        });
      }
      function openHol(dist) {
        if (dist && !E.holSel.disabled) { E.holSel.value = dist; renderHol(dist); }
        $("gt-hol").scrollIntoView({ behavior: "smooth", block: "start" });
      }

      /* ---------- 事件 ---------- */
      function boot() {
        if (!BOOT) {
          setStatus("清運點資料沒有載入，請重新整理再試；也可以用環保局官方查詢。", true);
          return;
        }
        // 門牌索引帶版本字樣（跟 tc-addr.js 同一份建置），/data/* 有 1 天快取也不會拿到舊索引
        if (window.TcAddr && window.TcAddr.config && BOOT.vIdx) {
          try { window.TcAddr.config({ v: BOOT.vIdx }); } catch (e) { /* 舊版 tc-addr.js 沒有 v 參數也能用 */ }
        }
        renderToday();
        buildDaySelect();
        initHolidaySection();
        initMap();
        if (!cm) {
          // cine-map.js 本身沒載到（網路擋住）→ 跟原本地圖載入失敗一樣
          E.map.innerHTML = '<p class="gt-mapfail">地圖載入失敗（可能是網路擋住了地圖服務）。清單查詢還是可以用。</p>';
          if (E.map.parentNode) E.map.parentNode.classList.add("is-fallback");
          mapGone();
        }

        var skip = $("gt-skip");
        if (skip) skip.addEventListener("click", function (e) {
          e.preventDefault();
          var tgt = !E.listwrap.hidden ? $("gt-list-h") : $("gt-hol-h");
          if (tgt) { if (!tgt.hasAttribute("tabindex")) tgt.setAttribute("tabindex", "-1"); tgt.focus(); tgt.scrollIntoView({ block: "start" }); }
        });
        E.form.addEventListener("submit", function (e) {
          e.preventDefault();
          E.addr.blur();
          lookupAddr((E.addr.value || "").trim());
        });
        // 第一次點輸入框就先載門牌索引（~21KB gzip），按查詢時比較快
        E.addr.addEventListener("focus", function () { if (window.TcAddr) window.TcAddr.ready().catch(function () {}); }, { once: true });
        E.cands.addEventListener("click", function (e) {
          var b = e.target.closest("[data-cand]");
          if (!b || !E.cands._list) return;
          var c = E.cands._list[+b.getAttribute("data-cand")];
          if (!c) return;
          E.addr.value = c.query || c.label;
          lookupAddr(c.query || c.label);
        });
        E.here.addEventListener("click", function () {
          if (!navigator.geolocation) { setStatus("這個瀏覽器不支援定位，請輸入地址或點地圖。", true); return; }
          setStatus("定位中……（需要你允許使用位置）");
          E.here.setAttribute("aria-busy", "true");
          navigator.geolocation.getCurrentPosition(function (pos) {
            E.here.removeAttribute("aria-busy");
            var acc = pos.coords.accuracy;
            runQuery(pos.coords.latitude, pos.coords.longitude, "geo", {
              label: "", dist: "",
              note: acc && acc > 200 ? "定位誤差約 " + Math.round(acc) + " 公尺，結果可能有偏差；可以改輸入地址。" : "",
            });
          }, function () {
            E.here.removeAttribute("aria-busy");
            setStatus("拿不到位置（可能沒給權限）。請輸入地址，或直接點地圖。", true);
            track("gt_query", { result: "fail", reason: "geo", via: "geo" });
          }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 60000 });
        });
        Array.prototype.forEach.call(document.querySelectorAll('input[name="gt-r"]'), function (el) {
          el.addEventListener("change", function () {
            S.radius = Number(el.value) || 300;
            S.limit = PAGE;
            if (S.pt) renderAll(true);
          });
        });
        Array.prototype.forEach.call(document.querySelectorAll('input[name="gt-sort"]'), function (el) {
          el.addEventListener("change", function () { S.sort = el.value; S.limit = PAGE; renderList(); });
        });
        E.day.addEventListener("change", function () {
          S.dayOff = Number(E.day.value) || 0;
          S.limit = PAGE;
          renderList();
          if (routeState) showRoute(routeState.plate, routeState.fromId);
        });
        E.only.addEventListener("change", function () { S.only = E.only.checked; S.limit = PAGE; renderList(); });
        E.more.addEventListener("click", function () { S.limit += PAGE; renderList(); });
        E.live.addEventListener("change", function () { if (E.live.checked) liveOn(); else liveOff(); });
        E.holSel.addEventListener("change", function () { renderHol(E.holSel.value); });

        // 清單、摘要、地圖彈窗裡的按鈕（capture：地圖彈窗裡的點擊不一定會冒泡上來）
        document.addEventListener("click", function (e) {
          var t = e.target;
          if (!t || !t.closest) return;
          var go = t.closest("[data-gt-go]");
          if (go) { e.preventDefault(); closePop(); goCard(go.getAttribute("data-gt-go")); return; }
          var here = t.closest("[data-gt-here]");
          if (here) {
            e.preventDefault();
            var ll = here.getAttribute("data-gt-here").split(",");
            closePop();
            runQuery(+ll[0], +ll[1], "map", { label: "", note: "", dist: "" });
            return;
          }
          var hb = t.closest("[data-gt-hol]");
          if (hb) { e.preventDefault(); openHol(hb.getAttribute("data-gt-hol")); return; }
          var a = t.closest("[data-act]");
          if (!a) return;
          var act = a.getAttribute("data-act");
          if (act === "map") { e.preventDefault(); showOnMap(a.getAttribute("data-id")); }
          else if (act === "route") {
            e.preventDefault();
            closePop();
            showRoute(a.getAttribute("data-route"), a.getAttribute("data-id"));
            if (window.innerWidth < 1024) setTimeout(function () { E.route.scrollIntoView({ behavior: "smooth", block: "start" }); }, 50);
          } else if (act === "route-close") { e.preventDefault(); closeRoute(false); }
        }, true);
        // 常見問題的站內連結：打開對應的那一題
        function openFaq(id) {
          var d = document.getElementById(id);
          if (!d || d.tagName !== "DETAILS") return false;
          d.open = true;
          d.scrollIntoView({ behavior: "smooth", block: "start" });
          return true;
        }
        document.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest('a[href^="#gt-faq-"]');
          if (a && openFaq(a.getAttribute("href").slice(1))) e.preventDefault();
        });
        if (/^#gt-faq-/.test(location.hash)) openFaq(location.hash.slice(1));
        // 「看假日定點」連結：已經查過地址時，直接帶入那一區
        E.today.addEventListener("click", function (e) {
          var a = e.target.closest && e.target.closest('a[href="#gt-hol"]');
          if (a && S.dist) { e.preventDefault(); openHol(S.dist); }
        });

        setInterval(function () {
          if (document.visibilityState !== "visible") return;
          tickStates();
        }, 60000);
        // 下一班倒數：每 30 秒更新；分頁切回前景時馬上更新一次
        setInterval(function () {
          if (document.visibilityState !== "visible") return;
          renderNext(false);
        }, 30000);
        document.addEventListener("visibilitychange", function () {
          if (document.visibilityState === "visible") renderNext(false);
        });
      }

      if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", boot);
      else boot();
    })();
  </script>
</Layout>

<style is:global>
  /* ===== 版面：主視覺與內容共用同一條格線（手機 48rem、電腦 80rem） ===== */
  .gt-wrap {
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 640px) {
    .gt-wrap { padding-inline: 1.5rem; }
  }
  /* 電腦版跟學區頁同一條格線（.cine-tool-wrap：80rem、左右 1.5rem） */
  @media (min-width: 1024px) {
    .gt-wrap { max-width: 80rem; }
  }
  /* 內容區後面的暖色環境光（玻璃面板透出來才有層次；純背景，不吃事件） */
  .gt-body {
    position: relative;
    isolation: isolate;
  }
  /* 光暈用 closest-side（在自己的格子裡就淡到 0）＋四邊都淡出的遮罩 → 不會被盒子切出直角亮塊，
     主視覺淡出到內容是連續的。左右不超出盒子（不會產生橫向捲軸），往上伸進主視覺的淡出區 */
  .gt-body::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 0;
    right: 0;
    top: -10rem;
    height: min(1800px, calc(100% + 10rem));
    pointer-events: none;
    background:
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.14), transparent) 12% 22% / 60% 36% no-repeat,
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.1), transparent) 88% 34% / 50% 32% no-repeat,
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.07), transparent) 32% 70% / 64% 34% no-repeat;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 10rem, #000 85%, transparent), linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(180deg, transparent, #000 10rem, #000 85%, transparent), linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect;
  }
  :root[data-theme="dark"] .gt-body::before {
    background:
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.09), transparent) 12% 22% / 60% 36% no-repeat,
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.07), transparent) 88% 34% / 50% 32% no-repeat,
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.05), transparent) 32% 70% / 64% 34% no-repeat;
  }

  .gt-app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "today" "summary" "map" "route" "list";
    column-gap: 1.5rem;
    row-gap: 0;
  }
  .gt-app > * {
    min-width: 0;
    margin-bottom: 1rem;
  }
  .gt-app > .gt-a-summary { margin-bottom: 0; }
  .gt-a-summary > * { margin-bottom: 1rem; }
  .gt-app [hidden],
  .gt-hol [hidden],
  .gt-search [hidden] {
    display: none !important;
  }
  .gt-a-today { grid-area: today; }
  .gt-a-summary { grid-area: summary; min-width: 0; }
  .gt-a-map { grid-area: map; }
  .gt-a-route { grid-area: route; }
  .gt-a-list { grid-area: list; }
  @media (min-width: 1024px) {
    .gt-app {
      grid-template-columns: minmax(340px, 410px) minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas: "today map" "summary map" "route map" "list map";
      align-items: start;
    }
    .gt-a-map {
      position: sticky;
      top: 1rem;
      align-self: start;
    }
  }

  /* ===== 玻璃面板（不加 backdrop-filter：後面是靜態環境光，模糊看不出差別，省下手機繪圖） ===== */
  .gt-card {
    position: relative;
    background: var(--cine-glass-bg);
    border: 1px solid var(--cine-glass-border);
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: var(--cine-glass-shadow);
  }
  @supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
    .gt-card::before {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(155deg, var(--cine-glass-edge-a), transparent 38%, transparent 62%, var(--cine-glass-edge-b));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      pointer-events: none;
    }
  }
  .gt-card-soft {
    background: linear-gradient(160deg, rgb(var(--cine-glow) / 0.1), rgb(var(--cine-glow) / 0.03) 60%), var(--cine-glass-bg);
  }
  .gt-h2 { font-size: 1.25rem; font-weight: 700; line-height: 1.4; }
  .gt-h3 { font-size: 1.05rem; font-weight: 700; line-height: 1.4; }

  /* ===== 搜尋卡（放在主視覺裡） ===== */
  .gt-search { padding: 1rem; }
  .gt-label { display: block; font-weight: 700; margin-bottom: 0.5rem; }
  .gt-row { display: flex; gap: 0.5rem; align-items: stretch; }
  .gt-row2 { margin-top: 0.625rem; flex-wrap: wrap; }
  /* 輸入框、查詢鈕的外觀用共用的 .cine-input／.cine-cta（跟學區頁同一套），這裡只管排版 */
  .gt-input {
    flex: 1 1 auto;
    min-width: 0;
  }
  .gt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 0.85rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }
  .gt-btn-primary {
    background: var(--accent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 88%, #fff) 0%, var(--accent) 55%, color-mix(in srgb, var(--accent) 86%, #000) 100%);
    color: var(--accent-foreground);
    border: 1px solid var(--accent);
    box-shadow: 0 6px 16px -8px rgb(var(--cine-glow) / 0.9), 0 1px 0 rgb(255 255 255 / 0.35) inset;
  }
  .gt-btn-outline { background: transparent; color: var(--accent); border: 1.5px solid var(--accent); }
  .gt-btn-outline:hover { background: var(--accent); color: var(--accent-foreground); }
  .gt-btn-here { gap: 0.5rem; }
  .gt-btn-sm { font-size: 0.9rem; padding: 0.35rem 0.8rem; }
  .gt-btn-block { width: 100%; margin-top: 0.75rem; }
  .gt-seg {
    display: inline-flex;
    border: 1.5px solid var(--accent);
    border-radius: 0.75rem;
    overflow: hidden;
    flex: 0 0 auto;
    background: rgb(255 255 255 / 0.35);
  }
  :root[data-theme="dark"] .gt-seg { background: rgb(0 0 0 / 0.15); }
  .gt-seg label { position: relative; display: flex; }
  .gt-seg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .gt-seg span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.65rem;
    font-size: 0.95rem;
    color: var(--accent);
    cursor: pointer;
    white-space: nowrap;
  }
  .gt-seg label + label span { border-left: 1.5px solid var(--accent); }
  .gt-seg input:checked + span { background: var(--accent); color: var(--accent-foreground); font-weight: 600; }
  .gt-seg input:focus-visible + span { outline: 2px dashed var(--accent); outline-offset: -4px; }
  .gt-status { margin-top: 0.75rem; font-size: 0.9rem; color: var(--cine-sub, var(--muted-foreground)); line-height: 1.6; }
  .gt-status.gt-err, .gt-err { color: #b3261e; }
  [data-theme="dark"] .gt-status.gt-err, [data-theme="dark"] .gt-err { color: #ffb4ab; }
  .gt-cands { margin-top: 0.5rem; }
  .gt-cand-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .gt-chip {
    min-height: 44px;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(var(--cine-glow) / 0.45);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    color: var(--foreground);
    font-size: 0.95rem;
    text-align: left;
  }
  :root[data-theme="dark"] .gt-chip { background: rgb(0 0 0 / 0.2); }
  .gt-chip:hover { border-color: var(--accent); color: var(--accent); }
  .gt-small { font-size: 0.875rem; color: var(--muted-foreground); line-height: 1.6; }
  .gt-mt { margin-top: 0.75rem; }
  .gt-a { color: var(--accent); text-decoration: underline; }
  .gt-today-date { font-weight: 700; }
  .gt-facts { margin-top: 0.4rem; padding-left: 1.1rem; list-style: disc; font-size: 0.95rem; line-height: 1.65; }
  .gt-facts li::marker { color: rgb(var(--cine-glow)); }
  .gt-facts li + li { margin-top: 0.3rem; }
  @media (max-width: 399px) {
    .gt-facts { font-size: 0.9rem; line-height: 1.55; }
    .gt-facts li + li { margin-top: 0.2rem; }
  }
  .gt-warn { color: inherit; }
  .gt-warn b { color: #9a3412; }
  [data-theme="dark"] .gt-warn b { color: #fdba74; }
  .gt-warn-box {
    border-left: 4px solid #c2410c;
    background: rgb(194 65 12 / 0.08);
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .gt-kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--cine-eyebrow, var(--muted-foreground));
  }
  .gt-kicker::before {
    content: "";
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(var(--cine-glow));
    box-shadow: 0 0 0 3px rgb(var(--cine-glow) / 0.2), 0 0 10px 2px rgb(var(--cine-glow) / 0.6);
  }
  .gt-sum-title { font-weight: 800; font-size: 1.1rem; overflow-wrap: anywhere; }
  .gt-note { margin-top: 0.35rem; font-size: 0.875rem; color: #9a3412; }
  [data-theme="dark"] .gt-note { color: #fdba74; }
  .gt-sum-count { margin-top: 0.5rem; font-size: 1.05rem; }
  .gt-sum-count b { color: var(--cine-num); font-size: 1.25em; text-shadow: 0 0 18px var(--cine-num-glow); }
  /* 官方抽查：班表可能已改 */
  .gt-drift {
    margin: 0.4rem 0;
    padding: 0.45rem 0.7rem;
    border-left: 4px solid #b3261e;
    background: rgb(179 38 30 / 0.07);
    border-radius: 0.375rem;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .gt-drift-big { font-size: 0.95rem; margin-top: 0.6rem; }
  .gt-drift-big p + p { margin-top: 0.3rem; }
  /* 摘要最上面的抽查警示：手機只顯示一句＋「展開說明」，電腦版整段攤開 */
  .gt-drift-desk { display: none; }
  @media (min-width: 1024px) {
    .gt-drift-desk { display: block; }
    .gt-drift-mob { display: none; }
  }
  .gt-drift-more > summary { cursor: pointer; color: var(--accent); min-height: 44px; display: flex; align-items: center; font-size: 0.9rem; font-weight: 600; list-style: none; }
  .gt-drift-more > summary::-webkit-details-marker { display: none; }
  .gt-drift-more > summary::before { content: "▸"; margin-right: 0.4rem; flex: 0 0 auto; }
  .gt-drift-more[open] > summary::before { content: "▾"; }
  .gt-drift-more > p { font-size: 0.9rem; }
  .gt-drift-more > p + p { margin-top: 0.3rem; }
  [data-theme="dark"] .gt-drift { border-left-color: #ffb4ab; background: rgb(255 180 171 / 0.1); }
  .gt-old { opacity: 0.6; }
  /* 查新地址失敗：上一次的結果淡化 */
  .gt-stale > .gt-card, .gt-stale > .gt-listhead, .gt-stale > #gt-dayinfo, .gt-stale > .gt-list, .gt-a-route.gt-stale, .gt-next.gt-stale { opacity: 0.45; }
  .gt-stale-note { margin-bottom: 0.6rem; }
  .gt-sum-more { margin-top: 0.6rem; border-top: 1px solid rgb(var(--cine-glow) / 0.25); }
  .gt-sum-more > summary { cursor: pointer; color: var(--accent); min-height: 44px; display: flex; align-items: center; font-size: 0.92rem; }
  .gt-sum-more > summary::before { content: "▸"; margin-right: 0.4rem; flex: 0 0 auto; }
  .gt-sum-more[open] > summary::before { content: "▾"; }
  .gt-holnear {
    margin-top: 0.75rem;
    padding: 0.75rem;
    border: 1px dashed #7a4a8c;
    border-radius: 0.75rem;
    font-size: 0.92rem;
    line-height: 1.6;
    background: rgb(122 74 140 / 0.05);
  }
  .gt-ol { list-style: decimal; padding-left: 1.3rem; margin: 0.3rem 0 0.6rem; }
  .gt-more-d { margin: 0.2rem 0 0.6rem; }
  .gt-more-d summary { cursor: pointer; color: var(--accent); min-height: 44px; display: flex; align-items: center; }
  #gt-summary, .gt-list, .gt-hol, #gt-route, .gt-next { overflow-wrap: anywhere; }

  /* ===== 結果依序滑入（摘要各段、清單卡片、路線與假日清單） ===== */
  #gt-summary > .gt-card > *,
  #gt-summary .gt-facts > li,
  .gt-stag > li {
    animation: cine-rise-in 0.6s var(--cine-ease-out) backwards;
  }
  #gt-summary > .gt-card > :nth-child(2), #gt-summary .gt-facts > li:nth-child(1), .gt-stag > li:nth-child(2) { animation-delay: 60ms; }
  #gt-summary > .gt-card > :nth-child(3), #gt-summary .gt-facts > li:nth-child(2), .gt-stag > li:nth-child(3) { animation-delay: 120ms; }
  #gt-summary > .gt-card > :nth-child(4), #gt-summary .gt-facts > li:nth-child(3), .gt-stag > li:nth-child(4) { animation-delay: 180ms; }
  #gt-summary > .gt-card > :nth-child(5), #gt-summary .gt-facts > li:nth-child(4), .gt-stag > li:nth-child(5) { animation-delay: 240ms; }
  #gt-summary > .gt-card > :nth-child(6), #gt-summary .gt-facts > li:nth-child(5), .gt-stag > li:nth-child(6) { animation-delay: 300ms; }
  #gt-summary > .gt-card > :nth-child(n + 7), #gt-summary .gt-facts > li:nth-child(n + 6), .gt-stag > li:nth-child(n + 7) { animation-delay: 340ms; }
  .cine-stagger > .gt-noanim { animation: none; }

  /* ===== 下一班倒數光圈 ===== */
  .gt-next {
    --gt-rc: 168 162 158;
    display: flex;
    align-items: center;
    gap: 0.95rem;
    padding: 0.9rem 1rem;
  }
  .gt-next.is-soon { --gt-rc: 79 154 94; }
  :root[data-theme="dark"] .gt-next.is-soon { --gt-rc: 127 191 134; }
  .gt-next.is-now { --gt-rc: 240 160 32; }
  .gt-next.is-in { animation: cine-rise-in 0.6s var(--cine-ease-out) backwards; }
  .gt-ring {
    position: relative;
    flex: 0 0 auto;
    width: 92px;
    height: 92px;
  }
  .gt-ring::before {
    content: "";
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--gt-rc) / 0.3) 0%, rgb(var(--gt-rc) / 0.1) 45%, transparent 68%);
    animation: gt-halo 3.2s var(--cine-ease-soft) infinite;
    pointer-events: none;
  }
  .gt-next.is-now .gt-ring::before { animation-duration: 1.5s; }
  .gt-next.is-later .gt-ring::before { animation: none; opacity: 0.5; }
  .gt-ring-rot {
    position: absolute;
    inset: 0;
  }
  .gt-next.is-in .gt-ring-rot { animation: gt-ring-in 1.2s var(--cine-ease-out) 0.15s backwards; }
  .gt-ring svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    transform: rotate(-90deg);
  }
  .gt-ring-track {
    fill: rgb(255 255 255 / 0.28);
    stroke: rgb(var(--gt-rc) / 0.18);
    stroke-width: 7;
  }
  :root[data-theme="dark"] .gt-ring-track { fill: rgb(0 0 0 / 0.18); }
  .gt-ring-arc {
    fill: none;
    stroke: rgb(var(--gt-rc));
    stroke-width: 7;
    stroke-linecap: round;
    stroke-dasharray: 100 100;
    stroke-dashoffset: 100;
    filter: drop-shadow(0 0 4px rgb(var(--gt-rc) / 0.65));
  }
  .gt-next.is-later .gt-ring-arc { opacity: 0; }
  .gt-ring-tipr {
    position: absolute;
    inset: 0;
    transition: transform 0.9s var(--cine-ease-out);
  }
  .gt-ring-tip {
    position: absolute;
    left: 50%;
    top: -0.5px;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: #fffaf0;
    box-shadow: 0 0 0 2px rgb(var(--gt-rc)), 0 0 12px 3px rgb(var(--gt-rc) / 0.75);
  }
  .gt-next.is-later .gt-ring-tip { opacity: 0; }
  .gt-next.is-now .gt-ring-tip { animation: gt-tip 1.5s var(--cine-ease-soft) infinite; }
  .gt-ring-c {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.1;
    text-align: center;
  }
  .gt-ring-c b {
    font-size: 1.25rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--cine-num);
    text-shadow: 0 0 16px var(--cine-num-glow);
  }
  .gt-ring-c small { margin-top: 0.15rem; font-size: 0.72rem; color: var(--muted-foreground); }
  .gt-next-txt { min-width: 0; flex: 1 1 auto; }
  .gt-next-k {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--cine-eyebrow, var(--muted-foreground));
  }
  .gt-next-main { margin-top: 0.2rem; font-size: 1.08rem; font-weight: 800; line-height: 1.45; }
  .gt-next.is-now .gt-next-main { color: #9a3412; }
  :root[data-theme="dark"] .gt-next.is-now .gt-next-main { color: #fdba74; }
  .gt-next-sub { margin-top: 0.1rem; font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  .gt-nw { white-space: nowrap; }
  .gt-next-where { margin-top: 0.1rem; font-size: 0.85rem; color: var(--muted-foreground); line-height: 1.5; }
  .gt-next-note { margin-top: 0.3rem; font-size: 0.75rem; color: var(--muted-foreground); }
  @media (max-width: 359px) {
    .gt-next { gap: 0.7rem; padding: 0.8rem; }
    .gt-ring { width: 78px; height: 78px; }
    .gt-ring-c b { font-size: 1.08rem; }
  }
  @keyframes gt-halo {
    0%, 100% { transform: scale(0.9); opacity: 0.75; }
    50% { transform: scale(1.08); opacity: 1; }
  }
  @keyframes gt-ring-in {
    from { transform: rotate(-150deg) scale(0.9); opacity: 0; }
    to { transform: none; opacity: 1; }
  }
  @keyframes gt-tip {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  /* 骨架（第一次查詢還沒結果時） */
  .gt-skel > .gt-card + .gt-card { margin-top: 1rem; }

  /* ===== 地圖 ===== */
  .gt-mapwrap { position: relative; isolation: isolate; }
  #gt-map, #gt-hol-map {
    width: 100%;
    height: clamp(240px, 60vh, 560px);
  }
  #gt-hol-map { height: clamp(240px, 50vh, 460px); }
  @media (min-width: 1024px) {
    #gt-map { height: clamp(460px, calc(100vh - 9rem), 860px); }
  }
  .cine-mapframe.is-fallback #gt-map,
  .cine-mapframe.is-fallback #gt-hol-map { height: 12rem; }
  .gt-mapempty {
    position: absolute;
    left: 50%;
    bottom: 2.75rem;
    transform: translateX(-50%);
    z-index: 6;
    max-width: calc(100% - 2rem);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: var(--cine-glass-bg-solid);
    color: var(--foreground);
    border: 1px solid rgb(var(--cine-glow) / 0.35);
    font-size: 0.875rem;
    box-shadow: 0 10px 26px -12px rgb(60 38 14 / 0.5), 0 0 18px -4px rgb(var(--cine-glow) / 0.45);
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gt-mapfail { padding: 2rem 1rem; text-align: center; color: var(--muted-foreground); }
  /* 鍵盤用：地圖上每個點都是一個 Tab 停留點，先給一個跳過地圖的連結（平常看不到，Tab 到才出現） */
  .gt-skip {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .gt-skip:focus {
    position: static;
    clip: auto;
    clip-path: none;
    overflow: visible;
    white-space: normal;
    display: inline-flex;
    align-items: center;
    width: auto;
    height: auto;
    min-height: 44px;
    margin: 0 0 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 2px solid var(--accent);
    border-radius: 0.5rem;
    background: var(--card);
    color: var(--accent);
    font-weight: 600;
  }
  .gt-h2:focus { outline: none; }
  .gt-unlock-ctrl { margin: 10px 10px 0 0; }
  .gt-unlock {
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--cine-glow) / 0.45);
    background: var(--cine-glass-bg-solid);
    color: var(--foreground);
