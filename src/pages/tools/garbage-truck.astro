      function driftFlag(dist) { var d = BOOT && BOOT.drift; return !!(d && d.flag && d.flag.indexOf(dist) !== -1); }
      function isDrift(s) { return driftFlag(s.dist) || s.od === 1 || s.od === 2; }
      function driftDate() { var c = BOOT && BOOT.drift && BOOT.drift.checked; return c ? +c.slice(5, 7) + "/" + +c.slice(8, 10) : ""; }
