      /* ---------- 資料 ---------- */
      var tileCache = {};
      function loadTile(k) {
        if (!tileCache[k]) {
          tileCache[k] = getJSON(BASE + "t/" + k + ".json?v=" + BOOT.v)
            .then(function (j) { return j.stops || []; })
            .catch(function (e) { delete tileCache[k]; throw e; });
        }
        return tileCache[k];
      }
      function cellOf(lat, lng) {
        return [Math.floor(Math.round(lat * BOOT.scale) / BOOT.cell), Math.floor(Math.round(lng * BOOT.scale) / BOOT.cell)];
      }
      function stopsNear(lat, lng, R) {
        var dLat = R / 111320, dLng = R / (111320 * Math.cos(lat * Math.PI / 180));
        var a = cellOf(lat - dLat, lng - dLng), b = cellOf(lat + dLat, lng + dLng);
        var keys = [];
        for (var y = a[0]; y <= b[0]; y++) for (var x = a[1]; x <= b[1]; x++) {
          var k = y + "_" + x;
          if (BOOT.tiles[k]) keys.push(k);
        }
        return Promise.all(keys.map(loadTile)).then(function (arrs) {
          var out = [], seen = {};
          arrs.forEach(function (arr) {
            arr.forEach(function (s) {
              if (s.lat == null || seen[s.id]) return;
