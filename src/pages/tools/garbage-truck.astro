      }
      var routesP = null;
      function loadRoutes() {
        if (!routesP) routesP = getJSON(BASE + "routes.json?v=" + BOOT.v).catch(function (e) { routesP = null; throw e; });
        return routesP;
      }
      var holP = null;
      function loadHoliday() {
        if (!holP) holP = getJSON(BASE + "holiday.json?v=" + BOOT.v).catch(function (e) { holP = null; throw e; });
        return holP;
      }
      function inR() {
        var R = S.radius;
        return S.all.filter(function (it) { return it.d <= R; });
      }

      /* ---------- 地圖（MapLibre GL ＋ 國土測繪中心 EMAP 圖磚，共用 /js/cine-map.js） ---------- */
      // 座標：MapLibre 一律 [lng, lat]；資料（s.lat / s.lng）跟原本一樣。
      // 地圖是「快進畫面才下載」：還沒載好之前查詢、畫點都先記在 MS，載好時一次補畫。
      var CM = window.CineMap || null;
      var RM = !!(CM && CM.reducedMotion());
      var cm = null, M = null, ML = null;
      function mapOK() { return !!(cm && cm.available); }
      function isDark() { return document.documentElement.getAttribute("data-theme") === "dark"; }
      function accent() { return isDark() ? "#e2b36e" : "#8a6539"; }
      function stCol() { var C = COLS[isDark() ? "dark" : "light"]; return ["match", ["get", "st"], "g", C.g, "r", C.r, C.n]; }
      function fcol(f) { return { type: "FeatureCollection", features: f || [] }; }
      function ptF(lng, lat, p) { return { type: "Feature", properties: p || {}, geometry: { type: "Point", coordinates: [lng, lat] } }; }
      function bbox(pts) {
        var w = 180, s = 90, e = -180, n = -90;
        pts.forEach(function (p) { w = Math.min(w, p[0]); e = Math.max(e, p[0]); s = Math.min(s, p[1]); n = Math.max(n, p[1]); });
        return [[w, s], [e, n]];
      }
      var MS = { q: fcol(), stops: fcol(), near: fcol(), nearPt: fcol(), route: fcol(), routePts: fcol(), holNear: [] };
      function setSrc(k, data) { MS[k] = data; var src = M && M.getSource("gt-" + k); if (src) src.setData(data); }
      // 最近清運點的光柱：內芯分 4 段往上越來越淡（fill-extrusion 不能做透明漸層，用顏色往背景色退），外面包一層半透明光暈
      var BEAM_Z = [[0, 26], [26, 50], [50, 72], [72, 90]]; // 各段高度（公尺）
      var BEAM_C = { light: ["#ffb347", "#ffc672", "#ffd99e", "#ffecc9"], dark: ["#ffe6b0", "#ffd48c", "#f2b865", "#d69a4c"] };
      function beamColor() { var c = BEAM_C[isDark() ? "dark" : "light"]; return ["match", ["get", "k"], 0, c[0], 1, c[1], 2, c[2], c[3]]; }
