  .gt-seg input:focus-visible + span { outline: 2px dashed var(--accent); outline-offset: -4px; }
  .gt-status { margin-top: 0.75rem; font-size: 0.9rem; color: var(--muted-foreground); }
  .gt-status.gt-err, .gt-err { color: #b3261e; }
  [data-theme="dark"] .gt-status.gt-err, [data-theme="dark"] .gt-err { color: #ffb4ab; }
  .gt-cands { margin-top: 0.5rem; }
  .gt-cand-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .gt-chip {
    min-height: 44px;
