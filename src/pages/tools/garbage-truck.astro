---
/**
 * 台中垃圾車時間查詢 — /tools/garbage-truck/（工具代號 garbage-truck）
 *
 * 做什麼：輸入地址 / 用我的位置 / 點地圖 → 列出 300／500 公尺內的垃圾車清運點、每週班表、
 *   今天明天有沒有收；國定假日定點班表；附近垃圾車大約位置（/api/garbage-live）。
 *
 * 資料（全部在 public/data/，由 scripts/build-garbage.py 從官方開放資料產生，本頁不打任何政府網站）：
 *   - /data/garbage/index.json（本頁在 build 時直接內嵌，不再另外下載）
 *   - /data/garbage/t/<格>.json   清運點分塊（0.02 度一格，查詢時只抓附近 1～4 塊）
 *   - /data/garbage/routes.json   車牌 → 路線（看路線、判斷即時車輛是不是垃圾車時才抓）
 *   - /data/garbage/holiday.json  國定假日定點（選行政區或 14 天內有國定假日時才抓）
 *   - /data/garbage/rules.json    規則原文與官方網址（build 時讀；頁面上的規則文字都附官方連結）
 *   - 地址 → 座標：/js/tc-addr.js + /data/tc-addr/（115 年 1 月門牌，全在瀏覽器本機比對）
 *
 * ⛔ 隱私：使用者輸入的地址只在瀏覽器比對，不放 URL、不送 GA、不送任何 API。
 *    GA4 事件只記 result / via / district / radius（沒有地址、沒有座標）。
 * ⛔ 規則類敘述一律要有官方來源（rules.json evidence 的網址）；「週三、週日停收」只能當一般說明，
 *    不是環保局明文規定。106 年分日回收說明跟現況不一致，只當背景、不拿來判斷哪天收。
 * ⛔ 「這一點今天車子到了沒／預計幾點到」不做（那是環保局非開放查詢服務），一律連官方。
 * ⚠️ 本機 astro dev 沒有 Pages Functions，/api/garbage-live 會 404 → 頁面要安靜降級。
 * ⚠️ 不要在模板裡寫 TS 泛型（Record<...>），Astro 模板解析器會把 < 當標籤。
 */
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";
import gIndex from "../../../public/data/garbage/index.json";
import gMeta from "../../../public/data/garbage/meta.json";
import gRules from "../../../public/data/garbage/rules.json";
import gHoliday from "../../../public/data/garbage/holiday.json";

const canonicalURL = new URL("/tools/garbage-truck/", Astro.site).href; // 全站 canonical 帶結尾斜線

// 門牌庫的版本字樣（檔案內容雜湊）：/data/* 與 /js/* 有 1 天快取，換月份版時網址跟著變，瀏覽器才不會拿舊檔
// （跟 school-district.astro 同一套做法；Cloudflare Pages 靜態檔不看 query string，分片版本要靠 index.json 自己帶）
function fileVer(rel: string): string {
  try {
    return crypto.createHash("md5").update(fs.readFileSync(path.join(process.cwd(), rel))).digest("hex").slice(0, 10);
  } catch {
    return gIndex.v;
  }
}
const vAddr = fileVer("public/js/tc-addr.js");
const vIdx = fileVer("public/data/tc-addr/index.json");

const OFFICIAL = "https://cleaner.epb.taichung.gov.tw/";
const HOLIDAY_PAGE = "https://cleaner.epb.taichung.gov.tw/schedule.aspx";
const TEAM_PAGE = "https://cleaner.epb.taichung.gov.tw/services_4.aspx";
const NEWS_PAGE = "https://cleaner.epb.taichung.gov.tw/services_2_1.aspx"; // 大車隊「最新消息」：國定假日、颱風等收運訊息
const LICENSE_URL = "https://data.gov.tw/license";
const POST_HOLIDAY = gHoliday.announcement; // 115 年國定假日收運公告（環保局）
const POST_MID_AUTUMN = "https://www.epb.taichung.gov.tw/3375213/post"; // 2026-09-21 新聞稿
const POST_LABOR_DAY = "https://www.epb.taichung.gov.tw/3263783/post"; // 2026-04-27 新聞稿（三類）
const RECYCLE_SPLIT = "https://recycle.epb.taichung.gov.tw/other/other10.asp"; // 資源回收網：分日回收
const RECYCLE_QA = "https://recycle.epb.taichung.gov.tw/qa/qa_01-1.asp"; // 資源回收網：常見問答
const DATA_STOPS = gIndex.srcUrl; // data.gov.tw 84004
const DATA_LIVE = "https://data.gov.tw/dataset/83558";
const DATA_ADDR = "https://opendata.taichung.gov.tw/search/50168dd2-4239-4f3e-89cf-f706617f0436";
const APP_ANDROID = gRules.app.android;
const APP_IOS = gRules.app.ios;

const dataModified = gIndex.modified; // 開放資料平臺修改日（資料版本）
const dataFetched = gIndex.fetched.slice(0, 10);
const stopCount = gMeta.stops.count;
const rawCount = gMeta.stops.raw_rows;
const holFetched = gHoliday.fetched.slice(0, 10);
const holCount = gHoliday.count;
const geoMedian = gMeta.stops.geo_validation_vs_epb_holiday_xy.median_m;
const geoCompared = gMeta.stops.geo_validation_vs_epb_holiday_xy.compared;

// 建置時用環保局官方查詢系統抽查開放資料有沒有過時（scripts/build-garbage.py --drift-check）
type DriftDist = { n: number; diff: number; plate: number; only: number };
type DriftRoute = { n: number; diff: number; dists: string[]; msg: string; marked?: number };
type Drift = {
  checked: string; against: string; src: string; stops: number; same: number;
  dists: { [d: string]: DriftDist }; flag: string[]; msg: { [d: string]: string };
  routes?: { [plate: string]: DriftRoute } | null;
};
const drift = (gIndex as unknown as { drift: Drift | null }).drift;
const driftChecked = drift ? `${+drift.checked.slice(5, 7)}/${+drift.checked.slice(8, 10)}` : "";
const driftDistCount = drift ? Object.keys(drift.dists).filter(d => drift.dists[d].n > 0).length : 0;
const driftFlag = drift ? drift.flag : [];
const driftFlagText = driftFlag.map(d => `${d}（${drift!.dists[d].n} 點有 ${drift!.dists[d].diff} 點不同）`).join("、");
// 整區沒被標、但有路線抽到不同的區 → 「南區 1 條路線（車號 411-VP）」
const driftRoutes = (drift && drift.routes) || {};
const extraRoutesByDist: { [d: string]: string[] } = {};
Object.keys(driftRoutes).forEach(plate => {
  driftRoutes[plate].dists.filter(d => !driftFlag.includes(d)).forEach(d => {
    (extraRoutesByDist[d] = extraRoutesByDist[d] || []).push(plate);
  });
});
const extraRouteDists = Object.keys(extraRoutesByDist);
const extraRouteText = extraRouteDists.map(d => `${d} ${extraRoutesByDist[d].length} 條路線（車號 ${extraRoutesByDist[d].join("、")}）`).join("、");
// FAQ 用的短句：「中區、太平區整區和南區部分路線」
const driftScope = [
  driftFlag.length ? `${driftFlag.join("、")}整區` : "",
  extraRouteDists.length ? `${extraRouteDists.join("、")}部分路線` : "",
].filter(Boolean).join("和");

// 官方彈窗原文（去掉結尾「，時間、地點如下：」，其餘一字不改）
const holidayNotice = gHoliday.notice.replace(/，?時間、地點如下[:：]?\s*$/, "");

const weekly = gRules.rules.find(r => r.id === "weekly_pattern") as { data_evidence?: string } | undefined;
const weeklyEvidence = weekly?.data_evidence ?? "";

const districts = Object.keys(gRules.contacts.dist_team);

// 前端要用的小資料直接內嵌（省一次請求；資料重建時頁面也會一起重建）
const boot = {
  v: gIndex.v,
  modified: dataModified,
  scale: gIndex.scale,
  cell: gIndex.cell,
  tiles: gIndex.tiles,
  geoApprox: gIndex.geoApprox,
  hol: {
    year: gHoliday.year,
    yearRoc: gHoliday.year_roc,
    dates: gHoliday.dates,
    noData: gHoliday.no_data_districts,
    noDataNote: gHoliday.no_data_note,
    pdf: gHoliday.pdf_by_district,
    announcement: POST_HOLIDAY,
  },
  drift: drift
    ? {
        checked: drift.checked, against: drift.against, flag: drift.flag, msg: drift.msg,
        routes: Object.fromEntries(Object.entries(driftRoutes).map(([k, r]) => [k, { n: r.n, diff: r.diff, dists: r.dists, msg: r.msg }])),
        dists: Object.fromEntries(Object.entries(drift.dists).map(([k, d]) => [k, { n: d.n, diff: d.diff }])),
      }
    : null,
  vIdx,
  teamPage: TEAM_PAGE,
  teams: gRules.contacts.teams.map(t => ({ no: t.no, name: t.name, tel: t.tel })),
  distTeam: gRules.contacts.dist_team,
  official: OFFICIAL,
};

const faqs = [
  {
    id: "how",
    q: "台中垃圾車時間怎麼查？",
    a: `在本頁輸入台中的地址、用手機定位或在地圖上點一下，就會列出 300／500 公尺內每個清運點的收運時間與收運方式，資料來自臺中市政府環境保護局開放資料「臺中市定時定點垃圾收運地點」（${dataModified} 版）。這份開放資料是不定期更新的預定班表，可能跟現況不同${driftScope ? `；本站 ${driftChecked} 用環保局官方查詢系統抽查，${driftScope}的時間已經不一樣，查到會標「時間可能已改」，請以官方為準` : ""}。實際到點請看環保局「臺中垃圾清運大車隊」查詢網頁或官方 APP。`,
    html: `在本頁輸入台中的地址、用手機定位或在地圖上點一下，就會列出 300／500 公尺內每個清運點的收運時間與收運方式，資料來自臺中市政府環境保護局開放資料<a href="${DATA_STOPS}" rel="noopener" target="_blank">「臺中市定時定點垃圾收運地點」</a>（${dataModified} 版）。這份開放資料是不定期更新的預定班表，可能跟現況不同${driftScope ? `；本站 ${driftChecked} 用環保局官方查詢系統抽查，<strong>${driftScope}的時間已經不一樣</strong>，查到會標「時間可能已改」，請以官方為準` : ""}。實際到點請看環保局<a href="${OFFICIAL}" rel="noopener" target="_blank">「臺中垃圾清運大車隊」</a>查詢網頁或<a href="#gt-official">官方 APP</a>。`,
  },
  {
    id: "holiday",
    q: "國定假日垃圾車有沒有收？",
    a: "臺中市環保局公告，115 年元旦、農曆春節初一與初三、和平紀念日、兒童節、勞動節、端午節、中秋節、教師節、國慶日、行憲紀念日，停止沿街垃圾收運，當天改為定時定點服務。各區定點的時間與地點，可以在本頁「國定假日定點班表」選行政區查，或看環保局公告附的各區 PDF。和平區在官方的國定假日定點班表裡沒有資料，請洽和平區清潔隊。",
    html: `臺中市環保局公告，115 年元旦、農曆春節初一與初三、和平紀念日、兒童節、勞動節、端午節、中秋節、教師節、國慶日、行憲紀念日，<strong>停止沿街垃圾收運，當天改為定時定點服務</strong>（<a href="${POST_HOLIDAY}" rel="noopener" target="_blank">環保局公告</a>）。各區定點的時間與地點，可以在本頁<a href="#gt-hol">「國定假日定點班表」</a>選行政區查，或看環保局公告附的各區 PDF。和平區在<a href="${HOLIDAY_PAGE}" rel="noopener" target="_blank">官方的國定假日定點班表</a>裡沒有資料，請洽和平區清潔隊。`,
  },
  {
    id: "recycle",
    q: "資源回收哪天收？",
    a: "每個清運點不一樣。本頁列表裡的「資源回收」就是該點的資源回收時段，來自環保局開放資料；那天沒寫時間，就是那天沒排資源回收。瓦斯罐、殺蟲劑、噴漆罐等壓力容器，環保局提醒要交給資源回收車，不要丟進垃圾車。環保局資源回收網另有一份 106 年 10 月起實施的原市 8 區「分日回收」說明（週一收紙類與玻璃容器、週四收紙容器與塑膠、金屬容器、週六全收，北區與西屯區週二也收容器類），但現在各點的資源回收班表和那份說明不完全一致，哪天有資源回收車，看各點班表或官方 APP。",
    html: `每個清運點不一樣。本頁列表裡的「資源回收」就是該點的資源回收時段，來自<a href="${DATA_STOPS}" rel="noopener" target="_blank">環保局開放資料</a>；那天沒寫時間，就是那天沒排資源回收。瓦斯罐、殺蟲劑、噴漆罐等壓力容器，環保局提醒要交給資源回收車，不要丟進垃圾車（<a href="${POST_MID_AUTUMN}" rel="noopener" target="_blank">環保局 2026-09-21 新聞稿</a>）。<br />環保局資源回收網另有一份 106 年 10 月起實施的原市 8 區<a href="${RECYCLE_SPLIT}" rel="noopener" target="_blank">「分日回收」說明</a>（週一收紙類與玻璃容器、週四收紙容器與塑膠、金屬容器、週六全收，北區與西屯區週二也收容器類），但現在各點的資源回收班表和那份說明不完全一致，<strong>哪天有資源回收車，看各點班表或官方 APP</strong>。`,
  },
  {
    id: "wed",
    q: "週三、週日有收垃圾嗎？",
    a: `依環保局開放資料的清運班表統計：${weeklyEvidence}。環保局 2026-09-21 的新聞稿也寫到 9 月 27 日（星期日）為例假日不收運。這是從資料整理出來的一般情形，不是環保局明文規定；你家附近哪天收，看本頁查到的各點班表或官方 APP。`,
    html: `依<a href="${DATA_STOPS}" rel="noopener" target="_blank">環保局開放資料</a>的清運班表統計：${weeklyEvidence}。環保局 <a href="${POST_MID_AUTUMN}" rel="noopener" target="_blank">2026-09-21 的新聞稿</a>也寫到 9 月 27 日（星期日）為例假日不收運。<strong>這是從資料整理出來的一般情形，不是環保局明文規定</strong>；你家附近哪天收，看本頁查到的各點班表或官方 APP。`,
  },
  {
    id: "kitchen",
    q: "廚餘要怎麼丟？",
    a: "廚餘跟著垃圾車收。環保局資源回收網說明：廚餘類隨垃圾車收運日回收，民眾自備容器盛裝，交給清潔隊垃圾車上的廚餘回收桶；塑膠袋、衛生紙、竹筷等雜質不能丟進廚餘桶，並請先瀝乾水分。環保局也提醒，倒垃圾前先分成「資源垃圾」「生、熟廚餘」「一般垃圾」三類。",
    html: `廚餘跟著垃圾車收。環保局資源回收網說明：廚餘類隨垃圾車收運日回收（<a href="${RECYCLE_SPLIT}" rel="noopener" target="_blank">分日回收頁</a>），民眾自備容器盛裝，交給清潔隊垃圾車上的廚餘回收桶；塑膠袋、衛生紙、竹筷等雜質不能丟進廚餘桶，並請先瀝乾水分（<a href="${RECYCLE_QA}" rel="noopener" target="_blank">常見問答</a>）。環保局也提醒，倒垃圾前先分成「資源垃圾」「生、熟廚餘」「一般垃圾」三類（<a href="${POST_LABOR_DAY}" rel="noopener" target="_blank">環保局 2026-04-27 新聞稿</a>）。`,
  },
  {
    id: "bulky",
    q: "大型家電、堪用家具要怎麼丟？",
    a: "環保局資源回收網說明，大型家電、堪用家具屬於約定收運項目，要先向所在地的清潔隊申請、約好時間。本頁查詢結果會附上該區清潔隊電話。",
    html: `環保局資源回收網說明，大型家電、堪用家具屬於約定收運項目，要先向所在地的清潔隊申請、約好時間（<a href="${RECYCLE_SPLIT}" rel="noopener" target="_blank">資源回收網</a>）。本頁查詢結果會附上該區清潔隊電話，完整名單在<a href="${TEAM_PAGE}" rel="noopener" target="_blank">環保局清潔隊聯絡方式</a>。`,
  },
];

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "台中垃圾車時間查詢",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web",
  url: canonicalURL,
  description:
    "輸入台中的地址、用手機定位或在地圖上點一下，列出 300／500 公尺內的垃圾車清運點與每週收運時間，看今天、明天有沒有收、資源回收哪天來，以及國定假日的定時定點班表。資料來自臺中市政府環境保護局開放資料，僅供參考，以官方公告為準。",
  offers: { "@type": "Offer", price: "0", priceCurrency: "TWD" },
  provider: { "@id": `${config.site.url}#realestateagent` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首頁", item: config.site.url },
    { "@type": "ListItem", position: 2, name: "客戶工具", item: `${config.site.url}tools/` },
    { "@type": "ListItem", position: 3, name: "台中垃圾車時間查詢", item: canonicalURL },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Layout
  title={`台中垃圾車時間查詢｜輸入地址看附近清運點 | ${config.site.title}`}
  description="台中垃圾車時間怎麼查？輸入地址、用手機定位或點地圖，列出 300／500 公尺內的清運點與每週收運時間，看今天、明天有沒有收，資源回收哪天來，國定假日改到哪個定點。資料來自臺中市環保局開放資料。"
  canonicalURL={canonicalURL}
  ogImage="/og/page-tools.jpg"
  showFloatingCTA={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={safeJsonLd(appSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(faqSchema)} />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
  </Fragment>
  <Header />

  <Main
    pageTitle="台中垃圾車時間查詢"
    pageDesc="輸入地址、用手機定位，或在地圖上點一下，看附近垃圾車幾點來、今天有沒有收。"
    class="gt-main"
  >
    <noscript>
      <p class="gt-card">
        這個工具需要開啟 JavaScript。也可以直接用環保局官方的
