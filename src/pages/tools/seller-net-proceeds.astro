  <style is:global>
    .print-only { display: none; }
    @page { size: A4; margin: 10mm; }
    /* 列印：導覽、說明小字全藏，輸入在左、結果在右，整體縮到 88% 塞進一頁 A4 給屋主帶回去 */
    @media print {
      header, footer, nav, .no-print, .hint, #main-content > h1 + p { display: none !important; }
      .print-only { display: block !important; }
      main { max-width: 100% !important; padding: 0 !important; zoom: 0.88; }
      body { font-size: 10.5pt; }
      h1 { font-size: 16pt !important; }
      h2 { font-size: 12pt !important; }
      #calc { display: grid !important; grid-template-columns: 3fr 2fr; gap: 10px; align-items: start; }
      #calc > div { min-width: 0; }
      .space-y-6 > * + * { margin-top: 10px !important; }
      .card-surface { box-shadow: none !important; break-inside: avoid; padding: 10px !important; }
      .lg\:sticky { position: static !important; }
      #calc input[type="text"], #calc input[type="date"] {
        border: 0 !important;
        border-bottom: 1px solid #999 !important;
        border-radius: 0 !important;
        padding: 1px 0 !important;
        background: transparent !important;
      }
      #calc input::placeholder { color: transparent !important; }
      #calc input[type="date"]::-webkit-calendar-picker-indicator { display: none !important; }
      #hl-details { border: 0 !important; padding: 0 !important; }
      #hl-details summary { list-style: none; }
      details > summary::-webkit-details-marker { display: none; }
    }
  </style>

  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var ids = ["name", "ask", "discount", "sale", "acqDate", "saleDate", "cost", "expense", "selfUse",
                 "lvt", "lvtSelf", "fee", "other", "loan", "target"];
      var el = {};
      for (var i = 0; i < ids.length; i++) el[ids[i]] = $(ids[i]);

      // 全部以「萬」為單位計算
      function num(x) {
        var s = String(x == null ? "" : x).replace(/[,\s萬元]/g, "");
        var v = parseFloat(s);
        return isFinite(v) ? v : 0;
      }
      function has(x) { return String(x == null ? "" : x).trim() !== ""; }
      function wan(n) {
        var r = Math.round(n * 10) / 10;
        return r.toLocaleString("zh-TW", { minimumFractionDigits: 0, maximumFractionDigits: 1 }) + " 萬";
      }
      function pct(n) { return (Math.round(n * 100) / 100) + "%"; }
      function toDate(s) {
        if (!s) return null;
        var p = s.split("-");
        if (p.length !== 3) return null;
        var d = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]));
        return isNaN(d.getTime()) ? null : d;
      }
      function addYears(d, n) {
        var r = new Date(d.getTime());
        r.setFullYear(r.getFullYear() + n);
        return r;
      }
      function todayStr() {
        var d = new Date();
        var m = d.getMonth() + 1, day = d.getDate();
        return d.getFullYear() + "-" + (m < 10 ? "0" : "") + m + "-" + (day < 10 ? "0" : "") + day;
      }
      function holdingText(a, b) {
        var y = b.getFullYear() - a.getFullYear();
        var m = b.getMonth() - a.getMonth();
        if (b.getDate() < a.getDate()) m--;
        if (m < 0) { y--; m += 12; }
        if (y < 0) return "出售日早於取得日";
        return y + " 年 " + m + " 個月";
      }

      // 房地合一 2.0：回傳 { tax, rate, note[], regime }
      function houseLandTax(sale, cost, expense, landGain, selfUse, acq, sold) {
        var out = { tax: 0, rate: null, notes: [], regime: "new", taxable: 0 };
        if (!acq || !sold) {
          out.regime = "unknown";
          out.notes.push("還沒填取得日期，房地合一稅先以 0 計。");
          return out;
        }
        if (sold < acq) {
          out.regime = "invalid";
          out.notes.push("出售日期早於取得日期，請檢查。");
          return out;
        }
        if (acq < new Date(2016, 0, 1)) {
          out.regime = "old";
          out.notes.push("2015/12/31 以前取得＝舊制，不適用房地合一；房屋部分的財產交易所得要併入隔年綜所稅，這裡沒算。");
          return out;
        }
        // 持有期間：「超過 N 年」= 出售日在取得日加 N 年之後（同日仍算 N 年以內）
        var over = function (n) { return sold.getTime() > addYears(acq, n).getTime(); };
        var rate = !over(2) ? 45 : !over(5) ? 35 : !over(10) ? 20 : 15;
        var taxable = sale - cost - expense - landGain;
        if (taxable < 0) taxable = 0;
        out.taxable = taxable;
        out.notes.push("持有 " + holdingText(acq, sold) + "。");
        out.notes.push("課稅所得 ＝ " + wan(sale) + " − 成本 " + wan(cost) + " − 費用 " + wan(expense) +
          (landGain > 0 ? " − 土地漲價總數額 " + wan(landGain) : "") + " ＝ " + wan(taxable) + "。");
        if (selfUse) {
          if (!over(6) && sold.getTime() < addYears(acq, 6).getTime()) {
            out.notes.push("勾了自住優惠，但持有還不滿 6 年，不符合條件，改用一般稅率 " + rate + "%。");
            out.rate = rate;
            out.tax = taxable * rate / 100;
          } else {
            var ex = Math.max(0, taxable - 400);
            out.rate = 10;
            out.tax = ex * 0.10;
            out.notes.push("自住優惠：400 萬以內免稅，超過的 " + wan(ex) + " × 10% ＝ " + wan(out.tax) + "。");
          }
        } else {
          out.rate = rate;
          out.tax = taxable * rate / 100;
          out.notes.push("一般稅率 " + rate + "%：" + wan(taxable) + " × " + rate + "% ＝ " + wan(out.tax) + "。");
        }
        return out;
      }

      function readInputs() {
        var lvt = has(el.lvt.value) ? num(el.lvt.value) : null;
        return {
          sale: num(el.sale.value),
          cost: num(el.cost.value),
          expense: num(el.expense.value),
          selfUse: el.selfUse.checked,
          lvt: lvt,
          landGain: (lvt !== null && lvt > 0 && el.lvtSelf.checked) ? lvt / 0.10 : 0,
          feePct: has(el.fee.value) ? num(el.fee.value) : 0,
          escrow: true, // 履約保證一律計入（2026-09-20 景泰：不給選）
          other: num(el.other.value),
          loan: num(el.loan.value),
          acq: toDate(el.acqDate.value),
          sold: toDate(el.saleDate.value),
        };
      }

      // 給定成交價算實拿（反推也用這支）
      function compute(inp, sale) {
        var fee = sale * inp.feePct / 100;
        var escrow = inp.escrow ? sale * 0.0003 : 0;
        var hl = houseLandTax(sale, inp.cost, inp.expense, inp.landGain, inp.selfUse, inp.acq, inp.sold);
        var lvt = inp.lvt === null ? 0 : inp.lvt;
        var net = sale - fee - escrow - inp.other - lvt - hl.tax;
        var cash = net - inp.loan;
        return { sale: sale, fee: fee, escrow: escrow, other: inp.other, lvt: lvt, hl: hl, net: net, cash: cash };
      }

      // 手機底部實拿條顯示時，把全站右下角的 LINE 浮動鈕往上推，不然會壓到數字
      // （FloatingCTA 的 bottom 本來就吃 --consent-h，這裡只在它原本的算式上再加條高）
      function showSticky(show) {
        $("sticky").hidden = !show;
        var cta = document.querySelector("[data-floating-cta]");
        if (!cta) return;
        if (cta.dataset.origBottom == null) cta.dataset.origBottom = cta.style.bottom || "";
        cta.style.bottom = show ? "calc(1rem + var(--consent-h, 0px) + 3.5rem)" : cta.dataset.origBottom;
      }

      function render() {
        var inp = readInputs();
        var hasSale = inp.sale > 0;
        var r = compute(inp, inp.sale);

        var set = function (id, v) { $(id).textContent = v; };
        if (!hasSale) {
          ["res-cash", "res-cash2", "res-sale", "res-fee", "res-escrow", "res-other", "res-lvt", "res-hl", "res-net", "res-loan", "sticky-cash"]
            .forEach(function (id) { set(id, "—"); });
          set("res-fee-pct", ""); set("res-hl-rate", "");
          $("res-flag").textContent = "先填開價或預估成交價。";
          $("hl-detail").innerHTML = "";
          showSticky(false);
          return;
        }
        set("res-cash", wan(r.cash)); set("res-cash2", wan(r.cash)); set("sticky-cash", wan(r.cash));
        set("res-sale", wan(r.sale));
        set("res-fee", wan(r.fee)); set("res-fee-pct", "(" + pct(inp.feePct) + ")");
        set("res-escrow", wan(r.escrow));
        set("res-other", wan(r.other));
        set("res-lvt", inp.lvt === null ? "未計" : wan(r.lvt));
        set("res-hl", r.hl.regime === "new" ? wan(r.hl.tax) : (r.hl.regime === "old" ? "舊制 0" : "未計"));
        set("res-hl-rate", r.hl.rate !== null ? "(" + r.hl.rate + "%)" : "");
        set("res-net", wan(r.net));
        set("res-loan", wan(inp.loan));
        showSticky(true);

        var flags = [];
        if (inp.lvt === null) flags.push("⚠️ 尚未含土地增值稅");
        if (r.hl.regime === "old") flags.push("⚠️ 舊制：房屋部分綜所稅另計");
        if (r.hl.regime === "unknown") flags.push("⚠️ 尚未含房地合一稅（沒填取得日期）");
        if (!has(el.cost.value) && r.hl.regime === "new") flags.push("⚠️ 取得成本填 0，房地合一稅會偏高");
        if (r.cash < 0) flags.push("⚠️ 賣了還不夠還貸款和費用，要自己補差額");
        $("res-flag").textContent = flags.join("　");

        var html = "";
        for (var i = 0; i < r.hl.notes.length; i++) html += "<p>" + esc(r.hl.notes[i]) + "</p>";
        $("hl-detail").innerHTML = html;

        renderTarget(inp);
      }

      function esc(s) {
        return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      }

      // 反推：二分法找「實拿 ≥ 目標」的最低成交價（實拿對成交價單調遞增）
      function renderTarget(inp) {
        var t = num(el.target.value);
        if (!(t > 0)) { $("target-out").textContent = "—"; return; }
        var lo = 0, hi = Math.max(t * 4, 100);
        // 稅率最高 45%、仲介費最高 6%，實拿至少是成交價的一半左右，hi 夠用；保險再放大
        for (var g = 0; g < 8 && compute(inp, hi).cash < t; g++) hi *= 2;
        if (compute(inp, hi).cash < t) { $("target-out").textContent = "算不出來"; return; }
        for (var i = 0; i < 60; i++) {
          var mid = (lo + hi) / 2;
          if (compute(inp, mid).cash >= t) hi = mid; else lo = mid;
        }
        $("target-out").textContent = wan(Math.ceil(hi));
      }

      // 開價 × 議價空間 ↔ 成交價 雙向聯動
      var syncing = false;
      function fromAsk() {
        if (syncing) return; syncing = true;
        var ask = num(el.ask.value), d = num(el.discount.value);
        if (ask > 0) el.sale.value = String(Math.round(ask * (1 - d / 100)));
        syncing = false;
      }
      function fromSale() {
        if (syncing) return; syncing = true;
        var ask = num(el.ask.value), sale = num(el.sale.value);
        if (ask > 0 && sale > 0) el.discount.value = String(Math.round((1 - sale / ask) * 1000) / 10);
        syncing = false;
      }

      function boot() {
        if (!el.sale) return;
        if (!el.saleDate.value) el.saleDate.value = todayStr();

        el.ask.addEventListener("input", function () { fromAsk(); render(); });
        el.discount.addEventListener("input", function () { fromAsk(); render(); });
        el.sale.addEventListener("input", function () { fromSale(); render(); });
        Array.prototype.forEach.call(document.querySelectorAll("[data-disc]"), function (b) {
          b.addEventListener("click", function () {
            el.discount.value = b.getAttribute("data-disc");
            fromAsk(); render();
          });
        });
        $("expense3").addEventListener("click", function () {
          var s = num(el.sale.value);
          if (!(s > 0)) { el.sale.focus(); return; }
          el.expense.value = String(Math.min(30, Math.round(s * 0.03 * 10) / 10));
          render();
        });
        ["acqDate", "saleDate", "cost", "expense", "selfUse", "lvt", "lvtSelf", "fee", "other", "loan", "target"]
          .forEach(function (id) {
            el[id].addEventListener("input", render);
            el[id].addEventListener("change", render);
          });
        el.name.addEventListener("input", function () { $("print-name").textContent = el.name.value; });

        $("print").addEventListener("click", function () { window.print(); });
        $("reset").addEventListener("click", function () {
          for (var i = 0; i < ids.length; i++) {
            var e = el[ids[i]];
            if (e.type === "checkbox") e.checked = false;
            else e.value = "";
          }
          el.fee.value = "4";
          el.saleDate.value = todayStr();
          $("print-name").textContent = "";
          render();
        });
        window.addEventListener("beforeprint", function () {
          $("print-date").textContent = todayStr().replace(/-/g, "/");
          $("hl-details").open = true;
        });
        $("print-date").textContent = todayStr().replace(/-/g, "/");
        render();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot);
      } else {
        boot();
      }
    })();
  </script>
