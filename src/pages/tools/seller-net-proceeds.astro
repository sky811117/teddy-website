---
/**
 * 賣方售出實拿試算 — /tools/seller-net-proceeds/
 *
 * 為什麼做這頁：跟屋主談委託、談底價時，最常被問的就是「開價這樣，扣掉稅跟費用
 * 我到底拿多少？」。原本要開 Excel 手算房地合一，現在手機掏出來當場算給屋主看，
 * 也能直接列印／存 PDF 留給屋主帶回去想。
 *
 * 設計原則（2026-09-20 景泰）：
 *  - 認列成本（當初買價、可列舉費用）一律屋主自己填，不用推定值當預設。
 *  - 土增稅屋主常常不知道 → 留白就「先不計」，明白標示未含，附官方試算入口。
 *  - 手機優先：數字鍵盤、單位用「萬」、輸入即算不用按按鈕、底部固定顯示實拿。
 *  - 可列印：隱藏導覽與說明，只留輸入摘要 + 明細 + 證號。
 *
 * 計算依據（全部在頁面下方「怎麼算的」段落再講一次）：
 *  - 房地合一 2.0：所得稅法第 14 條之 4（2021-07-01 施行；2016-01-01 以後取得才適用）
 *    持有 ≤2 年 45%、>2～5 年 35%、>5～10 年 20%、>10 年 15%；
 *    自住（設籍居住連續滿 6 年、無出租營業）課稅所得 400 萬免稅、超過部分 10%。
 *    費用未提示：成交價 3%、上限 30 萬（財政部 110 年 6 月 11 日令）。
 *  - 土地增值稅：土地稅法第 33、34 條（自用住宅 10%；一般 20／30／40% 累進）。
 *  - 仲介服務費：不動產經紀業報酬計收標準（買賣雙方合計不得超過成交價 6%）。
 *  - 履約保證：市場常見服務費萬分之 6、買賣各半（各家履保公司費率略有不同）。
 *
 * ⚠️ 這是試算，不是稅務申報。繼承／受贈取得、預售換約、合建分屋、非自願因素
 *    交易等特殊情形不在這頁範圍，頁面上有寫。
 */
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";

const canonicalURL = new URL("/tools/seller-net-proceeds", Astro.site).href;

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "賣方售出實拿試算（房地合一稅＋土增稅＋仲介費）",
  applicationCategory: "FinanceApplication",
  operatingSystem: "Web",
  url: canonicalURL,
  description:
    "輸入開價或預估成交價、當初買價、取得日期，一秒算出賣房後扣掉房地合一稅、土地增值稅、仲介服務費、履約保證費與貸款餘額之後，屋主實際拿到多少。手機可用、可列印。",
  offers: { "@type": "Offer", price: "0", priceCurrency: "TWD" },
  provider: { "@id": `${config.site.url}#realestateagent` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首頁", item: config.site.url },
    { "@type": "ListItem", position: 2, name: "客戶工具", item: `${config.site.url}tools/` },
    { "@type": "ListItem", position: 3, name: "賣方售出實拿試算", item: canonicalURL },
  ],
};

const faqs = [
  {
    q: "賣房子要繳哪些稅和費用？",
    a: "賣方常見的支出有：仲介服務費（買賣雙方合計不超過成交價 6%，賣方常見 4%）、土地增值稅、房地合一稅（2016 年 1 月 1 日以後取得的房地才適用）、履約保證服務費（常見萬分之 6，買賣各半）、抵押權塗銷等代辦費，以及交屋日前的地價稅、房屋稅分攤。如果房子還有貸款，成交款要先清償貸款餘額，剩下的才是實拿。",
  },
  {
    q: "房地合一稅怎麼算？",
    a: "課稅所得 = 成交價 − 取得成本 − 可列舉的費用 − 土地漲價總數額。稅率看持有期間：2 年以內 45%、超過 2 年到 5 年 35%、超過 5 年到 10 年 20%、超過 10 年 15%。本人、配偶或未成年子女設籍並實際居住連續滿 6 年、期間沒有出租或營業，可以用自住優惠：課稅所得 400 萬以內免稅、超過的部分 10%，6 年內只能用一次。",
  },
  {
    q: "我不知道土增稅是多少，怎麼辦？",
    a: "土地增值稅要看這筆土地前次移轉現值、現在的公告現值和持有年數，屋主通常不會記得。可以帶土地所有權狀或謄本上的地號，到台中市政府地方稅務局臨櫃或用線上試算查。這個工具土增稅欄位留白就當「先不計」，結果會標示尚未含土增稅。",
  },
  {
    q: "2016 年以前買的房子也適用房地合一嗎？",
    a: "不適用。2015 年 12 月 31 日以前取得的房地是「舊制」：土地部分只課土地增值稅，房屋部分的財產交易所得併入隔年綜合所得稅申報。這個工具遇到舊制會把房地合一稅顯示為 0，並提醒你另外估房屋部分的綜所稅。",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const inputCls =
  "border-border bg-background w-full rounded-md border px-3 py-2.5 text-base tabular-nums";
const labelCls = "text-foreground block text-sm font-medium";
// hint：列印時整個藏掉（屋主拿到的紙只要數字，不要說明文），壓成一頁 A4
const hintCls = "hint text-muted-foreground mt-1 text-xs leading-relaxed";
---

<Layout
  title={`賣方售出實拿試算｜扣掉房地合一稅、土增稅、仲介費，屋主實際拿多少 | ${config.site.title}`}
  description="輸入開價或預估成交價、當初買價、取得日期，一秒算出賣房後扣掉房地合一稅、土地增值稅、仲介服務費、履約保證費與貸款餘額之後，屋主實際拿到多少。手機可用、可列印給屋主。"
  canonicalURL={canonicalURL}
  ogImage="/og/page-tools.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={safeJsonLd(appSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(faqSchema)} />
  </Fragment>
  <Header />

  <Main
    pageTitle="賣方售出實拿試算"
    pageDesc="開價這樣，扣掉房地合一稅、土增稅、仲介費、履保費、還掉貸款，屋主到底拿多少？填幾個數字，當場算給你看。"
  >
    {/* 列印時才出現的抬頭：左邊日期＋物件名，右邊兩個品牌 LOGO（2026-09-20 景泰：LOGO 也要坐進去） */}
    <div class="print-only mb-4">
      <div class="flex items-center justify-between gap-4">
        <div>
          <p class="text-sm">試算日期：<span id="print-date"></span></p>
          <p id="print-name" class="mt-1 text-lg font-bold"></p>
        </div>
        <div class="flex shrink-0 items-center gap-4">
          <img src="/logos/utrust-wordmark.png" alt="有巢氏房屋" width="800" height="240" style="height:40px;width:auto" />
          <img src="/logos/bigkanban-wordmark.png" alt="房仲大看板 Big KanBan" width="800" height="262" style="height:40px;width:auto" />
        </div>
      </div>
    </div>

    <form id="calc" class="grid grid-cols-1 gap-6 lg:grid-cols-5" autocomplete="off" novalidate>
      {/* ===== 左：輸入 ===== */}
      <div class="space-y-6 lg:col-span-3">
        {/* 1. 價格 */}
        <section class="card-surface p-4 sm:p-5">
          <h2 class="text-lg font-bold">① 價格</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label class={labelCls} for="name">物件名稱（選填，印出來用）</label>
              <input id="name" type="text" class={inputCls} placeholder="例：北屯 XX 社區 12 樓" />
            </div>
            <div>
              <label class={labelCls} for="ask">開價（萬）</label>
              <input id="ask" type="text" inputmode="decimal" class={inputCls} placeholder="例：1280" />
            </div>
            <div>
              <label class={labelCls} for="discount">議價空間（%）</label>
              <input id="discount" type="text" inputmode="decimal" class={inputCls} placeholder="0" />
              <div class="no-print mt-2 flex flex-wrap gap-2" role="group" aria-label="常用議價空間">
                <button type="button" data-disc="0" class="border-border rounded-md border px-3 py-1.5 text-sm">0%</button>
                <button type="button" data-disc="3" class="border-border rounded-md border px-3 py-1.5 text-sm">3%</button>
                <button type="button" data-disc="5" class="border-border rounded-md border px-3 py-1.5 text-sm">5%</button>
                <button type="button" data-disc="8" class="border-border rounded-md border px-3 py-1.5 text-sm">8%</button>
              </div>
            </div>
            <div class="sm:col-span-2">
              <label class={labelCls} for="sale">預估成交價（萬）</label>
              <input id="sale" type="text" inputmode="decimal" class={`${inputCls} text-lg font-semibold`} placeholder="會依開價 × 議價空間自動帶入，也可以直接改" />
              <p class={hintCls}>直接改這格，上面的議價空間會跟著反算。</p>
            </div>
          </div>
        </section>

        {/* 2. 取得資料 */}
        <section class="card-surface p-4 sm:p-5">
          <h2 class="text-lg font-bold">② 當初怎麼買的（算房地合一稅用）</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class={labelCls} for="acqDate">取得日期（所有權登記日）</label>
              <input id="acqDate" type="date" class={inputCls} />
              <p class={hintCls}>看謄本「登記日期」或權狀。2015/12/31 以前取得＝舊制，不算房地合一。</p>
            </div>
            <div>
              <label class={labelCls} for="saleDate">預計出售日期</label>
              <input id="saleDate" type="date" class={inputCls} />
              <p class={hintCls}>預設今天。持有期間差一天就可能差一個稅率級距。</p>
            </div>
            <div>
              <label class={labelCls} for="cost">取得成本：當初買價（萬）</label>
              <input id="cost" type="text" inputmode="decimal" class={inputCls} placeholder="例：980" />
              <p class={hintCls}>含車位。看當時的買賣契約或實價登錄。</p>
            </div>
            <div>
              <label class={labelCls} for="expense">可認列費用（萬）</label>
              <input id="expense" type="text" inputmode="decimal" class={inputCls} placeholder="0" />
              <p class={hintCls}>
                買進時的契稅、印花稅、代書費、仲介費，加上有單據的裝潢、修繕。
                沒單據可用國稅局推計：成交價 3%、上限 30 萬
                <button type="button" id="expense3" class="no-print text-accent ms-1 underline">→ 帶入 3% 推計</button>
              </p>
            </div>
            <div class="sm:col-span-2">
              <label class="flex items-start gap-2 text-sm">
                <input id="selfUse" type="checkbox" class="mt-1" />
                <span>
                  <strong>符合自住優惠</strong>：本人、配偶或未成年子女設籍並實際居住<strong>連續滿 6 年</strong>，期間沒有出租、營業，而且 6 年內沒用過這個優惠
                  <span class={`${hintCls} block`}>符合的話：課稅所得 400 萬以內免稅、超過的部分 10%。</span>
                </span>
              </label>
            </div>
            <div>
              <label class={labelCls} for="lvt">土地增值稅（萬）</label>
              <input id="lvt" type="text" inputmode="decimal" class={inputCls} placeholder="不知道就留白" />
              <p class={hintCls}>
                留白＝先不計，結果會標示。要查：帶謄本上的地號到
                <a class="text-accent underline" href="https://www.tax.taichung.gov.tw/" target="_blank" rel="noopener">台中市政府地方稅務局</a>
                線上試算或臨櫃問。
              </p>
            </div>
            <div>
              <label class="flex items-start gap-2 pt-6 text-sm">
                <input id="lvtSelf" type="checkbox" class="mt-1" />
                <span>
                  這個土增稅是用<strong>自用住宅稅率 10%</strong> 算的
                  <span class={`${hintCls} block`}>勾了會把土地漲價總數額（土增稅 ÷ 10%）從房地合一課稅所得裡扣掉，稅會少一點。不確定就別勾，算出來的稅偏保守。</span>
                </span>
              </label>
            </div>
          </div>
        </section>

        {/* 3. 交易費用 */}
        <section class="card-surface p-4 sm:p-5">
          <h2 class="text-lg font-bold">③ 交易費用與貸款</h2>
          <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div>
              <label class={labelCls} for="fee">仲介服務費（%）</label>
              <input id="fee" type="text" inputmode="decimal" class={inputCls} value="4" />
              <p class={hintCls}>法規上限：買賣雙方合計不超過成交價 6%。賣方常見 4%，可以改。</p>
            </div>
            <div>
              <p class={labelCls}>履約保證費（固定計入）</p>
              <p class="mt-2 py-2.5 text-base">成交價 × 0.03%，自動計算</p>
              <p class={hintCls}>買賣一定走履約保證。服務費常見萬分之 6、買賣各付一半。</p>
            </div>
            <div>
              <label class={labelCls} for="other">其他費用（萬）</label>
              <input id="other" type="text" inputmode="decimal" class={inputCls} placeholder="0" />
              <p class={hintCls}>抵押權塗銷代辦、交屋前的地價稅／房屋稅分攤、搬家等。沒有就 0。</p>
            </div>
            <div>
              <label class={labelCls} for="loan">尚未清償的貸款餘額（萬）</label>
              <input id="loan" type="text" inputmode="decimal" class={inputCls} placeholder="0" />
              <p class={hintCls}>成交款會先還掉這筆，剩下才是實拿。沒貸款就 0。</p>
            </div>
          </div>
        </section>
      </div>

      {/* ===== 右：結果 ===== */}
      <div class="lg:col-span-2">
        <div class="lg:sticky lg:top-4">
          <section id="result" class="card-surface p-4 sm:p-5" aria-live="polite">
            <p class="text-muted-foreground text-sm">屋主實際拿到（扣稅、扣費用、還完貸款）</p>
            <p id="res-cash" class="text-accent mt-1 text-4xl font-extrabold tabular-nums">—</p>
            <p id="res-flag" class="text-muted-foreground mt-2 text-xs leading-relaxed"></p>

            <table class="mt-5 w-full text-sm">
              <tbody>
                <tr class="border-border border-b">
                  <td class="py-2">預估成交價</td>
                  <td id="res-sale" class="py-2 text-right font-semibold tabular-nums">—</td>
                </tr>
                <tr class="border-border/50 border-b">
                  <td class="py-2 ps-3">− 仲介服務費 <span id="res-fee-pct" class="text-muted-foreground"></span></td>
                  <td id="res-fee" class="py-2 text-right tabular-nums">—</td>
                </tr>
                <tr class="border-border/50 border-b">
                  <td class="py-2 ps-3">− 履約保證費</td>
                  <td id="res-escrow" class="py-2 text-right tabular-nums">—</td>
                </tr>
                <tr class="border-border/50 border-b">
                  <td class="py-2 ps-3">− 其他費用</td>
                  <td id="res-other" class="py-2 text-right tabular-nums">—</td>
                </tr>
                <tr class="border-border/50 border-b">
                  <td class="py-2 ps-3">− 土地增值稅</td>
                  <td id="res-lvt" class="py-2 text-right tabular-nums">—</td>
                </tr>
                <tr class="border-border/50 border-b">
                  <td class="py-2 ps-3">− 房地合一稅 <span id="res-hl-rate" class="text-muted-foreground"></span></td>
                  <td id="res-hl" class="py-2 text-right tabular-nums">—</td>
                </tr>
                <tr class="border-border border-b-2">
                  <td class="py-2 font-semibold">＝ 稅後淨額（還沒扣貸款）</td>
                  <td id="res-net" class="py-2 text-right font-semibold tabular-nums">—</td>
                </tr>
                <tr class="border-border/50 border-b">
                  <td class="py-2 ps-3">− 清償貸款餘額</td>
                  <td id="res-loan" class="py-2 text-right tabular-nums">—</td>
                </tr>
                <tr>
                  <td class="py-2 text-base font-bold">＝ 實拿現金</td>
                  <td id="res-cash2" class="text-accent py-2 text-right text-base font-bold tabular-nums">—</td>
                </tr>
              </tbody>
            </table>

            <details id="hl-details" class="border-border mt-4 rounded-md border p-3 text-sm">
              <summary class="cursor-pointer font-medium">房地合一稅是怎麼算出來的</summary>
              <div id="hl-detail" class="text-muted-foreground mt-2 space-y-1 leading-relaxed"></div>
            </details>

            <div class="no-print mt-4 flex flex-wrap gap-2">
              <button type="button" id="print" class="btn-outline flex-1">🖨️ 列印 / 存 PDF</button>
              <button type="button" id="reset" class="border-border rounded-btn min-h-11 border px-4 text-sm">清空</button>
            </div>
          </section>

          {/* 反推：想拿多少 → 要賣多少 */}
          <section class="card-surface mt-4 p-4 sm:p-5">
            <h2 class="text-base font-bold">反過來算：屋主想實拿多少？</h2>
            <div class="mt-3 flex items-end gap-3">
              <div class="flex-1">
                <label class={labelCls} for="target">想實拿（萬）</label>
                <input id="target" type="text" inputmode="decimal" class={inputCls} placeholder="例：1000" />
              </div>
              <div class="flex-1 text-right">
                <p class="text-muted-foreground text-xs">至少要成交</p>
                <p id="target-out" class="text-xl font-bold tabular-nums">—</p>
              </div>
            </div>
            <p class={hintCls}>用上面同一組成本、費用、貸款條件反算，成交價一動稅率級距不變。</p>
          </section>
        </div>
      </div>
    </form>

    {/* 手機底部固定條：捲到下面填資料時還看得到結果 */}
    <div id="sticky" class="no-print bg-card border-border fixed inset-x-0 bottom-0 z-40 border-t px-4 py-2.5 shadow-lg lg:hidden" hidden>
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-3">
        <span class="text-muted-foreground text-sm">屋主實拿約</span>
        <span id="sticky-cash" class="text-accent text-2xl font-extrabold tabular-nums">—</span>
        <a href="#result" class="text-accent text-sm underline">看明細</a>
      </div>
    </div>

    <hr class="no-print my-8 border-dashed" />

    <section class="no-print">
      <h2 class="text-xl font-semibold">怎麼算的、哪些地方要注意</h2>
      <ul class="mt-3 space-y-2 ps-5 text-sm leading-relaxed" style="list-style:disc;">
        <li>
          <strong>房地合一稅（2.0）</strong>：課稅所得 ＝ 成交價 − 取得成本 − 可認列費用 − 土地漲價總數額。
          稅率看持有期間：<strong>2 年以內 45%、超過 2～5 年 35%、超過 5～10 年 20%、超過 10 年 15%</strong>。
          自住優惠（設籍居住連續滿 6 年、無出租營業、6 年一次）：400 萬以內免稅、超過的部分 10%。
          費用沒單據，國稅局按成交價 3% 推計、上限 30 萬。
        </li>
        <li>
          <strong>2015/12/31 以前取得＝舊制</strong>：土地只課土增稅，房屋部分的財產交易所得併入隔年綜所稅，這頁不算那一段。
        </li>
        <li>
          <strong>土地增值稅</strong>：自用住宅用地 10%（一生一次／一生一屋有條件）、一般 20／30／40% 累進，要看地號的前次移轉現值與公告現值，屋主通常不知道，所以留白就先不計。
        </li>
        <li>
          <strong>繼承、受贈取得</strong>的取得成本不是當初的買價，而是繼承或受贈時的房屋評定現值＋公告土地現值（按物價指數調整），這頁的「當初買價」欄位不適用，請另外問。
        </li>
        <li>
          預售屋換約、合建分屋、非自願因素交易（調職、非自願離職、重大疾病等有 20% 的特別規定）都不在這頁範圍。
        </li>
        <li>
          結果是<strong>試算</strong>，實際稅額以國稅局、地方稅務局核定為準。要正式申報建議找地政士或會計師。
        </li>
      </ul>

      <p class="text-muted-foreground mt-4 text-xs leading-relaxed">
        📌 資料來源：財政部 所得稅法第 14 條之 4、第 14 條之 5（房地合一 2.0，2021-07-01 施行）／財政部 110-06-11 台財稅字第 11004575360 號令（費用推計 3%、上限 30 萬）／土地稅法第 33、34 條／內政部 不動產經紀業報酬計收標準。
        線上試算：<a class="underline" href="https://www.etax.nat.gov.tw/" target="_blank" rel="noopener">財政部電子申報繳稅服務網（房地合一稅額試算）</a>、
        <a class="underline" href="https://www.tax.taichung.gov.tw/" target="_blank" rel="noopener">台中市政府地方稅務局（土地增值稅試算）</a>。
      </p>

      <h2 class="mt-8 text-xl font-semibold">常見問題</h2>
      <div class="mt-3 space-y-3">
        {faqs.map(f => (
          <details class="border-border rounded-md border p-3">
            <summary class="cursor-pointer font-medium">{f.q}</summary>
            <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>

      <p class="mt-6 text-sm">
        算完想知道這個開價在市場上站不站得住？我可以幫你做一次免費的行情評估，
        <a class="text-accent underline" href="/go/line?src=tools-seller-net">LINE sky811117</a> 或到
        <a class="text-accent underline" href="/sell/">賣房服務</a> 看流程。
      </p>
