---
/**
 * 台中嫌惡設施查詢地圖 — /tools/undesirable-facilities/（工具代號 undesirable-facilities）
 *
 * 為什麼做這頁：GSC 實測「嫌惡設施查詢」113 曝、「嫌惡設施地圖」31 曝、
 * 「不動產嫌惡設施查詢」7 曝、「300公尺內嫌惡設施查詢」6 曝，合計 157 次搜尋。
 * Google 第一頁全是**地圖工具站** —— 搜這個字的人要的是可以點的東西，不是一篇教學文。
 *
 * 資料：public/data/undesirable-facilities.json（建置腳本 scripts/fetch-undesirable-facilities.mjs）
 *   items[]：{k 類別代號, n 名稱, y 緯度, x 經度, s? 來源代號}
 *   categories：{代號: {label, why}}（同一個 label 可以有好幾個代號，例：掩埋場＋轉運站 → 同一類）
 *   sources?：[{id, name, org, url, version, license, count}]、builtAt?（新版才有；舊版只有 source／fetchedAt）
 *   ⛔ 頁面上的筆數、類別數、來源清單一律從 JSON 算，不寫死在文案裡（資料更新時頁面跟著重建）。
 *   ⚠️ 不讓訪客直接打 Overpass／任何外部 API：公開節點有速率限制，也會把位置送出去。
 *
 * ⛔ 隱私：使用者輸入的地址、定位座標只在瀏覽器比對（/js/tc-addr.js 本機門牌庫），不放 URL、不送 GA、不送任何 API。
 *    GA4 事件只記 result（ok／empty／fail）、radius、cats（範圍內幾類）。舊版的 OSM Nominatim 地址搜尋已移除。
 *    地圖底圖（國土測繪中心 EMAP）會下載正在看的那幾張圖磚，頁尾「資料來源」有寫。
 * ⛔ 「嫌惡」是主觀的：頁面只講「附近有什麼、多遠」，不下「會不會影響房價」這種判斷。
 * ⛔ 未完工／規劃中的設施不收、不寫（CLAUDE.md 紅線）；資料本身只有現存的點位。
 * ⚠️ 不要在模板裡寫 TS 泛型（Record<...>），Astro 模板解析器會把 < 當標籤。
 *
 * 畫面（2026-09-30 電影感改版，主題「雷達掃描」——跟學區頁的「學區拼圖」、垃圾車頁的「傍晚光軌」刻意不同）：
 *   - 主視覺 <CinematicHero variant="tool" scene="radar">（琥珀雷達：三圈同心圓＋旋轉光束，場景程式在 cinematic/ 由場景負責人維護），
 *     搜尋卡放在主視覺裡（375×812 第一屏看得到輸入框和查詢鈕）；查詢成功發 document 事件 "cine:radar-ping"（detail 只有 {radius}）
 *   - 地圖：MapLibre GL（/js/cine-map.js 共用）＋國土測繪中心 EMAP。全市總覽是熱度圖，放大轉成依類別上色的點；
 *     查詢時三圈 300／500／1000 公尺＋一道雷達光束繞一圈，範圍內的設施在光束掃過它的方位時才亮起（小六角光柱升起）
 *   - 結果：一句摘要＋距離尺（0 到範圍公尺，每處一個點）＋依距離排序的精簡清單；類別膠囊篩選（地圖、尺、清單同步）
 *   - 前端程式在 src/components/uf/（uf-page.js 主程式、uf-sweep.js 雷達光束、uf-ruler.js 距離尺），Astro 打包壓縮、只有這頁下載
 *   - WebGL 不能用時摘要、距離尺、清單照常可用；prefers-reduced-motion 時不掃描、不飛，全部直接顯示
 */
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CinematicHero from "@/components/cinematic/CinematicHero.astro";
import config from "@/config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { safeJsonLd } from "@/utils/safeJsonLd";
import facilitiesRaw from "../../../public/data/undesirable-facilities.json";

const canonicalURL = new URL("/tools/undesirable-facilities/", Astro.site).href; // 全站 canonical 帶結尾斜線

// ---------- 資料（新舊兩版格式都吃） ----------
type Src = {
  id: string;
  name: string;
  org?: string;
  url?: string;
  version?: string;
  license?: string;
  licenseUrl?: string;
  geo?: string; // 點位怎麼來的（例：「以臺中市門牌定位」），新版才有
  geoRef?: { text: string; url: string }; // geo 裡提到的另一份資料（例：中油站點座標）的出處連結
  versionKind?: string; // content 清冊日期／meta 資料集更新日／fetched 下載日期／osm 資料時間
  short?: string; // 彈窗用的短名（清冊原名太長或容易誤解時）
  note?: string; // 清冊原名的補充說明（例：攤販集中區清冊的「籌設」）
  count?: number;
};
type Cat = { label?: string; why?: string };
type Item = { k: string; n?: string; y: number; x: number; s?: string };
type FData = {
  source?: string;
  fetchedAt?: string;
  builtAt?: string;
  categories?: { [k: string]: Cat };
  sources?: Src[];
  items?: Item[];
};
const F = facilitiesRaw as unknown as FData;
const items: Item[] = Array.isArray(F.items) ? F.items.filter(it => typeof it.y === "number" && typeof it.x === "number") : [];
const catDefs = F.categories ?? {};

function isOsm(s: Src): boolean {
  return s.id === "osm" || /openstreetmap/i.test(`${s.name} ${s.org ?? ""} ${s.url ?? ""}`);
}
const OSM_DEFAULT: Src = {
  id: "osm",
  name: "OpenStreetMap",
  org: "OpenStreetMap 貢獻者",
  url: "https://www.openstreetmap.org/copyright",
  version: (F.fetchedAt ?? "").slice(0, 10),
  license: "開放資料庫授權條款（ODbL）",
};
const sources: Src[] = Array.isArray(F.sources) && F.sources.length ? F.sources.filter(s => s && s.id) : [OSM_DEFAULT];
const defSrc = (sources.find(isOsm) ?? sources[0]).id;
const srcById: { [id: string]: Src } = {};
sources.forEach(s => { srcById[s.id] = s; });

// 類別配色（地圖點、光柱、距離尺、清單圓點、膠囊共用；[淺色, 深色]）。
// 大地色系：赤陶、琥珀、赭黃、苔綠、灰青、暖灰、灰玫瑰……降飽和、往暖色偏（⛔ 不用霓虹、螢光綠、紫藍），米色與夜晚琥珀底上都不刺眼
const PAL: { [k: string]: [string, string] } = {
  fuel: ["#c9822e", "#eeb064"],
  gas: ["#c9822e", "#eeb064"],
  temple: ["#b04a36", "#e88f78"],
  cemetery: ["#667a45", "#a9c088"],
  funeral: ["#7d5a4f", "#c29d8f"],
  crematorium: ["#7d5a4f", "#c29d8f"],
  columbarium: ["#7d5a4f", "#c29d8f"],
  substation: ["#3f7a80", "#8cbfc0"],
  tower: ["#7a6e62", "#bcae9d"],
  mast: ["#5b7486", "#a3b8c4"],
  hospital: ["#b5606c", "#e3a3aa"],
  market: ["#a8862a", "#dcc070"],
  prison: ["#57524b", "#aea597"],
  landfill: ["#8b5e3c", "#cfa280"],
  waste: ["#8b5e3c", "#cfa280"],
  incinerator: ["#8b5e3c", "#cfa280"],
};
const FALLBACK: [string, string][] = [
  ["#9a5a2e", "#dca07a"],
  ["#4f7a6a", "#9cc4b3"],
  ["#8c7a3c", "#cdbd82"],
  ["#8a5e66", "#cfa1a8"],
  ["#6b6b4a", "#b5b58c"],
  ["#5f6a66", "#a9b5b0"],
];

// 類別（依 label 分組）：代號、筆數、來源
type Group = { label: string; keys: string[]; why: string; n: number; srcN: { [id: string]: number }; cl: string; cd: string };
const groups: Group[] = [];
const byLabel: { [label: string]: Group } = {};
function groupFor(k: string): Group {
  const c = catDefs[k] ?? {};
  const label = (c.label ?? "").trim() || k;
  let g = byLabel[label];
  if (!g) {
    g = { label, keys: [], why: "", n: 0, srcN: {}, cl: "", cd: "" };
    byLabel[label] = g;
    groups.push(g);
  }
  if (!g.keys.includes(k)) g.keys.push(k);
  if (!g.why && c.why) g.why = c.why;
  return g;
}
Object.keys(catDefs).forEach(k => groupFor(k));
const srcN: { [id: string]: number } = {};
const srcLabels: { [id: string]: string[] } = {};
for (const it of items) {
  const g = groupFor(it.k);
  const sid = it.s && srcById[it.s] ? it.s : defSrc;
  g.n++;
  g.srcN[sid] = (g.srcN[sid] ?? 0) + 1;
  srcN[sid] = (srcN[sid] ?? 0) + 1;
}
// 只留有資料的類別；依筆數排序（表格、膠囊預設順序）
const liveGroups = groups.filter(g => g.n > 0).sort((a, b) => b.n - a.n);
const usedCol = new Set<string>();
let fb = 0;
for (const g of liveGroups) {
  let col = g.keys.map(k => PAL[k]).find(c => c && !usedCol.has(c[0]));
  while (!col) {
    const c = FALLBACK[fb % FALLBACK.length];
    fb++;
    if (!usedCol.has(c[0]) || fb > FALLBACK.length * 2) col = c;
  }
  usedCol.add(col[0]);
  g.cl = col[0];
  g.cd = col[1];
  for (const sid of Object.keys(g.srcN)) (srcLabels[sid] = srcLabels[sid] ?? []).push(g.label);
}

const total = items.length;
const nCats = liveGroups.length;
const dataDate = (F.builtAt ?? F.fetchedAt ?? "").slice(0, 10);

// 來源（實際有筆數的才列）
const srcRows = sources
  .map(s => ({ ...s, osm: isOsm(s), n: srcN[s.id] ?? 0, labels: srcLabels[s.id] ?? [] }))
  .filter(r => r.n > 0);
const officialRows = srcRows.filter(r => !r.osm);
const osmRows = srcRows.filter(r => r.osm);
const hasOsm = osmRows.length > 0;
const allGov = officialRows.length > 0 && officialRows.every(r => /gov\.tw/i.test(r.url ?? "") || /政府|市府|公所|內政部|環境部|衛生福利部|法務部|經濟部|交通部|局|署/.test(r.org ?? ""));
const officialWord = allGov ? "政府開放資料" : "官方公開資料";
const srcPhrase = [officialRows.length ? officialWord : "", hasOsm ? "OpenStreetMap" : ""].filter(Boolean).join("與 ");
// 類別的來源：同一個機關的清冊合併寫（例：臺中市政府經濟發展局（3 份清冊）），依筆數排序
function catSrcText(g: Group): string {
  const byOrg: { [o: string]: { n: number; ids: string[] } } = {};
  for (const sid of Object.keys(g.srcN)) {
    const src = srcById[sid];
    const key = src ? (isOsm(src) ? "OpenStreetMap" : src.org || src.name) : sid;
    const o = (byOrg[key] = byOrg[key] ?? { n: 0, ids: [] });
    o.n += g.srcN[sid];
    o.ids.push(sid);
  }
  return Object.keys(byOrg)
    .sort((a, b) => byOrg[b].n - byOrg[a].n)
    .map(k => {
      const o = byOrg[k];
      if (o.ids.length > 1) return `${k}（${o.ids.length} 份清冊）`;
      const src = srcById[o.ids[0]];
      return src && !isOsm(src) && src.org ? `${src.org}〈${src.name}〉` : k;
    })
    .join("、");
}
const isOffSid = (sid: string) => !!srcById[sid] && !isOsm(srcById[sid]);
// 限制說明用：哪幾類有官方資料、哪幾類有（或全部是）OpenStreetMap
const offLabels = liveGroups.filter(g => Object.keys(g.srcN).some(isOffSid)).map(g => g.label);
const osmOnlyLabels = liveGroups.filter(g => !Object.keys(g.srcN).some(isOffSid)).map(g => g.label);
const osmMixLabels = liveGroups.filter(g => Object.keys(g.srcN).some(isOffSid) && Object.keys(g.srcN).some(sid => !isOffSid(sid))).map(g => g.label);
const offOrgs = [...new Set(officialRows.map(r => r.org || r.name))];
const offN = officialRows.reduce((a, r) => a + r.n, 0);
const osmN = osmRows.reduce((a, r) => a + r.n, 0);
const geoByAddr = officialRows.some(r => /門牌/.test(r.geo ?? ""));
const geoByRoad = officialRows.filter(r => /路段/.test(r.geo ?? "")).map(r => r.short ?? r.name); // 限制說明用短名（清冊原名與說明寫在資料來源段）
const geoText = [
  geoByAddr ? "有些清冊只有地址，點位是用臺中市門牌資料定位的，落在門牌的位置，不一定是設施的出入口。" : "",
  geoByRoad.length ? `〈${geoByRoad.join("〉〈")}〉只寫路段，點位定在路口附近，實際範圍比一個點大。` : "",
].join("");
const osmText = [
  osmOnlyLabels.length ? `${osmOnlyLabels.join("、")}全部來自 OpenStreetMap` : "",
  osmMixLabels.length ? `${osmMixLabels.join("、")}除了官方清冊，也收了 OpenStreetMap 上的點` : "",
]
  .filter(Boolean)
  .join("；");
// 版本欄位的意思不一樣，照實寫（夜市清冊是 2018 年的內容，平台 2026 年只是改了欄位，不能寫成「版本 2026」）
const VER_LABEL: { [k: string]: string } = { content: "清冊日期", meta: "資料集更新日", fetched: "下載日期", osm: "資料時間" };
const verText = (r: Src) => (r.version ? `，${VER_LABEL[r.versionKind ?? ""] ?? "版本"} ${r.version}` : "");
const licUrl = (lic?: string, url?: string) =>
  url || (lic && /政府資料開放授權/.test(lic) ? "https://data.gov.tw/license" : lic && /ODbL/i.test(lic) ? "https://opendatacommons.org/licenses/odbl/" : "");

// 表格：類別、筆數、來源、買方常見的考量
const catRows = liveGroups.map(g => ({
  label: g.label,
  n: g.n,
  why: g.why,
  cl: g.cl,
  cd: g.cd,
  src: catSrcText(g),
}));

// ---------- 版本字樣（/data/* /js/* 有 1 天快取：檔案一改網址就換） ----------
function fileVer(rel: string): string {
  try {
    return crypto.createHash("md5").update(fs.readFileSync(path.join(process.cwd(), rel))).digest("hex").slice(0, 10);
  } catch {
    return dataDate || "1";
  }
}
const vAddr = fileVer("public/js/tc-addr.js");
const vIdx = fileVer("public/data/tc-addr/index.json");
const vMap = fileVer("public/js/cine-map.js");
const vData = fileVer("public/data/undesirable-facilities.json");

// 門牌庫的出處（跟 tc-addr.js 同一份建置）
let addrSrc = { ver: "115年1月", src: "臺中市政府資料開放平臺「臺中市空間資訊建物及門牌號碼位置新版本資料」（臺中市政府數位發展局）", srcUrl: "https://opendata.taichung.gov.tw/search/50168dd2-4239-4f3e-89cf-f706617f0436", lic: "政府資料開放授權條款-第1版" };
try {
  const ix = JSON.parse(fs.readFileSync(path.join(process.cwd(), "public/data/tc-addr/index.json"), "utf8"));
  addrSrc = { ver: ix.ver ?? addrSrc.ver, src: ix.src ?? addrSrc.src, srcUrl: ix.srcUrl ?? addrSrc.srcUrl, lic: ix.lic ?? addrSrc.lic };
} catch {
  /* 用預設文字 */
}

// 主視覺的數字：只用本頁「這份資料涵蓋什麼」已經列出來的數字
const heroStats = [
  { value: total, label: "筆設施位置" },
  { value: nCats, label: "類設施" },
];

// 原本 <Main> 做的事：記下返回網址（文章頁「返回」鈕用）
const locale = Astro.currentLocale ?? config.site.lang;
const backUrl = config.features.showBackButton ? Astro.url.pathname : getRelativeLocaleUrl(locale, "");

// 前端用的小資料直接內嵌（設施本體 JSON 另外下載，地圖快進畫面或第一次查詢時才抓）
const boot = {
  dataUrl: `/data/undesirable-facilities.json?v=${vData}`,
  vIdx,
  defSrc,
  groups: liveGroups.map(g => ({ label: g.label, cl: g.cl, cd: g.cd })),
  k2g: Object.fromEntries(liveGroups.flatMap((g, i) => g.keys.map(k => [k, i]))),
  src: Object.fromEntries(sources.map(s => [s.id, { name: s.name, ...(s.short ? { short: s.short } : {}), org: s.org ?? "", osm: isOsm(s) }])),
  fallback: FALLBACK,
};

const pageDesc = `輸入台中地址、用手機定位或在地圖上點一下，查周邊 300／500／1000 公尺內的加油站、宮廟、公墓、殯葬設施、變電所、高壓電塔、基地台與市場，列出直線距離與資料來源。${srcPhrase ? `資料來自${/^[A-Za-z]/.test(srcPhrase) ? " " : ""}${srcPhrase}，` : ""}看屋前先查一次。`;

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "台中嫌惡設施查詢地圖",
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Web",
  url: canonicalURL,
  description: pageDesc,
  offers: { "@type": "Offer", price: "0", priceCurrency: "TWD" },
  provider: { "@id": `${config.site.url}#realestateagent` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首頁", item: config.site.url },
    { "@type": "ListItem", position: 2, name: "客戶工具", item: `${config.site.url}tools/` },
    { "@type": "ListItem", position: 3, name: "嫌惡設施查詢", item: canonicalURL },
  ],
};
---

<Layout
  title={`嫌惡設施查詢地圖｜輸入台中地址，查周邊 300 公尺內有什麼 | ${config.site.title}`}
  description={pageDesc}
  canonicalURL={canonicalURL}
  ogImage="/og/page-tools.jpg"
  showFloatingCTA={false}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={safeJsonLd(appSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(breadcrumbSchema)} />
  </Fragment>
  <Header />

  <main id="main-content" data-backUrl={backUrl} class="uf-main pb-4">
    <CinematicHero
      variant="tool"
      scene="radar"
      layout="split"
      eyebrow="免費工具・不用登入"
      title="台中嫌惡設施查詢地圖"
      subtitle="輸入地址、用手機定位或點地圖，看周邊有哪些加油站、宮廟、墓地、變電所、高壓電塔。"
      stats={heroStats}
      container="uf-wrap"
    >
      <section class="uf-search cine-glass" aria-label="查詢周邊設施">
        <form id="uf-form" autocomplete="off" role="search">
          <label for="uf-addr" class="uf-label">輸入台中的地址</label>
          <div class="uf-row">
            <input
              id="uf-addr"
              type="text"
              inputmode="text"
              enterkeyhint="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="例：北屯區崇德路二段46號"
              class="uf-input cine-input"
            />
            <button type="submit" class="cine-cta cine-btn">查詢</button>
          </div>
          <div class="uf-row uf-row2">
            <button type="button" id="uf-here" class="uf-btn uf-btn-outline uf-btn-here cine-btn"><span class="cine-locate-dot" aria-hidden="true"></span>用我的位置</button>
            <div class="uf-seg" role="radiogroup" aria-label="查詢範圍">
              <label><input type="radio" name="uf-r" value="300" checked /><span>300 公尺</span></label>
              <label><input type="radio" name="uf-r" value="500" /><span>500 公尺</span></label>
              <label><input type="radio" name="uf-r" value="1000" /><span>1 公里</span></label>
            </div>
          </div>
        </form>
        <p id="uf-status" class="uf-status" role="status" aria-live="polite">
          也可以直接點地圖上的位置。你打的地址只在你的裝置上比對，不會送出。
        </p>
        <div id="uf-cands" class="uf-cands" hidden></div>
      </section>
    </CinematicHero>

    <div class="uf-wrap uf-body">
      <noscript>
        <p class="uf-card">這個工具需要開啟 JavaScript 才能查詢。下面的類別說明與資料來源不受影響。</p>
      </noscript>

      <div class="uf-app" id="uf-app">
        <div class="uf-a-summary">
          <section id="uf-intro" class="uf-card uf-card-soft" aria-label="怎麼用">
            <p class="uf-kicker">怎麼用</p>
            <p class="uf-intro-t">查詢後會掃描周邊 300／500 公尺或 1 公里，列出範圍內有幾處、最近的是什麼、直線多遠。</p>
            <p class="uf-small uf-mt-s">結果會排在一條距離尺上：越右邊越遠，顏色代表類別。</p>
          </section>
          {/* 第一次查詢還沒有結果時的骨架閃光（純裝飾，沒有文字） */}
          <div id="uf-skel" class="uf-skel" aria-hidden="true" hidden>
            <div class="uf-card">
              <span class="cine-skeleton cine-skeleton--pill"></span>
              <span class="cine-skeleton cine-skeleton--title"></span>
              <span class="cine-skeleton cine-skeleton--line"></span>
              <span class="cine-skeleton cine-skeleton--line" style="width:82%"></span>
              <span class="cine-skeleton cine-skeleton--line" style="width:58%"></span>
            </div>
          </div>
          <section id="uf-summary" aria-live="polite" hidden></section>
        </div>

        <div class="uf-a-map" id="uf-mapcol">
          <a class="uf-skip" href="#uf-list-h" id="uf-skip">跳過地圖，看設施清單</a>
          <div class="uf-mapwrap cine-mapframe">
            <div id="uf-map" role="application" aria-label="周邊設施地圖"></div>
            <div class="uf-mapempty" id="uf-mapempty">輸入地址，或直接點地圖上的位置</div>
          </div>
          <div class="uf-legend" id="uf-legend">
            <span class="uf-heatbar" aria-hidden="true"><i>少</i><i>多</i></span>
            <p id="uf-legend-t">顏色越深代表設施越密集。放大地圖會變成一個個依類別上色的點，點了看名稱。</p>
          </div>
        </div>

        <section class="uf-a-filters uf-card" id="uf-filters" aria-labelledby="uf-f-h">
          <div class="uf-fhead">
            <h2 class="uf-h3" id="uf-f-h">地圖上顯示的類別</h2>
            <button type="button" id="uf-fall" class="uf-linkbtn uf-fall">全部取消</button>
          </div>
          <div id="uf-chips" class="uf-chips" role="group" aria-labelledby="uf-f-h">
            {
              liveGroups.map((g, i) => (
                <button type="button" class="uf-chip" data-g={i} aria-pressed="true" style={`--cl:${g.cl};--cd:${g.cd}`}>
                  <i class="uf-dot" aria-hidden="true"></i>
                  <span>{g.label}</span>
                </button>
              ))
            }
          </div>
          <p id="uf-fzero" class="uf-small uf-mt-s" hidden></p>
        </section>

        <section class="uf-a-ruler uf-card" id="uf-rulerwrap" aria-labelledby="uf-ruler-h" hidden>
          <h2 class="uf-h3" id="uf-ruler-h">距離尺</h2>
          <p id="uf-rinfo" class="uf-small uf-mt-s"></p>
          <div id="uf-ruler"></div>
        </section>

        <section class="uf-a-list" id="uf-listwrap" hidden>
          <div class="uf-listhead">
            <h2 class="uf-h2" id="uf-list-h" tabindex="-1">範圍內的設施</h2>
            <p id="uf-listinfo" class="uf-small"></p>
          </div>
          <ol id="uf-list" class="uf-list"></ol>
          <button type="button" id="uf-more" class="uf-btn uf-btn-outline uf-btn-block cine-btn" hidden>顯示全部</button>
        </section>
      </div>

      <div class="uf-prose">
        <section class="cine-reveal" aria-labelledby="uf-data-h">
          <h2 id="uf-data-h" class="uf-h2">這份資料涵蓋什麼</h2>
          <p class="uf-small mt-2">
            台中市共 {total.toLocaleString("zh-TW")} 筆、{nCats} 類{dataDate ? `，資料整理日期 ${dataDate}` : ""}。每一類的來源寫在類別名稱下面。
          </p>
          <div class="uf-tablewrap">
            <table class="uf-table">
              <thead>
                <tr>
                  <th scope="col">類別</th>
                  <th scope="col" class="uf-num">筆數</th>
                  <th scope="col">買方常見的考量</th>
                </tr>
              </thead>
              <tbody>
                {
                  catRows.map(row => (
                    <tr>
                      <th scope="row" style={`--cl:${row.cl};--cd:${row.cd}`}>
                        <span class="uf-tcat"><i class="uf-dot" aria-hidden="true"></i>{row.label}</span>
                        <small>來源：{row.src}</small>
                      </th>
                      <td class="uf-num">{row.n.toLocaleString("zh-TW")}</td>
                      <td class="uf-why">{row.why || "—"}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section class="uf-card uf-card-soft mt-8 cine-reveal" aria-labelledby="uf-lim-h">
          <h2 id="uf-lim-h" class="uf-h3">這個工具的限制，先講清楚</h2>
          <ul class="uf-ul">
            {
              offLabels.length > 0 && (
                <li>
                  <strong>官方資料</strong>：{offLabels.join("、")}的點位有 {offN.toLocaleString("zh-TW")} 筆來自{offOrgs.join("、")}公布的清冊（每一類用了哪份清冊，寫在上面表格的類別名稱下面）。以機關公布的版本為準，之後新設、遷移、裁撤的設施要等資料更新才會反映。
                </li>
              )
            }
            {geoText && <li>{geoText}</li>}
            {
              hasOsm && (
                <li>
                  <strong>OpenStreetMap</strong>：{osmText}，共 {osmN.toLocaleString("zh-TW")} 筆。這是志工社群標註的地圖，<strong>不保證完整</strong>，也可能留著已經拆除、搬走的點。
                </li>
              )
            }
            <li><strong>沒查到不等於沒有。</strong>小型宮廟、私人神壇、剛蓋好的設施，資料常常還沒有。</li>
            <li>
              距離是<strong>直線距離</strong>，從你查的位置算到設施的點位。公墓、變電所這類占地大的設施，資料只有一個代表點，實際邊界可能更近。
            </li>
            <li>
              <strong>凶宅、輻射屋、海砂屋不在這份資料裡</strong>，查法寫在<a class="text-accent underline" href="/posts/faq-03-haunted-house-check/">凶宅怎麼查</a>與<a class="text-accent underline" href="/posts/viewing-04-sea-sand-radiation/">海砂屋年代怎麼判別</a>。
            </li>
            <li>
              <strong>「嫌惡」是主觀的。</strong>有人不能接受宮廟，有人覺得熱鬧有人氣；有人在意變電所，有人只在意通勤。這個工具只告訴你附近有什麼、多遠，值不值得在意由你自己判斷。
            </li>
            <li>真正要下決定前，請到現場走一趟，並以<strong>不動產說明書</strong>（仲介或建商提供）的記載為準。</li>
          </ul>
        </section>

        <section class="mt-10 cine-reveal">
          <h2 class="uf-h2">看屋當天，再用眼睛確認一次</h2>
          <p class="mt-2">
            每一種設施買方常在意什麼，寫在這篇：<a class="text-accent underline" href="/posts/week-04-undesirable-facilities/">嫌惡設施怎麼查、到現場怎麼再確認一次</a>
          </p>
          <p class="mt-2">
            同一個地址也可以順便查：<a class="text-accent underline" href="/tools/school-district/">台中學區查詢</a>、<a class="text-accent underline" href="/tools/garbage-truck/">台中垃圾車時間查詢</a>。
          </p>
        </section>

        <section class="mt-10 cine-reveal" aria-labelledby="uf-src-h">
          <h2 id="uf-src-h" class="uf-h2">資料來源與版本</h2>
          <ul class="uf-ul uf-src">
            {
              srcRows.map(r => (
                <li>
                  {r.osm ? "設施點位（社群標註）：" : `設施點位：${r.org ?? ""}`}{r.url ? <a class="text-accent underline" href={r.url} rel="noopener" target="_blank">〈{r.name}〉</a> : `〈${r.name}〉`}{r.note ? `（${r.note}）` : ""}{`${verText(r)}，本頁用到 ${r.n.toLocaleString("zh-TW")} 筆（${r.labels.join("、")}）。`}{r.geo ? `位置：${r.geo}` : ""}{r.geo && r.geoRef ? (<>（中油站點出處：<a class="text-accent underline" href={r.geoRef.url} rel="noopener" target="_blank">{r.geoRef.text}</a>）</>) : ""}{r.geo ? "。" : ""}{r.osm ? (
                    <>
                      地圖資料 ©<a class="text-accent underline" href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap 貢獻者</a>，採<a class="text-accent underline" href="https://opendatacommons.org/licenses/odbl/" rel="noopener" target="_blank">ODbL</a>授權。
                    </>
                  ) : r.license && licUrl(r.license, r.licenseUrl) ? (
                    <>依<a class="text-accent underline" href={licUrl(r.license, r.licenseUrl)} rel="noopener" target="_blank">{r.license}</a>使用。</>
                  ) : r.license ? (
                    `依${r.license}使用。`
                  ) : (
                    ""
                  )}
                </li>
              ))
            }
            <li>
              地址比對：{addrSrc.src}（<a class="text-accent underline" href={addrSrc.srcUrl} rel="noopener" target="_blank">{addrSrc.ver} 版</a>，依{addrSrc.lic}使用）。你輸入的地址和手機定位的座標只在瀏覽器裡比對，不會傳到任何伺服器；頁面會下載你查的那一區的公開門牌資料檔。
            </li>
            <li>
              地圖底圖 © <a class="text-accent underline" href="https://maps.nlsc.gov.tw/" rel="noopener" target="_blank">內政部國土測繪中心</a>「臺灣通用電子地圖」線上圖磚，會下載你正在看的那一塊。
            </li>
            <li>地圖元件：<a class="text-accent underline" href="https://maplibre.org/" rel="noopener" target="_blank">MapLibre GL JS</a> 4.7.1（BSD-3-Clause 授權）</li>
          </ul>
        </section>

        <hr class="my-8 border-dashed" />

        <p class="text-muted-foreground text-sm">
          <strong>陳景泰 — 一品不動產（有巢氏房屋台中世界之心加盟店）</strong><br />
          經紀人黃永隆 113 彰縣字第 324 號 / 營業員陳景泰 114 登字第 488296 號<br />
          0920-118-756 / LINE <a class="text-accent underline" href="/go/line?src=undesirable-facilities">sky811117</a>
        </p>
      </div>
    </div>
  </main>

  <Footer />

  <script type="application/json" id="uf-boot" is:inline set:html={safeJsonLd(boot)} />

  {/* 地圖：MapLibre GL 本體（含 SRI）由 cine-map.js 在地圖快進畫面時才下載 */}
  <script is:inline src={`/js/cine-map.js?v=${vMap}`}></script>
  <script is:inline src={`/js/tc-addr.js?v=${vAddr}`}></script>
  {/* 頁面程式：Astro 打包壓縮，只有這一頁下載（雷達光束 uf-sweep.js、距離尺 uf-ruler.js 拆成小檔，第一次查詢才下載） */}
  <script>
    import "@/components/uf/uf-page.js";
