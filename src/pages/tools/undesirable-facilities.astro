</Layout>

<style is:global>
  /* ===== 版面：主視覺與內容共用同一條格線（手機 48rem、電腦 80rem；跟垃圾車頁同一套） ===== */
  .uf-wrap {
    width: 100%;
    max-width: 48rem;
    margin-inline: auto;
    padding-inline: 1rem;
  }
  @media (min-width: 640px) {
    .uf-wrap { padding-inline: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .uf-wrap { max-width: 80rem; }
  }
  /* 內容區後面的暖色環境光（純背景，不吃事件；左右不超出盒子，不會產生橫向捲軸） */
  .uf-body {
    position: relative;
    isolation: isolate;
  }
  .uf-body::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 0;
    right: 0;
    top: -10rem;
    height: min(1800px, calc(100% + 10rem));
    pointer-events: none;
    background:
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.14), transparent) 12% 22% / 60% 36% no-repeat,
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.1), transparent) 88% 34% / 50% 32% no-repeat,
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.07), transparent) 32% 70% / 64% 34% no-repeat;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 10rem, #000 85%, transparent), linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(180deg, transparent, #000 10rem, #000 85%, transparent), linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-composite: intersect;
  }
  :root[data-theme="dark"] .uf-body::before {
    background:
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.09), transparent) 12% 22% / 60% 36% no-repeat,
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.07), transparent) 88% 34% / 50% 32% no-repeat,
      radial-gradient(closest-side, rgb(var(--cine-glow) / 0.05), transparent) 32% 70% / 64% 34% no-repeat;
  }

  /* 手機：摘要 → 地圖 → 類別 → 距離尺 → 清單；電腦：左欄摘要／類別／距離尺／清單，右欄地圖黏在畫面上 */
  .uf-app {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "summary" "map" "filters" "ruler" "list";
    column-gap: 1.5rem;
  }
  .uf-app > * { min-width: 0; margin-bottom: 1rem; }
  .uf-app > .uf-a-summary { margin-bottom: 0; }
  .uf-a-summary > * { margin-bottom: 1rem; }
  .uf-app [hidden],
  .uf-search [hidden],
  .uf-app .uf-chip[hidden] {
    display: none !important;
  }
  .uf-a-summary { grid-area: summary; }
  .uf-a-map { grid-area: map; }
  .uf-a-filters { grid-area: filters; }
  .uf-a-ruler { grid-area: ruler; }
  .uf-a-list { grid-area: list; }
  @media (min-width: 1024px) {
    .uf-app {
      grid-template-columns: minmax(340px, 420px) minmax(0, 1fr);
      grid-template-rows: auto auto auto 1fr;
      grid-template-areas: "summary map" "filters map" "ruler map" "list map";
      align-items: start;
    }
    .uf-a-map {
      position: sticky;
      top: 1rem;
      align-self: start;
    }
  }

  /* ===== 玻璃面板（不加 backdrop-filter：後面是靜態環境光，省下手機繪圖） ===== */
  .uf-card {
    position: relative;
    background: var(--cine-glass-bg);
    border: 1px solid var(--cine-glass-border);
    border-radius: 1rem;
    padding: 1rem;
    box-shadow: var(--cine-glass-shadow);
  }
  @supports ((-webkit-mask-composite: xor) or (mask-composite: exclude)) {
    .uf-card::before {
      content: "";
      position: absolute;
      inset: -1px;
      border-radius: inherit;
      padding: 1px;
      background: linear-gradient(155deg, var(--cine-glass-edge-a), transparent 38%, transparent 62%, var(--cine-glass-edge-b));
      -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
      -webkit-mask-composite: xor;
      mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
      pointer-events: none;
    }
  }
  .uf-card-soft {
    background: linear-gradient(160deg, rgb(var(--cine-glow) / 0.1), rgb(var(--cine-glow) / 0.03) 60%), var(--cine-glass-bg);
  }
  .uf-h2 { font-size: 1.25rem; font-weight: 700; line-height: 1.4; }
  .uf-h3 { font-size: 1.05rem; font-weight: 700; line-height: 1.4; }
  .uf-h2:focus { outline: none; }
  .uf-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ===== 搜尋卡（放在主視覺裡） ===== */
  .uf-search { padding: 1rem; }
  .uf-label { display: block; font-weight: 700; margin-bottom: 0.5rem; }
  .uf-row { display: flex; gap: 0.5rem; align-items: stretch; }
  .uf-row2 { margin-top: 0.625rem; flex-wrap: wrap; }
  .uf-input { flex: 1 1 auto; min-width: 0; }
  .uf-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 0.85rem;
    border-radius: 0.75rem;
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }
  .uf-btn-primary {
    background: var(--accent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 88%, #fff) 0%, var(--accent) 55%, color-mix(in srgb, var(--accent) 86%, #000) 100%);
    color: var(--accent-foreground);
    border: 1px solid var(--accent);
    box-shadow: 0 6px 16px -8px rgb(var(--cine-glow) / 0.9), 0 1px 0 rgb(255 255 255 / 0.35) inset;
  }
  .uf-btn-outline { background: transparent; color: var(--accent); border: 1.5px solid var(--accent); }
  .uf-btn-outline:hover { background: var(--accent); color: var(--accent-foreground); }
  .uf-btn-here { gap: 0.5rem; }
  .uf-btn-sm { font-size: 0.9rem; padding: 0.35rem 0.8rem; }
  .uf-btn-block { width: 100%; margin-top: 0.75rem; }
  .uf-seg {
    display: inline-flex;
    border: 1.5px solid var(--accent);
    border-radius: 0.75rem;
    overflow: hidden;
    flex: 0 0 auto;
    background: rgb(255 255 255 / 0.35);
  }
  :root[data-theme="dark"] .uf-seg { background: rgb(0 0 0 / 0.15); }
  .uf-seg label { position: relative; display: flex; }
  .uf-seg input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .uf-seg span {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.6rem;
    font-size: 0.95rem;
    color: var(--accent);
    cursor: pointer;
    white-space: nowrap;
  }
  .uf-seg label + label span { border-left: 1.5px solid var(--accent); }
  .uf-seg input:checked + span { background: var(--accent); color: var(--accent-foreground); font-weight: 600; }
  .uf-seg input:focus-visible + span { outline: 2px dashed var(--accent); outline-offset: -4px; }
  @media (max-width: 359px) {
    .uf-seg span { padding: 0 0.45rem; font-size: 0.9rem; }
  }
  .uf-status { margin-top: 0.75rem; font-size: 0.9rem; color: var(--cine-sub, var(--muted-foreground)); line-height: 1.6; }
  .uf-status.uf-err, .uf-err { color: #b3261e; }
  [data-theme="dark"] .uf-status.uf-err, [data-theme="dark"] .uf-err { color: #ffb4ab; }
  .uf-cands { margin-top: 0.5rem; }
  .uf-cand-btns { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .uf-cand {
    min-height: 44px;
    padding: 0.4rem 0.8rem;
    border: 1px solid rgb(var(--cine-glow) / 0.45);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    color: var(--foreground);
    font-size: 0.95rem;
    text-align: left;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  :root[data-theme="dark"] .uf-cand { background: rgb(0 0 0 / 0.2); }
  .uf-cand:hover { border-color: var(--accent); color: var(--accent); }

  /* ===== 共用小元件 ===== */
  .uf-small { font-size: 0.875rem; color: var(--muted-foreground); line-height: 1.6; }
  .uf-mt { margin-top: 0.75rem; }
  .uf-mt-s { margin-top: 0.4rem; }
  .uf-a { color: var(--accent); text-decoration: underline; }
  .uf-kicker {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--cine-eyebrow, var(--muted-foreground));
  }
  .uf-kicker::before {
    content: "";
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgb(var(--cine-glow));
    box-shadow: 0 0 0 3px rgb(var(--cine-glow) / 0.2), 0 0 10px 2px rgb(var(--cine-glow) / 0.6);
  }
  .uf-intro-t { margin-top: 0.35rem; line-height: 1.65; }
  .uf-warn-box {
    border-left: 4px solid #c2410c;
    background: rgb(194 65 12 / 0.08);
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.9rem;
    margin-bottom: 0.6rem;
  }
  /* 類別圓點：跟地圖上的點同一個顏色（--cl 淺色、--cd 深色，從 JSON 類別算出來） */
  .uf-dot {
    display: inline-block;
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--cl, #8a8a8a);
    box-shadow: 0 0 0 1.5px rgb(255 250 240 / 0.9), 0 0 8px 1px color-mix(in srgb, var(--cl, #8a8a8a) 55%, transparent);
    vertical-align: -0.05em;
  }
  :root[data-theme="dark"] .uf-dot {
    background: var(--cd, #b5b5b5);
    box-shadow: 0 0 0 1.5px rgb(40 33 28 / 0.9), 0 0 9px 1px color-mix(in srgb, var(--cd, #b5b5b5) 55%, transparent);
  }

  /* ===== 摘要：左邊一個小雷達錶（掃一圈停住），右邊查詢點；下面一句話講完 ===== */
  .uf-sum-top { display: flex; align-items: center; gap: 0.9rem; }
  .uf-sum-head { min-width: 0; flex: 1 1 auto; }
  .uf-dial {
    position: relative;
    isolation: isolate;
    flex: none;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1.5px solid rgb(var(--cine-glow) / 0.75);
    background:
      radial-gradient(circle, transparent 0 30%, rgb(var(--cine-glow) / 0.45) 30.5% 31.5%, transparent 32% 62%, rgb(var(--cine-glow) / 0.4) 62.5% 63.5%, transparent 64%),
      linear-gradient(transparent calc(50% - 0.5px), rgb(var(--cine-glow) / 0.28) calc(50% - 0.5px) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      linear-gradient(90deg, transparent calc(50% - 0.5px), rgb(var(--cine-glow) / 0.28) calc(50% - 0.5px) calc(50% + 0.5px), transparent calc(50% + 0.5px)),
      radial-gradient(circle, rgb(var(--cine-glow) / 0.2), rgb(var(--cine-glow) / 0.05) 72%);
    box-shadow: 0 0 22px -4px rgb(var(--cine-glow) / 0.65), inset 0 0 14px rgb(var(--cine-glow) / 0.22);
  }
  .uf-dial-sweep {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: conic-gradient(from 0deg, rgb(var(--cine-glow) / 0) 0deg 280deg, rgb(var(--cine-glow) / 0.6) 360deg);
    animation: uf-dial 2.6s linear 0.15s 1 both;
  }
  @keyframes uf-dial {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .uf-dial b {
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1;
    color: var(--cine-num);
    text-shadow: 0 0 16px var(--cine-num-glow), 0 0 2px var(--background);
    font-variant-numeric: tabular-nums;
  }
  .uf-dial small { margin-top: 2px; font-size: 0.72rem; font-weight: 600; color: var(--muted-foreground); }
  .uf-dial.is-zero { border-color: rgb(var(--cine-glow) / 0.4); box-shadow: none; }
  .uf-dial.is-zero b { color: var(--muted-foreground); text-shadow: none; }
  .uf-sum-title { margin-top: 0.2rem; font-weight: 800; font-size: 1.08rem; line-height: 1.45; overflow-wrap: anywhere; }
  .uf-note { margin-top: 0.6rem; font-size: 0.875rem; color: #9a3412; }
  [data-theme="dark"] .uf-note { color: #fdba74; }
  .uf-sum-line { margin-top: 0.75rem; font-size: 1.02rem; line-height: 1.7; overflow-wrap: anywhere; }
  .uf-sum-line b { color: var(--cine-num); font-size: 1.2em; text-shadow: 0 0 18px var(--cine-num-glow); }
  .uf-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.6rem; }
  .uf-stale > .uf-card, .uf-stale > .uf-listhead, .uf-stale > .uf-list, .uf-stale.uf-card > * { opacity: 0.45; }
  #uf-summary { overflow-wrap: anywhere; }
  .uf-skel > .uf-card + .uf-card { margin-top: 1rem; }
  #uf-summary > .uf-card > * { animation: cine-rise-in 0.6s var(--cine-ease-out) backwards; }
  #uf-summary > .uf-card > :nth-child(2) { animation-delay: 80ms; }
  #uf-summary > .uf-card > :nth-child(3) { animation-delay: 160ms; }
  #uf-summary > .uf-card > :nth-child(n + 4) { animation-delay: 240ms; }

  /* ===== 地圖 ===== */
  .uf-mapwrap { position: relative; isolation: isolate; }
  #uf-map { width: 100%; height: clamp(260px, 58vh, 540px); }
  @media (min-width: 1024px) {
    #uf-map { height: clamp(460px, calc(100vh - 9rem), 860px); }
  }
  .cine-mapframe.is-fallback #uf-map { height: 12rem; }
  /* 雷達光束疊層（uf-sweep.js 插在地圖畫布與圖釘之間）；夜間用濾色混合，像暖燈打在地面 */
  .uf-sweep { position: absolute; left: 0; top: 0; pointer-events: none; }
  :root[data-theme="dark"] .uf-sweep { mix-blend-mode: screen; }
  .uf-mapempty {
    position: absolute;
    left: 50%;
    bottom: 2.75rem;
    transform: translateX(-50%);
    z-index: 6;
    max-width: calc(100% - 2rem);
    padding: 0.45rem 0.95rem;
    border-radius: 999px;
    background: var(--cine-glass-bg-solid);
    color: var(--foreground);
    border: 1px solid rgb(var(--cine-glow) / 0.35);
    font-size: 0.875rem;
    box-shadow: 0 10px 26px -12px rgb(60 38 14 / 0.5), 0 0 18px -4px rgb(var(--cine-glow) / 0.45);
    pointer-events: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .uf-mapfail { padding: 2rem 1rem; text-align: center; color: var(--muted-foreground); }
  .uf-legend { display: flex; align-items: flex-start; gap: 0.6rem; margin-top: 0.5rem; font-size: 0.85rem; color: var(--muted-foreground); line-height: 1.55; }
  .uf-legend p { min-width: 0; flex: 1 1 auto; }
  /* 熱度圖圖例（跟 uf-page.js heatRamp 同一組顏色） */
  .uf-heatbar {
    flex: none;
    display: inline-flex;
    justify-content: space-between;
    align-items: center;
    width: 4.6rem;
    height: 1.15rem;
    margin-top: 0.15rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: linear-gradient(90deg, rgb(244 206 146 / 0.55), rgb(222 140 72 / 0.8), rgb(160 70 40 / 0.9), rgb(122 48 30));
    font-size: 0.68rem;
    font-weight: 700;
  }
  .uf-heatbar i { font-style: normal; }
  .uf-heatbar i:first-child { color: #6b4a2a; }
  .uf-heatbar i:last-child { color: #fff4e4; }
  :root[data-theme="dark"] .uf-heatbar { background: linear-gradient(90deg, rgb(140 86 40 / 0.6), rgb(222 156 84 / 0.8), rgb(255 222 168 / 0.9), rgb(255 240 210)); }
  :root[data-theme="dark"] .uf-heatbar i:first-child { color: #f5e6d0; }
  :root[data-theme="dark"] .uf-heatbar i:last-child { color: #4a3016; }
  .uf-legend.is-query .uf-heatbar { display: none; }
  /* 鍵盤用：先給一個跳過地圖的連結（Tab 到才出現） */
  .uf-skip {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .uf-skip:focus {
    position: static;
    clip: auto;
    clip-path: none;
    overflow: visible;
    white-space: normal;
    display: inline-flex;
    align-items: center;
    width: auto;
    height: auto;
    min-height: 44px;
    margin: 0 0 0.5rem;
    padding: 0.4rem 0.8rem;
    border: 2px solid var(--accent);
    border-radius: 0.5rem;
    background: var(--card);
    color: var(--accent);
    font-weight: 600;
  }
  .uf-unlock-ctrl { margin: 10px 10px 0 0; }
  .uf-unlock {
    min-height: 44px;
    padding: 0 0.85rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--cine-glow) / 0.45);
    background: var(--cine-glass-bg-solid);
    color: var(--foreground);
    font-size: 0.9rem;
    font-weight: 600;
    box-shadow: 0 6px 18px -6px rgb(60 38 14 / 0.35);
  }
  .uf-unlock[aria-pressed="true"] { background: var(--accent); color: var(--accent-foreground); border-color: var(--accent); }

  /* 地圖彈窗：暖色玻璃 */
  .uf-mapwrap .maplibregl-popup-content {
    padding: 12px 36px 10px 14px;
    background: rgb(255 253 249 / 0.86);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border: 1px solid rgb(255 255 255 / 0.7);
  }
  .uf-mapwrap .uf-tip .maplibregl-popup-content,
  .uf-mapwrap .maplibregl-popup-content:not(:has(.maplibregl-popup-close-button)) { padding: 8px 12px; }
  .uf-mapwrap .uf-tip { pointer-events: none; }
  .uf-mapwrap .uf-tip .uf-pop { font-size: 13px; }
  .uf-mapwrap .maplibregl-popup-anchor-top .maplibregl-popup-tip,
  .uf-mapwrap .maplibregl-popup-anchor-top-left .maplibregl-popup-tip,
  .uf-mapwrap .maplibregl-popup-anchor-top-right .maplibregl-popup-tip { border-bottom-color: rgb(255 253 249 / 0.86); }
  .uf-mapwrap .maplibregl-popup-anchor-bottom .maplibregl-popup-tip,
  .uf-mapwrap .maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip,
  .uf-mapwrap .maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip { border-top-color: rgb(255 253 249 / 0.86); }
  .uf-mapwrap .maplibregl-popup-anchor-left .maplibregl-popup-tip { border-right-color: rgb(255 253 249 / 0.86); }
  .uf-mapwrap .maplibregl-popup-anchor-right .maplibregl-popup-tip { border-left-color: rgb(255 253 249 / 0.86); }
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-content { background: rgb(40 33 28 / 0.88); border-color: rgb(255 236 205 / 0.12); }
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-anchor-top .maplibregl-popup-tip,
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-anchor-top-left .maplibregl-popup-tip,
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-anchor-top-right .maplibregl-popup-tip { border-bottom-color: rgb(40 33 28 / 0.88); }
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-anchor-bottom .maplibregl-popup-tip,
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-anchor-bottom-left .maplibregl-popup-tip,
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-anchor-bottom-right .maplibregl-popup-tip { border-top-color: rgb(40 33 28 / 0.88); }
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-anchor-left .maplibregl-popup-tip { border-right-color: rgb(40 33 28 / 0.88); }
  :root[data-theme="dark"] .uf-mapwrap .maplibregl-popup-anchor-right .maplibregl-popup-tip { border-left-color: rgb(40 33 28 / 0.88); }
  .uf-pop { font-size: 14px; line-height: 1.55; overflow-wrap: anywhere; }
  .uf-pop strong { display: block; margin-bottom: 2px; }
  .uf-pop-sub { display: flex; align-items: center; gap: 0.4rem; }
  .uf-pop-note { color: #6b5e54; font-size: 12.5px; }
  [data-theme="dark"] .uf-pop-note { color: #c9bdb3; }
  .uf-linkbtn {
    margin-top: 2px;
    padding: 6px 0;
    min-height: 44px;
    color: #8a6539;
    text-decoration: underline;
    background: none;
    border: 0;
    font-size: 14px;
    cursor: pointer;
  }
  [data-theme="dark"] .uf-linkbtn { color: #c9a87c; }

  /* ===== 類別膠囊 ===== */
  .uf-fhead { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex-wrap: wrap; }
  .uf-fall { margin: 0; padding: 0 0.25rem; }
  .uf-chips { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-top: 0.5rem; }
  .uf-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 40px;
    padding: 0.3rem 0.8rem 0.3rem 0.65rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--cl) 45%, transparent);
    background: color-mix(in srgb, var(--cl) 12%, rgb(255 255 255 / 0.7));
    color: var(--foreground);
    font-size: 0.92rem;
    cursor: pointer;
    transition: opacity 0.2s ease, background-color 0.2s ease, transform 0.18s var(--cine-ease-out);
  }
  .uf-chip b { font-weight: 800; color: var(--cine-num); font-variant-numeric: tabular-nums; }
  .uf-chip:active { transform: scale(0.96); }
  .uf-chip[aria-pressed="false"] {
    background: transparent;
    border-style: dashed;
    border-color: rgb(var(--cine-glow) / 0.45);
    color: var(--muted-foreground);
  }
  .uf-chip[aria-pressed="false"] .uf-dot { background: transparent; box-shadow: inset 0 0 0 2px var(--cl); }
  .uf-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  :root[data-theme="dark"] .uf-chip {
    border-color: color-mix(in srgb, var(--cd) 45%, transparent);
    background: color-mix(in srgb, var(--cd) 14%, rgb(0 0 0 / 0.2));
  }
  :root[data-theme="dark"] .uf-chip[aria-pressed="false"] { background: transparent; border-color: rgb(var(--cine-glow) / 0.3); }
  :root[data-theme="dark"] .uf-chip[aria-pressed="false"] .uf-dot { background: transparent; box-shadow: inset 0 0 0 2px var(--cd); }

  /* ===== 距離尺（uf-ruler.js）：0 到範圍公尺，點依直線距離擺放、太擠往上疊 ===== */
  .uf-ruler {
    position: relative;
    margin-top: 0.5rem;
    padding-top: 3.2rem;
    border-radius: 0.75rem;
    outline: none;
  }
  .uf-ruler:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .uf-r-plot { position: relative; margin: 0 10px; }
  .uf-r-dots { position: relative; height: 18px; }
  .uf-r-dot {
    position: absolute;
    bottom: 0;
    width: var(--uf-rs, 14px);
    height: var(--uf-rs, 14px);
    margin-left: calc(var(--uf-rs, 14px) / -2);
    padding: 0;
    border-radius: 50%;
    border: 1.5px solid rgb(255 250 240 / 0.95);
    background: var(--cl);
    box-shadow: 0 0 8px 1px color-mix(in srgb, var(--cl) 55%, transparent);
    cursor: pointer;
    transition: transform 0.2s var(--cine-ease-out), box-shadow 0.2s ease;
  }
  :root[data-theme="dark"] .uf-r-dot {
    border-color: rgb(40 33 28 / 0.9);
    background: var(--cd);
    box-shadow: 0 0 10px 1px color-mix(in srgb, var(--cd) 60%, transparent);
  }
  /* 點很小：往外多給 4px 好點 */
  .uf-r-dot::before { content: ""; position: absolute; inset: -4px; border-radius: 50%; }
  .uf-r-dot:hover,
  .uf-r-dot.is-sel { transform: scale(1.35); z-index: 2; }
  .uf-r-dot.is-sel { box-shadow: 0 0 0 2.5px var(--accent), 0 0 16px 3px rgb(var(--cine-glow) / 0.65); }
  .uf-r-dot:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .uf-r-dot.is-ping::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--cl);
    animation: uf-rping 0.9s ease-out forwards;
    pointer-events: none;
  }
  :root[data-theme="dark"] .uf-r-dot.is-ping::after { border-color: var(--cd); }
  @keyframes uf-rping {
    from { transform: scale(1); opacity: 0.95; }
    to { transform: scale(2.8); opacity: 0; }
  }
  /* 出場：一道光從 0 掃到最遠，點依距離依序浮現 */
  .uf-ruler.is-anim .uf-r-dot { animation: uf-rdot-in 0.5s var(--cine-ease-out) backwards; animation-delay: calc(var(--p, 0) * 1.1s + 0.1s); }
  @keyframes uf-rdot-in {
    from { opacity: 0; transform: translateY(10px) scale(0.4); }
  }
  .uf-r-scan {
    position: absolute;
    top: -0.6rem;
    bottom: -8px;
    left: 0;
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
    background: linear-gradient(to top, rgb(var(--cine-glow)), rgb(var(--cine-glow) / 0));
    box-shadow: 0 0 12px 3px rgb(var(--cine-glow) / 0.55);
    opacity: 0;
    pointer-events: none;
  }
  .uf-ruler.is-anim .uf-r-scan { animation: uf-rscan 1.35s var(--cine-ease-soft) 0.05s both; }
  @keyframes uf-rscan {
    0% { left: 0; opacity: 0; }
    10% { opacity: 1; }
    85% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  .uf-r-tip {
    position: absolute;
    z-index: 3;
    transform: translateX(-50%);
    max-width: min(260px, 100%);
    padding: 0.35rem 0.65rem;
    border-radius: 0.6rem;
    background: var(--cine-glass-bg-solid);
    border: 1px solid rgb(var(--cine-glow) / 0.5);
    box-shadow: 0 10px 24px -12px rgb(60 38 14 / 0.55), 0 0 16px -6px rgb(var(--cine-glow) / 0.6);
    font-size: 0.82rem;
    line-height: 1.4;
    white-space: nowrap;
    pointer-events: none;
  }
  .uf-r-tip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: var(--ax, 50%);
    width: 1.5px;
    height: var(--drop, 0px);
    margin-left: -0.75px;
    background: linear-gradient(rgb(var(--cine-glow) / 0.85), rgb(var(--cine-glow) / 0.25));
  }
  .uf-ruler.is-anim .uf-r-tip.is-near { animation: uf-fade-in 0.5s ease 1s backwards; }
  @keyframes uf-fade-in {
    from { opacity: 0; }
  }
  .uf-r-tip b { display: block; overflow: hidden; text-overflow: ellipsis; }
  .uf-r-tip span { display: block; color: var(--muted-foreground); overflow: hidden; text-overflow: ellipsis; }
  .uf-r-axis { position: relative; height: 2.2rem; margin: 6px 10px 0; }
  .uf-r-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, rgb(var(--cine-glow)), rgb(var(--cine-glow) / 0.4));
    box-shadow: 0 0 10px rgb(var(--cine-glow) / 0.45);
  }
  .uf-r-mt { position: absolute; top: 0; width: 1px; height: 6px; background: rgb(var(--cine-glow) / 0.6); }
  .uf-r-tk { position: absolute; top: 0; display: flex; flex-direction: column; align-items: center; transform: translateX(-50%); }
  .uf-r-tk i { width: 1.5px; height: 10px; background: rgb(var(--cine-glow)); }
  .uf-r-tk b { margin-top: 3px; font-size: 0.75rem; font-weight: 600; color: var(--muted-foreground); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .uf-r-tk.is-first { transform: none; align-items: flex-start; }
  .uf-r-tk.is-last { transform: translateX(-100%); align-items: flex-end; }

  /* ===== 精簡清單：一列一處，依距離 ===== */
  .uf-listhead { margin-bottom: 0.6rem; }
  .uf-listhead .uf-small { margin-top: 0.2rem; }
  .uf-list { display: flex; flex-direction: column; gap: 0.4rem; overflow-wrap: anywhere; }
  .uf-li { position: relative; }
  .uf-li-btn {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    min-height: 48px;
    padding: 0.5rem 0.75rem;
    border-radius: 0.8rem;
    border: 1px solid var(--cine-glass-border);
    border-left: 3px solid var(--cl);
    background: var(--cine-glass-bg);
    color: var(--foreground);
    text-align: left;
    cursor: pointer;
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.7) inset, 0 10px 24px -20px rgb(92 62 28 / 0.5);
    transition: transform 0.3s var(--cine-ease-out), box-shadow 0.2s ease;
  }
  :root[data-theme="dark"] .uf-li-btn { border-left-color: var(--cd); box-shadow: 0 1px 0 rgb(255 236 205 / 0.06) inset, 0 12px 28px -20px rgb(0 0 0 / 0.8); }
  @media (hover: hover) and (pointer: fine) {
    .uf-li-btn:hover { transform: translateX(2px); }
  }
  .uf-li-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .uf-li.is-sel .uf-li-btn { box-shadow: 0 0 0 2px var(--accent), 0 0 20px -2px rgb(var(--cine-glow) / 0.55); }
  .uf-li::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: 0.8rem;
    box-shadow: 0 0 0 3px var(--accent), 0 0 26px 2px rgb(var(--cine-glow) / 0.55);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .uf-li.uf-flash::after { opacity: 1; }
  .uf-li-d { flex: none; min-width: 4.4rem; font-weight: 800; color: var(--cine-num); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .uf-li-m { display: flex; flex-direction: column; flex: 1 1 auto; min-width: 0; }
