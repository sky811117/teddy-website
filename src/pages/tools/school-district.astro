        map.addLayer({ id: "z-" + lv + "-ln", type: "line", source: "z-" + lv, filter: ["!=", ["get", "approx"], true], layout: hid(J), paint: { "line-color": lineCol(), "line-width": 1, "line-opacity": 0 } }, B);
