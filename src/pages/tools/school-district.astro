      overflow: hidden;
      isolation: isolate;
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 0.75rem 0.875rem;
    }
    .sd-lv::before {
      content: "";
      position: absolute;
      z-index: -1;
      left: -22%;
      top: -70%;
      width: 72%;
      height: 170%;
      border-radius: 50%;
      background: radial-gradient(closest-side, var(--lv-glow), transparent);
      pointer-events: none;
    }
    .sd-lv--green { --lv-glow: rgb(34 179 94 / 0.2); border-color: rgb(34 179 94 / 0.36); background: linear-gradient(135deg, rgb(236 252 242 / 0.95), rgb(255 255 255 / 0.6)); }
    .sd-lv--yellow { --lv-glow: rgb(240 160 32 / 0.24); border-color: rgb(226 150 30 / 0.45); background: linear-gradient(135deg, rgb(255 247 228 / 0.97), rgb(255 255 255 / 0.6)); }
    .sd-lv--none { background: linear-gradient(135deg, var(--muted), rgb(255 255 255 / 0.5)); }
    [data-theme="dark"] .sd-lv--green { border-color: rgb(74 200 128 / 0.32); background: linear-gradient(135deg, rgb(22 58 38 / 0.7), rgb(44 37 34 / 0.55)); }
    [data-theme="dark"] .sd-lv--yellow { border-color: rgb(236 170 64 / 0.38); background: linear-gradient(135deg, rgb(78 54 16 / 0.7), rgb(44 37 34 / 0.55)); }
    [data-theme="dark"] .sd-lv--none { background: linear-gradient(135deg, rgb(58 52 46 / 0.7), rgb(44 37 34 / 0.55)); }
    .sd-lv .cine-orb { margin-right: 0.15rem; }

    /* 判斷依據（定位精度／行政區／系統判定的里、鄰）：一塊獨立的依據區，一眼看得到。
       標籤不斷行；卡片太窄（320 手機）時整列改成上下排 */
    .sd-card { container-type: inline-size; }
    .sd-basis > dt { white-space: nowrap; }
    .sd-basis {
      padding: 0.7rem 0.85rem;
      border-radius: 12px;
      background: rgb(var(--cine-glow) / 0.07);
      border: 1px solid rgb(var(--cine-glow) / 0.28);
      box-shadow: inset 3px 0 0 rgb(var(--cine-glow) / 0.8);
    }
    .sd-basis > dt { font-weight: 600; }
    .sd-basis > dt ~ dt,
    .sd-basis > dt ~ dt + dd { border-top: 1px dashed rgb(var(--cine-glow) / 0.35); padding-top: 0.5rem; }
    .sd-basis > dt:nth-of-type(3) { color: var(--foreground); }
    .sd-basis > dd:nth-of-type(3) { font-size: 0.9375rem; }
    .sd-basis dd b { font-weight: 800; }
    .sd-basis dd ul > li { position: relative; padding-left: 0.85rem; }
    .sd-basis dd ul > li::before { content: ""; position: absolute; left: 0; top: 0.62em; width: 5px; height: 5px; border-radius: 50%; background: rgb(var(--cine-glow)); box-shadow: 0 0 6px rgb(var(--cine-glow) / 0.9); }
    /* 卡片太窄（320 手機）：改上下排。標籤 13px 灰字、值緊接在下；分隔線只畫在「每一組」上面（標籤和自己的值之間不畫）
       ⚠ 要放在上面那組規則後面才蓋得過（同樣的權重，後寫的贏） */
    @container (max-width: 340px) {
      .sd-basis { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
      .sd-basis > dt,
      .sd-basis > dt:nth-of-type(3) { font-size: 13px; font-weight: 600; color: var(--muted-foreground); }
      .sd-basis > dd { margin-top: 2px; }
      .sd-basis > dt ~ dt + dd { border-top: 0; padding-top: 0; }
      .sd-basis > dt ~ dt { margin-top: 11px; padding-top: 11px; }
    }

    .sd-legend-card { border-radius: 14px; }

    /* ---------- 地圖卡 ---------- */
    /* 地圖卡很大又 sticky：不用毛玻璃（捲動時每格重算模糊很吃效能），改半實心 */
    .sd-mapcard { border-radius: 18px; -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--cine-glass-bg-solid); }
    .sd-seg-group {
      position: relative;
      isolation: isolate;
      display: inline-grid;
      grid-template-columns: 1fr 1fr;
      flex-shrink: 0;
      padding: 3px;
      border-radius: 999px;
      background: var(--muted);
      border: 1px solid var(--border);
