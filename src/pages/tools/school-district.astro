---
/**
 * 台中學區查詢地圖 — /tools/school-district/（工具代號 school-district）
 *
 * 為什麼做這頁：買方問學區，一般人手上只有「門牌地址」，但教育局學區表是用「里、鄰」寫的，
 * 地址本身不會寫里鄰。這頁的主角是地址查詢：
 *   一般地址 → /js/tc-addr.js（臺中市 GIS 門牌，瀏覽器本機比對）推出里、鄰
 *            → /js/sd-lookup.js 對 115 學年度學區表 → 綠燈／黃燈／查無
 * 資料全部來自政府公開資料（來源寫在 public/data/school-district/meta.json，頁尾也會列出）：
 *   scripts/build-tc-addr.py         → public/data/tc-addr/
 *   scripts/build-school-district.py → public/data/school-district/（zones_*.json 是 GeoJSON，副檔名故意用 .json）
 *
 * 隱私：使用者輸入的地址文字只在瀏覽器裡比對，不送任何伺服器、不進網址、不進 GA 參數。
 *       GA 事件只記「成功／失敗原因、精度、行政區、燈號」。
 *       （地圖底圖會向國土測繪中心下載查詢位置附近的圖磚，頁面上有寫清楚）
 *
 * 規則類文字都附官方出處，2026-09-29 實際讀過：
 *   臺中市公立國民中小學新生分發及入學實施要點（law.taichung.gov.tw GL000378，103-07-08 修正）第三、四、五點
 *   115 學年度國小學區表（中區區公所 2026-02-24 轉公告）、國中學區表（西屯區公所 2026-02-11 公告）
 *   臺中市政府教育局 學區查詢（tc.edu.tw；共同學區／自由學區的各校說明）
 *   國立中科實驗高級中學 招生資訊（國小部）
 * 「共同學區」「自由學區」一律照學區表原文標示，⛔ 不自己寫「可選讀」這種規則。
 */
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";
import meta from "../../../public/data/school-district/meta.json";
import schoolInfo from "../../../public/data/school-district/school_info.json";
import lookupGs from "../../../public/data/school-district/lookup_gs.json";

const pageURL = new URL("/tools/school-district/", Astro.site).href;

// 靜態 JS／資料的版本號：public/_headers.txt 讓 /js/* /data/* 快取 1 天＋背景更新 7 天，
// 所以網址一定要帶 ?v=，檔案內容一改就換號（算不到就退回學區資料的整理日期）。
function fileVer(rel: string): string {
  try {
    const buf = fs.readFileSync(path.join(process.cwd(), rel));
    return crypto.createHash("md5").update(buf).digest("hex").slice(0, 10);
  } catch {
    return meta.built;
  }
}
const vAddr = fileVer("public/js/tc-addr.js");
const vSd = fileVer("public/js/sd-lookup.js");
const vIdx = fileVer("public/data/tc-addr/index.json");
// 學區資料（zones／lookup／school_info／meta）的 ?v=：6 個檔內容合起來算雜湊，同一天重建也會換號
const dataVer = (() => {
  try {
    const h = crypto.createHash("md5");
    for (const f of ["meta.json", "school_info.json", "lookup_gs.json", "lookup_jh.json", "zones_gs.json", "zones_jh.json"]) {
      h.update(fs.readFileSync(path.join(process.cwd(), "public/data/school-district", f)));
    }
    return h.digest("hex").slice(0, 10);
  } catch {
    return meta.built;
  }
})();
// 「115學年度」→「115 學年度」（頁面其他地方都是這種寫法）
const yearTxt = String(meta.year).replace(/^(\d+)\s*/, "$1 ");

type SrcMeta = { name: string; url: string; page?: string; version: string; kind?: string; org?: string; year?: string };
const metaAny = meta as unknown as { tables: SrcMeta[]; sources: SrcMeta[]; attribution: string; licenseUrl: string };
const tables = metaAny.tables;
const openData = metaAny.sources.filter(s => s.kind === "opendata");
const otherData = metaAny.sources.filter(s => s.kind === "other");
const officialQuery = meta.officialQuery;
const LAW_URL = "https://law.taichung.gov.tw/LawContent.aspx?id=GL000378";
const NEHS_URL = "https://www.nehs.tc.edu.tw/招生資訊國小部/";
const GS_TABLE_PAGE = tables[0].page ?? tables[0].url;
const JH_TABLE_PAGE = tables[1].page ?? tables[1].url;
const GS_TABLE_PDF = tables[0].url;

// 國小學區要看到「鄰」才分得出來的里（同一里各鄰對到的學校不一樣）
type LkEntry = { all?: string[]; lin?: { [k: string]: string[] } };
const lkEntries = Object.entries(lookupGs as unknown as { [k: string]: LkEntry });
const splitLi = lkEntries.filter(([k, e]) => {
  if (k.startsWith("_") || !e.lin || !Object.keys(e.lin).length) return false;
  const base = e.all ?? [];
  const sets = new Set(Object.values(e.lin).map(v => [...new Set([...base, ...v])].sort().join("|")));
  return sets.size > 1 || base.length > 0;
}).length;

// 依行政區列出學校（給「依行政區找學校」；也讓搜尋引擎讀得到校名）
const DIST_ORDER = [
  "中區", "東區", "南區", "西區", "北區", "西屯區", "南屯區", "北屯區", "豐原區", "東勢區",
  "大甲區", "清水區", "沙鹿區", "梧棲區", "后里區", "神岡區", "潭子區", "大雅區", "新社區", "石岡區",
  "外埔區", "大安區", "烏日區", "大肚區", "龍井區", "霧峰區", "太平區", "大里區", "和平區",
];
type SchoolRow = { id: string; name: string; isNew: boolean };
type DistGroup = { dist: string; items: SchoolRow[] };
type InfoRec = { name: string; dist: string; status?: string };
function groupSchools(level: "gs" | "jh"): DistGroup[] {
  const src = (schoolInfo as unknown as { [lv: string]: { [id: string]: InfoRec } })[level];
  const by = new Map<string, SchoolRow[]>();
  for (const [id, v] of Object.entries(src)) {
    const list = by.get(v.dist) ?? [];
    list.push({ id, name: v.name, isNew: !!v.status });
    by.set(v.dist, list);
  }
  return DIST_ORDER.filter(d => by.has(d)).map(d => ({
    dist: d,
    items: (by.get(d) ?? []).sort((a, b) => a.name.localeCompare(b.name, "zh-Hant")),
  }));
}
const gsGroups = groupSchools("gs");
const jhGroups = groupSchools("jh");

const faqs = [
  {
    q: "台中學區怎麼查？",
    a: "在上面輸入門牌地址就能查。要正式確認，用臺中市政府教育局的「學區查詢」，選學校類型和行政區，看各校的學區里鄰。",
    src: [
      { name: "臺中市政府教育局 學區查詢", url: officialQuery.url },
      { name: "115 學年度國小學區表（中區區公所公告）", url: GS_TABLE_PAGE },
      { name: "臺中市 115 學年度國中學區表（西屯區公所公告）", url: JH_TABLE_PAGE },
    ],
  },
  {
    q: "共同學區是什麼？",
    a: "學區表寫「某里第幾鄰為 A 國小及 B 國小共同學區」，就是這幾鄰同時列在兩所學校的學區裡。例：115 學年度國小學區表寫明，東區泉源里第 16 鄰進德路以東，為臺中國小及樂業國小共同學區。至於怎麼分發，各校說法不同，僑忠國小的學區說明是「共同學區可選擇就讀僑忠國小或頭家國小」。有一種是整區的：國小學區表在國立中科實驗高級中學國小部那一列寫「大雅區及西屯區皆為共同學區」，這所學校另外辦招生，要網路報名、抽籤。遇到共同學區，工具會亮黃燈，每一所都列出來。",
    src: [
      { name: "115 學年度國小學區表（PDF）", url: GS_TABLE_PDF },
      { name: "臺中市政府教育局 學區查詢（各校學區說明）", url: officialQuery.url },
      { name: "國立中科實驗高級中學 招生資訊（國小部）", url: NEHS_URL },
    ],
  },
  {
    q: "自由學區是什麼？",
    a: "學區表有幾個地方寫「自由學區」：國中學區表在和平國中那一列，行政區寫和平區，里鄰只寫【自由學區】；國小學區表把太平區黃竹里列為自由學區。同樣叫自由學區，意思不一定一樣。黃竹國小的說明是「本校為自由學區（台中市全區、入學免遷戶籍）」。大里區瑞城里第 4 鄰，瑞城國小那一列寫【自由學區】，美群國小那一列寫【共同學區】，並註明「共同學區可選擇就讀瑞城國小或美群國小」。",
    src: [
      { name: "115 學年度國小學區表（PDF）", url: GS_TABLE_PDF },
      { name: "臺中市 115 學年度國中學區表（西屯區公所公告）", url: JH_TABLE_PAGE },
      { name: "臺中市政府教育局 學區查詢（各校學區說明）", url: officialQuery.url },
    ],
  },
  {
    q: "學區以什麼為準？買了房子就能讀嗎？",
    a: "看兩件事：教育局公告的學區表，和孩子的戶籍。《臺中市公立國民中小學新生分發及入學實施要點》第三點寫明，入學以「設籍並實際居住於學區內之學齡學生」為對象。第四點是學生數超額學校的作法：新生依設籍先後分發到額滿為止，其餘由原校協調轉介到鄰近學校（第二款）；超額學校做入學資格審查時，會核對房屋所有權狀正本、經法院公證的租賃契約正本，或其他足以證明實際居住的文件（第五款）。所以看的是設籍加上實際居住，不是只看房子在哪裡。熱門學校有沒有額滿、要多早設籍，請直接問學校。",
    src: [{ name: "臺中市公立國民中小學新生分發及入學實施要點（103-07-08 修正）", url: LAW_URL }],
  },
  {
    q: "學區資料多久更新？",
    a: "學區表是以「學年度」為單位公告：115 學年度國中學區表在 2026-02-11、國小學區表在 2026-02-24 由區公所轉公告，國小另附當年度的「學區調整說明表」。上面那份實施要點第五點也寫明，教育局得定期檢討學區劃分。這頁用的是 115 學年度學區表，門牌資料是臺中市 115 年 1 月版，版本都寫在頁面下方的資料來源。",
    src: [
      { name: "115 學年度國小學區表公告（2026-02-24）", url: GS_TABLE_PAGE },
      { name: "臺中市 115 學年度國中學區表公告（2026-02-11）", url: JH_TABLE_PAGE },
      { name: "新生分發及入學實施要點 第五點", url: LAW_URL },
    ],
  },
  {
    q: "地圖和地址查詢的結果不一樣，要看哪一個？",
    a: "看地址查詢。地圖上的學區交界是依門牌位置推估的，交界附近不一定準；同一鄰依路段分給不同學校的地方，地圖上兩校範圍會重疊。地址查詢直接用門牌資料對學區表，兩者不同時以地址查詢為準。",
    src: [] as { name: string; url: string }[],
  },
];

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "台中學區查詢地圖（國小・國中）",
  applicationCategory: "EducationalApplication",
  operatingSystem: "Web",
  url: pageURL,
  description:
    "輸入台中的門牌地址，不用知道里鄰，查這個地址在哪一所國小、國中的學區（115 學年度），並列出判斷依據的里鄰；地圖分色標示每所學校的學區。",
  offers: { "@type": "Offer", price: "0", priceCurrency: "TWD" },
  provider: { "@id": `${config.site.url}#realestateagent` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首頁", item: config.site.url },
    { "@type": "ListItem", position: 2, name: "客戶工具", item: `${config.site.url}tools/` },
    { "@type": "ListItem", position: 3, name: "台中學區查詢", item: pageURL },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const chipCls =
  "border-border bg-background hover:border-accent inline-flex min-h-11 items-center rounded-full border px-3 text-sm";
---

<Layout
  title={`台中學區查詢地圖｜輸入地址查國小、國中（115 學年度） | ${config.site.title}`}
  description="台中學區查詢：輸入門牌地址，不用知道里鄰，就能查國小、國中學區（115 學年度），附判斷依據的里鄰與官方查詢連結；地圖分色標示各校學區。"
  canonicalURL={pageURL}
  ogImage="/og/page-tools.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={safeJsonLd(appSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(faqSchema)} />
    <link
      rel="stylesheet"
      href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
      integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
      crossorigin=""
    />
  </Fragment>
  <Header />

  <main id="main-content" class="pb-6">
    <div
      id="sd-app"
      class="mx-auto w-full max-w-[1440px] px-4 sm:px-6"
      data-v={dataVer}
      data-vidx={vIdx}
      data-official={officialQuery.url}
      data-gs-table={GS_TABLE_PAGE}
      data-jh-table={JH_TABLE_PAGE}
    >
      <h1 class="mt-6 text-2xl font-extrabold sm:text-3xl">台中學區查詢（國小・國中）</h1>
      <p class="text-muted-foreground mt-2 mb-4 sm:mb-6">
        輸入門牌地址，不用知道里、鄰，就能查這個地址在哪一所國小、國中的學區（{yearTxt}）。
      </p>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[380px_minmax(0,1fr)] lg:gap-6 xl:grid-cols-[420px_minmax(0,1fr)]">
        {/* ===== 左：地址查詢＋結果 ===== */}
        <div class="min-w-0 space-y-4">
          <section class="card-surface p-4" aria-labelledby="sd-q-title">
            <label id="sd-q-title" for="sd-addr" class="text-base font-bold">輸入地址查學區</label>
            <form id="sd-form" class="mt-2 flex gap-2" role="search" autocomplete="off">
              <input
                id="sd-addr"
                type="text"
                inputmode="text"
                enterkeyhint="search"
                autocomplete="off"
                spellcheck="false"
                placeholder="例：福星路123號"
                aria-describedby="sd-q-hint"
                class="border-border bg-background min-h-11 min-w-0 flex-1 rounded-md border px-3 py-2 text-base"
              />
              <button id="sd-go" type="submit" class="btn-primary shrink-0 px-5">查詢</button>
            </form>
            <p id="sd-q-hint" class="text-muted-foreground mt-2 text-sm leading-relaxed">
              照平常寫法打：樓層、之幾號、全形數字、「三段／3段」、沒寫行政區都可以。
              你打的地址只在你的手機或電腦裡比對，不會傳出去（地圖會向國土測繪中心下載那一帶的底圖）。
              網站的匿名使用統計只記查詢有沒有成功、定位精度、燈號和行政區，不含地址。
            </p>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <button id="sd-here" type="button" class="border-border bg-background hover:border-accent inline-flex min-h-11 items-center gap-1.5 rounded-md border px-3 text-sm">
                <span aria-hidden="true">📍</span>用我的位置
              </button>
              <span class="text-muted-foreground text-sm">試試看：</span>
              <button type="button" class={chipCls} data-example="西屯區福星路123號5樓">福星路123號5樓</button>
              <button type="button" class={chipCls} data-example="北屯區崇德路三段200號">崇德路三段200號</button>
              <button type="button" class={chipCls} data-example="北屯區崇德路二段">只打路名</button>
            </div>
            <p id="sd-status" class="text-muted-foreground mt-3 min-h-5 text-sm" role="status" aria-live="polite"></p>
            <p class="text-muted-foreground mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
              <span class="inline-flex items-center gap-1"><span class="sd-dot sd-dot-green" aria-hidden="true"></span>只有一所</span>
              <span class="inline-flex items-center gap-1"><span class="sd-dot sd-dot-yellow" aria-hidden="true"></span>可能不只一所，全部列出</span>
              <span class="inline-flex items-center gap-1"><span class="sd-dot sd-dot-none" aria-hidden="true"></span>學區表查無</span>
            </p>
          </section>

          <section id="sd-result" class="scroll-mt-4" aria-live="polite" hidden></section>

          <p class="text-muted-foreground text-sm leading-relaxed">
            ⚠️ 僅供參考，以教育局公告的學區表與學校通知為準。本工具依 {yearTxt}學區表（<a class="text-accent underline" href={GS_TABLE_PAGE} target="_blank" rel="noopener">國小</a>、<a class="text-accent underline" href={JH_TABLE_PAGE} target="_blank" rel="noopener">國中</a>）＋臺中市 115 年 1 月門牌資料。
            正式查詢：<a class="text-accent underline" href={officialQuery.url} target="_blank" rel="noopener">臺中市政府教育局 學區查詢</a>
          </p>
        </div>

        {/* ===== 右：地圖 ===== */}
        <div class="min-w-0 lg:sticky lg:top-4 lg:self-start">
          <section class="card-surface p-2 sm:p-3" aria-label="學區地圖">
            <div class="flex flex-wrap items-center gap-2">
              <div class="border-border inline-flex shrink-0 overflow-hidden rounded-md border" role="group" aria-label="切換國小或國中學區">
                <button type="button" data-level-btn="gs" aria-pressed="true" class="sd-seg min-h-11 px-4 text-sm font-semibold">國小</button>
                <button type="button" data-level-btn="jh" aria-pressed="false" class="sd-seg border-border min-h-11 border-s px-4 text-sm font-semibold">國中</button>
              </div>
              <div class="relative min-w-0 flex-1 basis-40">
                <label for="sd-school" class="sr-only">依校名找學校</label>
                <input
                  id="sd-school"
                  type="search"
                  role="combobox"
                  enterkeyhint="search"
                  autocomplete="off"
                  placeholder="搜尋校名，例：四維"
                  class="border-border bg-background min-h-11 w-full min-w-0 rounded-md border px-3 text-base"
                  aria-controls="sd-school-list"
                  aria-autocomplete="list"
                  aria-expanded="false"
                />
                <ul id="sd-school-list" class="bg-card border-border absolute inset-x-0 top-full z-20 mt-1 max-h-72 overflow-y-auto rounded-md border shadow-lg" role="listbox" hidden></ul>
              </div>
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-x-4 text-sm">
              <label class="inline-flex min-h-11 items-center gap-2"><input id="sd-show-schools" type="checkbox" class="size-4" checked /> 學校位置</label>
              <label class="inline-flex min-h-11 items-center gap-2"><input id="sd-show-labels" type="checkbox" class="size-4" checked /> 校名（放大才顯示）</label>
            </div>

            <div class="relative mt-1">
              <div
                id="sd-map"
                class="border-border h-[60vh] max-h-[680px] min-h-[260px] w-full rounded-lg border lg:h-[calc(100vh-12rem)] lg:max-h-[900px] lg:min-h-[520px]"
                role="application"
                aria-label="台中國小、國中學區地圖"
              ></div>
              <div id="sd-map-msg" class="pointer-events-none absolute inset-0 z-10 grid place-items-center p-4" hidden>
                <p class="bg-card border-border rounded-md border px-4 py-3 text-center text-sm shadow"></p>
              </div>
              <div id="sd-gesture" class="pointer-events-none absolute inset-0 z-10 grid place-items-center rounded-lg bg-black/45 p-4 text-center text-base font-semibold text-white opacity-0 transition-opacity duration-200">
                用兩根手指移動、縮放地圖
              </div>
            </div>
            <p id="sd-legend" class="text-muted-foreground mt-2 text-sm leading-relaxed">
              每個顏色是一所學校的學區（顏色只用來分開相鄰學區）。交界是依門牌位置推估的，交界附近請用地址查詢。點地圖看那裡的學區。
            </p>
          </section>
        </div>
      </div>
    </div>

    <div class="app-layout mt-10">
      <section>
        <h2 class="text-xl font-semibold">為什麼一定要輸入門牌號碼？</h2>
        <p class="mt-2 leading-relaxed">
          台中全市 {meta.counts.li} 個里，有 {splitLi} 個里的國小學區要看到「鄰」才分得出來。同一條路，隔幾個門牌號碼，可能就在不同學校的學區。
        </p>
        <p class="mt-2 leading-relaxed">
          地址上不會寫里、鄰。這個工具先用臺中市政府的門牌資料，把地址對到里與鄰，再去對教育局公告的學區表。結果卡會寫出「系統判定的里、鄰」和定位精度，依據攤開給你看。
        </p>
        <p class="text-muted-foreground mt-2 text-sm">📌 里數依臺中市政府民政局鄰長名冊（{meta.counts.li} 里）；要看到鄰才分得出來的里，依 {yearTxt}國小學區表逐里統計（學區表來源見下方）。</p>

        <h3 class="mt-6 text-lg font-semibold">燈號怎麼看</h3>
        <ul class="mt-2 space-y-2 text-sm leading-relaxed">
          <li class="flex gap-2"><span class="sd-dot sd-dot-green mt-1.5 shrink-0" aria-hidden="true"></span><span><strong>綠燈：只有一所。</strong>門牌對到的里鄰只在一所學校的學區裡。寫著「推估」的，是門牌資料沒有這個號碼，但同一號的其他門牌和前後門牌，全都在同一所學校的學區。</span></li>
          <li class="flex gap-2"><span class="sd-dot sd-dot-yellow mt-1.5 shrink-0" aria-hidden="true"></span><span><strong>黃燈：可能不只一所，全部列出來，請再向學校確認。</strong>遇到下面任一種就亮黃燈：
            <ul class="mt-1 space-y-0.5 ps-5" style="list-style:disc;">
              <li>學區表寫明共同學區、自由學區，或註記「可選…就讀」</li>
              <li>同一鄰依路段分給不同學校</li>
              <li>整區另列一所學校（西屯區、大雅區的國小另有中科實中國小部；和平區的國中另有和平國中）</li>
              <li>門牌資料沒有這個號，附近門牌分屬不同學區</li>
              <li>同一個門牌號登記在不同里鄰</li>
              <li>門牌寫法有兩種讀法</li>
              <li>行政區、段別或路名是工具推測的（沒寫區、沒寫段，或打的那條路沒有這個門牌、改用同名的另一段）</li>
              <li>只輸入到路名、巷名</li>
            </ul></span></li>
          <li class="flex gap-2"><span class="sd-dot sd-dot-none mt-1.5 shrink-0" aria-hidden="true"></span><span><strong>查無：</strong>官方學區表沒有列到這個里鄰，結果卡會附教育局學區查詢的連結。</span></li>
        </ul>

        <h3 class="mt-6 text-lg font-semibold">輸入地址的小提醒</h3>
        <ul class="mt-2 space-y-1.5 ps-5 text-sm leading-relaxed" style="list-style:disc;">
          <li>樓層不影響學區：「12號5樓之3」看的是 12 號。</li>
          <li>「12之1號」「12號之1」都當成 12 之 1 號。</li>
          <li>「12號之15樓」分不出是「12 之 1 號 5 樓」還是「12 之 15 號」，兩種都會查；寫成「12之1號5樓」最清楚。</li>
          <li>門牌號碼前面有字的（例：臨3號、某某新村6號），請照門牌上的寫法打。只打「3號」時，同一個號的這類門牌也會一起列出來。</li>
          <li>沒寫行政區也可以；同名的路在好幾區都有時，會請你選區。</li>
          <li>新大樓的門牌如果還不在門牌資料裡，會用同一條路（巷）同一號的其他門牌和前後門牌推估，並列出那幾個門牌的里鄰；對到不同學校時亮黃燈、全部列出。</li>
          <li>只打里名（例：太平區黃竹里）時，會列出學區表上這個里的學校；同一個里各鄰分屬不同學校的，要打路名和門牌號碼才分得出來。</li>
          <li>只打到路名或巷名，會列出這段路（這條巷）經過的所有里鄰和可能的學校。</li>
          <li>戶口名簿上有里鄰的話可以一起打（例：北屯區平安里11鄰崇德路二段46號）；跟門牌資料不同時，兩邊對到的學校都會列出來。</li>
        </ul>
      </section>

      <hr class="my-8 border-dashed" />

      <section>
