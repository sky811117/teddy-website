        map.addLayer({ id: "z-" + lv + "-glow", type: "line", source: "z-" + lv, filter: ["==", ["get", "school"], ""], layout: hid(J), paint: { "line-color": glowCol(), "line-width": 3.2, "line-blur": 1.2, "line-opacity": 0 } }, B);
