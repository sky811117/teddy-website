---
/**
 * 台中學區查詢地圖 — /tools/school-district/（工具代號 school-district）
 *
 * 為什麼做這頁：買方問學區，一般人手上只有「門牌地址」，但教育局學區表是用「里、鄰」寫的，
 * 地址本身不會寫里鄰。這頁的主角是地址查詢：
 *   一般地址 → /js/tc-addr.js（臺中市 GIS 門牌，瀏覽器本機比對）推出里、鄰
 *            → /js/sd-lookup.js 對 115 學年度學區表 → 綠燈／黃燈／查無
 * 資料全部來自政府公開資料（來源寫在 public/data/school-district/meta.json，頁尾也會列出）：
 *   scripts/build-tc-addr.py         → public/data/tc-addr/
 *   scripts/build-school-district.py → public/data/school-district/（zones_*.json 是 GeoJSON，副檔名故意用 .json）
 *
 * 隱私：使用者輸入的地址文字只在瀏覽器裡比對，不送任何伺服器、不進網址、不進 GA 參數。
 *       GA 事件只記「成功／失敗原因、精度、行政區、燈號」。
 *       （地圖底圖會向國土測繪中心下載查詢位置附近的圖磚，頁面上有寫清楚）
 *
 * 規則類文字都附官方出處，2026-09-29 實際讀過：
 *   臺中市公立國民中小學新生分發及入學實施要點（law.taichung.gov.tw GL000378，103-07-08 修正）第三、四、五點
 *   115 學年度國小學區表（中區區公所 2026-02-24 轉公告）、國中學區表（西屯區公所 2026-02-11 公告）
 *   臺中市政府教育局 學區查詢（tc.edu.tw；共同學區／自由學區的各校說明）
 *   國立中科實驗高級中學 招生資訊（國小部）
 * 「共同學區」「自由學區」一律照學區表原文標示，⛔ 不自己寫「可選讀」這種規則。
 *
 * 畫面（2026-09-30 電影感改版）：
 *   主視覺 <CinematicHero variant="tool">，地址搜尋卡放在主視覺裡（375×812 第一屏看得到輸入框＋查詢鈕）
 *   地圖 /js/cine-map.js（MapLibre GL 4.7.1＋國土測繪中心 EMAP 暖色調色）：
 *     全市視角＝平面、安靜：學區是往米色混 40% 的淡色塊（fill，5 色序號 ci 沿用建置腳本「相鄰學區不同色」）＋細邊線
 *     國小／國中切換＝各 ci 層依序淡入、由下往上滑進定位（fill-opacity／fill-translate 屬性轉場，不重算圖磚）
 *     查詢命中＝另一個小 source（z-hi）：用原色 fill-extrusion 從地面「升起」（feature-state 動畫）＋金色光暈邊＋落地陰影，其他學區淡化
 *     學校點＝全市視角（zoom < 12.5）用小圓點 circle 圖層；放大後換成可點的光點 HTML Marker
 *     點地圖／「用我的位置」一律用自己的點在多邊形內判斷（跟 Leaflet 版同一套，斜視也準）
 *   ⛔ 查詢邏輯與結果卡文字跟改版前一致（基準比對：scratchpad tools2/design/baseline/capture.py）
 */
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import CinematicHero from "@/components/cinematic/CinematicHero.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";
import meta from "../../../public/data/school-district/meta.json";
import schoolInfo from "../../../public/data/school-district/school_info.json";
import lookupGs from "../../../public/data/school-district/lookup_gs.json";

const pageURL = new URL("/tools/school-district/", Astro.site).href;

// 靜態 JS／資料的版本號：public/_headers.txt 讓 /js/* /data/* 快取 1 天＋背景更新 7 天，
// 所以網址一定要帶 ?v=，檔案內容一改就換號（算不到就退回學區資料的整理日期）。
function fileVer(rel: string): string {
  try {
    const buf = fs.readFileSync(path.join(process.cwd(), rel));
    return crypto.createHash("md5").update(buf).digest("hex").slice(0, 10);
  } catch {
    return meta.built;
  }
}
const vAddr = fileVer("public/js/tc-addr.js");
const vSd = fileVer("public/js/sd-lookup.js");
const vMap = fileVer("public/js/cine-map.js");
const vIdx = fileVer("public/data/tc-addr/index.json");
// 學區資料（zones／lookup／school_info／meta）的 ?v=：6 個檔內容合起來算雜湊，同一天重建也會換號
const dataVer = (() => {
  try {
    const h = crypto.createHash("md5");
    for (const f of ["meta.json", "school_info.json", "lookup_gs.json", "lookup_jh.json", "zones_gs.json", "zones_jh.json"]) {
      h.update(fs.readFileSync(path.join(process.cwd(), "public/data/school-district", f)));
    }
    return h.digest("hex").slice(0, 10);
  } catch {
    return meta.built;
  }
})();
// 「115學年度」→「115 學年度」（頁面其他地方都是這種寫法）
const yearTxt = String(meta.year).replace(/^(\d+)\s*/, "$1 ");

type SrcMeta = { name: string; url: string; page?: string; version: string; kind?: string; org?: string; year?: string };
const metaAny = meta as unknown as { tables: SrcMeta[]; sources: SrcMeta[]; attribution: string; licenseUrl: string };
const tables = metaAny.tables;
const openData = metaAny.sources.filter(s => s.kind === "opendata");
const otherData = metaAny.sources.filter(s => s.kind === "other");
const officialQuery = meta.officialQuery;
const LAW_URL = "https://law.taichung.gov.tw/LawContent.aspx?id=GL000378";
const NEHS_URL = "https://www.nehs.tc.edu.tw/招生資訊國小部/";
const GS_TABLE_PAGE = tables[0].page ?? tables[0].url;
const JH_TABLE_PAGE = tables[1].page ?? tables[1].url;
const GS_TABLE_PDF = tables[0].url;

// 國小學區要看到「鄰」才分得出來的里（同一里各鄰對到的學校不一樣）
type LkEntry = { all?: string[]; lin?: { [k: string]: string[] } };
const lkEntries = Object.entries(lookupGs as unknown as { [k: string]: LkEntry });
const splitLi = lkEntries.filter(([k, e]) => {
  if (k.startsWith("_") || !e.lin || !Object.keys(e.lin).length) return false;
  const base = e.all ?? [];
  const sets = new Set(Object.values(e.lin).map(v => [...new Set([...base, ...v])].sort().join("|")));
  return sets.size > 1 || base.length > 0;
}).length;

// 依行政區列出學校（給「依行政區找學校」；也讓搜尋引擎讀得到校名）
const DIST_ORDER = [
  "中區", "東區", "南區", "西區", "北區", "西屯區", "南屯區", "北屯區", "豐原區", "東勢區",
  "大甲區", "清水區", "沙鹿區", "梧棲區", "后里區", "神岡區", "潭子區", "大雅區", "新社區", "石岡區",
  "外埔區", "大安區", "烏日區", "大肚區", "龍井區", "霧峰區", "太平區", "大里區", "和平區",
];
type SchoolRow = { id: string; name: string; isNew: boolean };
type DistGroup = { dist: string; items: SchoolRow[] };
type InfoRec = { name: string; dist: string; status?: string };
function groupSchools(level: "gs" | "jh"): DistGroup[] {
  const src = (schoolInfo as unknown as { [lv: string]: { [id: string]: InfoRec } })[level];
  const by = new Map<string, SchoolRow[]>();
  for (const [id, v] of Object.entries(src)) {
    const list = by.get(v.dist) ?? [];
    list.push({ id, name: v.name, isNew: !!v.status });
    by.set(v.dist, list);
  }
  return DIST_ORDER.filter(d => by.has(d)).map(d => ({
    dist: d,
    items: (by.get(d) ?? []).sort((a, b) => a.name.localeCompare(b.name, "zh-Hant")),
  }));
}
const gsGroups = groupSchools("gs");
const jhGroups = groupSchools("jh");

const faqs = [
  {
    q: "台中學區怎麼查？",
    a: "在上面輸入門牌地址就能查。要正式確認，用臺中市政府教育局的「學區查詢」，選學校類型和行政區，看各校的學區里鄰。",
    src: [
      { name: "臺中市政府教育局 學區查詢", url: officialQuery.url },
      { name: "115 學年度國小學區表（中區區公所公告）", url: GS_TABLE_PAGE },
      { name: "臺中市 115 學年度國中學區表（西屯區公所公告）", url: JH_TABLE_PAGE },
    ],
  },
  {
    q: "共同學區是什麼？",
    a: "學區表寫「某里第幾鄰為 A 國小及 B 國小共同學區」，就是這幾鄰同時列在兩所學校的學區裡。例：115 學年度國小學區表寫明，東區泉源里第 16 鄰進德路以東，為臺中國小及樂業國小共同學區。至於怎麼分發，各校說法不同，僑忠國小的學區說明是「共同學區可選擇就讀僑忠國小或頭家國小」。有一種是整區的：國小學區表在國立中科實驗高級中學國小部那一列寫「大雅區及西屯區皆為共同學區」，這所學校另外辦招生，要網路報名、抽籤。遇到共同學區，工具會亮黃燈，每一所都列出來。",
    src: [
      { name: "115 學年度國小學區表（PDF）", url: GS_TABLE_PDF },
      { name: "臺中市政府教育局 學區查詢（各校學區說明）", url: officialQuery.url },
      { name: "國立中科實驗高級中學 招生資訊（國小部）", url: NEHS_URL },
    ],
  },
  {
    q: "自由學區是什麼？",
    a: "學區表有幾個地方寫「自由學區」：國中學區表在和平國中那一列，行政區寫和平區，里鄰只寫【自由學區】；國小學區表把太平區黃竹里列為自由學區。同樣叫自由學區，意思不一定一樣。黃竹國小的說明是「本校為自由學區（台中市全區、入學免遷戶籍）」。大里區瑞城里第 4 鄰，瑞城國小那一列寫【自由學區】，美群國小那一列寫【共同學區】，並註明「共同學區可選擇就讀瑞城國小或美群國小」。",
    src: [
      { name: "115 學年度國小學區表（PDF）", url: GS_TABLE_PDF },
      { name: "臺中市 115 學年度國中學區表（西屯區公所公告）", url: JH_TABLE_PAGE },
      { name: "臺中市政府教育局 學區查詢（各校學區說明）", url: officialQuery.url },
    ],
  },
  {
    q: "學區以什麼為準？買了房子就能讀嗎？",
    a: "看兩件事：教育局公告的學區表，和孩子的戶籍。《臺中市公立國民中小學新生分發及入學實施要點》第三點寫明，入學以「設籍並實際居住於學區內之學齡學生」為對象。第四點是學生數超額學校的作法：新生依設籍先後分發到額滿為止，其餘由原校協調轉介到鄰近學校（第二款）；超額學校做入學資格審查時，會核對房屋所有權狀正本、經法院公證的租賃契約正本，或其他足以證明實際居住的文件（第五款）。所以看的是設籍加上實際居住，不是只看房子在哪裡。熱門學校有沒有額滿、要多早設籍，請直接問學校。",
    src: [{ name: "臺中市公立國民中小學新生分發及入學實施要點（103-07-08 修正）", url: LAW_URL }],
  },
  {
    q: "學區資料多久更新？",
    a: "學區表是以「學年度」為單位公告：115 學年度國中學區表在 2026-02-11、國小學區表在 2026-02-24 由區公所轉公告，國小另附當年度的「學區調整說明表」。上面那份實施要點第五點也寫明，教育局得定期檢討學區劃分。這頁用的是 115 學年度學區表，門牌資料是臺中市 115 年 1 月版，版本都寫在頁面下方的資料來源。",
    src: [
      { name: "115 學年度國小學區表公告（2026-02-24）", url: GS_TABLE_PAGE },
      { name: "臺中市 115 學年度國中學區表公告（2026-02-11）", url: JH_TABLE_PAGE },
      { name: "新生分發及入學實施要點 第五點", url: LAW_URL },
    ],
  },
  {
    q: "地圖和地址查詢的結果不一樣，要看哪一個？",
    a: "看地址查詢。地圖上的學區交界是依門牌位置推估的，交界附近不一定準；同一鄰依路段分給不同學校的地方，地圖上兩校範圍會重疊。地址查詢直接用門牌資料對學區表，兩者不同時以地址查詢為準。",
    src: [] as { name: string; url: string }[],
  },
];

const appSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "台中學區查詢地圖（國小・國中）",
  applicationCategory: "EducationalApplication",
  operatingSystem: "Web",
  url: pageURL,
  description:
    "輸入台中的門牌地址，不用知道里鄰，查這個地址在哪一所國小、國中的學區（115 學年度），並列出判斷依據的里鄰；地圖分色標示每所學校的學區。",
  offers: { "@type": "Offer", price: "0", priceCurrency: "TWD" },
  provider: { "@id": `${config.site.url}#realestateagent` },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "首頁", item: config.site.url },
    { "@type": "ListItem", position: 2, name: "客戶工具", item: `${config.site.url}tools/` },
    { "@type": "ListItem", position: 3, name: "台中學區查詢", item: pageURL },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

// 主視覺關鍵數字：只用本頁已經列出來源的數字（學校數＝學區表、里數＝鄰長名冊、門牌數＝臺中市 GIS 門牌 115 年 1 月）
const heroStats = [
  { value: meta.counts.gs, suffix: "所", label: "國小" },
  { value: meta.counts.jh, suffix: "所", label: "國中" },
  { value: meta.counts.li, label: "里" },
  { prefix: "約", value: Math.round(meta.counts.addr / 10000), suffix: "萬", label: "筆門牌" },
];
---

<Layout
  title={`台中學區查詢地圖｜輸入地址查國小、國中（115 學年度） | ${config.site.title}`}
  description="台中學區查詢：輸入門牌地址，不用知道里鄰，就能查國小、國中學區（115 學年度），附判斷依據的里鄰與官方查詢連結；地圖分色標示各校學區。"
  canonicalURL={pageURL}
  ogImage="/og/page-tools.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={safeJsonLd(appSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={safeJsonLd(faqSchema)} />
    <link rel="preconnect" href="https://unpkg.com" crossorigin="anonymous" />
    <link rel="preconnect" href="https://wmts.nlsc.gov.tw" crossorigin="anonymous" />
  </Fragment>
  <Header />

  <main id="main-content" class="pb-6">
    {/* ===== 主視覺＋地址查詢（搜尋卡直接放在主視覺裡：手機第一屏就看得到輸入框和查詢鈕） ===== */}
    <CinematicHero
      variant="tool"
      layout="split"
      eyebrow={`客戶工具・${yearTxt}`}
      title="台中學區查詢（國小・國中）"
      subtitle={`輸入門牌地址，不用知道里、鄰，就能查這個地址在哪一所國小、國中的學區（${yearTxt}）。`}
      stats={heroStats}
      container="cine-tool-wrap"
      titleId="sd-title"
      class="sd-hero"
    >
      <section class="cine-glass sd-search p-4" aria-labelledby="sd-q-title">
        <label id="sd-q-title" for="sd-addr" class="text-base font-bold">輸入地址查學區</label>
        <form id="sd-form" class="mt-2 flex gap-2" role="search" autocomplete="off">
          <input
            id="sd-addr"
            type="text"
            inputmode="text"
            enterkeyhint="search"
            autocomplete="off"
            spellcheck="false"
            placeholder="例：福星路123號"
            aria-describedby="sd-q-hint"
            class="cine-input flex-1"
          />
          <button id="sd-go" type="submit" class="cine-cta cine-btn">查詢</button>
        </form>
        <p id="sd-q-hint" class="text-muted-foreground mt-2 text-sm leading-relaxed">
          照平常寫法打：樓層、之幾號、全形數字、「三段／3段」、沒寫行政區都可以。
        </p>
        {/* 隱私說明收進「怎麼保護你的地址」（內容一字不差），手機第一屏留給輸入框和數字 */}
        <details class="sd-privacy mt-1 text-sm">
          <summary class="text-muted-foreground">怎麼保護你的地址</summary>
          <p class="text-muted-foreground mt-1 leading-relaxed">
            你打的地址只在你的手機或電腦裡比對，不會傳出去（地圖會向國土測繪中心下載那一帶的底圖）。
            網站的匿名使用統計只記查詢有沒有成功、定位精度、燈號和行政區，不含地址。
          </p>
        </details>
        <div class="sd-chips mt-2 flex flex-wrap items-center gap-2">
          <button id="sd-here" type="button" class="sd-chip sd-chip--here">
            <span class="cine-locate-dot" aria-hidden="true"></span>用我的位置
          </button>
          <span class="text-muted-foreground text-sm">試試看：</span>
          <button type="button" class="sd-chip" data-example="西屯區福星路123號5樓">福星路123號5樓</button>
          <button type="button" class="sd-chip" data-example="北屯區崇德路三段200號">崇德路三段200號</button>
          <button type="button" class="sd-chip" data-example="北屯區崇德路二段">只打路名</button>
        </div>
        <p id="sd-status" class="sd-status text-muted-foreground mt-2 text-sm" role="status" aria-live="polite"></p>
      </section>
    </CinematicHero>

    <div
      id="sd-app"
      class="cine-tool-wrap"
      data-v={dataVer}
      data-vidx={vIdx}
      data-official={officialQuery.url}
      data-gs-table={GS_TABLE_PAGE}
      data-jh-table={JH_TABLE_PAGE}
    >
      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[380px_minmax(0,1fr)] lg:gap-6 xl:grid-cols-[420px_minmax(0,1fr)]">
        {/* ===== 左：查詢結果＋燈號說明 ===== */}
        <div class="min-w-0 space-y-4">
          <section id="sd-result" class="sd-result scroll-mt-4" aria-live="polite" hidden></section>

          <div class="cine-glass sd-legend-card cine-reveal px-4 py-3">
            <p class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm">
              <span class="inline-flex items-center gap-2"><span class="cine-orb cine-orb--green cine-orb--sm cine-orb--static" aria-hidden="true"></span>只有一所</span>
              <span class="inline-flex items-center gap-2"><span class="cine-orb cine-orb--yellow cine-orb--sm cine-orb--static" aria-hidden="true"></span>可能不只一所，全部列出</span>
