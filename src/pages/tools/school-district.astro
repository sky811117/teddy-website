      z-index: -1;
      top: 3px;
      bottom: 3px;
      left: 3px;
      width: calc(50% - 3px);
      border-radius: 999px;
      /* 淺色：深木色漸層（白字 5.3～7.9:1），光澤靠內側高光，不靠把底色調亮 */
      background: linear-gradient(135deg, #8a6539, #6f4f29);
      box-shadow: 0 1px 0 rgb(255 255 255 / 0.25) inset, 0 6px 16px -6px rgb(var(--cine-glow) / 0.95), 0 0 18px -4px rgb(var(--cine-glow) / 0.6);
      transition: transform 0.5s var(--cine-ease-spring);
    }
    [data-theme="dark"] .sd-seg-thumb { background: linear-gradient(135deg, #e2c79f, var(--accent)); }
    .sd-seg-group[data-lv="jh"] .sd-seg-thumb { transform: translateX(100%); }
    .sd-seg { min-width: 4.5rem; border-radius: 999px; background: transparent; color: var(--foreground); transition: color 0.3s ease; }
    .sd-seg[aria-pressed="true"] { color: var(--accent-foreground); }
    .sd-check input { accent-color: var(--accent); }
    [data-theme="dark"] .sd-check input { color-scheme: dark; accent-color: #c9a87c; }
    .sd-school-list {
      border-radius: 14px;
      border: 1px solid var(--border);
      background: var(--card);
      box-shadow: 0 18px 40px -16px rgb(60 38 14 / 0.45), 0 0 0 1px rgb(var(--cine-glow) / 0.2);
    }
    .sd-map-msg { background: var(--cine-glass-bg-solid); color: var(--foreground); box-shadow: 0 10px 30px -12px rgb(60 38 14 / 0.45), 0 0 0 1px rgb(var(--cine-glow) / 0.3); }
    .sd-dash { flex: none; width: 22px; height: 0; border-top: 2px dashed var(--muted-foreground); }
    /* 沒有 WebGL：訊息框不用佔一整個地圖高 */
    .cine-mapframe.is-fallback #sd-map { height: 12rem; min-height: 0; }

    /* 學校點（HTML Marker）：滑鼠 24px、觸控 40px 的點擊範圍，看得到的光點 12px；校名放大到街道層級才顯示
       ⚠ MapLibre 會改 .sd-school 本身的 transform，動畫只放在子元素 */
    .sd-school { width: 24px; height: 24px; cursor: pointer; }
    .sd-touch .sd-school { width: 40px; height: 40px; }
    .sd-school-dot {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 12px;
      height: 12px;
      margin: -6px 0 0 -6px;
      border-radius: 50%;
      background: radial-gradient(circle at 36% 30%, #fff 0 28%, #fbe5bd 55%, #d49a4e 100%);
      box-shadow: 0 0 0 2px #fffaf0, 0 0 0 3.5px rgb(92 62 28 / 0.6), 0 0 14px 3px rgb(var(--cine-glow) / 0.7);
      transition: transform 0.3s var(--cine-ease-spring);
    }
    .sd-z-low .sd-school-dot { transform: scale(0.7); }
    @media (hover: hover) {
      .sd-school:hover .sd-school-dot { transform: scale(1.4); }
    }
    .sd-school.is-on .sd-school-dot { transform: scale(1.4); box-shadow: 0 0 0 2px #fffaf0, 0 0 0 3.5px rgb(92 62 28 / 0.7), 0 0 20px 6px rgb(var(--cine-glow) / 0.95); }
    .sd-school-name {
      display: none;
      position: absolute;
      left: calc(50% + 11px);
      top: 50%;
      margin-top: -0.7em;
      white-space: nowrap;
      font-size: 14px;
      font-weight: 700;
      line-height: 1.4;
      color: #2c2522;
      text-shadow: 0 0 2px #fff, 0 0 3px #fff, 0 0 5px #fff, 0 0 9px rgb(255 244 222 / 0.95);
      pointer-events: none;
    }
    [data-theme="dark"] .sd-school-name { color: #fbefdc; text-shadow: 0 0 2px #120d09, 0 0 4px #120d09, 0 0 8px rgb(0 0 0 / 0.85), 0 0 16px rgb(226 170 96 / 0.4); }
    .sd-labels-on .sd-school-name { display: block; }
    .sd-pin-hit { width: 34px; height: 44px; cursor: pointer; }

    /* 滑過學區的名稱（跟著滑鼠，只動 transform） */
    .sd-tip {
      position: absolute;
      left: 0;
      top: 0;
      z-index: 3;
      padding: 4px 11px;
      border-radius: 999px;
      font-size: 14px;
      font-weight: 600;
      white-space: nowrap;
      pointer-events: none;
      background: var(--cine-glass-bg-solid);
      color: var(--foreground);
      box-shadow: 0 8px 20px -8px rgb(60 38 14 / 0.5), 0 0 0 1px rgb(var(--cine-glow) / 0.4);
      opacity: 0;
      transition: opacity 0.15s ease;
      will-change: transform;
    }
    .sd-tip.is-on { opacity: 1; }

    /* ---------- 地圖彈窗（MapLibre Popup；右邊留 32px 給關閉鈕，內容太高時在彈窗裡捲） ---------- */
    .sd-popup .maplibregl-popup-content { padding: 12px 32px 12px 14px; animation: sd-pop-in 0.38s var(--cine-ease-out) backwards; }
    @keyframes sd-pop-in { from { opacity: 0; transform: translate3d(0, 8px, 0) scale(0.97); } }
    .sd-pop { font-size: 15px; line-height: 1.55; overflow-y: auto; overscroll-behavior: contain; }
    .sd-pop p { margin: 0; }
    .sd-pop-k { font-size: 14px; color: var(--muted-foreground); }
    .sd-pop-t { font-size: 17px; font-weight: 800; margin-top: 2px !important; }
    .sd-pop-s { font-size: 14px; color: var(--muted-foreground); margin-top: 2px !important; }
    .sd-pop-tag { display: inline-block; margin-top: 6px; font-size: 14px; padding: 1px 8px; border-radius: 9999px; background: var(--muted); }
    .sd-pop-h { font-weight: 700; margin-top: 10px !important; font-size: 15px; }
    .sd-pop-l { margin: 4px 0 0; padding-left: 18px; list-style: disc; font-size: 14px; }
    .sd-pop-l li { margin: 2px 0; }
    .sd-pop-n { margin: 8px 0 0; padding: 8px 10px; list-style: none; font-size: 14px; background: var(--muted); border-radius: 10px; }
    .sd-pop-n li + li { margin-top: 4px; }
    .sd-pop-n a { text-decoration: underline; }
    .sd-pop-a { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .sd-pop-a a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; border-radius: 10px; font-weight: 600; font-size: 15px; text-decoration: none; }
    .sd-pop-a a.sd-pop-off { border: 1.5px solid var(--accent); color: var(--accent); }
    .sd-pop-a a.sd-pop-line { background: var(--color-line, #0c8540); color: #fff; }
    .sd-pop-here { margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px dashed var(--border); }
    .sd-pop-here b { font-weight: 800; }
    .sd-pop-warn { font-size: 14px; color: var(--muted-foreground); margin-top: 4px !important; }
    .sd-pop-btns { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .sd-pop-btns button, .sd-pop-inline { min-height: 44px; padding: 0 10px; border-radius: 10px; border: 1px solid var(--border); background: var(--background); color: var(--foreground); font-size: 15px; }
    .sd-pop-btns button[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); font-weight: 700; box-shadow: 0 0 0 1px rgb(var(--cine-glow) / 0.35), 0 0 14px -4px rgb(var(--cine-glow) / 0.8); }
    .sd-pop-inline { margin-top: 8px; }

    /* ---------- 下方內容 ---------- */
    .sd-sb {
      min-height: 44px;
      padding: 0 11px;
      border: 1px solid var(--border);
      border-radius: 999px;
      font-size: 14px;
      background: var(--card);
      background: color-mix(in srgb, var(--card) 70%, transparent);
      transition: border-color 0.2s ease, box-shadow 0.3s ease;
    }
    @media (hover: hover) {
      .sd-sb:hover { border-color: var(--accent); box-shadow: 0 0 0 1px rgb(var(--cine-glow) / 0.3), 0 8px 18px -10px rgb(var(--cine-glow) / 0.9); }
    }
    .sd-det {
      border: 1px solid var(--border);
      border-radius: 14px;
      background: var(--card);
      background: color-mix(in srgb, var(--card) 72%, transparent);
      transition: border-color 0.3s ease, box-shadow 0.4s ease;
    }
    .sd-det[open] { border-color: rgb(var(--cine-glow) / 0.5); box-shadow: 0 14px 34px -22px rgb(var(--cine-glow) / 0.95); }
    .sd-det > summary { min-height: 28px; }
    .sd-hr { border: 0; height: 1px; background: linear-gradient(90deg, transparent, rgb(var(--cine-glow) / 0.55), transparent); }

    @media (prefers-reduced-motion: reduce) {
      .sd-popup .maplibregl-popup-content { animation: none; }
      .sd-seg-thumb,
      .sd-school-dot { transition: none; }
    }
  </style>
