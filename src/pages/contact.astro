---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PageHero from "@/components/PageHero.astro";
import ContactForm from "@/components/ContactForm.astro";
import SellForm from "@/components/SellForm.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";
import IconPhone from "@/assets/icons/IconPhone.svg";
import LineIcon from "@/assets/icons/socials/line.svg";
import InstagramIcon from "@/assets/icons/socials/instagram.svg";

// 這是純靜態站，build 時讀不到 ?type=；所以兩張表單都輸出，
// 由下面的 inline script 依 location.search 切換（type=sell → 賣房模式；
// type=buy → 買方表單預選「找房」；area=北屯區 → 預勾區域）。
// 賣房模式的 h1 / 副標 / 補充說明也在 client 端替換。
const pageTitle = "聯絡景泰";
const pageDesc = "LINE / 電話 / 表單三條路、看你方便。30 秒到 30 分鐘內回。";

const sellTitle = "賣房諮詢";
const sellDesc =
  "留下屋況基本資訊、24 小時內回你行情評估區間。也可以 LINE / 電話直接問。";

const metaTitle = `${pageTitle} | ${config.site.title}`;
const metaDesc =
  "台中房仲陳景泰 — 找房、賣房、換屋、投資諮詢。LINE / 電話 / 表單三條路、看你方便。30 分鐘內回覆。";

// canonicalURL 不帶 query string (?type=sell / ?type=buy 都指向同一頁，避免重複 indexing)
const canonicalURL = new URL("/contact", Astro.site).href;
const siteOrigin = new URL("/", Astro.site).href;

// ContactPage schema (Google 認得是聯絡頁、可能進 sitelinks)
const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "@id": `${canonicalURL}#contactpage`,
  url: canonicalURL,
  name: metaTitle,
  description: metaDesc,
  mainEntity: { "@id": `${siteOrigin}#realestateagent` },
  // 聯絡資訊重複放在 contact page 級別 (給 Google 更明確訊號)
  potentialAction: [
    {
      "@type": "CommunicateAction",
      name: "LINE 私訊",
      target: "https://line.me/ti/p/sky811117",
    },
    {
      "@type": "CommunicateAction",
      name: "電話",
      target: "tel:+886920118756",
    },
  ],
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: siteOrigin,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: pageTitle,
      item: canonicalURL,
    },
  ],
};
---

<Layout
  title={metaTitle}
  description={metaDesc}
  ogImage="/og/page-contact.jpg"
  canonicalURL={canonicalURL}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(contactPageSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(breadcrumbSchema)}
    />
  </Fragment>

  <Header />

  <div data-contact-hero data-sell-title={sellTitle} data-sell-desc={sellDesc}>
    <PageHero title={pageTitle} description={pageDesc} />
  </div>

  <main id="main-content" class="app-layout pb-4" data-contact-page>
    {/* 實名 / 證號信任段 — 讓客戶確認對接的是登記在案的本人，不是名單機器人 */}
    <div
      class="card-surface mt-6 flex flex-col items-center gap-4 p-6 sm:flex-row sm:items-center sm:text-left"
    >
      <img
        src="/photos/teddy-avatar.jpg"
        alt="陳景泰 / 泰迪 — 台中房仲營業員"
        width="64"
        height="64"
        class="border-accent h-16 w-16 shrink-0 rounded-full border-2 object-cover"
        loading="lazy"
      />
      <div class="text-center sm:text-left">
        <p class="text-foreground text-[18px] font-bold">陳景泰</p>
        <p class="text-muted-foreground mt-1 text-[14px] leading-relaxed">
          一品不動產 有巢氏房屋台中世界之心加盟店 ／ 經紀人 黃永隆 113彰縣字324
          ・ 營業員 陳景泰 114登字488296
        </p>
        <p class="text-muted-foreground mt-2 text-[15px] leading-relaxed">
          證號可查、實名執業。你聯絡到的是本人，不是名單客服、不是 AI
          機器人；你留的資料只用來回覆你，存在景泰自己的客戶名單與手機通知裡，不轉賣、不外流。
        </p>
      </div>
    </div>

    {
      /* 三個主要聯絡方式 cards — 不分模式都保留（賣房客戶也可能想直接 LINE） */
    }
    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <a
        href="/go/line?src=contact"
        target="_blank"
        rel="noopener"
        class="card-interactive flex flex-col items-center p-6 text-center no-underline"
      >
        <div class="bg-line/10 w-fit rounded-xl p-3">
          <LineIcon class="text-line size-7" aria-hidden="true" />
        </div>
        <h2 class="text-foreground mt-3 text-[18px] font-bold">LINE</h2>
        <p
          class="text-muted-foreground mt-2 flex-1 text-[14px] leading-relaxed"
        >
          <span data-mode="buy">最快、習慣 LINE 的話直接這條</span>
          <span data-mode="sell" hidden>想先聊聊再填表？這條最快</span>
        </p>
        <span class="btn-line mt-4 w-full text-sm">sky811117</span>
      </a>

      <a
        href="tel:+886920118756"
        class="card-interactive flex flex-col items-center p-6 text-center no-underline"
      >
        <div class="bg-accent/10 w-fit rounded-xl p-3">
          <IconPhone class="text-accent size-7" aria-hidden="true" />
        </div>
        <h2 class="text-foreground mt-3 text-[18px] font-bold">電話</h2>
        <p
          class="text-muted-foreground mt-2 flex-1 text-[14px] leading-relaxed"
        >
          急的話直接撥、每天 09:00-22:00 都接
        </p>
        <span class="btn-outline mt-4 w-full text-sm">0920-118-756</span>
      </a>

      <a
        href="https://instagram.com/nov__817"
        target="_blank"
        rel="noopener"
        class="card-interactive flex flex-col items-center p-6 text-center no-underline"
      >
        <div class="bg-accent/10 w-fit rounded-xl p-3">
          <InstagramIcon class="text-accent size-7" aria-hidden="true" />
        </div>
        <h2 class="text-foreground mt-3 text-[18px] font-bold">Instagram</h2>
        <p
          class="text-muted-foreground mt-2 flex-1 text-[14px] leading-relaxed"
        >
          看日常 + 物件短影音、DM 也接
        </p>
        <span class="btn-outline mt-4 w-full text-sm">@nov__817</span>
      </a>
    </div>

    {/* 表單入口分隔 */}
    <div class="mt-12 mb-8 flex items-center gap-4">
      <div class="border-border flex-1 border-t"></div>
      <p class="text-muted-foreground text-center text-[15px]">
        <span data-mode="buy">或者、不想加 LINE / 不想電話？用下面表單</span>
        <span data-mode="sell" hidden
          >或者、用下面表單給我屋況資料、24 小時內回行情評估區間</span
        >
      </p>
      <div class="border-border flex-1 border-t"></div>
    </div>

    {/* 兩張表單都輸出；預設顯示買方 / 一般表單，?type=sell 時由 script 切到賣房表單 */}
    <div data-mode="buy" id="contact-form-section">
      <ContactForm
        title="留你的聯絡方式、我回你"
        subtitle="長輩、企業戶、不愛即時通的人 — 用這條最舒服。留下後直接推到景泰手機、30 分鐘內回。"
      />
    </div>
    <div data-mode="sell" hidden id="sell-form-section">
      <SellForm
        title="想賣房？留 3 分鐘給景泰"
        subtitle="把屋況基本資訊留下、24 小時內回你行情評估區間。坪數、期望總價不確定可以先空著。"
      />
    </div>

    {/* 補充說明 */}
    <section
      class="border-border rounded-card mt-10 border border-dashed p-6 sm:p-8"
    >
      <div data-mode="buy">
        <h2 class="text-foreground text-[18px] font-bold">關於回覆時間</h2>
        <ul class="text-muted-foreground mt-3 space-y-2 text-[15px] leading-relaxed">
          <li>・每天 09:00-22:00：30 秒到 30 分鐘內回</li>
          <li>・22:00 後 - 翌日 09:00：隔天早上一起回</li>
          <li>・帶看 / 開會中：訊息看到會排進當日回覆順序</li>
          <li>・所有訊息都會回，沒有「回不上」的</li>
        </ul>
      </div>
      <div data-mode="sell" hidden>
        <h2 class="text-foreground text-[18px] font-bold">關於行情評估時程</h2>
        <ul class="text-muted-foreground mt-3 space-y-2 text-[15px] leading-relaxed">
          <li>
            ・收到表單後 24 小時內，給你行情評估區間（不是單一價、是合理區間）
          </li>
          <li>・評估依據：實價登錄成交 + 同社區在售 + 屋況加減項</li>
          <li>・想看完整的行情評估：景泰會約一次 30 分鐘的免費通話 / 視訊</li>
          <li>・委託 vs 自售都可以聊、沒委託壓力</li>
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  // 靜態站讀不到 query string，所以在瀏覽器端依 ?type= / ?area= 切換
  (function () {
    var params = new URLSearchParams(location.search);
    var type = (params.get("type") || "").toLowerCase();
    var area = (params.get("area") || "").trim();
    var isSell = type === "sell";

    if (isSell) {
      // 切換所有 data-mode 區塊
      document.querySelectorAll("[data-mode]").forEach(function (el) {
        el.hidden = el.getAttribute("data-mode") !== "sell";
      });
      // 換 h1 / 副標
      var hero = document.querySelector("[data-contact-hero]");
      if (hero) {
        var h1 = hero.querySelector("h1");
        var p = hero.querySelector("p");
        if (h1) h1.textContent = hero.getAttribute("data-sell-title") || h1.textContent;
        if (p) p.textContent = hero.getAttribute("data-sell-desc") || p.textContent;
      }
      document.title = "賣房諮詢 | " + document.title.split(" | ").slice(1).join(" | ");
      return;
    }

    // 買方 / 一般模式：type=buy 預選「找房」
    if (type === "buy") {
      var intent = document.getElementById("cf-intent");
      if (intent) intent.value = "找房";
    }
    // area=北屯區 → 預勾區域偏好（找不到就略過）
    if (area) {
      // areas/[district].astro 帶的是 shortName（例「北屯」），checkbox 值是「北屯區」，兩種都試
      var safe = area.replace(/"/g, "");
      var box =
        document.querySelector('[data-area-checkbox][value="' + safe + '"]') ||
        document.querySelector('[data-area-checkbox][value="' + safe + '區"]');
      if (box) {
        box.checked = true;
        box.dispatchEvent(new Event("change", { bubbles: true }));
        var summary = document.querySelector("[data-area-summary]");
        if (summary) summary.textContent = "已選 1 個區域 ▾（點開修改）";
      }
    }
  })();
</script>
