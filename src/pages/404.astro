---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout
  title={`${t.notFound.title} | ${config.site.title}`}
  description="找不到頁面 — 試試首頁、在售物件、房市筆記、客戶工具，或直接 LINE 景泰問。"
  noindex={true}
>
  <Header />

  {/* 2026-11 極簡改版：大數字黑色粗字、選項收成淺灰膠囊、LINE 是唯一一顆藍色實心按鈕（長相在 ax-pages.css 的 .axp-404） */}
  <main
    id="main-content"
    class="app-layout axp flex flex-1 items-center justify-center py-16"
  >
    <div class="flex flex-col items-center justify-center max-w-md">
      <h1 class="axp-404">404</h1>
      <span aria-hidden="true" class="text-muted-foreground"> ¯\_(ツ)_/¯ </span>
      <p class="mt-4 text-center text-2xl font-semibold">{t.notFound.message}</p>

      <p class="text-muted-foreground mt-4 text-center text-[15px] leading-relaxed">
        這頁不存在了 — 可能被搬走或拼錯網址。試試這些：
      </p>
      <ul class="mt-6 flex w-full flex-wrap justify-center gap-2">
        <li>
          <a href="/" class="bg-muted text-foreground hover:bg-(--press) inline-flex min-h-11 items-center rounded-full px-5 text-sm no-underline transition-colors">
            🏠 首頁
          </a>
        </li>
        <li>
          <a href="/properties" class="bg-muted text-foreground hover:bg-(--press) inline-flex min-h-11 items-center rounded-full px-5 text-sm no-underline transition-colors">
            🏘️ 在售物件
          </a>
        </li>
        <li>
          <a href="/posts" class="bg-muted text-foreground hover:bg-(--press) inline-flex min-h-11 items-center rounded-full px-5 text-sm no-underline transition-colors">
            📝 房市筆記
          </a>
        </li>
        <li>
          <a href="/search" class="bg-muted text-foreground hover:bg-(--press) inline-flex min-h-11 items-center rounded-full px-5 text-sm no-underline transition-colors">
            🔍 搜尋
          </a>
        </li>
        <li>
          <a href="/faq" class="bg-muted text-foreground hover:bg-(--press) inline-flex min-h-11 items-center rounded-full px-5 text-sm no-underline transition-colors">
            ❓ 常見問題
          </a>
        </li>
        <li>
          <a href="/go/line?src=404" class="btn-line text-sm">
            💬 LINE 景泰
          </a>
        </li>
      </ul>

      <LinkButton
        href={getRelativeLocaleUrl(locale, "")}
        class="fl-link mt-6 min-h-11"
      >
        {t.notFound.goHome}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
