---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import ContactForm from "@/components/ContactForm.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";

const services = [
  {
    slug: "buy",
    emoji: "🏠",
    name: "買房諮詢",
    headline: "從預算評估到簽約點交全程協助",
    targetUsers: [
      "首購族（青安 3.0 資格 + 自備款不夠）",
      "換屋族（要先賣 + 同步找新家）",
      "投資族（看 NPV 不看感覺）",
      "外地買家（給預算我幫你過濾）",
    ],
    whatYouGet: [
      "客需訪談 → 過濾 30+ 物件 → 推薦 5-8 間",
      "陪看 + 出價評估（用同社區近 12 個月實價登錄）",
      "貸款規劃（青安 3.0 vs 一般、跑 2-3 家銀行比較）",
      "簽約 / 過戶 / 點交全程陪同",
      "履約保證 + 漏水保固條款協助",
    ],
    timeline: "從訪談到交屋 1-3 個月",
    cta: "找我看房",
  },
  {
    slug: "sell",
    emoji: "💰",
    name: "賣房協助",
    headline: "行情評估 + 多平台曝光 + 出價協調",
    targetUsers: [
      "急售族（時間敏感、要快速成交）",
      "換屋族（要先賣 + 同步買新）",
      "投資出場族（算稅後利潤）",
      "繼承族（不熟流程、要全程協助）",
    ],
    whatYouGet: [
      "定價分析（同社區近一年實價登錄 + 在售戶數，給合理區間）",
      "物件照統一調亮調正（不美化屋況，縮圖更容易被點開）",
      "591 / 樂屋 / 5168 多平台同步上架",
      "公司自媒體 BigKanBan 跨 IG / TT / FB 曝光",
      "出價協調 + 簽約全程協助",
    ],
    timeline: "從委託到成交 1-4 個月（依物件熱度）",
    cta: "找我賣房",
  },
  {
    slug: "invest",
    emoji: "📊",
    name: "投資諮詢",
    headline: "看數字不看感覺：投報、持有成本、稅費先算清楚",
    targetUsers: [
      "收租型（看租金投報率、管理費與空置成本）",
      "置產型（看持有成本與房地合一 2.0 稅費）",
      "資產配置族（房地產 vs 其他資產的現金流比較）",
      "公司戶（法人持有的貸款成數與稅費差異）",
    ],
    whatYouGet: [
      "區段行情整理（合泰建經月報 + 內政部實價登錄）",
      "租金行情 + 收益率試算",
      "房地合一 2.0 稅費試算（複雜案件轉介會計師）",
      "同區近 24 個月實價登錄走勢與在售存量整理",
      "投資物件條件篩選（嫌惡設施、產權、屋況）",
    ],
    timeline: "從評估到買入 2-6 週",
    cta: "找我談投資",
  },
  {
    slug: "upgrade",
    emoji: "🔄",
    name: "換屋升級",
    headline: "賣舊買新中間 3 個月不踩雷",
    targetUsers: [
      "首購升級（小換大、市區換郊區）",
      "三代同堂（要找符合家庭結構的物件）",
      "區位調整（從南屯換七期 / 北屯換西屯）",
      "退休換屋（要無障礙、低公設）",
    ],
    whatYouGet: [
      "舊屋行情評估 + 賣屋規劃",
      "新屋同步找 + 出價評估",
      "貸款橋接（避免雙重房貸壓力）",
      "時間軸協調（賣完才搬 vs 先住新家）",
      "自住換屋稅費試算（房地合一自住優惠 4 條件）",
    ],
    timeline: "從規劃到搬家 3-6 個月",
    cta: "找我談換屋",
  },
];

// Service schema for each service (Google rich result + OfferCatalog)
const siteOrigin = new URL("/", Astro.site).href;
const realEstateAgentId = `${siteOrigin}#realestateagent`;

const serviceSchemas = services.map(s => ({
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteOrigin}services#${s.slug}`,
  name: s.name,
  description: s.headline,
  serviceType: s.name,
  provider: { "@id": realEstateAgentId },
  areaServed: {
    "@type": "City",
    name: "台中市",
  },
  audience: {
    "@type": "PeopleAudience",
    suggestedAudience: s.targetUsers,
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `${s.name}服務內容`,
    itemListElement: s.whatYouGet.map((item, idx) => ({
      "@type": "Offer",
      position: idx + 1,
      itemOffered: {
        "@type": "Service",
        name: item,
      },
    })),
  },
}));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: siteOrigin,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "服務項目",
      item: new URL("/services", Astro.site).href,
    },
  ],
};
---

<Layout
  title={`服務項目 | ${config.site.title}`}
  description="台中買房、賣房、置產、換屋各要跑幾步、要多久：買 1-3 個月、賣 1-4 個月、換屋 3-6 個月，每一步做什麼一次列清。陳景泰 114登字488296。"
  canonicalURL={new URL("/services", Astro.site).href}
  ogImage="/og/page-services.jpg"
>
  <Fragment slot="head">
    {serviceSchemas.map(s => (
      <script
        type="application/ld+json"
        is:inline
        set:html={safeJsonLd(s)}
      />
    ))}
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(breadcrumbSchema)}
    />
  </Fragment>
  <Header />

  <Main
    pageTitle="服務項目"
    pageDesc="買、賣、投資、換屋 4 大方向。看你是哪一種、我給你對應流程跟工具。"
  >
    {/* 4 大服務 cards */}
    <div class="mt-8 space-y-8">
      {
        services.map(s => (
          <section
            id={s.slug}
            class="border-border bg-card rounded-lg border p-6 sm:p-8"
          >
            <header class="border-border border-b pb-4">
              <h2 class="text-foreground flex items-center gap-3 text-2xl font-bold sm:text-3xl">
                <span class="text-4xl">{s.emoji}</span>
                {s.name}
              </h2>
              <p class="text-accent mt-2 text-lg font-medium">{s.headline}</p>
            </header>

            <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <h3 class="text-foreground text-base font-bold">
                  🎯 適合誰找
                </h3>
                <ul class="text-muted-foreground mt-2 space-y-1 text-sm leading-relaxed">
                  {s.targetUsers.map(u => (
                    <li>・{u}</li>
                  ))}
                </ul>
              </div>

              <div>
                <h3 class="text-foreground text-base font-bold">
                  📋 我幫你做的事
                </h3>
                <ul class="text-muted-foreground mt-2 space-y-1 text-sm leading-relaxed">
                  {s.whatYouGet.map(w => (
                    <li>・{w}</li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="border-border mt-6 flex flex-wrap items-center justify-between gap-4 border-t pt-4">
              <p class="text-muted-foreground text-sm">
                ⏱️ {s.timeline}
              </p>
              <a
                href="/go/line?src=services"
                class="bg-accent text-accent-foreground rounded-lg px-4 py-2 text-sm font-medium no-underline"
              >
                💬 {s.cta}
              </a>
            </div>
          </section>
        ))
      }
    </div>

    {/* 底部說明 — 不確定屬於哪一類 */}
    <section
      class="border-border mt-12 rounded-lg border border-dashed p-6 text-center sm:p-8"
    >
      <p class="text-foreground text-[18px] font-medium">
        不確定自己屬於哪一類？
      </p>
      <p
        class="text-muted-foreground mt-3 text-[16px] leading-relaxed"
      >
        買賣房很多情況交叉 — 換屋族同時是買 + 賣、投資族可能要換屋。<br />
        說你的狀況、我直接幫你判斷對應流程。
      </p>
      <div
        class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row"
      >
        <a
          href="/go/line?src=services"
          class="bg-accent text-accent-foreground inline-block rounded-md px-6 py-3 text-[17px] font-medium no-underline"
        >
          💬 LINE 私訊
        </a>
        <a
          href="#contact-form-section"
          class="border-accent text-accent inline-block rounded-md border-2 px-6 py-3 text-[17px] font-medium no-underline"
        >
          📝 用表單聯絡 ↓
        </a>
      </div>
    </section>

    {/* 表單 — 給不愛 LINE / 長輩 / 企業戶 */}
    <div id="contact-form-section">
      <ContactForm
        title="留你的聯絡方式、我回你"
        subtitle="不愛即時通、不想加 LINE 的話 — 用這條最舒服。Email 收件、30 分鐘內回。"
      />
    </div>
  </Main>

  <Footer />
</Layout>
