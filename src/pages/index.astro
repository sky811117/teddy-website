  /* 首頁第一眼（2026-11 極簡改版）：
     1 「用條件篩選」點了才展開（aria-expanded／.open）；沒有 JavaScript 時 ax-home.css 的 @media (scripting: none) 直接顯示。
     2 例句和「找房小幫手是自動化工具…」平常收著，第一次點到輸入框才滑出來，之後就留著。
     3 打字時在輸入框下面讀出條件：用站上現成的 /js/need-extract.js，點到輸入框才載入，不拖慢開站。
     4 輸入框是空的、沒被點到時，例句自己一個字一個字打出來（減少動態、.lite 時不跑）。
     5 「告訴小幫手」把那句話交給 /find/：放在同分頁的暫存（sessionStorage），不放網址、不經過伺服器；暫存不能用時退成網址片段（#q=）。 */
  (function () {
    var d = document, root = d.documentElement;
    var hero = d.getElementById("hero"), ta = d.getElementById("hero-say"), reads = d.querySelector("[data-reads]");
    var calm = (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) || root.classList.contains("lite");

    /* 1 */
    var fbtn = d.getElementById("tab-filter"), fpanel = d.getElementById("panel-filter");
    if (fbtn && fpanel) fbtn.addEventListener("click", function () {
      var on = !fpanel.classList.contains("open");
      fpanel.classList.toggle("open", on);
      fbtn.setAttribute("aria-expanded", on ? "true" : "false");
    });

    if (!ta) return;

    /* 3 */
    var NE = null, asked = false, fails = 0;
    var PARK = { flat: "平面車位", ramp_flat: "坡道平面車位", mechanical: "機械車位", any: "要車位", none: "不用車位" };
    var TYPE = { elevator_building: "電梯大樓", mid_rise: "華廈", apartment: "公寓", townhouse: "透天", studio: "套房" };
    var num = function (v) { return Number(v).toLocaleString("en-US"); };
    var chips = function (f) {
      var a = [], hi = f.price_max_wan, lo = f.price_min_wan;
      (f.districts || []).forEach(function (x) { a.push(x); });
      (f.types || []).forEach(function (k) { if (TYPE[k]) a.push(TYPE[k]); });
      if (f.rooms_min) a.push(f.rooms_min + " 房" + (f.rooms_max && f.rooms_max > f.rooms_min ? "以上" : ""));
      if (hi && lo) a.push(num(lo) + "–" + num(hi) + " 萬");
      else if (hi) a.push(num(hi) + " 萬內");
      else if (lo) a.push(num(lo) + " 萬以上");
      if (f.parking && PARK[f.parking]) a.push(PARK[f.parking]);
      if (f.age_max != null) a.push("屋齡 " + f.age_max + " 年內");
      if (f.area_min != null) a.push(f.area_min + " 坪以上");
      return a;
    };
    var run = function () {
      ta.style.height = "26px";
      if (ta.value) ta.style.height = Math.min(78, ta.scrollHeight) + "px";
      if (!NE || !reads) return;
      var v = ta.value.trim(), list = [];
      try { list = v ? chips(NE.extract(v).fields || {}) : []; } catch (e) { list = []; }
      [].slice.call(reads.children).forEach(function (c) {
        var i = list.indexOf(c.textContent);
        if (i < 0) reads.removeChild(c); else list.splice(i, 1);
      });
      list.forEach(function (t, i) {
        var c = d.createElement("span");
        c.className = "rd"; c.textContent = t; c.style.animationDelay = (i * 70) + "ms";
        reads.appendChild(c);
      });
      var on = reads.children.length > 0;
      reads.style.setProperty("--h", (on ? reads.scrollHeight : 0) + "px");
      reads.classList.toggle("on", on);
    };
    var load = function () {
      if (asked) return; asked = true;
      var s = d.createElement("script"), v = ta.getAttribute("data-ne");
      s.src = "/js/need-extract.js" + (v ? "?v=" + v : "");   // 跟找房頁同一個網址（同一個版本號）：換版時一起換，從首頁進找房頁也不用再下載一次
      s.onload = function () { NE = window.NeedExtract; run(); d.dispatchEvent(new CustomEvent("ne:ready")); };
      // 沒載到（換網路、斷線一下）：隔 4 秒、8 秒自己再試，最多兩次；這段時間客人點輸入框或打字也會馬上重試
      s.onerror = function () {
        if (s.parentNode) s.parentNode.removeChild(s);
        if (++fails <= 2) { asked = false; setTimeout(load, 4000 * fails); }
      };
      d.head.appendChild(s);
    };
    /* 首頁地圖（/js/home-map.js）也要用這支讀條件：它閒下來時發 ne:want 請這裡載入，載好後由上面那行發 ne:ready 通知它；同一支只載一次 */
    d.addEventListener("ne:want", load);

    /* 2 */
    var wake = function () { if (hero) hero.classList.add("on"); load(); };
    ta.addEventListener("focus", wake);
    ta.addEventListener("input", function () { wake(); run(); });
    var tries = d.querySelector(".ax-home .tries");
    if (tries) tries.addEventListener("click", function (e) {
      var f = e.target.closest ? e.target.closest("[data-fill]") : null;
      if (f) { ta.value = f.getAttribute("data-fill"); wake(); run(); ta.focus(); }
    });

    /* 4 */
    var exs = [];
    try { exs = JSON.parse(ta.getAttribute("data-ex") || "[]"); } catch (e) { exs = []; }
    if (exs.length > 1 && !calm) {
      var ei = -1, ci = ta.placeholder.length, dir = -1, cur = ta.placeholder, tm = null, seen = true;
      var idle = function () { return !ta.value && d.activeElement !== ta && seen && !d.hidden; };
      var tick = function () {
        tm = null;
        if (!idle()) return;
        var wait;
        ci += dir;
        ta.placeholder = cur.slice(0, Math.max(0, ci));
        if (dir > 0 && ci >= cur.length) { dir = -1; wait = 2400; }
        else if (dir < 0 && ci <= 0) { dir = 1; ei = (ei + 1) % exs.length; cur = exs[ei]; wait = 420; }
        else wait = dir > 0 ? 75 : 26;
        tm = setTimeout(tick, wait);
      };
      var kick = function (ms) { if (!tm && idle()) tm = setTimeout(tick, ms || 700); };
      ta.addEventListener("focus", function () { clearTimeout(tm); tm = null; ta.placeholder = cur; ci = cur.length; dir = -1; });
      ta.addEventListener("blur", function () { kick(1200); });
      d.addEventListener("visibilitychange", function () { kick(); });
      if ("IntersectionObserver" in window) new IntersectionObserver(function (es) { seen = es[0].isIntersecting; kick(); }).observe(ta);
      kick(3200);
    }

    /* 5 */
    var form = d.getElementById("say-form");
    if (form) form.addEventListener("submit", function (e) {
      e.preventDefault();
      var text = (ta.value || "").trim().slice(0, 300);
      var url = "/find/?from=home";
      var kept = false;
      if (text) { try { sessionStorage.setItem("find.say", text); kept = true; } catch (err) { kept = false; } }
      if (text && !kept) url += "#q=" + encodeURIComponent(text);
      location.href = url;
    });
  })();
</script>

{/* 首頁地圖的程式：只有地圖版（HOME_MAP）才載入。defer＝不擋畫面，等上面兩段行內程式跑完才執行；資料網址從 #home-map 的 data- 屬性讀 */}
{hm && <script is:inline defer src={`/js/home-map.js?v=${jsVer}`}></script>}
