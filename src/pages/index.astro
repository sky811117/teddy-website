---
/**
 * 首頁：ui2 設計系統版。URL、title、H1 文字、JSON-LD（homePageSchema／navSchema）、canonical、內部連結、
 * id="hero"、data-track／data-property-* 一律不變（改版前後用 scripts/seo-diff.mjs 逐項比對）。
 * 新增：找房卡（白話找＋原本的條件篩選）、「你決定每一步要不要走」四步。區塊順序依 10 號設計文件。
 */
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header2 from "@/components/ui2/Header2.astro";
import Footer2 from "@/components/ui2/Footer2.astro";
import Sprite from "@/components/ui2/Sprite.astro";
import Testimonials from "@/components/Testimonials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { safeJsonLd } from "@/utils/safeJsonLd";
import { isTaichung } from "@/utils/isTaichung";
import { cleanPropertyTitle } from "@/utils/cleanPropertyTitle";
import { areaIncludesParking, bodyPropertyType } from "@/utils/parkingCaliber";
import { COVER_CARD_SIZES, coverSrcOf, coverSrcset, coverThumb } from "@/utils/coverThumb";
import config from "@/config";
import { areas } from "@/data/areas";
import { YT_CHANNEL_URL, YT_HANDLE } from "@/astro-paper.config";
import { Image } from "astro:assets";
import ycLogo from "@/assets/logos/yochaoshi.png";
import "@/styles/ui2-core.css";
import "@/styles/ui2-home.css";

const locale = Astro.currentLocale ?? config.site.lang;

// 首頁房市筆記 section：1 篇 featured + 1 篇最新社區評測 + 1 篇最新（三篇不重複）
// 不再只靠 featured：featured 幾乎全是青安題，社區評測是 GSC 證實有排名的頁型，首頁要給它入口
const posts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const pickedIds = new Set<string>();
const pickPost = (pred: (p: (typeof sortedPosts)[number]) => boolean) => {
  const hit = sortedPosts.find(p => !pickedIds.has(p.id) && pred(p));
  if (hit) pickedIds.add(hit.id);
  return hit;
};
const recentPosts = [
  pickPost(p => Boolean(p.data.featured)),
  pickPost(p => (p.data.tags ?? []).includes("community-review")),
  pickPost(() => true),
].filter((p): p is (typeof sortedPosts)[number] => Boolean(p));

// 在售精選 3 筆（空 collection 時不顯示）
const allProperties = await getCollection(
  "properties",
  ({ data }) => data.status === "active"
).catch(() => []);
// 台中在售（信任條數字用這個，不把彰化 / 南投的物件算進「台中房仲」的門面數字）
const taichungProperties = allProperties.filter(p => isTaichung(p.data.district));
const taichungDistrictCount = new Set(taichungProperties.map(p => p.data.district)).size;

// 在售精選：只放台中純住宅（排除土地 / 店面 / 廠房 / 商辦 / 農地，跟 8-23 上架資格口徑一致）
// 有封面照優先（首頁門面不能擺 placeholder）> 最新
const NON_RESIDENTIAL_RE = /土地|建地|農地|林地|店面|廠房|商辦|辦公|停車塔|車位$/;
const featuredProperties = taichungProperties
  .filter(p => !NON_RESIDENTIAL_RE.test(`${cleanPropertyTitle(p.data.title)} ${p.data.layout ?? ""}`))
  .sort(
    (a, b) =>
      Number(Boolean(b.data.coverImage)) - Number(Boolean(a.data.coverImage)) ||
      b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
  )
  .slice(0, 3);

// ===== 客戶見證（Phase 3 預留）=====
// 目前傳空陣列 → Testimonials 元件不渲染。
// 之後有真實見證，照下面範例格式填入就會自動顯示：
// ⚠️ 必須是「真實客戶 + 取得刊登授權」，不可虛構、不可改寫客戶原話語意。
// const testimonials = [
//   {
//     name: "王太太",            // 姓氏 + 稱謂即可，不公開全名
//     role: "北屯首購夫妻",       // 身分標籤
//     quote: "（客戶授權的原話）", // 見證引文
//     dealType: "買方成交",       // 成交類型
//   },
// ];
const testimonials: {
  name: string;
  role: string;
  quote: string;
  dealType: string;
}[] = [];

const personalAccounts = [
  {
    platform: "Instagram",
    handle: "@nov__817",
    desc: "主帳號 · 房仲日常",
    url: "https://www.instagram.com/nov__817/",
    icon: "i-ig",
  },
  {
    platform: "Facebook",
    handle: "泰迪 房仲大看板",
    desc: "日常 + 業務分享",
    url: "https://www.facebook.com/profile.php?id=61575492127872",
    icon: "i-user",
  },
  {
    platform: "YouTube",
    handle: YT_HANDLE,
    desc: "房屋開箱 + 看屋",
    url: YT_CHANNEL_URL,
    icon: "i-play",
  },
  {
    platform: "TikTok",
    handle: "@sky811117",
    desc: "短影音 + 快剪",
    url: "https://www.tiktok.com/@sky811117",
    icon: "i-play",
  },
  {
    platform: "LINE",
    handle: "sky811117",
    desc: "私訊（30 秒-30 分回）",
    url: "/go/line?src=home-social",
    icon: "i-chat",
  },
];

// 首頁 WebPage + SiteNavigationElement schema
const siteOrigin = new URL("/", Astro.site).href;
const homePageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteOrigin}#webpage`,
  url: siteOrigin,
  name: config.site.title,
  description: config.site.description,
  isPartOf: { "@id": `${siteOrigin}#website` },
  about: { "@id": `${siteOrigin}#realestateagent` },
  inLanguage: "zh-TW",
  significantLink: [
    `${siteOrigin}properties/`,
    `${siteOrigin}posts/`,
    `${siteOrigin}faq/`,
    `${siteOrigin}services/`,
    `${siteOrigin}tools/`,
    `${siteOrigin}areas/`,
    `${siteOrigin}contact/`,
    `${siteOrigin}about/`,
  ],
};

// SiteNavigationElement — 給 Google 認得主導航結構，可能進 sitelinks
const navSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  name: "主導航",
  hasPart: [
    { "@type": "WebPage", name: "在售物件", url: `${siteOrigin}properties/` },
    { "@type": "WebPage", name: "房市筆記", url: `${siteOrigin}posts/` },
    { "@type": "WebPage", name: "客戶工具", url: `${siteOrigin}tools/` },
    { "@type": "WebPage", name: "常見問題", url: `${siteOrigin}faq/` },
    { "@type": "WebPage", name: "台中各區", url: `${siteOrigin}areas/` },
    { "@type": "WebPage", name: "服務項目", url: `${siteOrigin}services/` },
    { "@type": "WebPage", name: "找景泰", url: `${siteOrigin}media/` },
    { "@type": "WebPage", name: "關於景泰", url: `${siteOrigin}about/` },
    { "@type": "WebPage", name: "聯絡景泰", url: `${siteOrigin}contact/` },
  ],
};

const bigKanBanAccounts = [
  {
    platform: "Instagram",
    handle: "@bigkanban",
    desc: "主帳號 · 11K 粉絲",
    url: "https://instagram.com/bigkanban",
    icon: "i-ig",
  },
  {
    platform: "Instagram",
    handle: "@bigkanban.boss",
    desc: "BOSS 本尊個人帳",
    url: "https://instagram.com/bigkanban.boss",
    icon: "i-ig",
  },
  {
    platform: "TikTok",
    handle: "@bigkanban2.0",
    desc: "房屋開箱短影音",
    url: "https://www.tiktok.com/@bigkanban2.0",
    icon: "i-play",
  },
  {
    platform: "Facebook",
    handle: "BigKanBan 粉專",
    desc: "深度長文+物件",
    url: "https://www.facebook.com/bigkanban",
    icon: "i-user",
  },
];
---

<Layout title="陳景泰（泰迪）｜台中房仲・有巢氏房屋台中世界之心加盟店">
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(homePageSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(navSchema)}
    />
  </Fragment>

  <Sprite />
  <Header2 />

  <main id="main-content" class="ui2">
    {/* ============ 1 開場：一張「找房卡」＋居家情境圖（#hero 保留：FloatingCTA 依賴這個 id） ============ */}
    <section id="hero" class="u2-hero">
      <div class="u2-wrap u2-hero__grid">
        <div class="u2-hero__text">
          <p class="u2-hero__who">
            <span class="u2-hero__mini"><img src="/photos/teddy-avatar.jpg" alt="" width="44" height="54" loading="eager" decoding="async" /></span>
            <span>陳景泰 / 泰迪 Teddy</span>
          </p>

          <h1 class="u2-display"><span class="u2-h1__pre">在台中買房 / 賣房，</span>{" "}<span class="u2-h1__main">用 AI 找到對的答案</span></h1>

          <p class="u2-lead">
            同社區近一年成交、在售戶數、貸款月付、稅費 — 帶看前先整理成一頁給你，看完數字再決定。
            我是<strong>陳景泰</strong>，一品不動產 有巢氏房屋台中世界之心加盟店房仲，短影音上叫<strong>泰迪</strong>。
          </p>

          {/* 找房卡：同一張卡兩種找法。預設「白話找」；原本的下拉篩選與 data-hero-* 腳本原樣保留 */}
          <div class="u2-ask" id="ask">
            <div class="u2-ask__tabs" role="tablist" aria-label="找房方式" data-js-only>
              <button type="button" role="tab" id="tab-say" aria-selected="true" aria-controls="panel-say">白話找</button>
              <button type="button" role="tab" id="tab-filter" aria-selected="false" aria-controls="panel-filter" tabindex="-1">用條件篩選</button>
            </div>

            <div role="tabpanel" id="panel-say" aria-labelledby="tab-say">
              <form id="say-form" action="/find/" method="get">
                <label class="u2-label" for="hero-say">你想找什麼樣的房子？一句話就好。</label>
                <textarea id="hero-say" class="u2-textarea" rows="2" maxlength="300" placeholder="例：北屯三房，兩千萬內，要有車位"></textarea>
                <div class="u2-ask__go">
                  <button class="u2-btn u2-btn--primary" type="submit">
                    <svg class="u2-ico" aria-hidden="true"><use href="#i-send"></use></svg>告訴小幫手
                  </button>
                  <span class="u2-cap">找房小幫手是自動化工具，只幫你整理。要不要聊，由你決定。</span>
                </div>
              </form>
              <div class="u2-hot" role="group" aria-label="試試看">
                <button class="u2-tag u2-tag--btn" type="button" data-fill="北屯三房，兩千萬內，要平面車位">北屯三房，兩千萬內</button>
                <button class="u2-tag u2-tag--btn" type="button" data-fill="西屯 電梯大樓 1500萬以下">西屯電梯大樓，1500 萬以下</button>
              </div>
            </div>

            <div role="tabpanel" id="panel-filter" aria-labelledby="tab-filter" data-filter-panel>
              <div class="u2-ask__grid">
                <label class="u2-sr" for="hero-district">區域</label>
                <select id="hero-district" data-hero-district class="u2-select">
                  <option value="">區域（不限）</option>
                  <option value="北屯區">北屯區</option>
                  <option value="西屯區">西屯區</option>
                  <option value="南屯區">南屯區</option>
                  <option value="北區">北區</option>
                  <option value="南區">南區</option>
                  <option value="東區">東區</option>
                  <option value="西區">西區</option>
                  <option value="中區">中區</option>
                  <option value="太平區">太平區</option>
                  <option value="大里區">大里區</option>
                  <option value="霧峰區">霧峰區</option>
                </select>
                <label class="u2-sr" for="hero-price-max">總價上限</label>
                <input
                  id="hero-price-max"
                  type="number"
                  inputmode="numeric"
                  min="0"
                  step="100"
                  placeholder="總價上限（萬）"
                  data-hero-price-max
                  class="u2-input"
                />
                <label class="u2-sr" for="hero-rooms">房型</label>
                <select id="hero-rooms" data-hero-rooms class="u2-select">
                  <option value="">房型（不限）</option>
                  <option value="1房">1 房</option>
                  <option value="2房">2 房</option>
                  <option value="3房">3 房</option>
                  <option value="4房">4 房</option>
                  <option value="5房+">5 房以上</option>
                </select>
              </div>
              <button type="button" data-hero-search class="u2-btn u2-btn--primary">
                <svg class="u2-ico" aria-hidden="true"><use href="#i-search"></use></svg>搜尋
              </button>
              <div class="u2-hot">
                <span class="u2-small u2-hot__lead">熱門：</span>
                <a href="/properties/?priceMax=1000">青安額度內（≤1000 萬）</a>
                <a href="/properties/north-tun/">北屯</a>
                <a href="/properties/west-tun/">西屯 / 七期</a>
                <a href="/properties/south-tun/">南屯</a>
                <a href="/properties/?quick=new">新上架</a>
                <a href="/properties/?quick=drop">降價中</a>
                <a href="/properties/?ageMax=5">新成屋（≤5 年）</a>
              </div>
            </div>
          </div>

          <div class="u2-hero__aux">
            <a class="u2-btn u2-btn--ghost" href="/sell/#sell-form-section">我要賣房（免費行情評估）</a>
            <a class="u2-btn u2-btn--text" href="/go/line?src=home-hero-text">或 LINE 先聊聊 →</a>
            <a class="u2-btn u2-btn--text" href="/contact/">或填表單留資料 →</a>
          </div>
          {/* 顯式電話 CTA — Layout 設了 format-detection telephone=no，手機要靠這條才撥得通 */}
          <p class="u2-small u2-hero__tel-row">
            急約看屋、想直接講？
            <a class="u2-hero__tel" href="tel:+886920118756" data-track="cta" data-cta="hero-tel">
              <svg class="u2-ico" aria-hidden="true"><use href="#i-phone"></use></svg>0920-118-756
            </a>
            直撥本人
          </p>
        </div>

        {/* 桌機才有：門洞居家情境圖＋小幫手對話預覽。手機只放 44px 小門洞頭像，不下載大圖（img 用 1×1 透明圖，<source> 只在 ≥1024px 啟用）。
            2026-10-07 景泰：首頁大圖原本是本人大頭照，客人不想一進來看到房仲的臉 → 改 AI 生成的北歐風客廳＋窗外台中市景；本人照片只留在作者小框／關於我。
            圖是 AI 生成（scripts/gen_image.py，檔案帶 XMP AI 標記），畫面上要標「示意圖」，alt 不能寫成任何實際物件或社區。 */}
        <div class="u2-hero__visual">
          <figure class="u2-arch">
            <picture>
              <source
                media="(min-width:1024px)"
                srcset="/photos/ui2/home-hero-440.webp 440w, /photos/ui2/home-hero-880.webp 880w"
                sizes="26rem"
                type="image/webp"
              />
              <img
                src="data:image/gif;base64,R0lGODlhAQABAAAAACw="
                alt="明亮的北歐風客廳，窗外是台中市景與山景（AI 生成示意圖，非實際物件）"
                width="1024"
                height="1280"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
            <figcaption class="u2-arch__tag">示意圖</figcaption>
          </figure>
          <div class="u2-hero__chat" aria-hidden="true">
            <div class="u2-msg u2-msg--me"><div class="u2-bubble"><p>北屯三房，兩千萬內</p></div></div>
            <div class="u2-msg u2-msg--bot">
              <span class="u2-avatar"><svg class="u2-ico"><use href="#u2-house"></use></svg></span>
              <div class="u2-bubble"><p>整理好了，這是依你的條件挑出的 7 間。</p></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* ============ 2 帳本列＋證號（內容一字不動） ============ */}
    <section aria-label="信任資訊">
      <div class="u2-wrap">
        <div class="u2-ledger">
          <div><b>{taichungProperties.length}+</b><span>筆台中在售物件</span></div>
          <div><b>{taichungDistrictCount} 區</b><span>台中行政區有在售物件</span></div>
          <div><b>30秒-30分</b><span>LINE 回覆</span></div>
          <div><b>有巢氏</b><span>世界之心加盟店</span></div>
        </div>
        <div class="u2-certs">
          <span class="u2-small">所屬公司</span>
          <span class="u2-brandtag">
            <Image
              src={ycLogo}
              alt="有巢氏房屋 台中世界之心加盟店"
              width={155}
              widths={[155, 310, 465]}
              sizes="(min-width: 640px) 155px, 129px"
              format="webp"
              loading="lazy"
              decoding="async"
              style="display:block;height:2.4rem;width:auto"
            />
          </span>
          <p class="u2-small u2-certs__text">
            一品不動產 ・ 經紀人 黃永隆 113彰縣字324 ・ 營業員 陳景泰
            114登字488296
          </p>
        </div>
      </div>
    </section>

    {/* ============ 3 怎麼找（新）：內容真的是一個順序，所以才編號 ============ */}
    <section class="u2-band" aria-labelledby="h-steps">
      <div class="u2-wrap">
        <div class="u2-sec-head"><h2 class="u2-h2" id="h-steps">你決定每一步要不要走</h2></div>
        <ol class="u2-dim">
          <li><h3>說一句話</h3><p>打一句你想找的房子，或用選的。不用留電話。</p></li>
          <li><h3>看整理好的一頁</h3><p>小幫手挑出幾間，做成一頁給你看。</p></li>
          <li><h3>告訴景泰想看哪一間</h3><p>用 LINE 或電話問。景泰會先確認現況，再回你。</p></li>
          <li><h3>約時間看屋</h3><p>要不要看、什麼時候看，由你決定。</p></li>
        </ol>
      </div>
    </section>

    {/* ============ 4 為什麼找景泰（文字一字不動；版面改成一個主張＋兩個輔助） ============ */}
    <section class="u2-band u2-band--sunken" aria-labelledby="h-usp">
      <div class="u2-wrap">
        <div class="u2-sec-head"><h2 class="u2-h2" id="h-usp">為什麼找景泰</h2></div>
        <div class="u2-usp">
          <article class="u2-usp__lead">
            <h3 class="u2-h3">AI 工具加持</h3>
            <p class="u2-lead">
              我一邊跑業務，一邊用 Claude Code 把 591、樂屋、5168
              三大平台的上架、排版、回訊自動化。同樣 24
              小時，你的物件能被更多買家看到、你的問題能更快得到回覆。
            </p>
          </article>
          <article>
            <h3 class="u2-h3">公司自媒體後盾</h3>
            <p class="u2-body">
              公司經營「<a href="/media" class="u2-link">房仲大看板 BigKanBan</a>」自媒體 IP，IG 主帳 11K 粉、跨 IG / TikTok / FB 4 個帳號 — 你的物件曝光不只一個房仲，是一整個團隊。
            </p>
          </article>
          <article class="u2-usp__photo">
            <h3 class="u2-h3">台中全區覆蓋</h3>
            <p class="u2-body">
              北屯、西屯、南屯、七期、中區、太平、大里 — 整個台中我都跑。不是只熟一區的房仲，是真的能幫你跨區比較的選擇。
            </p>
            <img src="/photos/ui2/aerial-900.webp" alt="台中七期天際線與秋紅谷空拍" width="900" height="506" loading="lazy" decoding="async" />
          </article>
        </div>
      </div>
    </section>

    {/* ============ 5 你是要買，還是要賣？（深色節奏帶；文字一字不動） ============ */}
    <section class="u2-band u2-band--inverse" aria-labelledby="h-split">
      <div class="u2-wrap">
        <div class="u2-sec-head"><h2 class="u2-h2" id="h-split">你是要買，還是要賣？</h2></div>
        <div class="u2-split">
          <div>
            <h3>我要找房</h3>
            <p>台中買房太多眉角，我用工具幫你省力：</p>
            <ul class="u2-checks">
