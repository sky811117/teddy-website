<script is:inline>
  (function () {
    const btn = document.querySelector("[data-hero-search]");
    if (!btn) return;
    function go() {
      const district =
        document.querySelector("[data-hero-district]")?.value || "";
      const priceMax =
        document.querySelector("[data-hero-price-max]")?.value || "";
      const rooms = document.querySelector("[data-hero-rooms]")?.value || "";
      const params = new URLSearchParams();
      if (district) params.set("district", district);
      if (priceMax) params.set("priceMax", priceMax);
      if (rooms) params.set("rooms", rooms);
      const qs = params.toString();
      location.href = "/properties/" + (qs ? "?" + qs : "");
    }
    btn.addEventListener("click", go);
    // Enter 鍵在 input 內也觸發
    document
      .querySelector("[data-hero-price-max]")
      ?.addEventListener("keydown", e => {
        if (e.key === "Enter") {
          e.preventDefault();
          go();
        }
      });
  })();
</script>

<script is:inline>
  /* 找房卡：分頁（左右鍵、Home、End；沒選中的分頁 tabindex=-1）＋「告訴小幫手」把那句話交給 /find/。
     那句話放在同分頁的暫存（sessionStorage），不放在網址、不經過任何伺服器；暫存不能用時退成網址片段（#q=，同樣不會送到伺服器）。
     沒有 JavaScript 時：兩個面板都顯示，表單直接導到 /find/。 */
  (function () {
    var tabs = [].slice.call(document.querySelectorAll(".u2-ask [role=tab]"));
    if (!tabs.length) return;
    var tl = document.querySelector(".u2-ask__tabs");
    if (tl) tl.removeAttribute("data-js-only");   // 沒有 JavaScript 時分頁按鈕按了沒反應，所以預設藏起來（兩個面板都顯示）
    var fp = document.getElementById("panel-filter");
    if (fp) fp.hidden = true;
    function pick(i, focus) {
      tabs.forEach(function (t, j) {
        var on = i === j;
        t.setAttribute("aria-selected", on ? "true" : "false");
        t.tabIndex = on ? 0 : -1;
        var p = document.getElementById(t.getAttribute("aria-controls"));
        if (p) p.hidden = !on;
      });
      if (focus) tabs[i].focus();
    }
    tabs.forEach(function (t, i) {
      t.addEventListener("click", function () { pick(i, false); });
      t.addEventListener("keydown", function (e) {
        var n = { ArrowRight: (i + 1) % tabs.length, ArrowLeft: (i + tabs.length - 1) % tabs.length, Home: 0, End: tabs.length - 1 }[e.key];
        if (n !== undefined) { e.preventDefault(); pick(n, true); }
      });
    });
    var hot = document.querySelector("#panel-say .u2-hot");
    if (hot) hot.addEventListener("click", function (e) {
      var f = e.target.closest ? e.target.closest("[data-fill]") : null;
      if (f) { var ta = document.getElementById("hero-say"); ta.value = f.getAttribute("data-fill"); ta.focus(); }
    });
    var form = document.getElementById("say-form");
    if (form) form.addEventListener("submit", function (e) {
      e.preventDefault();
      var text = (document.getElementById("hero-say").value || "").trim().slice(0, 300);
      var url = "/find/?from=home";
      var kept = false;
      if (text) { try { sessionStorage.setItem("find.say", text); kept = true; } catch (err) { kept = false; } }
      if (text && !kept) url += "#q=" + encodeURIComponent(text);
      location.href = url;
    });
  })();
</script>
