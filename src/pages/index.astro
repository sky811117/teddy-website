---
/**
 * 首頁：ui2 設計系統版。URL、title、H1 文字、JSON-LD（homePageSchema／navSchema）、canonical、內部連結、
 * id="hero"、data-track／data-property-* 一律不變（改版前後用 scripts/seo-diff.mjs 逐項比對）。
 * 新增：找房卡（白話找＋原本的條件篩選）、「你決定每一步要不要走」四步。區塊順序依 10 號設計文件。
 */
import fs from "node:fs";
import path from "node:path";
import crypto from "node:crypto";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header2 from "@/components/ui2/Header2.astro";
import Footer2 from "@/components/ui2/Footer2.astro";
import Sprite from "@/components/ui2/Sprite.astro";
import Testimonials from "@/components/Testimonials.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { safeJsonLd } from "@/utils/safeJsonLd";
import { isTaichung } from "@/utils/isTaichung";
import { cleanPropertyTitle } from "@/utils/cleanPropertyTitle";
import { areaIncludesParking, bodyPropertyType } from "@/utils/parkingCaliber";
import { coverSrcOf, coverSrcset, coverThumb } from "@/utils/coverThumb";
import { getHomeMapData } from "@/utils/homeMapData";
import config from "@/config";
import { areas } from "@/data/areas";
import { YT_CHANNEL_URL, YT_HANDLE } from "@/astro-paper.config";
import { Image } from "astro:assets";
import ycLogo from "@/assets/logos/yochaoshi.png";
// 2026-11 極簡改版（景泰 11/12 定案，參考 Apple 台灣官網）：首頁吃 ax.css（共用元件）＋ax-home.css（首頁專用）。
// ui2-core.css／ui2-home.css 只剩 /find/ 用（有測試釘住，不動）；花店版的 flora-home.css 不再匯入。
import "@/styles/ax.css";
import "@/styles/ax-home.css";
// 首頁第一眼的在售地圖（下面的 HOME_MAP）專用樣式；關掉地圖時這些規則用不到
import "@/styles/home-map.css";

const locale = Astro.currentLocale ?? config.site.lang;

// 首頁房市筆記 section：1 篇 featured + 1 篇最新社區評測 + 1 篇最新（三篇不重複）
// 不再只靠 featured：featured 幾乎全是青安題，社區評測是 GSC 證實有排名的頁型，首頁要給它入口
const posts = await getCollection("posts", ({ data }) => !data.draft);
const sortedPosts = getSortedPosts(posts);
const pickedIds = new Set<string>();
const pickPost = (pred: (p: (typeof sortedPosts)[number]) => boolean) => {
  const hit = sortedPosts.find(p => !pickedIds.has(p.id) && pred(p));
  if (hit) pickedIds.add(hit.id);
  return hit;
};
const recentPosts = [
  pickPost(p => Boolean(p.data.featured)),
  pickPost(p => (p.data.tags ?? []).includes("community-review")),
  pickPost(() => true),
].filter((p): p is (typeof sortedPosts)[number] => Boolean(p));

// 在售精選 3 筆（空 collection 時不顯示）
const allProperties = await getCollection(
  "properties",
  ({ data }) => data.status === "active"
).catch(() => []);
// 台中在售（信任條數字用這個，不把彰化 / 南投的物件算進「台中房仲」的門面數字）
const taichungProperties = allProperties.filter(p => isTaichung(p.data.district));
const taichungDistrictCount = new Set(taichungProperties.map(p => p.data.district)).size;

// 在售精選：只放台中純住宅（排除土地 / 店面 / 廠房 / 商辦 / 農地，跟 8-23 上架資格口徑一致）
// 有封面照優先（首頁門面不能擺 placeholder）> 最新
const NON_RESIDENTIAL_RE = /土地|建地|農地|林地|店面|廠房|商辦|辦公|停車塔|車位$/;
const featuredProperties = taichungProperties
  .filter(p => !NON_RESIDENTIAL_RE.test(`${cleanPropertyTitle(p.data.title)} ${p.data.layout ?? ""}`))
  .sort(
    (a, b) =>
      Number(Boolean(b.data.coverImage)) - Number(Boolean(a.data.coverImage)) ||
      b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
  )
  .slice(0, 3);

// ===== 客戶見證（Phase 3 預留）=====
// 目前傳空陣列 → Testimonials 元件不渲染。
// 之後有真實見證，照下面範例格式填入就會自動顯示：
// ⚠️ 必須是「真實客戶 + 取得刊登授權」，不可虛構、不可改寫客戶原話語意。
// const testimonials = [
//   {
//     name: "王太太",            // 姓氏 + 稱謂即可，不公開全名
//     role: "北屯首購夫妻",       // 身分標籤
//     quote: "（客戶授權的原話）", // 見證引文
//     dealType: "買方成交",       // 成交類型
//   },
// ];
const testimonials: {
  name: string;
  role: string;
  quote: string;
  dealType: string;
}[] = [];

const personalAccounts = [
  {
    platform: "Instagram",
    handle: "@nov__817",
    desc: "主帳號 · 房仲日常",
    url: "https://www.instagram.com/nov__817/",
    icon: "i-ig",
  },
  {
    platform: "Facebook",
    handle: "泰迪 房仲大看板",
    desc: "日常 + 業務分享",
    url: "https://www.facebook.com/profile.php?id=61575492127872",
    icon: "i-user",
  },
  {
    platform: "YouTube",
    handle: YT_HANDLE,
    desc: "房屋開箱 + 看屋",
    url: YT_CHANNEL_URL,
    icon: "i-play",
  },
  {
    platform: "TikTok",
    handle: "@sky811117",
    desc: "短影音 + 快剪",
    url: "https://www.tiktok.com/@sky811117",
    icon: "i-play",
  },
  {
    platform: "LINE",
    handle: "sky811117",
    desc: "私訊（30 秒-30 分回）",
    url: "/go/line?src=home-social",
    icon: "i-chat",
  },
];

// 首頁 WebPage + SiteNavigationElement schema
const siteOrigin = new URL("/", Astro.site).href;
const homePageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteOrigin}#webpage`,
  url: siteOrigin,
  name: config.site.title,
  description: config.site.description,
  isPartOf: { "@id": `${siteOrigin}#website` },
  about: { "@id": `${siteOrigin}#realestateagent` },
  inLanguage: "zh-TW",
  significantLink: [
    `${siteOrigin}properties/`,
    `${siteOrigin}posts/`,
    `${siteOrigin}faq/`,
    `${siteOrigin}services/`,
    `${siteOrigin}tools/`,
    `${siteOrigin}areas/`,
    `${siteOrigin}contact/`,
    `${siteOrigin}about/`,
  ],
};

// SiteNavigationElement — 給 Google 認得主導航結構，可能進 sitelinks
const navSchema = {
  "@context": "https://schema.org",
  "@type": "SiteNavigationElement",
  name: "主導航",
  hasPart: [
    { "@type": "WebPage", name: "在售物件", url: `${siteOrigin}properties/` },
    { "@type": "WebPage", name: "房市筆記", url: `${siteOrigin}posts/` },
    { "@type": "WebPage", name: "客戶工具", url: `${siteOrigin}tools/` },
    { "@type": "WebPage", name: "常見問題", url: `${siteOrigin}faq/` },
    { "@type": "WebPage", name: "台中各區", url: `${siteOrigin}areas/` },
    { "@type": "WebPage", name: "服務項目", url: `${siteOrigin}services/` },
    { "@type": "WebPage", name: "找景泰", url: `${siteOrigin}media/` },
    { "@type": "WebPage", name: "關於景泰", url: `${siteOrigin}about/` },
    { "@type": "WebPage", name: "聯絡景泰", url: `${siteOrigin}contact/` },
  ],
};

// 首圖（AI 生成北歐風客廳＋窗外台中市景，畫面標「示意圖」）：改版後手機也顯示，釘住讓白紙蓋上來。
// 660w 是改版時用 sharp 從 880w 縮的（保留 XMP 的 AI 生成標記），多數 Android（約 1.75 倍螢幕）不用抓最大張
const HERO_SRCSET = "/photos/ui2/home-hero-440.webp 440w, /photos/ui2/home-hero-660.webp 660w, /photos/ui2/home-hero-880.webp 880w";
// AVIF 版（同一張圖用 sharp 轉的、保留 AI 生成標記）：880 寬 72KB→40KB，首屏最大圖小一半；不支援 AVIF 的瀏覽器自動用上面的 WebP
const HERO_AVIF = "/photos/ui2/home-hero-440.avif 440w, /photos/ui2/home-hero-880.avif 880w";
// 2026-11 極簡改版：上面這張客廳示意圖移到「我要找房」那一塊（照樣標「示意圖」）；第一眼的大圖換成台中空拍實景
//（public/photos/hero-aerial.jpg 用 sharp 轉的 440／660／900 寬）。它是首屏最大圖（LCP），要輕：
//   手機只給 440／660 兩種，sizes 故意寫 60vw（實際約 94vw）——照片不需要 3 倍清晰，一般手機抓 660（約 84KB）、
//   螢幕密度低的抓 440（約 39KB）；電腦（735 以上）另外用 <source media> 給 900。
//   11/12 測速：第一版讓手機抓到 660／900，首頁 LCP 比改版前慢 1 秒，才改成這樣。改這幾行之後請重跑 lighthouse_sample.py。
const TOP_AVIF = "/photos/ui2/home-top-440.avif 440w, /photos/ui2/home-top-660.avif 660w";
const TOP_WEBP = "/photos/ui2/home-top-440.webp 440w, /photos/ui2/home-top-660.webp 660w";
const TOP_SIZES = "60vw";
const TOP_MEDIA = "(max-width: 734px)";
// 2026-11-13：第一眼這一塊再換成「在售物件地圖」（景泰核准的樣稿：一個點是一間在售物件，輸入框打的那句話會即時篩選地圖）。
//   HOME_MAP = true  → figure.shot 只輸出地圖的外框（#home-map）、資料網址（data- 屬性）和一行數字，畫面由 /js/home-map.js 接手；
//                      點位資料（/data/ 底下的 home-map 兩份 JSON）是建置時從物件集合算的（src/utils/homeMapData.ts），樣式在 home-map.css。
//   HOME_MAP = false → 整塊回到上面那張空拍照：照片的 <picture> 與手機的 preload（下面的 lcpProps）都原樣留在另一個分支，不用重寫。
//   地圖圖片服務的網域只准寫在 home-map.js 裡；這個檔（含行內程式、data- 屬性）不能出現，部署前的稽核會擋。
const HOME_MAP = true;
const hm = HOME_MAP ? await getHomeMapData() : null;
// /js/ 與 /data/ 底下的檔快取一天，所以網址要帶 ?v=（檔案內容 md5 前 10 碼；跟 find.astro 的 fileVer 同一個做法）。
// 檔案讀不到時不擋建置，版本字樣退成 "dev"。點位那兩份 JSON 建置時才產生（public/ 裡沒有檔），版本用資料本身算的 hm.ver。
function fileVer(rel: string): string {
  try {
    const buf = fs.readFileSync(path.join(process.cwd(), rel));
    return crypto.createHash("md5").update(buf).digest("hex").slice(0, 10);
  } catch {
    return "dev";
  }
}
const jsVer = fileVer("public/js/home-map.js");
const zonesVer = fileVer("public/data/home-map-zones.json");
// 讀句子的程式：跟找房頁（find.astro 的 vNeed）同一個版本號，兩頁共用同一份快取
const neVer = fileVer("public/js/need-extract.js");
// 首屏最大圖的 preload（Layout 的 lcpImage 那五個參數）只有照片版需要；地圖版不帶，不然手機會白抓一張用不到的照片
const lcpProps = hm
  ? {}
  : {
      lcpImage: "/photos/ui2/home-top-660.avif",
      lcpImageSrcset: TOP_AVIF,
      lcpImageSizes: TOP_SIZES,
      lcpImageMedia: TOP_MEDIA,
      lcpImageType: "image/avif",
    };
// 「我要找房／我要賣房」兩塊的圖（在第一屏以下、延後載入）：電腦各佔一半；手機寫 90vw 讓一般手機抓 660 寬就好
const TILE_SIZES = "(min-width: 735px) 50vw, 90vw";
// 在售精選的卡片：手機一張約 78vw（最多 330px），縮圖不需要 2 倍以上清晰 → 寫 50vw，一般手機抓 400 寬那張
const HOME_CARD_SIZES = "(min-width: 735px) 330px, 50vw";

const bigKanBanAccounts = [
  {
    platform: "Instagram",
    handle: "@bigkanban",
    desc: "主帳號 · 11K 粉絲",
    url: "https://instagram.com/bigkanban",
    icon: "i-ig",
  },
  {
    platform: "Instagram",
    handle: "@bigkanban.boss",
    desc: "BOSS 本尊個人帳",
    url: "https://instagram.com/bigkanban.boss",
    icon: "i-ig",
  },
  {
    platform: "TikTok",
    handle: "@bigkanban2.0",
    desc: "房屋開箱短影音",
    url: "https://www.tiktok.com/@bigkanban2.0",
    icon: "i-play",
  },
  {
    platform: "Facebook",
    handle: "BigKanBan 粉專",
    desc: "深度長文+物件",
    url: "https://www.facebook.com/bigkanban",
    icon: "i-user",
  },
];
---

<Layout
  title="陳景泰（泰迪）｜台中房仲・有巢氏房屋台中世界之心加盟店"
  {...lcpProps}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(homePageSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(navSchema)}
    />
  </Fragment>

  <Sprite />
  <Header2 />

  <main id="main-content" class="ui2 ax ax-home">
    {/* ============ 1 第一眼：一句問句、一個輸入框、一張大圖（#hero 保留）============
        大標（h1）在原始碼裡排第一個、文字一字不改；畫面上用 flex order 排到大圖後面。 */}
    <section id="hero" class="hero">
      <h1><span class="h-pre" data-r="rise">在台中買房 / 賣房，</span>{" "}<span class="h-main" data-r="rise" style="--i:1">用 AI 找到對的答案</span></h1>

      {/* 找房：白話找（預設）＋用條件篩選（點了才展開）。原本的 data-hero-*、#say-form 腳本照用 */}
      <div class="ask" id="ask">
        <form id="say-form" action="/find/" method="get" aria-labelledby="tab-say">
          <span id="tab-say" class="sr-only">白話找</span>
          <label class="lbl" for="hero-say"><span class="q">你想找什麼樣的房子？</span><span class="sub">一句話就好。</span></label>
          <div class="field">
            <textarea id="hero-say" rows="1" maxlength="300" placeholder="例：北屯三房，兩千萬內，要有車位" data-ex='["北屯三房，兩千萬內","西屯電梯大樓，1500 萬以下"]' data-ne={neVer}></textarea>
            <button type="submit">
              <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5"></path></svg><span class="sr-only">告訴小幫手</span>
            </button>
          </div>
        </form>
        <div class="reads" data-reads aria-live="polite"></div>

        {/* 例句和說明：平常收著，點到輸入框才滑出來（沒有 JavaScript 時直接顯示） */}
        <div class="assist">
          <div class="in">
            <div class="tries" role="group" aria-label="試試看">
              <button class="try" type="button" data-fill="北屯三房，兩千萬內，要平面車位">北屯三房，兩千萬內</button>
              <button class="try" type="button" data-fill="西屯 電梯大樓 1500萬以下">西屯電梯大樓，1500 萬以下</button>
            </div>
            <p class="foot">找房小幫手是自動化工具，只幫你整理。要不要聊，由你決定。</p>
          </div>
        </div>

        <p class="links">
          <button class="more" type="button" id="tab-filter" aria-expanded="false" aria-controls="panel-filter">
            用條件篩選<svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
          </button>
          <a class="more" href="/sell/#sell-form-section">
            我要賣房<span class="d-only">（免費行情評估）</span><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
          </a>
        </p>

        <div class="filt" id="panel-filter" data-filter-panel>
          <div class="in">
            <div class="filt-grid">
              <label class="sr-only" for="hero-district">區域</label>
              <select id="hero-district" data-hero-district>
                <option value="">區域（不限）</option>
                <option value="北屯區">北屯區</option>
                <option value="西屯區">西屯區</option>
                <option value="南屯區">南屯區</option>
                <option value="北區">北區</option>
                <option value="南區">南區</option>
                <option value="東區">東區</option>
                <option value="西區">西區</option>
                <option value="中區">中區</option>
                <option value="太平區">太平區</option>
                <option value="大里區">大里區</option>
                <option value="霧峰區">霧峰區</option>
              </select>
              <label class="sr-only" for="hero-price-max">總價上限</label>
              <input id="hero-price-max" type="number" inputmode="numeric" min="0" step="100" placeholder="總價上限（萬）" data-hero-price-max />
              <label class="sr-only" for="hero-rooms">房型</label>
              <select id="hero-rooms" data-hero-rooms>
                <option value="">房型（不限）</option>
                <option value="1房">1 房</option>
                <option value="2房">2 房</option>
                <option value="3房">3 房</option>
                <option value="4房">4 房</option>
                <option value="5房+">5 房以上</option>
              </select>
              <button type="button" data-hero-search class="pill f">
                <svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="7"></circle><path d="M21 21l-6-6"></path></svg>搜尋
              </button>
            </div>
            <div class="hot">
              <span class="hot-lead">熱門：</span>
              <a href="/properties/?priceMax=1000">青安額度內（≤1000 萬）</a>
              <a href="/properties/north-tun/">北屯</a>
              <a href="/properties/west-tun/">西屯 / 七期</a>
              <a href="/properties/south-tun/">南屯</a>
              <a href="/properties/?quick=new">新上架</a>
              <a href="/properties/?quick=drop">降價中</a>
              <a href="/properties/?ageMax=5">新成屋（≤5 年）</a>
            </div>
          </div>
        </div>
      </div>

      {
        hm ? (
          <figure class="shot sgrow hm" id="home-map"
            data-points={`/data/home-map.json?v=${hm.ver}`}
            data-cards={`/data/home-map-cards.json?v=${hm.ver}`}
            data-zones={`/data/home-map-zones.json?v=${zonesVer}`}
            aria-label="台中在售物件地圖">
            <div class="hm-hud"><b class="tnum" data-hm-n>{hm.count}</b><span data-hm-l>間台中在售</span><small data-hm-s>一個點是一間房子，點一下看看</small></div>
            <noscript><a class="hm-all" href="/properties/">看全部在售物件</a></noscript>
          </figure>
        ) : (
          <figure class="shot sgrow">
            <picture>
              <source media="(min-width: 735px)" type="image/avif" srcset="/photos/ui2/home-top-900.avif" />
              <source media="(min-width: 735px)" type="image/webp" srcset="/photos/ui2/home-top-900.webp" />
              <source type="image/avif" srcset={TOP_AVIF} sizes={TOP_SIZES} />
              <img
                src="/photos/ui2/home-top-660.webp"
                srcset={TOP_WEBP}
                sizes={TOP_SIZES}
                alt="台中七期天際線與秋紅谷空拍"
                width="900"
                height="1125"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
            {/* 小幫手對話預覽：裝飾用（aria-hidden），電腦版壓在大圖角落，手機不顯示 */}
            <div class="hero-chat d-only" aria-hidden="true">
              <p class="me">北屯三房，兩千萬內</p>
              <p class="bot">整理好了，這是依你的條件挑出的 7 間。</p>
            </div>
          </figure>
        )
      }
    </section>

    {/* ============ 2 數字＋我是誰（介紹與證號收在名字旁邊的 ＋；內容一字不動） ============ */}
    <section class="proof" aria-label="信任資訊">
      <div class="nums">
