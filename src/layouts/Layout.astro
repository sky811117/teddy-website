---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { existsSync } from "node:fs";
import { join } from "node:path";
import sharp from "sharp";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath } from "@/utils/withBase";
import { safeJsonLd } from "@/utils/safeJsonLd";
import FloatingCTA from "@/components/FloatingCTA.astro";
import Analytics from "@/components/Analytics.astro";
import config from "@/config";
import { YT_CHANNEL_URL } from "@/astro-paper.config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  noindex?: boolean;
  prevURL?: string;
  nextURL?: string;
  showFloatingCTA?: boolean;
  // og:type 只輸出一個（ogp.me 以第一個為準）；文章頁由 PostLayout 傳 "article"
  ogType?: "website" | "article";
  // og:image 實際寬高。image() 匯入的圖（/_astro/xxx.hash.jpg，例：區域頁 heroImage）
  // 不在 public/、build 時讀不到檔頭，由呼叫端傳 ImageMetadata 的 width／height。
  // 有傳就優先用；沒傳才走下面 ogSize 的自動判斷。
  ogImageWidth?: number;
  ogImageHeight?: number;
  // 首屏最大圖（LCP）preload：輸出在 <Font> 字型宣告之前（字型 <style> 很大，
  // 放在它後面瀏覽器要先解析完那段才看得到圖）。srcset／sizes 必須跟頁面上那張
  // <img> 完全一致，否則瀏覽器會下載兩次。
  lcpImage?: string;
  lcpImageSrcset?: string;
  lcpImageSizes?: string;
};

const { site } = config;

const {
  title = site.title,
  description = site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
  noindex = false,
  prevURL,
  nextURL,
  showFloatingCTA = true,
  ogType = "website",
  ogImageWidth,
  ogImageHeight,
  lcpImage,
  lcpImageSrcset,
  lcpImageSizes,
} = Astro.props;

// Cloudflare Pages 一律 308 轉址到帶尾斜線的網址（實測 /properties/0066565 →
// /properties/0066565/），所以 canonical 也必須帶尾斜線，否則等於告訴 Google
// 「我的標準網址是那個會跳轉的」，索引報告就會累積「頁面會重新導向」。
// 各頁自己傳進來的 canonicalURL 也一併正規化，只放過帶副檔名的檔案路徑。
// rel=prev/next 也套同一個函式（posts／tags 分頁傳進來的是無尾斜線網址，每跳都 308）。
const withTrailingSlash = (href: string) => {
  // 相對路徑（frontmatter canonicalURL 寫 /posts/x/）以站台網址補全，換網域不用改文章
  const u = new URL(href, Astro.site ?? Astro.url);
  if (!u.pathname.endsWith("/") && !/\.[a-zA-Z0-9]+$/.test(u.pathname)) {
    u.pathname += "/";
  }
  return u.href;
};
const canonicalHref = withTrailingSlash(canonicalURL);
const prevHref = prevURL ? withTrailingSlash(prevURL) : undefined;
const nextHref = nextURL ? withTrailingSlash(nextURL) : undefined;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);

// og:image 寬高照實際檔案輸出（物件頁多是 1024×768、區域頁 1600×896，不能一律寫 1200×630）。
// - 同網域且 public/ 底下有檔 → sharp 只讀檔頭拿尺寸（模組層快取，800 多頁 build 不重讀）
// - 動態產生的 /og.png、/posts/*/index.png → 固定 1200×630（og.png.ts／index.png.ts 的輸出尺寸）
// - 呼叫端有傳 ogImageWidth／ogImageHeight（image() 匯入的 /_astro/ 圖）→ 直接用
// - /_astro/ 路徑沒傳寬高 → 不輸出（build 時 /_astro/ 的檔還不在 public/，讀不到）
// - 外部網址、找不到檔、讀失敗 → 不輸出這兩行
const ogSizeCache: Map<string, { w: number; h: number } | null> =
  ((globalThis as Record<string, unknown>).__teddyOgSizeCache as Map<string, { w: number; h: number } | null>) ??
  ((globalThis as Record<string, unknown>).__teddyOgSizeCache = new Map());
const ogSize = await (async (): Promise<{ w: number; h: number } | null> => {
  if (ogImageWidth && ogImageHeight && ogImageWidth > 0 && ogImageHeight > 0) {
    return { w: Math.round(ogImageWidth), h: Math.round(ogImageHeight) };
  }
  try {
    const siteOrigin = new URL(Astro.site ?? Astro.url).origin;
    if (socialImageURL.origin !== siteOrigin) return null;
    const pathname = decodeURIComponent(socialImageURL.pathname);
    if (pathname === "/og.png" || /^\/posts\/.+\/index\.png$/.test(pathname)) {
      return { w: 1200, h: 630 };
    }
    if (pathname.includes("..")) return null;
    if (pathname.startsWith("/_astro/") || pathname.startsWith("/@fs/")) return null;
    const cached = ogSizeCache.get(pathname);
    if (cached !== undefined) return cached;
    const filePath = join(process.cwd(), "public", pathname);
    let size: { w: number; h: number } | null = null;
    if (existsSync(filePath)) {
      const meta = await sharp(filePath).metadata();
      if (meta.width && meta.height) size = { w: meta.width, h: meta.height };
    }
    ogSizeCache.set(pathname, size);
    return size;
  } catch {
    return null;
  }
})();

// ⚠️ getRelativeLocaleUrl 會依 trailingSlash 設定在後面補一個斜線，
//    產出 /rss.xml/ —— 那個網址實測回 404（正確的是 /rss.xml）。
//    等於全站每一頁都在宣告一個壞掉的 RSS 位置，所以這裡把尾斜線去掉。
const rssHref = getRelativeLocaleUrl(
  Astro.currentLocale ?? config.site.lang,
  "rss.xml"
).replace(/\/+$/, "");
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={Astro.currentLocale ?? site.lang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="icon" href={getAssetPath("favicon.ico")} />
    {/* iOS 不吃 SVG 的 apple-touch-icon，要 180×180 PNG（public/apple-touch-icon.png，
        由 favicon.svg 疊在站底色上轉出；manifest.json.ts 的 192/512 也是同一批） */}
    <link rel="apple-touch-icon" sizes="180x180" href={getAssetPath("apple-touch-icon.png")} />
    <link rel="manifest" href={getAssetPath("manifest.json")} />
    <link rel="canonical" href={canonicalHref} />
    {prevHref && <link rel="prev" href={prevHref} />}
    {nextHref && <link rel="next" href={nextHref} />}
    {/* 可收錄頁宣告大圖預覽（Discover／搜尋結果用大圖）；noindex 頁照舊 */}
    <meta name="robots" content={noindex ? "noindex, follow" : "max-image-preview:large"} />
    <meta name="generator" content={Astro.generator} />
    <meta name="format-detection" content="telephone=no" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="景泰房仲" />

    <!-- Preconnect / DNS-prefetch 第三方資源（GA / fonts） -->
    {/* 不加 crossorigin：gtag.js 是一般（非 CORS）請求，加了反而開一條用不到的匿名連線 */}
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />
    <link rel="dns-prefetch" href="https://line.me" />

    {/* Google Sans Code 等寬字已拿掉（全站 0 glyph 使用、每頁白 preload 35KB）；
        theme.css 的 --font-app 同步改成只用 --font-app-cjk，兩處必須一起改。 */}
    {/* 標題層中文字體（700/900）。astro.config.ts 這個 entry 沒指定 formats →
        預設 woff2，Google provider 才會回 unicode-range 切片，瀏覽器只抓標題實際
        用到的字塊；不 preload（CJK 切片上百個、preload 反而搶頻寬）。
        內文走系統字（--font-app-cjk 不含 Noto），載量只發生在 font-heading 元素。
        ⛔ 絕對不要在這裡 render `--font-noto-sans-tc-og`：那是 OG 圖用的整檔 ttf
        （每個 weight 7MB），只給 og.png.ts / index.png.ts 的 satori 讀。
        驗收：curl 首頁 | grep -c unicode-range 要 > 0，dist/_astro/fonts 不該再有 .woff/.ttf 的 Noto 整檔給網頁用。 */}
    {/* LCP 圖 preload 必須在 <Font> 之前（理由見 Props 的 lcpImage 註解） */}
    {
      lcpImage && (
        <link
          rel="preload"
          as="image"
          href={lcpImage}
          imagesrcset={lcpImageSrcset}
          imagesizes={lcpImageSrcset ? lcpImageSizes : undefined}
          fetchpriority="high"
        />
      )
    }
    <Font cssVariable="--font-noto-sans-tc" />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={socialImageURL} />
    {ogSize && <meta property="og:image:width" content={String(ogSize.w)} />}
    {ogSize && <meta property="og:image:height" content={String(ogSize.h)} />}
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="zh_TW" />

    <!-- Twitter / X -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalHref} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    <meta property="twitter:image:alt" content={title} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Theme color：對 light / dark mode 各設 default，theme.ts runtime 會覆蓋成精確值 -->
    <meta name="theme-color" content="#f5f1eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1f1b17" media="(prefers-color-scheme: dark)" />

    <!-- JSON-LD: 多 schema @graph（影響 Google 搜尋呈現） -->
    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd({
        "@context": "https://schema.org",
        "@graph": [
          {
            // 景泰本人是「人」：Person 才能用 jobTitle／worksFor／knowsAbout／hasCredential。
            // @id 沿用 #realestateagent（about／posts／各頁都用這個 id 連回來，不要改）。
            "@type": "Person",
            "@id": `${site.url}#realestateagent`,
            name: "陳景泰",
            alternateName: ["Teddy Chen", "Teddy", "泰迪", "景泰", "房仲大看板 泰迪"],
            // 個人的代表頁＝關於頁（about.astro 的 ProfilePage.mainEntity 指回這個 @id）。
            // PostLayout 的 BlogPosting.author.url 同值，兩邊一起改。WebSite.url 仍是首頁。
            url: `${site.url}about/`,
            // 本人代表圖固定用人像，不能跟著每頁 og:image 跑（同一個 @id 跨頁要一致；
            // 頁尾每頁都有他的頭像，與可見內容相符）。og:image／twitter:image 仍用各頁自己的圖。
            image: {
              "@type": "ImageObject",
              "@id": `${site.url}#teddy-photo`,
              url: `${site.url}photos/teddy-portrait.jpg`,
              contentUrl: `${site.url}photos/teddy-portrait.jpg`,
              width: 815,
              height: 1041,
              caption: "陳景泰（泰迪）｜一品不動產 有巢氏房屋 台中世界之心加盟店 不動產營業員",
            },
            description:
              "台中市不動產營業員（114年登字第488296號），任職一品不動產 有巢氏房屋 台中世界之心加盟店。2025 年 3 月由 13 年廚師轉行，短影音與房仲大看板 BigKanBan 用名「泰迪」，自己寫程式做官網與房市工具。",
            // 正向寫法、不點名也不否定任何第三人
            disambiguatingDescription:
              "有巢氏房屋台中世界之心店的不動產營業員陳景泰（Teddy／泰迪），房仲大看板 BigKanBan 團隊成員。",
            telephone: "+886-920-118-756",
            email: "a0920118756@gmail.com",
            jobTitle: "不動產營業員（Real Estate Salesperson）",
            hasOccupation: {
              "@type": "Occupation",
              name: "不動產營業員",
              occupationLocation: { "@type": "City", name: "台中市" },
            },
            knowsLanguage: "zh-TW",
            // 可聯絡時段跟 contact.astro 可見文字（09:00–22:00）一致，有出處；
            // 公司節點的營業時間沒有來源，已整段拿掉。
            contactPoint: {
              "@type": "ContactPoint",
              contactType: "customer service",
              telephone: "+886-920-118-756",
              availableLanguage: "zh-TW",
              hoursAvailable: {
                "@type": "OpeningHoursSpecification",
                dayOfWeek: [
                  "Monday",
                  "Tuesday",
                  "Wednesday",
                  "Thursday",
                  "Friday",
                  "Saturday",
                  "Sunday",
                ],
                opens: "09:00",
                closes: "22:00",
              },
            },
            worksFor: { "@id": `${site.url}#organization` },
            memberOf: {
              "@type": "Organization",
              "@id": `${site.url}#bigkanban`,
              name: "房仲大看板 BigKanBan",
              alternateName: ["BigKanBan", "大看板"],
              url: "https://instagram.com/bigkanban",
              // 只列組織帳號；bigkanban.boss 是個人帳號不放
              sameAs: [
                "https://instagram.com/bigkanban",
                "https://www.tiktok.com/@bigkanban2.0",
                "https://www.facebook.com/bigkanban",
              ],
            },
            workLocation: { "@type": "City", name: "台中市", alternateName: "Taichung" },
            sameAs: [
              "https://line.me/ti/p/~sky811117",
              "https://instagram.com/nov__817",
              "https://www.instagram.com/nov_817taidi/",
              "https://www.threads.com/@nov__817",
              "https://www.facebook.com/profile.php?id=61575492127872",
              YT_CHANNEL_URL,
              "https://www.tiktok.com/@sky811117",
              "https://realtor.houseprice.tw/agent/buy/0920118756/",
              "https://github.com/sky811117",
            ],
            knowsAbout: [
              "台中房地產",
              "台中買房",
              "台中賣房",
              "北屯區房屋",
              "西屯區房屋",
              "南屯區房屋",
              "七期房屋",
              "新青安貸款",
              "房屋行情評估",
              "合理出價",
              "嫌惡設施",
              "不動產說明書",
              "房屋實價登錄",
              "房仲業務",
              "AI 自動化",
            ],
            // 只放景泰自己的證照；經紀人黃永隆掛在公司節點（以前兩張都掛這裡，AI 會誤以為景泰是經紀人）
            hasCredential: {
              "@type": "EducationalOccupationalCredential",
              name: "不動產營業員",
              credentialCategory: "license",
              identifier: "114年登字第488296號",
            },
          },
          {
            "@type": "RealEstateAgent",
            "@id": `${site.url}#organization`,
            name: "一品不動產 有巢氏房屋 台中世界之心加盟店",
            legalName: "一品不動產經紀股份有限公司",
            alternateName: "有巢氏房屋 世界之心店",
            // 公司自己的官方店頭頁（不是景泰個人站）；團隊頁有列景泰＝公司官方背書的身分證據
            url: "https://shop.u-trust.com.tw/0423120888",
            sameAs: ["https://shop.u-trust.com.tw/0423120888/team"],
            logo: `${site.url}logos/yochaoshi.png`,
            telephone: "+886-4-2312-0888",
            address: {
              "@type": "PostalAddress",
              addressLocality: "台中市",
              addressRegion: "Taichung",
              addressCountry: "TW",
            },
            areaServed: [
              { "@type": "City", name: "台中市" },
              { "@type": "AdministrativeArea", name: "南投縣" },
              { "@type": "AdministrativeArea", name: "彰化縣" },
              { "@type": "AdministrativeArea", name: "苗栗縣" },
            ],
            employee: [
              { "@id": `${site.url}#realestateagent` },
              {
                "@type": "Person",
                name: "黃永隆",
                jobTitle: "不動產經紀人",
                hasCredential: {
                  "@type": "EducationalOccupationalCredential",
                  name: "不動產經紀人",
                  credentialCategory: "license",
                  identifier: "113彰縣字第324號",
                },
              },
            ],
            parentOrganization: {
              "@type": "Organization",
              name: "有巢氏房屋",
              url: "https://www.u-trust.com.tw/",
            },
          },
          {
            "@type": "WebSite",
            "@id": `${site.url}#website`,
            url: site.url,
            // 站名＝人名（跟 Person 同名）；title 後綴「陳景泰｜台中房仲」不當站名
            name: site.author,
            alternateName: ["泰迪", "Teddy Chen", "陳景泰 台中房仲"],
            description: site.description,
            inLanguage: "zh-TW",
            publisher: { "@id": `${site.url}#organization` },
            author: { "@id": `${site.url}#realestateagent` },
            copyrightHolder: { "@id": `${site.url}#realestateagent` },
            potentialAction: {
              "@type": "SearchAction",
              target: {
                "@type": "EntryPoint",
                urlTemplate: `${site.url}search/?q={search_term_string}`,
              },
              "query-input": "required name=search_term_string",
            },
          },
        ],
      })}
    />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    {/* Analytics 必須排在 <slot name="head" /> 之前：PostLayout 注進 head slot 的
        追蹤腳本是 is:inline 的同步 script，會依文件順序先執行。放在後面時
        window.gtag 還沒定義，read_post 事件會被無聲丟棄（線上實測 byte 序驗證過）。 */}
    <Analytics />

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        document.firstElementChild?.setAttribute("data-theme", theme);
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <slot />
    {showFloatingCTA && <FloatingCTA />}
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
