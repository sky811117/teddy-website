---
import Layout from "./Layout.astro";
import config from "@/config";
import { safeJsonLd } from "@/utils/safeJsonLd";
import { normalizeFaqSchema } from "@/utils/faqSchema";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  tags?: string[];
  wordCount?: number;
  timeRequired?: string; // ISO 8601 duration (e.g. PT5M)
  // 文章 frontmatter 的 faqSchema（content.config.ts 是 z.unknown()，
  // 結構沒被驗過，所以這裡也收 unknown，交給 normalizeFaqSchema 把關）
  faqSchema?: unknown;
};

const { site } = config;

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  tags = [],
  wordCount,
  timeRequired,
  faqSchema: rawFaqSchema,
} = Astro.props;

// GA4 post tracking props
// canonicalURL 只餵 <link rel="canonical">（Layout 處理）；GA4 slug 與 BlogPosting @id
// 一律用頁面自身路徑，否則被 canonical 到主文的 7 篇舊青安新聞會把事件與 @id 全部記到主文名下。
const postSlug = Astro.url.pathname.replace(/\/$/, "").split("/").pop() ?? "";
const postTitle = title ?? "";
const postTags = tags.join(",");

// 強化 BlogPosting schema — 加 publisher / mainEntityOfPage / keywords / articleSection
const articleURL = new URL(Astro.url.pathname, site.url).href;
const blogPosting = {
  "@type": "BlogPosting",
  "@id": `${articleURL}#article`,
  headline: title ?? site.title,
  description: description ?? site.description,
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  author: {
    "@type": "Person",
    "@id": `${site.url}#realestateagent`,
    name: site.author,
    ...(site.profile && { url: site.profile }),
  },
  publisher: {
    "@type": "Organization",
    "@id": `${site.url}#organization`,
    name: "一品不動產 有巢氏房屋 台中世界之心加盟店",
    logo: {
      "@type": "ImageObject",
      url: `${site.url}logos/yochaoshi.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": articleURL,
  },
  inLanguage: "zh-TW",
  ...(tags.length > 0 && { keywords: tags.join(", ") }),
  articleSection: "房地產",
  ...(wordCount && { wordCount }),
  ...(timeRequired && { timeRequired }),
};

// BreadcrumbList — Home > Posts > 文章標題
const breadcrumbList = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "首頁",
      item: site.url,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "房市筆記",
      item: `${site.url}posts/`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: title,
    },
  ],
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [blogPosting, breadcrumbList],
};

// FAQPage — 文章 frontmatter 有 faqSchema 才輸出。
// 走跟 faq.astro / areas/[district].astro 一樣的模式：獨立一段 ld+json。
// 格式不合法就靜默跳過（全有全無）：格式錯誤的告警交給 scripts/lint-seo.mjs 在
// deploy 閘門點名檔案，這裡不 console.warn（eslint no-console）也不 throw
// （不值得為一個 Google 2026-05 已停用 rich result 的 schema 卡整條 deploy）。
// schema 本身無害且 Bing / AI 答案引擎仍會讀，所以保留輸出。
const faqSchema = normalizeFaqSchema(rawFaqSchema);
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <!-- Override og:type for article pages -->
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }
    {tags.map(tag => <meta property="article:tag" content={tag} />)}

    <script
      type="application/ld+json"
      is:inline
      set:html={safeJsonLd(structuredData)}
    />

    {
      faqSchema && (
        <script
          type="application/ld+json"
          is:inline
          set:html={safeJsonLd(faqSchema)}
        />
      )
    }

    <!-- GA4: 文章閱讀 + 停留時間追蹤 -->
    <script is:inline define:vars={{ postSlug, postTitle, postTags }}>
      function _gaConsented() {
        // 量測是否就緒（Analytics.astro 設的全域旗標）。
        // ⚠️ 不能只判斷 localStorage 的同意值 —— 2026-08-27 起未同意也會送
        //    cookieless 匿名瀏覽數，read_post / dwell 同樣不該被擋掉。
        if (window.__gaMeasure === true) return true;
        try { return localStorage.getItem("ga_consent") === "granted"; }
        catch (e) { return false; }
      }
      function _sendIfConsented(fn) {
        if (_gaConsented()) { fn(); }
        else { window.addEventListener("ga:consented", fn, { once: true }); }
      }

      // read_post：進入文章頁即記錄
      _sendIfConsented(function () {
        if (window.gtag) gtag("event", "read_post", {
          post_slug: postSlug,
          post_title: postTitle,
          post_tags: postTags,
        });
      });

      // dwell timers：30s / 60s / 120s，Page Visibility API 確認使用者在看
      [30, 60, 120].forEach(function (sec) {
        setTimeout(function () {
          if (document.visibilityState !== "visible") return;
          _sendIfConsented(function () {
            if (window.gtag) gtag("event", "dwell_" + sec, {
              post_slug: postSlug,
            });
          });
        }, sec * 1000);
      });
    </script>
  </Fragment>

  <slot />
</Layout>
